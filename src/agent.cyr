enum AgentType {
    AGENT_TYPE_SYSTEM;
    AGENT_TYPE_USER;
    AGENT_TYPE_SERVICE;
}
enum AgentStatus {
    AGENT_PENDING;
    AGENT_STARTING;
    AGENT_RUNNING;
    AGENT_PAUSED;
    AGENT_STOPPING;
    AGENT_STOPPED;
    AGENT_RESTARTING;
    AGENT_TERMINATED;
    AGENT_FAILED;
}
enum RestartPolicy {
    RESTART_NEVER;
    RESTART_ALWAYS;
    RESTART_ON_FAILURE;
}
enum ProbeType {
    PROBE_LIVENESS_READINESS;
    PROBE_LIVENESS;
    PROBE_READINESS;
    PROBE_STARTUP;
}
enum StopReason {
    STOP_USER_REQUESTED;
    STOP_RESOURCE_EXHAUSTED;
    STOP_ERROR;
    STOP_TIMEOUT;
    STOP_SYSTEM_SHUTDOWN;
}
# A StopReason: why an agent stopped. A 16-byte tagged box (tagged_new) whose
# tag is a StopReason member and whose payload is a message Str, or 0 when
# there is none. Read it with stop_reason_kind / stop_reason_message.
fn stop_reason_new(kind, message: Str) {
    return tagged_new(kind, message);
}
# StopReason member, the box's tag.
fn stop_reason_kind(sr) { return boxed_tag(sr); }
# Message Str, the box's payload; 0 when stop_reason_new was given none.
fn stop_reason_message(sr) { return boxed_payload(sr); }
