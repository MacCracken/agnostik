# An AgentConfig: the configuration of one agent. 104 bytes, all 8-byte
# slots, read through the AgentConfig_* accessors:
#   +0 name (Str), +8 agent_type (AgentType, default AGENT_TYPE_USER),
#   +16 limits (a fresh resource_limits_new()), +24 sandbox (0),
#   +32 permissions (vec, created on first access), +40 metadata (0),
#   +48 restart_policy (RESTART_NEVER), +56 max_restarts (3),
#   +64 health_check (0), +72 startup_timeout (0), +80 shutdown_timeout (0),
#   +88 lifecycle_hooks (0), +96 restart_backoff (0).
# A pointer slot holding 0 means that part is not configured.
fn agent_config_new(name: Str) {
    var c = _stik_alloc(104);
    store64(c, name);
    store64(c + 8, AGENT_TYPE_USER);
    store64(c + 16, resource_limits_new());
    store64(c + 24, 0);   # sandbox set later
    store64(c + 32, 0);
    store64(c + 40, 0);
    store64(c + 48, RESTART_NEVER);
    store64(c + 56, 3);
    store64(c + 64, 0);
    store64(c + 72, 0);
    store64(c + 80, 0);
    store64(c + 88, 0);
    store64(c + 96, 0);
    return c;
}
