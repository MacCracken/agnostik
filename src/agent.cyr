    return p;
}
# An AgentStats: cumulative counters for one agent. 24 bytes, all 0:
#   +0 total_requests, +8 total_tokens, +16 uptime_seconds.
# Set with the AgentStats_set_* setters (v1.11.0).
fn agent_stats_new() {
    var s = _stik_alloc(24);
    store64(s, 0);
    store64(s + 8, 0);
    store64(s + 16, 0);
    return s;
}
# An AgentManifest: the declarative description of an agent. 80 bytes:
#   +0 name (Str), +8 description, +16 author (Strs, default ""),
#   +24 version (Version, default 0.0.0), +32 homepage (Str, default ""),
#   +40 permissions (empty vec), +48 limits (a fresh resource_limits_new()),
#   +56 and +64 (empty vecs), +72 (empty map).
# Every collection is allocated up front. No accessor in this file reads
# +56, +64 or +72.
fn agent_manifest_new(name: Str) {
    var m = _stik_alloc(80);
    store64(m, name);
    store64(m + 8, str_from(""));
    store64(m + 16, str_from(""));
    store64(m + 24, version_default());
    store64(m + 32, str_from(""));
    store64(m + 40, vec_new());
    store64(m + 48, resource_limits_new());
    store64(m + 56, vec_new());
    store64(m + 64, vec_new());
    store64(m + 72, map_new());
    return m;
}
# AgentManifest's accessors AgentManifest_<field>(p) and AgentManifest_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   name: Agent name Str, as passed to agent_manifest_new.
#   description: Description Str (default "").
#   author: Author Str (default "").
#   version: Version pointer (default 0.0.0, from version_default).
#   homepage: Homepage Str (default "").
#   permissions: vec of the Permission members the agent requests; starts empty.
#   limits: ResourceLimits pointer, allocated with the resource_limits_new defaults.
#derive(accessors)
struct AgentManifest {
    name;
    description;
    author;
    version;
    homepage;
    permissions;
    limits;
}
# A fresh random TaskId, identifying a unit of agent work: a 16-byte RFC 4122
# v4 UUID, the same representation as an AgentId (agent_id_new).
fn task_id_new()      { return agent_id_new(); }
# TaskId as a 36-character lowercase hyphenated UUID Str (agent_id_to_str).
fn task_id_to_str(t)  { return agent_id_to_str(t); }
# A fresh random ExecutionId, identifying one execution attempt of a task: a
# 16-byte RFC 4122 v4 UUID, the same representation as an AgentId.
fn execution_id_new()      { return agent_id_new(); }
# ExecutionId as a 36-character lowercase hyphenated UUID Str (agent_id_to_str).
fn execution_id_to_str(e)  { return agent_id_to_str(e); }
# AgentStatus display name (a cstr): "Pending", "Starting", "Running",
# "Paused", "Stopping", "Stopped", "Restarting", "Terminated" or "Failed", and
# "Unknown" for a value outside the enum. agent_status_parse is the inverse.
fn agent_status_name(s) {
    if (s == AGENT_PENDING)          { return "Pending"; }
    elif (s == AGENT_STARTING)       { return "Starting"; }
    elif (s == AGENT_RUNNING)        { return "Running"; }
    elif (s == AGENT_PAUSED)         { return "Paused"; }
    elif (s == AGENT_STOPPING)       { return "Stopping"; }
    elif (s == AGENT_STOPPED)        { return "Stopped"; }
    elif (s == AGENT_RESTARTING)     { return "Restarting"; }
    elif (s == AGENT_TERMINATED)     { return "Terminated"; }
    elif (s == AGENT_FAILED)         { return "Failed"; }
    return "Unknown";
}
# Inverse of agent_status_name. Exact match on what agent_status_name emits; an
# unrecognised string is an error rather than a silent default, so
# agent_status_parse(agent_status_name(v)) == v holds for every AgentStatus member.
fn agent_status_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "Pending") == 1) { return Ok(AGENT_PENDING); }
    elif (str_eq_cstr(s, "Starting") == 1) { return Ok(AGENT_STARTING); }
    elif (str_eq_cstr(s, "Running") == 1) { return Ok(AGENT_RUNNING); }
    elif (str_eq_cstr(s, "Paused") == 1) { return Ok(AGENT_PAUSED); }
    elif (str_eq_cstr(s, "Stopping") == 1) { return Ok(AGENT_STOPPING); }
    elif (str_eq_cstr(s, "Stopped") == 1) { return Ok(AGENT_STOPPED); }
    elif (str_eq_cstr(s, "Restarting") == 1) { return Ok(AGENT_RESTARTING); }
    elif (str_eq_cstr(s, "Terminated") == 1) { return Ok(AGENT_TERMINATED); }
    elif (str_eq_cstr(s, "Failed") == 1) { return Ok(AGENT_FAILED); }
    return stik_err_invalid_argument(str_from("unknown AgentStatus name"));
}
# AgentType display name (a cstr): "System", "User" or "Service", and
# "Unknown" for a value outside the enum. agent_type_parse is the inverse.
fn agent_type_name(t) {
    if (t == AGENT_TYPE_SYSTEM)      { return "System"; }
    elif (t == AGENT_TYPE_USER)      { return "User"; }
    elif (t == AGENT_TYPE_SERVICE)   { return "Service"; }
    return "Unknown";
}
# Inverse of agent_type_name. Exact match on what agent_type_name emits; an
# unrecognised string is an error rather than a silent default, so
# agent_type_parse(agent_type_name(v)) == v holds for every AgentType member.
fn agent_type_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "System") == 1) { return Ok(AGENT_TYPE_SYSTEM); }
    elif (str_eq_cstr(s, "User") == 1) { return Ok(AGENT_TYPE_USER); }
    elif (str_eq_cstr(s, "Service") == 1) { return Ok(AGENT_TYPE_SERVICE); }
    return stik_err_invalid_argument(str_from("unknown AgentType name"));
}
# RestartPolicy display name: "Never", "Always" or "OnFailure", and "Unknown"
# for a value outside the enum. restart_policy_parse is the inverse. Spelling:
# the Kubernetes restartPolicy values. argonaut's systemd-style parser is the
# separate argonaut_restart_policy_parse ("on-failure"); the two enums are
# value-identical since argonaut 1.15.4.
fn restart_policy_name(p) {
    if (p == RESTART_NEVER)        { return "Never"; }
    elif (p == RESTART_ALWAYS)     { return "Always"; }
    elif (p == RESTART_ON_FAILURE) { return "OnFailure"; }
    return "Unknown";
}
# Parse a RestartPolicy display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn restart_policy_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "Never") == 1) { return Ok(RESTART_NEVER); }
    elif (str_eq_cstr(s, "Always") == 1) { return Ok(RESTART_ALWAYS); }
    elif (str_eq_cstr(s, "OnFailure") == 1) { return Ok(RESTART_ON_FAILURE); }
    return stik_err_invalid_argument(str_from("unknown RestartPolicy name"));
}
