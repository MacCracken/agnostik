var _stik_ft_astats = 0;
# The field table naming AgentStats's members in layout order.
fn _stik_ft_astats_get() {
    if (_stik_ft_astats == 0) {
        var ft = _stik_ft_new(3);
        _stik_ft_set(ft, 0, "total_requests");
        _stik_ft_set(ft, 1, "total_tokens");
        _stik_ft_set(ft, 2, "uptime_seconds");
        _stik_ft_astats = ft;
    }
    return _stik_ft_astats;
}
# A new AgentStats (24 bytes) from the JSON text at C string `json`, read in one pass up to its NUL
# terminator and never past it. 0 when `json` is 0 or the text is not a JSON object. A missing
# member, or one that is not a number or is outside i64, reads 0, and a repeated member gives its
# last value. Through 1.12.2 the derived scanner could read past the end of truncated text.
fn AgentStats_from_json_str(json) {
    if (_stik_json_is_obj_cstr(json) == 0) { return 0; }
    var p = _stik_alloc(24);
    store64(p, 0);
    store64(p + 8, 0);
    store64(p + 16, 0);
