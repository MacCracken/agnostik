fn AgentConfig_name(c)             { return load64(c); }
# AgentType member (default AGENT_TYPE_USER).
fn AgentConfig_type(c)             { return load64(c + 8); }
# ResourceLimits pointer; agent_config_new allocates one with the defaults.
fn AgentConfig_limits(c)           { return load64(c + 16); }
# SandboxConfig pointer (sandbox_config_new), or 0 until AgentConfig_set_sandbox.
fn AgentConfig_sandbox(c)          { return load64(c + 24); }
# vec of Permission members granted to the agent; created empty on first access.
fn AgentConfig_permissions(c)      { return _stik_lazy_vec(c + 32); }
# RestartPolicy member (default RESTART_NEVER).
fn AgentConfig_restart_policy(c)   { return load64(c + 48); }
# Maximum restart attempts (default 3).
fn AgentConfig_max_restarts(c)     { return load64(c + 56); }
# HealthCheck pointer (agnostik_health_check_new), or 0 when none is set.
fn AgentConfig_health_check(c)     { return load64(c + 64); }
# Metadata slot at +40: 0 until AgentConfig_set_metadata. agnostik does not
# interpret it.
fn AgentConfig_metadata(c)         { return load64(c + 40); }
# Set the value AgentConfig_metadata reads, stored as given (not validated). Returns 0.
fn AgentConfig_set_metadata(c, v) { store64(c + 40, v); return 0; }
# Startup timeout at +72: 0 until AgentConfig_set_startup_timeout.
fn AgentConfig_startup_timeout(c)  { return load64(c + 72); }
# Set the value AgentConfig_startup_timeout reads, stored as given (not validated). Returns 0.
fn AgentConfig_set_startup_timeout(c, v) { store64(c + 72, v); return 0; }
# Shutdown timeout at +80: 0 until AgentConfig_set_shutdown_timeout.
fn AgentConfig_shutdown_timeout(c) { return load64(c + 80); }
# Set the value AgentConfig_shutdown_timeout reads, stored as given (not validated). Returns 0.
fn AgentConfig_set_shutdown_timeout(c, v) { store64(c + 80, v); return 0; }
# LifecycleHooks pointer (lifecycle_hooks_new), or 0 when none is set.
fn AgentConfig_lifecycle_hooks(c)  { return load64(c + 88); }
