fn AgentConfig_set_restart_backoff(c, v) { store64(c + 96, v); return 0; }
# Set the AgentType member. Returns 0.
fn AgentConfig_set_type(c, v)             { store64(c + 8, v); return 0; }
# Set the SandboxConfig pointer. Returns 0.
fn AgentConfig_set_sandbox(c, v)          { store64(c + 24, v); return 0; }
# Set the RestartPolicy member. Returns 0.
fn AgentConfig_set_restart_policy(c, v)   { store64(c + 48, v); return 0; }
# Set the maximum restart attempts. Returns 0.
