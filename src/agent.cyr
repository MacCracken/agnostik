var _stik_ft_rlimits = 0;
# The field table naming ResourceLimits's members in layout order.
fn _stik_ft_rlimits_get() {
    if (_stik_ft_rlimits == 0) {
        var ft = _stik_ft_new(6);
        _stik_ft_set(ft, 0, "max_memory");
        _stik_ft_set(ft, 1, "max_cpu_time");
        _stik_ft_set(ft, 2, "max_fds");
        _stik_ft_set(ft, 3, "max_procs");
        _stik_ft_set(ft, 4, "max_disk");
        _stik_ft_set(ft, 5, "net_bw");
        _stik_ft_rlimits = ft;
    }
    return _stik_ft_rlimits;
}
# A new ResourceLimits (48 bytes) from the JSON text at C string `json`, read in one pass up to its
# NUL terminator and never past it. 0 when `json` is 0 or the text is not a JSON object. A missing
# member, or one that is not a number or is outside i64, reads 0, and a repeated member gives its
# last value. Through 1.12.2 the derived scanner could read past the end of truncated text.
fn ResourceLimits_from_json_str(json) {
    if (_stik_json_is_obj_cstr(json) == 0) { return 0; }
    var p = _stik_alloc(48);
    store64(p, 0);
    store64(p + 8, 0);
    store64(p + 16, 0);
    store64(p + 24, 0);
    store64(p + 32, 0);
    store64(p + 40, 0);
    _stik_json_read_fields(json, _stik_ft_rlimits_get(), p, 0);
    return p;
}
# A ResourceLimits: per-agent resource caps. 48 bytes, all 8-byte slots:
#   +0 max_memory (bytes, default 256 MB), +8 max_cpu_time (seconds, default
#   3600), +16 max_fds (256), +24 max_procs (64), +32 max_disk (0),
#   +40 net_bw (0).
# agnostik only stores the caps; enforcing them is the runtime's job.
fn resource_limits_new() {
    var r = _stik_alloc(48);
    store64(r, 268435456);     # 256 MB default
    store64(r + 8, 3600);      # 1 hour default
    store64(r + 16, 256);      # 256 fds
    store64(r + 24, 64);       # 64 processes
    store64(r + 32, 0);
    store64(r + 40, 0);
    return r;
}
# Memory cap in bytes (default 256 MB).
fn ResourceLimits_max_memory(r)           { return load64(r); }
# CPU-time cap in seconds (default 3600, one hour).
fn ResourceLimits_max_cpu_time(r)         { return load64(r + 8); }
# Cap on open file descriptors (default 256).
fn ResourceLimits_max_fds(r)              { return load64(r + 16); }
# Cap on processes (default 64).
fn ResourceLimits_max_procs(r)            { return load64(r + 24); }
# Disk-usage cap, the max_disk field (default 0).
fn ResourceLimits_max_disk(r)             { return load64(r + 32); }
# Network-bandwidth cap, the net_bw field (default 0).
fn ResourceLimits_net_bw(r)        { return load64(r + 40); }
# Set the memory cap, in bytes. Returns 0.
fn ResourceLimits_set_max_memory(r, v)    { store64(r, v); return 0; }
# Set the CPU-time cap (max_cpu_time), in seconds. Returns 0.
fn ResourceLimits_set_max_cpu_time(r, v)       { store64(r + 8, v); return 0; }
# Set the open-file-descriptor cap. Returns 0.
fn ResourceLimits_set_max_fds(r, v)       { store64(r + 16, v); return 0; }
# Set the process cap. Returns 0.
fn ResourceLimits_set_max_procs(r, v)     { store64(r + 24, v); return 0; }
# Set the disk-usage cap (max_disk). Returns 0.
fn ResourceLimits_set_max_disk(r, v)      { store64(r + 32, v); return 0; }
# Set the network-bandwidth cap (net_bw). Returns 0.
fn ResourceLimits_set_net_bw(r, v)        { store64(r + 40, v); return 0; }
