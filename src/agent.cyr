}
# RestartBackoff's accessors RestartBackoff_<field>(p) and RestartBackoff_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   initial_delay: Delay before the first restart, in ms (default 1000).
#   multiplier: Delay multiplier applied after each restart, in thousandths: the default 2000 is 2.0x, the fixed-
#     point form of the Rust original's float.
#   max_delay: Upper bound on the delay, in ms (default 60000).
#   jitter: Jitter flag: 1 to add random jitter to each delay (default 1).
#derive(accessors)
struct RestartBackoff {
    initial_delay;
    multiplier;
    max_delay;
    jitter;
}
# An AgentPool: a set of identical agents run from one AgentConfig template.
# 40 bytes: +0 name (Str), +8 config (AgentConfig), +16 replicas (1),
# +24 min_replicas (1), +32 max_replicas (10).
fn agent_pool_new(pool_name: Str, config) {
    var p = _stik_alloc(40);
    store64(p, pool_name);
    store64(p + 8, config);
    store64(p + 16, 1);
    store64(p + 24, 1);
    store64(p + 32, 10);
    return p;
}
# AgentPool's accessors AgentPool_<field>(p) and AgentPool_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   name: Pool name Str.
#   config: AgentConfig pointer: the template every member of the pool runs.
#   replicas: Desired replica count (default 1).
#   min_replicas: Minimum replica count (default 1).
#   max_replicas: Maximum replica count (default 10).
#derive(accessors)
struct AgentPool {
    name;
    config;
    replicas;
    min_replicas;
    max_replicas;
}
# An AgentCapabilities: what an agent advertises it can do. 32 bytes, all 0:
#   +0 skills, +8 input_types, +16 output_types (vecs, each created empty on
#   first access), +24 max_tasks (0).
fn agent_capabilities_new() {
    var c = _stik_alloc(32);
    store64(c, 0);
    store64(c + 8, 0);
    store64(c + 16, 0);
    store64(c + 24, 0);
    return c;
}
# vec of skill-name Strs the agent provides; created empty on first access.
fn AgentCapabilities_skills(c)      { return _stik_lazy_vec(c); }
# vec of input-type Strs the agent accepts; created empty on first access.
fn AgentCapabilities_input_types(c) { return _stik_lazy_vec(c + 8); }
# vec of output-type Strs the agent produces; created empty on first access.
fn AgentCapabilities_output_types(c){ return _stik_lazy_vec(c + 16); }
# Maximum concurrent tasks (default 0).
fn AgentCapabilities_max_tasks(c)   { return load64(c + 24); }
# Set the maximum concurrent tasks. Returns 0.
fn AgentCapabilities_set_max_tasks(c, v) { store64(c + 24, v); return 0; }
# A SchedulingConstraints: placement rules for an agent. 48 bytes, zeroed:
#   +0 node_affinity, +8 node_anti_affinity, +16 pod_affinity,
#   +24 pod_anti_affinity (vecs, each created empty on first access),
#   +32 priority (0), +40 preemptible (0).
fn scheduling_constraints_new() {
    var s = _stik_alloc(48);
    var i = 0;
    while (i < 48) { store64(s + i, 0); i = i + 8; }
    return s;
}
# vec of node-affinity LabelSelectors; created empty on first access.
fn SchedulingConstraints_node_affinity(s)      { return _stik_lazy_vec(s); }
# vec of node-anti-affinity LabelSelectors; created empty on first access.
fn SchedulingConstraints_node_anti_affinity(s) { return _stik_lazy_vec(s + 8); }
# vec of agents to co-locate with (pod affinity); created empty on first access.
fn SchedulingConstraints_pod_affinity(s)       { return _stik_lazy_vec(s + 16); }
# vec of agents not to co-locate with (pod anti-affinity); created empty on
# first access.
fn SchedulingConstraints_pod_anti_affinity(s)  { return _stik_lazy_vec(s + 24); }
# Scheduling priority (default 0).
fn SchedulingConstraints_priority(s)           { return load64(s + 32); }
# Preemptible flag at +40 (default 0), set with SchedulingConstraints_set_preemptible.
fn SchedulingConstraints_preemptible(s)        { return load64(s + 40); }
# Set the value SchedulingConstraints_preemptible reads, stored as given (not validated). Returns 0.
fn SchedulingConstraints_set_preemptible(s, v) { store64(s + 40, v); return 0; }
# Set the scheduling priority. Returns 0.
fn SchedulingConstraints_set_priority(s, v)    { store64(s + 32, v); return 0; }
# A LabelSelector: matches node labels by key. 24 bytes: +0 key (Str),
# +8 operator (LabelOperator), both as given, +16 values (vec, created empty
# on first access).
fn label_selector_new(key: Str, operator) {
    var l = _stik_alloc(24);
    store64(l, key);
    store64(l + 8, operator);
    store64(l + 16, 0);
    return l;
}
# Label key Str.
fn LabelSelector_key(l)      { return load64(l); }
# LabelOperator member.
fn LabelSelector_operator(l) { return load64(l + 8); }
# vec of the values the operator matches against; created empty on first access.
fn LabelSelector_values(l)   { return _stik_lazy_vec(l + 16); }
# A Topic: a named pub/sub channel. 24 bytes: +0 name (Str), +8 description
# (Str, default ""), +16 ttl (0).
fn topic_new(tname: Str) {
    var t = _stik_alloc(24);
    store64(t, tname);
    store64(t + 8, str_from(""));
    store64(t + 16, 0);
    return t;
}
# Topic's accessors Topic_<field>(p) and Topic_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   name: Topic name Str.
#   description: Description Str (default "").
#   ttl: Message TTL for the topic (default 0).
#derive(accessors)
struct Topic {
    name;
    description;
    ttl;
}
# A Subscription: one agent's subscription to a topic. 24 bytes:
#   +0 agent_id (the subscriber), +8 topic (Str, the topic's name),
#   +16 filter (Str, 0 for none).
fn subscription_new(agent_id, Topic_name: Str) {
    var s = _stik_alloc(24);
    store64(s, agent_id);
    store64(s + 8, Topic_name);
    store64(s + 16, 0);
    return s;
}
# Subscription's accessors Subscription_<field>(p) and Subscription_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   agent_id: Subscribing agent's id.
#   topic: Name Str of the subscribed topic.
#   filter: Filter expression Str, or 0 for none; agnostik does not parse it.
#derive(accessors)
struct Subscription {
    agent_id;
    topic;
    filter;
}
# A TopicMessage: one message published to a topic. 56 bytes:
#   +0 id (a fresh UUID from agent_id_new), +8 topic (Str), +16 publisher
#   (agent id), +24 payload (Str, default "{}"), +32 timestamp
#   (clock_epoch_ns at construction), +40 priority (0), +48 ttl (0).
fn topic_message_new(Topic_name: Str, publisher) {
    var m = _stik_alloc(56);
    store64(m, agent_id_new());
    store64(m + 8, Topic_name);
    store64(m + 16, publisher);
    store64(m + 24, str_from("{}"));
    store64(m + 32, clock_epoch_ns());
    store64(m + 40, 0);
    store64(m + 48, 0);
    return m;
}
# TopicMessage's accessors TopicMessage_<field>(p) and TopicMessage_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   id: Message id: a fresh 16-byte UUID (agent_id_new) assigned at construction.
#   topic: Name Str of the topic the message was published to.
#   publisher: Publishing agent's id.
#   payload: Payload Str; "{}" (an empty JSON object) until TopicMessage_set_payload.
#   timestamp: Construction time from clock_epoch_ns(): Unix time in nanoseconds (wall clock; whole seconds on
#     agnos).
#   priority: Message priority (default 0).
#   ttl: Message TTL (default 0).
#derive(accessors)
struct TopicMessage {
    id;
    topic;
    publisher;
    payload;
    timestamp;
    priority;
    ttl;
}
