fn HealthCheck_interval(h)        { return load64(h + 8); }
# Set the value HealthCheck_interval reads, stored as given (not validated). Returns 0.
fn HealthCheck_set_interval(h, v) { store64(h + 8, v); return 0; }
# Per-check timeout in seconds (default 5).
fn HealthCheck_timeout(h)         { return load64(h + 16); }
# Set the value HealthCheck_timeout reads, stored as given (not validated). Returns 0.
fn HealthCheck_set_timeout(h, v) { store64(h + 16, v); return 0; }
# Retry count (default 3).
fn HealthCheck_retries(h)         { return load64(h + 24); }
# Set the value HealthCheck_retries reads, stored as given (not validated). Returns 0.
fn HealthCheck_set_retries(h, v) { store64(h + 24, v); return 0; }
# Delay before the first check (default 0, none).
fn HealthCheck_initial_delay(h)   { return load64(h + 32); }
# Set the value HealthCheck_initial_delay reads, stored as given (not validated). Returns 0.
fn HealthCheck_set_initial_delay(h, v) { store64(h + 32, v); return 0; }
