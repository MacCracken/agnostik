#   +40 payload (Str, as given), +48 timestamp (clock_epoch_ns at construction).
fn agent_message_new(sender, receiver, payload_str: Str) {
    var m = _stik_alloc(56);
    store64(m, agent_id_new());
    store64(m + 8, sender);
    store64(m + 16, receiver);
    store64(m + 24, 0);
    store64(m + 32, 0);
    store64(m + 40, payload_str);
    store64(m + 48, clock_epoch_ns());
    return m;
