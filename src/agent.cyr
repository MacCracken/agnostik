# field's name gives its value. A missing member, or one that is not a number or is outside i64,
# reads 0 (since 1.12.3; the derived code wrapped out-of-range numbers and read "12abc" as 12).
fn AgentStats_from_json(pairs) {
    var p = _stik_alloc(24);
    store64(p, _stik_json_pair_int(pairs, "total_requests"));
    store64(p + 8, _stik_json_pair_int(pairs, "total_tokens"));
    store64(p + 16, _stik_json_pair_int(pairs, "uptime_seconds"));
    return p;
}
