enum ClassificationLevel { CLASS_PUBLIC; CLASS_INTERNAL; CLASS_CONFIDENTIAL; CLASS_RESTRICTED; }
fn classification_level_name(l) {
    if (l == CLASS_PUBLIC)       { return "Public"; }
    elif (l == CLASS_INTERNAL)     { return "Internal"; }
    elif (l == CLASS_CONFIDENTIAL) { return "Confidential"; }
    elif (l == CLASS_RESTRICTED)   { return "Restricted"; }
    return "Unknown";
}
# Inverse of classification_level_name. Exact match on what classification_level_name emits; an
# unrecognised string is an error rather than a silent default, so
# classification_level_parse(classification_level_name(v)) == v holds for every ClassificationLevel member.
fn classification_level_parse(s: Str) {
    if (str_eq_cstr(s, "Public") == 1) { return Ok(CLASS_PUBLIC); }
    elif (str_eq_cstr(s, "Internal") == 1) { return Ok(CLASS_INTERNAL); }
    elif (str_eq_cstr(s, "Confidential") == 1) { return Ok(CLASS_CONFIDENTIAL); }
    elif (str_eq_cstr(s, "Restricted") == 1) { return Ok(CLASS_RESTRICTED); }
    return stik_err_invalid_argument(str_from("unknown ClassificationLevel name"));
}
enum PiiKind {
    PII_EMAIL;
    PII_PHONE;
    PII_SSN;
    PII_CREDIT_CARD;
    PII_IP_ADDRESS;
    PII_PASSPORT;
    PII_DRIVERS_LICENSE;
    PII_DATE_OF_BIRTH;
    PII_FULL_NAME;
    PII_STREET_ADDRESS;
    PII_BANK_ACCOUNT;
    PII_TAX_ID;
    PII_NATIONAL_ID;
    PII_MEDICAL_RECORD;
    PII_BIOMETRIC_DATA;
    PII_CUSTOM;
    # v1.0.7 additions — emerging regulatory categories. Appended
    # after PII_CUSTOM to preserve wire-format tag values for
    # existing consumers. PII_CUSTOM stays in its original position
    # as the catch-all returned by pii_kind_name's fall-through.
    PII_GENETIC;             # GDPR Art 9 §1 "genetic data"; CCPA "sensitive PI"
    PII_BIOMETRIC_TEMPLATE;  # algorithmic representation (distinct from raw PII_BIOMETRIC_DATA)
    PII_PRECISE_GEOLOCATION; # CCPA / CO / CT / VA precise-location category
}
fn pii_kind_name(k) {
    if (k == PII_EMAIL)                 { return "Email"; }
    elif (k == PII_PHONE)               { return "Phone"; }
    elif (k == PII_SSN)                 { return "SSN"; }
    elif (k == PII_CREDIT_CARD)         { return "CreditCard"; }
    elif (k == PII_IP_ADDRESS)          { return "IpAddress"; }
    elif (k == PII_PASSPORT)            { return "Passport"; }
    elif (k == PII_DRIVERS_LICENSE)     { return "DriversLicense"; }
    elif (k == PII_DATE_OF_BIRTH)       { return "DateOfBirth"; }
    elif (k == PII_FULL_NAME)           { return "FullName"; }
    elif (k == PII_STREET_ADDRESS)      { return "StreetAddress"; }
    elif (k == PII_BANK_ACCOUNT)        { return "BankAccount"; }
    elif (k == PII_TAX_ID)              { return "TaxId"; }
    elif (k == PII_NATIONAL_ID)         { return "NationalId"; }
    elif (k == PII_MEDICAL_RECORD)      { return "MedicalRecord"; }
    elif (k == PII_BIOMETRIC_DATA)      { return "BiometricData"; }
    elif (k == PII_GENETIC)             { return "Genetic"; }
    elif (k == PII_BIOMETRIC_TEMPLATE)  { return "BiometricTemplate"; }
    elif (k == PII_PRECISE_GEOLOCATION) { return "PreciseGeolocation"; }
    return "Custom";
}
# Inverse of pii_kind_name. Exact match on what pii_kind_name emits; an
# unrecognised string is an error rather than a silent default, so
# pii_kind_parse(pii_kind_name(v)) == v holds for every PiiKind member.
# `Custom` is PII_CUSTOM's canonical name (it is produced by
# pii_kind_name's fallback, not by an explicit arm), so it maps back here.
fn pii_kind_parse(s: Str) {
    if (str_eq_cstr(s, "Email") == 1) { return Ok(PII_EMAIL); }
    elif (str_eq_cstr(s, "Phone") == 1) { return Ok(PII_PHONE); }
    elif (str_eq_cstr(s, "SSN") == 1) { return Ok(PII_SSN); }
    elif (str_eq_cstr(s, "CreditCard") == 1) { return Ok(PII_CREDIT_CARD); }
    elif (str_eq_cstr(s, "IpAddress") == 1) { return Ok(PII_IP_ADDRESS); }
    elif (str_eq_cstr(s, "Passport") == 1) { return Ok(PII_PASSPORT); }
    elif (str_eq_cstr(s, "DriversLicense") == 1) { return Ok(PII_DRIVERS_LICENSE); }
    elif (str_eq_cstr(s, "DateOfBirth") == 1) { return Ok(PII_DATE_OF_BIRTH); }
    elif (str_eq_cstr(s, "FullName") == 1) { return Ok(PII_FULL_NAME); }
    elif (str_eq_cstr(s, "StreetAddress") == 1) { return Ok(PII_STREET_ADDRESS); }
    elif (str_eq_cstr(s, "BankAccount") == 1) { return Ok(PII_BANK_ACCOUNT); }
    elif (str_eq_cstr(s, "TaxId") == 1) { return Ok(PII_TAX_ID); }
    elif (str_eq_cstr(s, "NationalId") == 1) { return Ok(PII_NATIONAL_ID); }
    elif (str_eq_cstr(s, "MedicalRecord") == 1) { return Ok(PII_MEDICAL_RECORD); }
    elif (str_eq_cstr(s, "BiometricData") == 1) { return Ok(PII_BIOMETRIC_DATA); }
    elif (str_eq_cstr(s, "Genetic") == 1) { return Ok(PII_GENETIC); }
    elif (str_eq_cstr(s, "BiometricTemplate") == 1) { return Ok(PII_BIOMETRIC_TEMPLATE); }
    elif (str_eq_cstr(s, "PreciseGeolocation") == 1) { return Ok(PII_PRECISE_GEOLOCATION); }
    elif (str_eq_cstr(s, "Custom") == 1) { return Ok(PII_CUSTOM); }
    return stik_err_invalid_argument(str_from("unknown PiiKind name"));
}
fn classification_result_new(level) {
    var r = alloc(48);
    store64(r, level);
    store64(r + 8, level);
    store64(r + 16, vec_new());
    store64(r + 24, vec_new());
    store64(r + 32, vec_new());
    store64(r + 40, 0);
    return r;
}
fn cresult_level(r)       { return load64(r); }
fn cresult_auto_level(r)  { return load64(r + 8); }
fn cresult_rules(r)       { return load64(r + 16); }
fn cresult_pii(r)         { return load64(r + 24); }
fn cresult_keywords(r)    { return load64(r + 32); }
fn cresult_confidence(r)  { return load64(r + 40); }
