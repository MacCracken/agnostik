enum AgnostikErrorKind {
    STIK_ERR_AGENT_NOT_FOUND;
    STIK_ERR_PERMISSION_DENIED;
    STIK_ERR_CONFIG_ERROR;
    STIK_ERR_TIMEOUT;
    STIK_ERR_RESOURCE_EXHAUSTED;
    STIK_ERR_INVALID_ARGUMENT;
    STIK_ERR_NOT_SUPPORTED;
    STIK_ERR_INTERNAL;
    STIK_ERR_SERIALIZATION;
    STIK_ERR_IO;
    STIK_ERR_UNKNOWN;
}
enum AgnostikErrorCode {
    CODE_AGENT_NOT_FOUND = 1001;
    CODE_PERMISSION_DENIED = 1002;
    CODE_CONFIG_ERROR = 1003;
    CODE_TIMEOUT = 1004;
    CODE_RESOURCE_EXHAUSTED = 1005;
    CODE_INVALID_ARGUMENT = 1006;
    CODE_NOT_SUPPORTED = 1007;
    CODE_INTERNAL = 1008;
    CODE_SERIALIZATION = 1009;
    CODE_IO = 1010;
}
# Every allocation in agnostik's shipped modules goes through here (ADR-007).
# The stdlib's alloc returns 0, rather than aborting, when the heap cannot grow
# or the size is <= 0 or over 2 GiB, and through 1.12.2 no call site checked:
# the next store wrote through address 0 plus an offset. This writes
# "agnostik: allocation failed" to stderr and exits with status 71
# (EX_OSERR) instead, so the failure is named and never writes through 0. A size
# <= 0 counts as a failure too: it means the caller's size arithmetic went
# wrong, and a minimum-size block handed back would turn that into a heap
# overflow. agnostik_err_new is the one exception (see _stik_err_oom). It cannot
# be #inline (the compiler refuses a body with control flow); the extra call
# costs the smallest benchmark rows a few ns.
fn _stik_alloc(n) {
    var p = alloc(n);
    if (p != 0) { return p; }
    return _stik_alloc_fail();
}
# The failure path of _stik_alloc, also taken by a caller that knows a size is
# out of range before asking (the protobuf buffer past 2 GiB): writes
# "agnostik: allocation failed" to stderr and exits 71 (EX_OSERR). Never returns.
fn _stik_alloc_fail() {
    var msg = "agnostik: allocation failed (out of memory, or a size <= 0 or over 2 GiB)\n";
    sys_write(2, msg, strlen(msg));
    sys_exit(71);
    return 0;
}
# The out-of-memory AgnostikError, in static storage so that building it needs no
# heap: 24 bytes for the error and 16 for its message's Str header (a top-level
# `var x[N]` is N*8 bytes).
var _stik_oom_err[3];
var _stik_oom_msg[2];
# The error agnostik_err_new returns when it cannot allocate: kind
# STIK_ERR_RESOURCE_EXHAUSTED (code 1005, so agnostik_err_is_retriable answers 1)
# with the message "out of memory". It is filled on each call, from constants,
# so it is the same object every time and stays valid when the heap is exhausted.
# The caller's own kind and message are lost: what failed was the allocation.
fn _stik_err_oom() {
    var m = "out of memory";
    store64(&_stik_oom_msg, m);
    store64(&_stik_oom_msg + 8, strlen(m));
    store64(&_stik_oom_err, STIK_ERR_RESOURCE_EXHAUSTED);
    store64(&_stik_oom_err + 8, CODE_RESOURCE_EXHAUSTED);
    store64(&_stik_oom_err + 16, &_stik_oom_msg);
    return &_stik_oom_err;
}
# An AgnostikError: a kind plus a message. 24 bytes, all 8-byte slots:
#   +0 kind (AgnostikErrorKind), +8 code (AgnostikErrorCode), +16 message (Str, or 0).
# The code is derived from the kind; STIK_ERR_UNKNOWN and any value outside the
# enum get CODE_INTERNAL (1008). The kind is stored as given, not validated.
# Fallible fns return it wrapped in Err through the stik_err_* constructors.
# Never 0: if the 24-byte allocation fails it returns the static out-of-memory
# error (_stik_err_oom) instead of writing through a null pointer, so the path
# that reports failures keeps working when memory runs out. Before 1.12.3 it
# wrote to addresses 0x00-0x17 (reported by anuenue).
fn agnostik_err_new(kind, message: Str) {
    var e = alloc(24);
    if (e == 0) { return _stik_err_oom(); }
    store64(e, kind);
    # Map kind → code
    var code = 1008;
    if (kind == STIK_ERR_AGENT_NOT_FOUND)    { code = CODE_AGENT_NOT_FOUND; }
    if (kind == STIK_ERR_PERMISSION_DENIED)  { code = CODE_PERMISSION_DENIED; }
    if (kind == STIK_ERR_CONFIG_ERROR)       { code = CODE_CONFIG_ERROR; }
    if (kind == STIK_ERR_TIMEOUT)            { code = CODE_TIMEOUT; }
    if (kind == STIK_ERR_RESOURCE_EXHAUSTED) { code = CODE_RESOURCE_EXHAUSTED; }
    if (kind == STIK_ERR_INVALID_ARGUMENT)   { code = CODE_INVALID_ARGUMENT; }
    if (kind == STIK_ERR_NOT_SUPPORTED)      { code = CODE_NOT_SUPPORTED; }
    if (kind == STIK_ERR_INTERNAL)           { code = CODE_INTERNAL; }
    if (kind == STIK_ERR_SERIALIZATION)      { code = CODE_SERIALIZATION; }
    if (kind == STIK_ERR_IO)                 { code = CODE_IO; }
    store64(e + 8, code);
    store64(e + 16, message);
    return e;
}
# The error's kind: an AgnostikErrorKind value.
fn agnostik_err_kind(e) { return load64(e); }
# The error's numeric AgnostikErrorCode (1001..1010), derived from its kind by
# agnostik_err_new.
fn agnostik_err_code(e) { return load64(e + 8); }
# The error's message (Str), or 0 when it has none, as from stik_err_timeout.
fn agnostik_err_message(e) { return load64(e + 16); }
# 1 when the error is worth retrying: its kind is STIK_ERR_TIMEOUT or
# STIK_ERR_RESOURCE_EXHAUSTED. 0 for every other kind.
fn agnostik_err_is_retriable(e) {
    var kind = agnostik_err_kind(e);
    if (kind == STIK_ERR_TIMEOUT) { return 1; }
    if (kind == STIK_ERR_RESOURCE_EXHAUSTED) { return 1; }
    return 0;
}
# Err(AgnostikError) of kind STIK_ERR_INVALID_ARGUMENT for a parser handed a 0
# Str. Every *_parse / *_from_str / tctx_from_traceparent returns it since
# 1.12.3 (F-036); they used to read address 0, so a missing JSON field passed
# straight through crashed.
fn _stik_err_no_value() {
    return stik_err_invalid_argument(str_from("no value (a 0 Str)"));
}
# Err(AgnostikError) of kind STIK_ERR_AGENT_NOT_FOUND, with `name` as the
# message. Like every stik_err_* constructor it returns the value-form
# (tag, payload) pair: return it from a fallible fn, and callers bind
# `var t, v = f();` and test `t`.
fn stik_err_agent_not_found(name: Str) {
    return Err(agnostik_err_new(STIK_ERR_AGENT_NOT_FOUND, name));
}
# Err(AgnostikError) of kind STIK_ERR_PERMISSION_DENIED, with message `msg`.
fn stik_err_permission_denied(msg: Str) {
    return Err(agnostik_err_new(STIK_ERR_PERMISSION_DENIED, msg));
}
# Err(AgnostikError) of kind STIK_ERR_CONFIG_ERROR, with message `msg`.
fn stik_err_config_error(msg: Str) {
    return Err(agnostik_err_new(STIK_ERR_CONFIG_ERROR, msg));
}
# Err(AgnostikError) of kind STIK_ERR_TIMEOUT, with no message (message slot 0).
fn stik_err_timeout() {
    return Err(agnostik_err_new(STIK_ERR_TIMEOUT, 0));
}
# Err(AgnostikError) of kind STIK_ERR_RESOURCE_EXHAUSTED, with message `msg`.
fn stik_err_resource_exhausted(msg: Str) {
    return Err(agnostik_err_new(STIK_ERR_RESOURCE_EXHAUSTED, msg));
}
# Err(AgnostikError) of kind STIK_ERR_INVALID_ARGUMENT, with message `msg`.
fn stik_err_invalid_argument(msg: Str) {
    return Err(agnostik_err_new(STIK_ERR_INVALID_ARGUMENT, msg));
}
# Err(AgnostikError) of kind STIK_ERR_NOT_SUPPORTED, with message `msg`.
fn stik_err_not_supported(msg: Str) {
    return Err(agnostik_err_new(STIK_ERR_NOT_SUPPORTED, msg));
}
# Err(AgnostikError) of kind STIK_ERR_INTERNAL, with message `msg`.
fn stik_err_internal(msg: Str) {
    return Err(agnostik_err_new(STIK_ERR_INTERNAL, msg));
}
# Err(AgnostikError) of kind STIK_ERR_SERIALIZATION, with message `msg`.
fn stik_err_serialization(msg: Str) {
    return Err(agnostik_err_new(STIK_ERR_SERIALIZATION, msg));
}
# Err(AgnostikError) of kind STIK_ERR_IO, with message `msg`.
fn stik_err_io(msg: Str) {
    return Err(agnostik_err_new(STIK_ERR_IO, msg));
}
# AgnostikErrorKind display name: lowercase phrases "agent not found",
# "permission denied" … "i/o error", and "unknown error" for STIK_ERR_UNKNOWN
# or a value outside the enum. agnostik_err_kind_parse is the inverse.
fn agnostik_err_kind_name(kind) {
    if (kind == STIK_ERR_AGENT_NOT_FOUND)    { return "agent not found"; }
    if (kind == STIK_ERR_PERMISSION_DENIED)  { return "permission denied"; }
    if (kind == STIK_ERR_CONFIG_ERROR)       { return "config error"; }
    if (kind == STIK_ERR_TIMEOUT)            { return "timeout"; }
    if (kind == STIK_ERR_RESOURCE_EXHAUSTED) { return "resource exhausted"; }
    if (kind == STIK_ERR_INVALID_ARGUMENT)   { return "invalid argument"; }
    if (kind == STIK_ERR_NOT_SUPPORTED)      { return "not supported"; }
    if (kind == STIK_ERR_INTERNAL)           { return "internal error"; }
    if (kind == STIK_ERR_SERIALIZATION)      { return "serialization error"; }
    if (kind == STIK_ERR_IO)                 { return "i/o error"; }
    return "unknown error";
}
# Inverse of agnostik_err_kind_name. Exact match on what agnostik_err_kind_name emits; an
# unrecognised string is an error rather than a silent default, so
# agnostik_err_kind_parse(agnostik_err_kind_name(v)) == v holds for every AgnostikErrorKind member.
# `unknown error` is STIK_ERR_UNKNOWN's canonical name (it is produced by
# agnostik_err_kind_name's fallback, not by an explicit arm), so it maps back here.
fn agnostik_err_kind_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "agent not found") == 1) { return Ok(STIK_ERR_AGENT_NOT_FOUND); }
    elif (str_eq_cstr(s, "permission denied") == 1) { return Ok(STIK_ERR_PERMISSION_DENIED); }
    elif (str_eq_cstr(s, "config error") == 1) { return Ok(STIK_ERR_CONFIG_ERROR); }
    elif (str_eq_cstr(s, "timeout") == 1) { return Ok(STIK_ERR_TIMEOUT); }
    elif (str_eq_cstr(s, "resource exhausted") == 1) { return Ok(STIK_ERR_RESOURCE_EXHAUSTED); }
    elif (str_eq_cstr(s, "invalid argument") == 1) { return Ok(STIK_ERR_INVALID_ARGUMENT); }
    elif (str_eq_cstr(s, "not supported") == 1) { return Ok(STIK_ERR_NOT_SUPPORTED); }
    elif (str_eq_cstr(s, "internal error") == 1) { return Ok(STIK_ERR_INTERNAL); }
    elif (str_eq_cstr(s, "serialization error") == 1) { return Ok(STIK_ERR_SERIALIZATION); }
    elif (str_eq_cstr(s, "i/o error") == 1) { return Ok(STIK_ERR_IO); }
    elif (str_eq_cstr(s, "unknown error") == 1) { return Ok(STIK_ERR_UNKNOWN); }
    return stik_err_invalid_argument(str_from("unknown AgnostikErrorKind name"));
}
# AgnostikErrorCode display name: "AgentNotFound", "PermissionDenied",
# "ConfigError" … "Io", and "Unknown" for a value outside the enum.
# agnostik_err_code_parse is the inverse.
fn agnostik_err_code_name(c) {
    if (c == CODE_AGENT_NOT_FOUND)      { return "AgentNotFound"; }
    elif (c == CODE_PERMISSION_DENIED)  { return "PermissionDenied"; }
    elif (c == CODE_CONFIG_ERROR)       { return "ConfigError"; }
    elif (c == CODE_TIMEOUT)            { return "Timeout"; }
    elif (c == CODE_RESOURCE_EXHAUSTED) { return "ResourceExhausted"; }
    elif (c == CODE_INVALID_ARGUMENT)   { return "InvalidArgument"; }
    elif (c == CODE_NOT_SUPPORTED)      { return "NotSupported"; }
    elif (c == CODE_INTERNAL)           { return "Internal"; }
    elif (c == CODE_SERIALIZATION)      { return "Serialization"; }
    elif (c == CODE_IO)                 { return "Io"; }
    return "Unknown";
}
# Parse a AgnostikErrorCode display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn agnostik_err_code_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "AgentNotFound") == 1) { return Ok(CODE_AGENT_NOT_FOUND); }
    elif (str_eq_cstr(s, "PermissionDenied") == 1) { return Ok(CODE_PERMISSION_DENIED); }
    elif (str_eq_cstr(s, "ConfigError") == 1) { return Ok(CODE_CONFIG_ERROR); }
    elif (str_eq_cstr(s, "Timeout") == 1) { return Ok(CODE_TIMEOUT); }
    elif (str_eq_cstr(s, "ResourceExhausted") == 1) { return Ok(CODE_RESOURCE_EXHAUSTED); }
    elif (str_eq_cstr(s, "InvalidArgument") == 1) { return Ok(CODE_INVALID_ARGUMENT); }
    elif (str_eq_cstr(s, "NotSupported") == 1) { return Ok(CODE_NOT_SUPPORTED); }
    elif (str_eq_cstr(s, "Internal") == 1) { return Ok(CODE_INTERNAL); }
    elif (str_eq_cstr(s, "Serialization") == 1) { return Ok(CODE_SERIALIZATION); }
    elif (str_eq_cstr(s, "Io") == 1) { return Ok(CODE_IO); }
    return stik_err_invalid_argument(str_from("unknown AgnostikErrorCode name"));
}
# Write the error to stderr (fd 2) as "<kind name>: <message>" and a newline,
# or just "<kind name>" and a newline when it has no message. Returns 0.
# A message Str with a negative length writes no message bytes: passed through,
# write(2) would read it as a huge unsigned count and copy the heap beyond the
# message to stderr until it faulted.
fn agnostik_err_print(e) {
    var kind = agnostik_err_kind(e);
    var name = agnostik_err_kind_name(kind);
    var namelen = strlen(name);
    sys_write(2, name, namelen);
    var msg = agnostik_err_message(e);
    if (msg != 0) {
        sys_write(2, ": ", 2);
        var s = str_data(msg);
        var slen = str_len(msg);
        if (slen > 0) { sys_write(2, s, slen); }
    }
    sys_write(2, "\n", 1);
    return 0;
}
# Report a Result whose Err payload is an AgnostikError. Takes both halves of
# the value-form pair: `res_t` the tag, `res` the payload. Ok prints nothing
# and returns 0; Err prints the error with agnostik_err_print and returns its
# AgnostikErrorCode.
fn result_print_agnostik_err(res_t, res) {
    if (is_ok(res_t) == 1) { return 0; }
    var e = res;
    agnostik_err_print(e);
    return agnostik_err_code(e);
}
