enum LlmProvider {
    LLM_OLLAMA;
    LLM_LLAMA_CPP;
    LLM_OPENAI;
    LLM_ANTHROPIC;
    LLM_GOOGLE;
    LLM_DEEPSEEK;
    LLM_MISTRAL;
    LLM_GROK;
    LLM_GROQ;
    LLM_OPENROUTER;
    LLM_LMSTUDIO;
    LLM_LOCALAI;
    LLM_CUSTOM;
    # v1.1.0 additions — 2026-Q1/Q2 ecosystem wave. Appended after
    # LLM_CUSTOM to preserve wire-format tag values 0..12 for
    # existing consumers.
    LLM_TOGETHER;     # Together AI
    LLM_FIREWORKS;    # Fireworks AI
    LLM_BEDROCK;      # AWS Bedrock (multi-vendor model hosting)
    LLM_VERTEX;       # Google Vertex AI
    LLM_COHERE;       # Cohere
}
# Display name of an LlmProvider: "Ollama", "LlamaCpp", "OpenAI" and so on.
# LLM_CUSTOM, and any value outside the enum, is "Custom", the fallthrough
# rather than an explicit arm. llm_provider_parse is the inverse.
fn llm_provider_name(p) {
    if (p == LLM_OLLAMA)       { return "Ollama"; }
    elif (p == LLM_LLAMA_CPP)  { return "LlamaCpp"; }
    elif (p == LLM_OPENAI)     { return "OpenAI"; }
    elif (p == LLM_ANTHROPIC)  { return "Anthropic"; }
    elif (p == LLM_GOOGLE)     { return "Google"; }
    elif (p == LLM_DEEPSEEK)   { return "DeepSeek"; }
    elif (p == LLM_MISTRAL)    { return "Mistral"; }
    elif (p == LLM_GROK)       { return "Grok"; }
    elif (p == LLM_GROQ)       { return "Groq"; }
    elif (p == LLM_OPENROUTER) { return "OpenRouter"; }
    elif (p == LLM_LMSTUDIO)   { return "LMStudio"; }
    elif (p == LLM_LOCALAI)    { return "LocalAI"; }
    elif (p == LLM_TOGETHER)   { return "Together"; }
    elif (p == LLM_FIREWORKS)  { return "Fireworks"; }
    elif (p == LLM_BEDROCK)    { return "Bedrock"; }
    elif (p == LLM_VERTEX)     { return "Vertex"; }
    elif (p == LLM_COHERE)     { return "Cohere"; }
    return "Custom";
}
# Inverse of llm_provider_name. Exact match on what llm_provider_name emits; an
# unrecognised string is an error rather than a silent default, so
# llm_provider_parse(llm_provider_name(v)) == v holds for every LlmProvider member.
# `Custom` is LLM_CUSTOM's canonical name (it is produced by
# llm_provider_name's fallback, not by an explicit arm), so it maps back here.
fn llm_provider_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "Ollama") == 1) { return Ok(LLM_OLLAMA); }
    elif (str_eq_cstr(s, "LlamaCpp") == 1) { return Ok(LLM_LLAMA_CPP); }
    elif (str_eq_cstr(s, "OpenAI") == 1) { return Ok(LLM_OPENAI); }
    elif (str_eq_cstr(s, "Anthropic") == 1) { return Ok(LLM_ANTHROPIC); }
    elif (str_eq_cstr(s, "Google") == 1) { return Ok(LLM_GOOGLE); }
    elif (str_eq_cstr(s, "DeepSeek") == 1) { return Ok(LLM_DEEPSEEK); }
    elif (str_eq_cstr(s, "Mistral") == 1) { return Ok(LLM_MISTRAL); }
    elif (str_eq_cstr(s, "Grok") == 1) { return Ok(LLM_GROK); }
    elif (str_eq_cstr(s, "Groq") == 1) { return Ok(LLM_GROQ); }
    elif (str_eq_cstr(s, "OpenRouter") == 1) { return Ok(LLM_OPENROUTER); }
    elif (str_eq_cstr(s, "LMStudio") == 1) { return Ok(LLM_LMSTUDIO); }
    elif (str_eq_cstr(s, "LocalAI") == 1) { return Ok(LLM_LOCALAI); }
    elif (str_eq_cstr(s, "Together") == 1) { return Ok(LLM_TOGETHER); }
    elif (str_eq_cstr(s, "Fireworks") == 1) { return Ok(LLM_FIREWORKS); }
    elif (str_eq_cstr(s, "Bedrock") == 1) { return Ok(LLM_BEDROCK); }
    elif (str_eq_cstr(s, "Vertex") == 1) { return Ok(LLM_VERTEX); }
    elif (str_eq_cstr(s, "Cohere") == 1) { return Ok(LLM_COHERE); }
    elif (str_eq_cstr(s, "Custom") == 1) { return Ok(LLM_CUSTOM); }
    return stik_err_invalid_argument(str_from("unknown LlmProvider name"));
}
enum MessageRole { ROLE_SYSTEM; ROLE_USER; ROLE_ASSISTANT; ROLE_TOOL; }
# MessageRole display name: "system", "user", "assistant" or "tool", and
# "unknown" for a value outside the enum. message_role_parse is the inverse.
fn message_role_name(r) {
    if (r == ROLE_SYSTEM)        { return "system"; }
    elif (r == ROLE_USER)        { return "user"; }
    elif (r == ROLE_ASSISTANT)   { return "assistant"; }
    elif (r == ROLE_TOOL)        { return "tool"; }
    return "unknown";
}
# Inverse of message_role_name. Exact match on what message_role_name emits; an
# unrecognised string is an error rather than a silent default, so
# message_role_parse(message_role_name(v)) == v holds for every MessageRole member.
fn message_role_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "system") == 1) { return Ok(ROLE_SYSTEM); }
    elif (str_eq_cstr(s, "user") == 1) { return Ok(ROLE_USER); }
    elif (str_eq_cstr(s, "assistant") == 1) { return Ok(ROLE_ASSISTANT); }
    elif (str_eq_cstr(s, "tool") == 1) { return Ok(ROLE_TOOL); }
    return stik_err_invalid_argument(str_from("unknown MessageRole name"));
}
enum ContentBlockType {
    CB_TEXT;
    CB_IMAGE;
    CB_DOCUMENT;
    CB_TOOL_USE;
    CB_TOOL_RESULT;
    CB_THINKING;
    CB_AUDIO;
    CB_CITATION;
}
# Text content block: a tagged box with tag CB_TEXT whose payload is the `text`
# Str. Read any content block with content_block_type / content_block_payload.
fn content_text(text: Str) { return tagged_new(CB_TEXT, text); }
# Tool-use content block: a tagged box with tag CB_TOOL_USE whose payload is a
# 24-byte record: +0 tool-use id, +8 tool name, +16 arguments, all Str.
fn content_tool_use(tid: Str, tname: Str, targs: Str) {
    var tu = _stik_alloc(24);
    store64(tu, tid);
    store64(tu + 8, tname);
    store64(tu + 16, targs);
    return tagged_new(CB_TOOL_USE, tu);
}
# Tool-result content block: a tagged box with tag CB_TOOL_RESULT whose payload
# is a 24-byte record: +0 id of the tool use it answers (Str), +8 result content
# (Str), +16 is-error flag. tool_result_new builds the same record unboxed.
fn content_tool_result(tuid: Str, tcontent: Str, tiserr) {
    var tr = _stik_alloc(24);
    store64(tr, tuid);
    store64(tr + 8, tcontent);
    store64(tr + 16, tiserr);
    return tagged_new(CB_TOOL_RESULT, tr);
}
# Thinking content block (model reasoning): a tagged box with tag CB_THINKING
# whose payload is the `text` Str.
fn content_thinking(text: Str) { return tagged_new(CB_THINKING, text); }
# Image content block: a tagged box with tag CB_IMAGE whose payload is a 24-byte
# record: +0 source (Str), +8 media type (Str, e.g. "image/png"), +16 is_url:
# 1 when `source` is a URL, 0 when it holds the encoded (base64) image data.
fn content_image(source: Str, media_type: Str, is_url) {
    var img = _stik_alloc(24);
    store64(img, source);
    store64(img + 8, media_type);
    store64(img + 16, is_url);
    return tagged_new(CB_IMAGE, img);
}
# Document content block (a PDF, for example): a tagged box with tag CB_DOCUMENT
# whose payload is a 16-byte record: +0 source (Str), +8 media type (Str).
# Unlike content_image there is no is_url flag.
fn content_document(source: Str, media_type: Str) {
    var doc = _stik_alloc(16);
    store64(doc, source);
    store64(doc + 8, media_type);
    return tagged_new(CB_DOCUMENT, doc);
}
# Audio content block: a tagged box with tag CB_AUDIO whose payload is a 16-byte
# record: +0 source (Str), +8 media type (Str, e.g. "audio/wav").
fn content_audio(source: Str, media_type: Str) {
    var aud = _stik_alloc(16);
    store64(aud, source);
    store64(aud + 8, media_type);
    return tagged_new(CB_AUDIO, aud);
}
# Citation content block: a tagged box with tag CB_CITATION whose payload is a
# 16-byte record: +0 source (Str), +8 cited text (Str).
fn content_citation(source: Str, text: Str) {
    var cit = _stik_alloc(16);
    store64(cit, source);
    store64(cit + 8, text);
    return tagged_new(CB_CITATION, cit);
}
# ContentBlockType of a content block box (the box's tag).
fn content_block_type(cb)    { return boxed_tag(cb); }
# Payload of a content block box: the Str itself for CB_TEXT and CB_THINKING,
# else a pointer to the record its content_* constructor laid out.
fn content_block_payload(cb) { return boxed_payload(cb); }
enum CacheControl { CACHE_EPHEMERAL; }
enum FinishReason {
    FINISH_STOP;
    FINISH_LENGTH;
    FINISH_CONTENT_FILTER;
    FINISH_TOOL_USE;
    FINISH_ERROR;
    FINISH_RECITATION;
}
# FinishReason display name: "stop", "length", "content_filter", "tool_use",
# "error" or "recitation", and "unknown" for a value outside the enum.
# finish_reason_parse is the inverse.
fn finish_reason_name(r) {
    if (r == FINISH_STOP)               { return "stop"; }
    elif (r == FINISH_LENGTH)           { return "length"; }
    elif (r == FINISH_CONTENT_FILTER)   { return "content_filter"; }
    elif (r == FINISH_TOOL_USE)         { return "tool_use"; }
    elif (r == FINISH_ERROR)            { return "error"; }
    elif (r == FINISH_RECITATION)       { return "recitation"; }
    return "unknown";
}
# Inverse of finish_reason_name. Exact match on what finish_reason_name emits; an
# unrecognised string is an error rather than a silent default, so
# finish_reason_parse(finish_reason_name(v)) == v holds for every FinishReason member.
fn finish_reason_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "stop") == 1) { return Ok(FINISH_STOP); }
    elif (str_eq_cstr(s, "length") == 1) { return Ok(FINISH_LENGTH); }
    elif (str_eq_cstr(s, "content_filter") == 1) { return Ok(FINISH_CONTENT_FILTER); }
    elif (str_eq_cstr(s, "tool_use") == 1) { return Ok(FINISH_TOOL_USE); }
    elif (str_eq_cstr(s, "error") == 1) { return Ok(FINISH_ERROR); }
    elif (str_eq_cstr(s, "recitation") == 1) { return Ok(FINISH_RECITATION); }
    return stik_err_invalid_argument(str_from("unknown FinishReason name"));
}
# ContentBlockType display name: "text", "image", "document" … "citation", and
# "Unknown" for a value outside the enum. content_block_type_parse is the
# inverse. Spelling: the provider APIs' lowercase wire spelling (Anthropic's
# block types where they exist).
fn content_block_type_name(t) {
    if (t == CB_TEXT)          { return "text"; }
    elif (t == CB_IMAGE)       { return "image"; }
    elif (t == CB_DOCUMENT)    { return "document"; }
    elif (t == CB_TOOL_USE)    { return "tool_use"; }
    elif (t == CB_TOOL_RESULT) { return "tool_result"; }
    elif (t == CB_THINKING)    { return "thinking"; }
    elif (t == CB_AUDIO)       { return "audio"; }
    elif (t == CB_CITATION)    { return "citation"; }
    return "Unknown";
}
# Parse a ContentBlockType display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn content_block_type_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "text") == 1) { return Ok(CB_TEXT); }
    elif (str_eq_cstr(s, "image") == 1) { return Ok(CB_IMAGE); }
    elif (str_eq_cstr(s, "document") == 1) { return Ok(CB_DOCUMENT); }
    elif (str_eq_cstr(s, "tool_use") == 1) { return Ok(CB_TOOL_USE); }
    elif (str_eq_cstr(s, "tool_result") == 1) { return Ok(CB_TOOL_RESULT); }
    elif (str_eq_cstr(s, "thinking") == 1) { return Ok(CB_THINKING); }
    elif (str_eq_cstr(s, "audio") == 1) { return Ok(CB_AUDIO); }
    elif (str_eq_cstr(s, "citation") == 1) { return Ok(CB_CITATION); }
    return stik_err_invalid_argument(str_from("unknown ContentBlockType name"));
}
# CacheControl display name: "ephemeral", and "Unknown" for a value outside
# the enum. cache_control_parse is the inverse. Spelling: Anthropic's
# `cache_control` type spelling.
fn cache_control_name(c) {
    if (c == CACHE_EPHEMERAL)   { return "ephemeral"; }
    return "Unknown";
}
# Parse a CacheControl display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn cache_control_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "ephemeral") == 1) { return Ok(CACHE_EPHEMERAL); }
    return stik_err_invalid_argument(str_from("unknown CacheControl name"));
}
# ToolChoice display name: "auto", "none", "required" or "specific", and
# "Unknown" for a value outside the enum. tool_choice_parse is the inverse.
# Spelling: OpenAI's `tool_choice` strings, plus "specific" for a named tool.
fn tool_choice_name(c) {
    if (c == TOOL_AUTO)       { return "auto"; }
    elif (c == TOOL_NONE)     { return "none"; }
    elif (c == TOOL_REQUIRED) { return "required"; }
    elif (c == TOOL_SPECIFIC) { return "specific"; }
    return "Unknown";
}
# Parse a ToolChoice display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn tool_choice_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "auto") == 1) { return Ok(TOOL_AUTO); }
    elif (str_eq_cstr(s, "none") == 1) { return Ok(TOOL_NONE); }
    elif (str_eq_cstr(s, "required") == 1) { return Ok(TOOL_REQUIRED); }
    elif (str_eq_cstr(s, "specific") == 1) { return Ok(TOOL_SPECIFIC); }
    return stik_err_invalid_argument(str_from("unknown ToolChoice name"));
}
# ResponseFormat display name: "text", "json_object" or "json_schema", and
# "Unknown" for a value outside the enum. response_format_parse is the
# inverse. Spelling: OpenAI's `response_format` type spelling.
fn response_format_name(f) {
    if (f == RESP_TEXT)          { return "text"; }
    elif (f == RESP_JSON_OBJECT) { return "json_object"; }
    elif (f == RESP_JSON_SCHEMA) { return "json_schema"; }
    return "Unknown";
}
# Parse a ResponseFormat display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn response_format_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "text") == 1) { return Ok(RESP_TEXT); }
    elif (str_eq_cstr(s, "json_object") == 1) { return Ok(RESP_JSON_OBJECT); }
    elif (str_eq_cstr(s, "json_schema") == 1) { return Ok(RESP_JSON_SCHEMA); }
    return stik_err_invalid_argument(str_from("unknown ResponseFormat name"));
}
# SafetyCategory display name: "HARM_CATEGORY_HATE_SPEECH",
# "HARM_CATEGORY_HARASSMENT", "HARM_CATEGORY_SEXUALLY_EXPLICIT",
# "HARM_CATEGORY_DANGEROUS_CONTENT" or "HARM_CATEGORY_CIVIC_INTEGRITY", and
# "Unknown" for a value outside the enum. safety_category_parse is the
# inverse. Spelling: Gemini's HarmCategory names, so a category from a Gemini
# response parses as-is.
fn safety_category_name(c) {
    if (c == SAFETY_HATE)         { return "HARM_CATEGORY_HATE_SPEECH"; }
    elif (c == SAFETY_HARASSMENT) { return "HARM_CATEGORY_HARASSMENT"; }
    elif (c == SAFETY_SEXUAL)     { return "HARM_CATEGORY_SEXUALLY_EXPLICIT"; }
    elif (c == SAFETY_DANGEROUS)  { return "HARM_CATEGORY_DANGEROUS_CONTENT"; }
    elif (c == SAFETY_CIVIC)      { return "HARM_CATEGORY_CIVIC_INTEGRITY"; }
    return "Unknown";
}
# Parse a SafetyCategory display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn safety_category_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "HARM_CATEGORY_HATE_SPEECH") == 1) { return Ok(SAFETY_HATE); }
    elif (str_eq_cstr(s, "HARM_CATEGORY_HARASSMENT") == 1) { return Ok(SAFETY_HARASSMENT); }
    elif (str_eq_cstr(s, "HARM_CATEGORY_SEXUALLY_EXPLICIT") == 1) { return Ok(SAFETY_SEXUAL); }
    elif (str_eq_cstr(s, "HARM_CATEGORY_DANGEROUS_CONTENT") == 1) { return Ok(SAFETY_DANGEROUS); }
    elif (str_eq_cstr(s, "HARM_CATEGORY_CIVIC_INTEGRITY") == 1) { return Ok(SAFETY_CIVIC); }
    return stik_err_invalid_argument(str_from("unknown SafetyCategory name"));
}
# SafetyProbability display name: "NEGLIGIBLE", "LOW", "MEDIUM" or "HIGH", and
# "Unknown" for a value outside the enum. safety_probability_parse is the
# inverse. Spelling: Gemini's HarmProbability names.
fn safety_probability_name(p) {
    if (p == SAFETY_NEGLIGIBLE)   { return "NEGLIGIBLE"; }
    elif (p == SAFETY_LOW)        { return "LOW"; }
    elif (p == SAFETY_MEDIUM)     { return "MEDIUM"; }
    elif (p == SAFETY_HIGH)       { return "HIGH"; }
    return "Unknown";
}
# Parse a SafetyProbability display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn safety_probability_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "NEGLIGIBLE") == 1) { return Ok(SAFETY_NEGLIGIBLE); }
    elif (str_eq_cstr(s, "LOW") == 1) { return Ok(SAFETY_LOW); }
    elif (str_eq_cstr(s, "MEDIUM") == 1) { return Ok(SAFETY_MEDIUM); }
    elif (str_eq_cstr(s, "HIGH") == 1) { return Ok(SAFETY_HIGH); }
    return stik_err_invalid_argument(str_from("unknown SafetyProbability name"));
}
# StreamEventType display name: "content_block_start", "delta",
# "tool_call_delta" … "ping", and "Unknown" for a value outside the enum.
# stream_event_type_parse is the inverse. Spelling: the lowercase snake_case
# wire style of this module's other names.
fn stream_event_type_name(t) {
    if (t == STREAM_CONTENT_BLOCK_START)   { return "content_block_start"; }
    elif (t == STREAM_DELTA)               { return "delta"; }
    elif (t == STREAM_TOOL_CALL_DELTA)     { return "tool_call_delta"; }
    elif (t == STREAM_CONTENT_BLOCK_STOP)  { return "content_block_stop"; }
    elif (t == STREAM_USAGE)               { return "usage"; }
    elif (t == STREAM_DONE)                { return "done"; }
    elif (t == STREAM_ERROR)               { return "error"; }
    elif (t == STREAM_PING)                { return "ping"; }
    return "Unknown";
}
# Parse a StreamEventType display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn stream_event_type_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "content_block_start") == 1) { return Ok(STREAM_CONTENT_BLOCK_START); }
    elif (str_eq_cstr(s, "delta") == 1) { return Ok(STREAM_DELTA); }
    elif (str_eq_cstr(s, "tool_call_delta") == 1) { return Ok(STREAM_TOOL_CALL_DELTA); }
    elif (str_eq_cstr(s, "content_block_stop") == 1) { return Ok(STREAM_CONTENT_BLOCK_STOP); }
    elif (str_eq_cstr(s, "usage") == 1) { return Ok(STREAM_USAGE); }
    elif (str_eq_cstr(s, "done") == 1) { return Ok(STREAM_DONE); }
    elif (str_eq_cstr(s, "error") == 1) { return Ok(STREAM_ERROR); }
    elif (str_eq_cstr(s, "ping") == 1) { return Ok(STREAM_PING); }
    return stik_err_invalid_argument(str_from("unknown StreamEventType name"));
}
# BatchStatus display name: "pending", "in_progress", "completed", "failed",
# "cancelled" or "expired", and "Unknown" for a value outside the enum.
# batch_status_parse is the inverse. Spelling: OpenAI's Batch API status
# spelling (it has no "pending").
fn batch_status_name(s) {
    if (s == BATCH_PENDING)       { return "pending"; }
    elif (s == BATCH_IN_PROGRESS) { return "in_progress"; }
    elif (s == BATCH_COMPLETED)   { return "completed"; }
    elif (s == BATCH_FAILED)      { return "failed"; }
    elif (s == BATCH_CANCELLED)   { return "cancelled"; }
    elif (s == BATCH_EXPIRED)     { return "expired"; }
    return "Unknown";
}
# Parse a BatchStatus display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn batch_status_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "pending") == 1) { return Ok(BATCH_PENDING); }
    elif (str_eq_cstr(s, "in_progress") == 1) { return Ok(BATCH_IN_PROGRESS); }
    elif (str_eq_cstr(s, "completed") == 1) { return Ok(BATCH_COMPLETED); }
    elif (str_eq_cstr(s, "failed") == 1) { return Ok(BATCH_FAILED); }
    elif (str_eq_cstr(s, "cancelled") == 1) { return Ok(BATCH_CANCELLED); }
    elif (str_eq_cstr(s, "expired") == 1) { return Ok(BATCH_EXPIRED); }
    return stik_err_invalid_argument(str_from("unknown BatchStatus name"));
}
enum ToolChoice { TOOL_AUTO; TOOL_NONE; TOOL_REQUIRED; TOOL_SPECIFIC; }
enum ResponseFormat { RESP_TEXT; RESP_JSON_OBJECT; RESP_JSON_SCHEMA; }
enum SafetyCategory { SAFETY_HATE; SAFETY_HARASSMENT; SAFETY_SEXUAL; SAFETY_DANGEROUS; SAFETY_CIVIC; }
enum SafetyProbability { SAFETY_NEGLIGIBLE; SAFETY_LOW; SAFETY_MEDIUM; SAFETY_HIGH; }
enum StreamEventType {
    STREAM_CONTENT_BLOCK_START;
    STREAM_DELTA;
    STREAM_TOOL_CALL_DELTA;
    STREAM_CONTENT_BLOCK_STOP;
    STREAM_USAGE;
    STREAM_DONE;
    STREAM_ERROR;
    STREAM_PING;
}
enum BatchStatus { BATCH_PENDING; BATCH_IN_PROGRESS; BATCH_COMPLETED; BATCH_FAILED; BATCH_CANCELLED; BATCH_EXPIRED; }
# A Message: one turn of an LLM conversation. 24 bytes, all 8-byte slots:
#   +0 role (MessageRole), +8 content (vec of content-block boxes, starts
#   empty), +16 zeroed, with no accessor.
# Add content by pushing content_* boxes onto Message_content.
fn message_new(role) {
    var m = _stik_alloc(24);
    store64(m, role);
    store64(m + 8, vec_new());
    store64(m + 16, 0);
    return m;
}
# Message with `role` and a single CB_TEXT content block holding `text`.
fn message_text(role, text: Str) {
    var m = message_new(role);
    vec_push(load64(m + 8), content_text(text));
    return m;
}
# Message's accessors Message_<field>(p) and Message_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   role: MessageRole of the message.
#   content: vec of the message's content-block boxes (see content_text and friends).
#derive(accessors)
struct Message {
    role;
    content;
}
# A ToolDefinition: a tool offered to the model. 32 bytes, all 8-byte slots:
#   +0 name (Str), +8 description (Str), +16 parameters (Str, may be 0),
#   +24 zeroed, with no accessor.
fn tool_definition_new(tname: Str, desc: Str, params: Str) {
    var t = _stik_alloc(32);
    store64(t, tname);
    store64(t + 8, desc);
    store64(t + 16, params);
    store64(t + 24, 0);
    return t;
}
# ToolDefinition's accessors ToolDefinition_<field>(p) and ToolDefinition_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   name: Tool name (Str).
#   desc: Tool description (Str).
#   params: Tool parameters (Str), or 0 when none were given.
#derive(accessors)
struct ToolDefinition {
    name;
    desc;
    params;
}
# A ToolCall: a model's request to invoke a tool. 24 bytes, all 8-byte slots:
#   +0 call id, +8 tool name, +16 arguments, all Str.
fn tool_call_new(tid: Str, tname: Str, targs: Str) {
    var tc = _stik_alloc(24);
    store64(tc, tid);
    store64(tc + 8, tname);
    store64(tc + 16, targs);
    return tc;
}
# ToolCall's accessors ToolCall_<field>(p) and ToolCall_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   id: Tool call id (Str).
#   name: Name of the tool to call (Str).
#   args: Call arguments (Str), stored as given.
#derive(accessors)
struct ToolCall {
    id;
    name;
    args;
}
# SamplingParams for an inference request. 56 bytes, all 8-byte slots:
#   +0 temperature (1000), +8 top_p, +16 top_k, +24 frequency penalty,
#   +32 presence penalty, +40 stop sequences (vec, starts empty), +48 seed.
# Every slot but temperature and the stop vec reads 0 (seed is left as
# allocated, i.e. zeroed). The numeric fields are integers, stored as given
# with no scaling or validation.
fn sampling_params_new() {
    var s = _stik_alloc(56);
    store64(s, 1000);
    var i = 8;
    while (i < 48) { store64(s + i, 0); i = i + 8; }
    store64(s + 40, vec_new());
    return s;
}
# SamplingParams's accessors SamplingParams_<field>(p) and SamplingParams_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   temperature: Sampling temperature, an integer stored as given; 1000 by default.
#   top_p: Nucleus-sampling top_p, an integer stored as given; 0 by default.
#   top_k: top_k sampling cutoff (a token count); 0 by default.
#   freq_penalty: Frequency penalty, an integer; 0 by default (SamplingParams_set_freq_penalty).
#   pres_penalty: Presence penalty, an integer; 0 by default (SamplingParams_set_pres_penalty).
#   stop_seqs: vec of stop sequences (Str), empty by default; push onto it to add one.
#   seed: Sampling seed; 0 by default.
#derive(accessors)
struct SamplingParams {
    temperature;
    top_p;
    top_k;
    freq_penalty;
    pres_penalty;
    stop_seqs;
    seed;
}
# TokenUsage's accessors TokenUsage_<field>(p) and TokenUsage_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   prompt_tok: Prompt (input) token count.
#   completion_tok: Completion (output) token count.
#   total_tok: Total token count, as set; nothing derives it from the other counts.
#   cache_create_tok: Input tokens written to the prompt cache (cache creation).
#   cache_read_tok: Input tokens read from the prompt cache.
#derive(accessors)
struct TokenUsage {
    prompt_tok: i64; completion_tok: i64; total_tok: i64;
    cache_create_tok: i64; cache_read_tok: i64;
}
# Write the TokenUsage at `ptr` to str_builder `sb` as JSON, each field an i64 member:
#   {"prompt_tok":N,"completion_tok":N,"total_tok":N,"cache_create_tok":N,"cache_read_tok":N}
# The bytes the #derive(Serialize) code wrote through 1.12.2, one literal per member as it emitted
# them (ADR-008). Returns 0.
fn TokenUsage_to_json(ptr, sb) {
    str_builder_add_cstr(sb, "{\"prompt_tok\":");
    str_builder_add_int(sb, load64(ptr));
    str_builder_add_cstr(sb, ",\"completion_tok\":");
    str_builder_add_int(sb, load64(ptr + 8));
    str_builder_add_cstr(sb, ",\"total_tok\":");
    str_builder_add_int(sb, load64(ptr + 16));
    str_builder_add_cstr(sb, ",\"cache_create_tok\":");
    str_builder_add_int(sb, load64(ptr + 24));
    str_builder_add_cstr(sb, ",\"cache_read_tok\":");
    str_builder_add_int(sb, load64(ptr + 32));
    str_builder_add_cstr(sb, "}");
    return 0;
}
# A new TokenUsage (40 bytes) from `pairs`, the vec bayan_json_parse returns; the first pair with a
# field's name gives its value. A missing member, or one that is not a number or is outside i64,
# reads 0 (since 1.12.3; the derived code wrapped out-of-range numbers and read "12abc" as 12).
fn TokenUsage_from_json(pairs) {
    var p = _stik_alloc(40);
    store64(p, _stik_json_pair_int(pairs, "prompt_tok"));
    store64(p + 8, _stik_json_pair_int(pairs, "completion_tok"));
    store64(p + 16, _stik_json_pair_int(pairs, "total_tok"));
    store64(p + 24, _stik_json_pair_int(pairs, "cache_create_tok"));
    store64(p + 32, _stik_json_pair_int(pairs, "cache_read_tok"));
    return p;
}
# TokenUsage_from_json_str's field table, built on first use.
var _stik_ft_tusage = 0;
# The field table naming TokenUsage's members in layout order.
fn _stik_ft_tusage_get() {
    if (_stik_ft_tusage == 0) {
        var ft = _stik_ft_new(5);
        _stik_ft_set(ft, 0, "prompt_tok");
        _stik_ft_set(ft, 1, "completion_tok");
        _stik_ft_set(ft, 2, "total_tok");
        _stik_ft_set(ft, 3, "cache_create_tok");
        _stik_ft_set(ft, 4, "cache_read_tok");
        _stik_ft_tusage = ft;
    }
    return _stik_ft_tusage;
}
# A new TokenUsage (40 bytes) from the JSON text at C string `json`, read in one pass up to its NUL
# terminator and never past it. 0 when `json` is 0 or the text is not a JSON object. A missing
# member, or one that is not a number or is outside i64, reads 0, and a repeated member gives its
# last value. Through 1.12.2 the derived scanner could read past the end of truncated text.
fn TokenUsage_from_json_str(json) {
    if (_stik_json_is_obj_cstr(json) == 0) { return 0; }
    var p = _stik_alloc(40);
    store64(p, 0);
    store64(p + 8, 0);
    store64(p + 16, 0);
    store64(p + 24, 0);
    store64(p + 32, 0);
    _stik_json_read_fields(json, _stik_ft_tusage_get(), p, 0);
    return p;
}
# A TokenUsage: token counts for an inference or embedding call. 40 bytes,
# all 8-byte slots, all 0 at construction:
#   +0 prompt, +8 completion, +16 total, +24 cache_create, +32 cache_read.
# Providers differ on whether prompt includes cached tokens: OpenAI's
# prompt_tokens includes them, Anthropic's input_tokens excludes them (the
# cache_* counts are separate). Record which convention a value follows.
# The layout is the TokenUsage struct above, which TokenUsage_to_json and the
# two TokenUsage_from_json fns read and write.
fn token_usage_new() {
    var u = _stik_alloc(40);
    var i = 0;
    while (i < 40) { store64(u + i, 0); i = i + 8; }
    return u;
}
# An InferenceRequest. 136 bytes, all 8-byte slots:
#   +0 model (Str), +8 prompt (Str, ""), +16 system prompt (Str, 0 = none),
#   +24 messages (vec of Message, empty), +32 max_tokens (0),
#   +40 sampling (a fresh sampling_params_new), +48 stream flag (0),
#   +56 tools (vec of ToolDefinition, empty), +64 tool_choice (0, TOOL_AUTO),
#   +72..+104 five slots zeroed with no accessor, +112 service_tier (Str, 0),
#   +120 metadata (0), +128 reasoning_effort (Str, 0).
fn inference_request_new(model: Str) {
    var r = _stik_alloc(136);
    store64(r, model);
    store64(r + 8, str_from(""));
    store64(r + 16, 0);
    store64(r + 24, vec_new());
    store64(r + 32, 0);
    store64(r + 40, sampling_params_new());
    store64(r + 48, 0);
    store64(r + 56, vec_new());
    store64(r + 64, 0);
    store64(r + 72, 0);
    store64(r + 80, 0);
    store64(r + 88, 0);
    store64(r + 96, 0);
    store64(r + 104, 0);
    store64(r + 112, 0);
    store64(r + 120, 0);
    store64(r + 128, 0);
    return r;
}
# Model identifier (Str) the request targets.
fn InferenceRequest_model(r)         { return load64(r); }
# Plain prompt (Str): "" from inference_request_new until InferenceRequest_set_prompt.
fn InferenceRequest_prompt(r)        { return load64(r + 8); }
# Set the value InferenceRequest_prompt reads, stored as given (not validated). Returns 0.
fn InferenceRequest_set_prompt(r, v) { store64(r + 8, v); return 0; }
# Top-level system prompt (Str), or 0 when none is set.
fn InferenceRequest_system(r)        { return load64(r + 16); }
# vec of the conversation's Message pointers, empty at construction; push to add
# a turn.
fn InferenceRequest_messages(r)      { return load64(r + 24); }
# Maximum number of tokens to generate; 0 until set.
fn InferenceRequest_max_tokens(r)    { return load64(r + 32); }
# The request's SamplingParams pointer, created by inference_request_new.
fn InferenceRequest_sampling(r)      { return load64(r + 40); }
# Streaming flag: 1 to request a streamed response, 0 (the default) otherwise.
fn InferenceRequest_stream(r)        { return load64(r + 48); }
# vec of ToolDefinition pointers offered to the model; empty at construction.
fn InferenceRequest_tools(r)         { return load64(r + 56); }
# ToolChoice for the request; 0 (TOOL_AUTO) at construction.
fn InferenceRequest_tool_choice(r)   { return load64(r + 64); }
# Set the system prompt (Str). Returns 0.
fn InferenceRequest_set_system(r, v: Str)     { store64(r + 16, v); return 0; }
# Set max_tokens. Returns 0.
fn InferenceRequest_set_max_tokens(r, v) { store64(r + 32, v); return 0; }
# Set the streaming flag (1 stream, 0 not). Returns 0.
fn InferenceRequest_set_stream(r, v)     { store64(r + 48, v); return 0; }
# Service tier name (Str, e.g. "auto"), or 0 when unset.
fn InferenceRequest_service_tier(r)      { return load64(r + 112); }
# Request metadata as passed to InferenceRequest_set_metadata, or 0 when unset. This module
# stores it without interpreting it.
fn InferenceRequest_metadata(r)          { return load64(r + 120); }
# Reasoning-effort level (Str, e.g. "high"), or 0 when unset.
fn InferenceRequest_reasoning_effort(r)  { return load64(r + 128); }
# Set tool_choice, a ToolChoice (not validated). Returns 0.
fn InferenceRequest_set_tool_choice(r, v)       { store64(r + 64, v); return 0; }
# Set the service tier name (Str). Returns 0.
fn InferenceRequest_set_service_tier(r, v: Str)     { store64(r + 112, v); return 0; }
# Set the request metadata, stored as given. Returns 0.
fn InferenceRequest_set_metadata(r, v)              { store64(r + 120, v); return 0; }
# Set the reasoning-effort level (Str). Returns 0.
fn InferenceRequest_set_reasoning_effort(r, v: Str) { store64(r + 128, v); return 0; }
# An InferenceResponse. 64 bytes, all 8-byte slots:
#   +0 id (Str, 0 until set), +8 model (Str), +16 content (vec of content-block
#   boxes, empty), +24 usage (a fresh token_usage_new), +32 finish_reason
#   (FINISH_STOP), +40 tool_calls (vec of ToolCall, empty), +48 and +56 zeroed,
#   with no accessor.
fn inference_response_new(model: Str) {
    var r = _stik_alloc(64);
    store64(r, 0);
    store64(r + 8, model);
    store64(r + 16, vec_new());
    store64(r + 24, token_usage_new());
    store64(r + 32, FINISH_STOP);
    store64(r + 40, vec_new());
    store64(r + 48, 0);
    store64(r + 56, 0);
    return r;
}
# InferenceResponse's accessors InferenceResponse_<field>(p) and InferenceResponse_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   id: Provider-assigned response id (Str), or 0 until set.
#   model: Model identifier (Str) passed to inference_response_new.
#   content: vec of the response's content-block boxes; empty at construction.
#   usage: The response's TokenUsage pointer, created zeroed by the constructor.
#   finish_reason: FinishReason of the response; FINISH_STOP until set.
#   tool_calls: vec of ToolCall pointers the model requested; empty at construction.
#derive(accessors)
struct InferenceResponse {
    id;
    model;
    content;
    usage;
    finish_reason;
    tool_calls;
}
# StreamEvent for a text delta: a tagged box with tag STREAM_DELTA whose payload
# is the `text` Str. Read stream events with boxed_tag / boxed_payload.
fn stream_delta(text: Str) { return tagged_new(STREAM_DELTA, text); }
# StreamEvent ending the stream: tag STREAM_DONE, payload the FinishReason.
fn stream_done(finish_reason) { return tagged_new(STREAM_DONE, finish_reason); }
# StreamEvent for an error: tag STREAM_ERROR, payload the `errmsg` Str.
fn stream_error(errmsg: Str) { return tagged_new(STREAM_ERROR, errmsg); }
# StreamEvent carrying token usage: tag STREAM_USAGE, payload the TokenUsage
# pointer.
fn stream_usage(usage_ptr) { return tagged_new(STREAM_USAGE, usage_ptr); }
# Ping StreamEvent: tag STREAM_PING, payload 0.
fn stream_ping() { return tagged_new(STREAM_PING, 0); }
# ModelCapabilities: what a model supports, for routing. 120 bytes, all 8-byte
# slots: +0 model_id (Str), +8 display_name (Str, defaults to model_id),
# +16 provider (LlmProvider), +24 context_window, +32 max_output, then 0/1
# flags +40 vision, +48 tools, +56 structured, +64 streaming, +72 thinking,
# +80 audio, +88 citations, +96 video_input, +104 caching,
# +112 parallel_tool_calls. Everything from +24 on starts at 0.
fn model_capabilities_new(model_id: Str, provider) {
    # 96 → 120 bytes at v1.1.0: 3 new flags appended (video_input,
    # caching, parallel_tool_calls). Existing offsets 0..88 unchanged.
    var m = _stik_alloc(120);
    store64(m, model_id);
    store64(m + 8, model_id);  # display_name defaults to model_id
    store64(m + 16, provider);
    var i = 24;
    while (i < 120) { store64(m + i, 0); i = i + 8; }
    return m;
}
# Model identifier (Str).
fn ModelCapabilities_model_id(m)        { return load64(m); }
# Human-readable model name (Str); model_id until ModelCapabilities_set_display_name.
fn ModelCapabilities_display_name(m)    { return load64(m + 8); }
# LlmProvider serving the model.
fn ModelCapabilities_provider(m)        { return load64(m + 16); }
# Context window size in tokens; 0 until set.
fn ModelCapabilities_context_window(m)  { return load64(m + 24); }
# Maximum output length in tokens; 0 until set.
fn ModelCapabilities_max_output(m)      { return load64(m + 32); }
# 1 if the model accepts image input, else 0.
fn ModelCapabilities_supports_vision(m) { return load64(m + 40); }
# 1 if the model supports tool calling, else 0.
fn ModelCapabilities_supports_tools(m)  { return load64(m + 48); }
# 1 if the model supports structured output, else 0.
fn ModelCapabilities_supports_structured(m) { return load64(m + 56); }
# 1 if the model supports streamed responses, else 0.
fn ModelCapabilities_supports_streaming(m)  { return load64(m + 64); }
# 1 if the model produces thinking (reasoning) output, else 0.
fn ModelCapabilities_supports_thinking(m)   { return load64(m + 72); }
# 1 if the model supports audio, else 0.
fn ModelCapabilities_supports_audio(m)      { return load64(m + 80); }
# 1 if the model supports citations, else 0.
fn ModelCapabilities_supports_citations(m)  { return load64(m + 88); }
# v1.1.0 — 2026-Q1/Q2 ecosystem wave additions.
# 1 if the model accepts video input, else 0.
fn ModelCapabilities_supports_video_input(m)         { return load64(m + 96); }
# 1 if the model supports prompt/context caching, else 0.
fn ModelCapabilities_supports_caching(m)             { return load64(m + 104); }  # prompt/context caching
# 1 if the model can make several tool calls in one response, else 0.
fn ModelCapabilities_supports_parallel_tool_calls(m) { return load64(m + 112); }
# F-021 (audit 2026-08-24): the seven original flag getters below had no
# setters, so they could only ever read 0 — the same defect class as
# SecretMetadata's unsettable fields, resolved together in v1.4.0 so the
# library gives one consistent answer on setter-less getters.
# Set the vision flag, 1 or 0. Returns 0.
fn ModelCapabilities_set_supports_vision(m, v)     { store64(m + 40, v); return 0; }
# Set the tool-calling flag, 1 or 0. Returns 0.
fn ModelCapabilities_set_supports_tools(m, v)      { store64(m + 48, v); return 0; }
# Set the structured-output flag, 1 or 0. Returns 0.
fn ModelCapabilities_set_supports_structured(m, v) { store64(m + 56, v); return 0; }
# Set the streaming flag, 1 or 0. Returns 0.
fn ModelCapabilities_set_supports_streaming(m, v)  { store64(m + 64, v); return 0; }
# Set the thinking flag, 1 or 0. Returns 0.
fn ModelCapabilities_set_supports_thinking(m, v)   { store64(m + 72, v); return 0; }
# Set the audio flag, 1 or 0. Returns 0.
fn ModelCapabilities_set_supports_audio(m, v)      { store64(m + 80, v); return 0; }
# Set the citations flag, 1 or 0. Returns 0.
fn ModelCapabilities_set_supports_citations(m, v)  { store64(m + 88, v); return 0; }
# Set the display name (Str). Returns 0.
fn ModelCapabilities_set_display_name(m, v: Str) { store64(m + 8, v); return 0; }
# Set the context window size in tokens. Returns 0.
fn ModelCapabilities_set_context_window(m, v)    { store64(m + 24, v); return 0; }
# Set the maximum output length in tokens. Returns 0.
fn ModelCapabilities_set_max_output(m, v)        { store64(m + 32, v); return 0; }
# Set the video-input flag, 1 or 0. Returns 0.
fn ModelCapabilities_set_supports_video_input(m, v)         { store64(m + 96, v);  return 0; }
# Set the caching flag, 1 or 0. Returns 0.
fn ModelCapabilities_set_supports_caching(m, v)             { store64(m + 104, v); return 0; }
# Set the parallel-tool-calls flag, 1 or 0. Returns 0.
fn ModelCapabilities_set_supports_parallel_tool_calls(m, v) { store64(m + 112, v); return 0; }
# A RateLimitInfo: a provider's rate-limit state. 40 bytes, all 8-byte slots,
# all 0 at construction: +0 request limit, +8 requests remaining, +16 token
# limit, +24 tokens remaining, +32 seconds until reset. The RateLimitInfo_set_* setters
# fill it (since v1.11.0).
fn rate_limit_info_new() {
    var r = _stik_alloc(40);
    var i = 0;
    while (i < 40) { store64(r + i, 0); i = i + 8; }
    return r;
}
# RateLimitInfo's accessors RateLimitInfo_<field>(p) and RateLimitInfo_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   limit_requests: Request limit.
#   remaining_requests: Requests remaining under the limit.
#   limit_tokens: Token limit.
#   remaining_tokens: Tokens remaining under the limit.
#   reset_seconds: Seconds until the rate limit resets.
#derive(accessors)
struct RateLimitInfo {
    limit_requests;
    remaining_requests;
    limit_tokens;
    remaining_tokens;
    reset_seconds;
}
# A ToolResult: the outcome of a tool call, returned to the model. 24 bytes,
# all 8-byte slots: +0 tool_use_id (Str, the tool use it answers), +8 content
# (Str), +16 is-error flag. content_tool_result boxes the same record.
fn tool_result_new(tuid: Str, tcontent: Str, tiserr) {
    var tr = _stik_alloc(24);
    store64(tr, tuid);
    store64(tr + 8, tcontent);
    store64(tr + 16, tiserr);
    return tr;
}
# ToolResult's accessors ToolResult_<field>(p) and ToolResult_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   tool_use_id: Id (Str) of the tool use this result answers.
#   content: Result content (Str).
#   is_error: Is-error flag as passed to tool_result_new: 1 when the result is an error.
#derive(accessors)
struct ToolResult {
    tool_use_id;
    content;
    is_error;
}
# A LogprobEntry: a token with its log probability. 24 bytes, all 8-byte
# slots: +0 token (Str), +8 logprob (integer, stored as given),
# +16 top_logprobs (vec, 0 until LogprobEntry_top_logprobs first creates it).
fn logprob_entry_new(token: Str, logprob) {
    var e = _stik_alloc(24);
    store64(e, token);
    store64(e + 8, logprob);
    store64(e + 16, 0);
    return e;
}
# The token (Str).
fn LogprobEntry_token(e)       { return load64(e); }
# Log probability of the token, an integer stored as given.
fn LogprobEntry_logprob(e)     { return load64(e + 8); }
# vec of the top alternative logprobs for this position; created empty on first
# access.
fn LogprobEntry_top_logprobs(e){ return _stik_lazy_vec(e + 16); }
# A TokenLogprob: a token with its log probability. 16 bytes: +0 token (Str),
# +8 logprob (integer, stored as given).
fn token_logprob_new(token: Str, logprob) {
    var t = _stik_alloc(16);
    store64(t, token);
    store64(t + 8, logprob);
    return t;
}
# TokenLogprob's accessors TokenLogprob_<field>(p) and TokenLogprob_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   token: The token (Str).
#   logprob: Log probability of the token, an integer stored as given.
#derive(accessors)
struct TokenLogprob {
    token;
    logprob;
}
# A SafetyRating: a safety assessment for one harm category. 24 bytes, all
# 8-byte slots: +0 category (SafetyCategory), +8 probability
# (SafetyProbability), +16 blocked flag. Values are stored as given.
fn safety_rating_new(category, probability, blocked) {
    var r = _stik_alloc(24);
    store64(r, category);
    store64(r + 8, probability);
    store64(r + 16, blocked);
    return r;
}
# SafetyRating's accessors SafetyRating_<field>(p) and SafetyRating_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   category: SafetyCategory the rating is for.
#   probability: SafetyProbability of harm in the category.
#   blocked: Blocked flag as passed to safety_rating_new: 1 when the content was blocked.
#derive(accessors)
struct SafetyRating {
    category;
    probability;
    blocked;
}
# An EmbeddingRequest. 24 bytes, all 8-byte slots: +0 model (Str), +8 inputs
# (vec, 0 until EmbeddingRequest_inputs first creates it), +16 dimensions (0).
fn embedding_request_new(model: Str) {
    var r = _stik_alloc(24);
    store64(r, model);
    store64(r + 8, 0);
    store64(r + 16, 0);
    return r;
}
# Model identifier (Str).
fn EmbeddingRequest_model(r)      { return load64(r); }
# vec of the inputs to embed; created empty on first access.
fn EmbeddingRequest_inputs(r)     { return _stik_lazy_vec(r + 8); }
# Requested embedding dimension count; 0 until set.
fn EmbeddingRequest_dimensions(r) { return load64(r + 16); }
# Set the requested embedding dimension count. Returns 0.
fn EmbeddingRequest_set_dimensions(r, v) { store64(r + 16, v); return 0; }
# An EmbeddingResponse. 24 bytes, all 8-byte slots: +0 model (Str),
# +8 embeddings (vec, 0 until EmbeddingResponse_embeddings first creates it),
# +16 usage (a fresh token_usage_new).
fn embedding_response_new(model: Str) {
    var r = _stik_alloc(24);
    store64(r, model);
    store64(r + 8, 0);
    store64(r + 16, token_usage_new());
    return r;
}
# Model identifier (Str).
fn EmbeddingResponse_model(r)      { return load64(r); }
# vec of the returned embeddings; created empty on first access.
fn EmbeddingResponse_embeddings(r) { return _stik_lazy_vec(r + 8); }
# The response's TokenUsage pointer, created zeroed by the constructor.
fn EmbeddingResponse_usage(r)      { return load64(r + 16); }
# A BatchRequest: one entry of a batch job. 16 bytes: +0 custom_id (Str),
# +8 request (pointer, stored as given).
fn batch_request_new(custom_id: Str, request) {
    var b = _stik_alloc(16);
    store64(b, custom_id);
    store64(b + 8, request);
    return b;
}
# BatchRequest's accessors BatchRequest_<field>(p) and BatchRequest_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   custom_id: Caller-chosen id (Str) that matches this entry to its BatchResult.
#   request: The request pointer passed to batch_request_new.
#derive(accessors)
struct BatchRequest {
    custom_id;
    request;
}
# A BatchResult: the outcome of one batch entry. 24 bytes, all 8-byte slots:
# +0 custom_id (Str), +8 response (0 until set), +16 error (Str, 0 until set).
fn batch_result_new(custom_id: Str) {
    var b = _stik_alloc(24);
    store64(b, custom_id);
    store64(b + 8, 0);
    store64(b + 16, 0);
    return b;
}
# BatchResult's accessors BatchResult_<field>(p) and BatchResult_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   custom_id: custom_id (Str) of the batch entry this result belongs to.
#   response: Response pointer, or 0 when none has been set.
#   error: Error message (Str), or 0 when none has been set.
#derive(accessors)
struct BatchResult {
    custom_id;
    response;
    error;
}
