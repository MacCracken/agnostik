# proto.cyr — minimal protobuf wire-format writer (OTLP encoder support)
#
# Implements just the primitives agnostik's OTLP encoders need — varint,
# tag, length-delimited bytes, fixed64 and nested messages — written into
# a private growable buffer, which the public encoders append to the
# caller's str_builder in one copy. Not a general-purpose protobuf library
# (no parsing, no field-set tracking).
#
# Why a buffer of its own (v1.10.0): str_builder_putc costs about 33 ns a
# byte (a call and a capacity check per byte), and a nested message built in
# a child str_builder pays for the builder, a build copy and an add copy,
# about 200 ns plus its bytes. Here a field reserves its worst case once and
# stores bytes directly. A nested message is written in place behind a
# one-byte length that is patched when it closes; only a body of 128 bytes
# or more is shifted to make room for a longer length. Lengths stay minimal
# varints, so the output is byte-identical to protoc's.
#
# Wire-type constants per https://protobuf.dev/programming-guides/encoding/
var PROTO_WT_VARINT  = 0;
var PROTO_WT_FIXED64 = 1;
var PROTO_WT_LENGTH  = 2;
var PROTO_WT_FIXED32 = 5;

# A new protobuf output buffer: 24 bytes, +0 data, +8 length, +16 capacity,
# starting with 256 bytes of capacity.
fn _stik_pb_new() {
    var b = _stik_alloc(24);
    store64(b, _stik_alloc(256));
    store64(b + 8, 0);
    store64(b + 16, 256);
    return b;
}

# Make room for `n` more bytes, at least doubling the capacity when it grows.
# The data may move; callers re-read it after reserving. Returns 0.
# A buffer never exceeds 2 GiB, the stdlib allocator's limit: a reservation
# that would take it past that, or a negative `n`, fails by name through
# _stik_alloc_fail (F-040, 1.12.3). Through 1.12.2 `len + n` could wrap for a
# Str claiming a length near i64 max, so the buffer did not grow and the copy
# wrote past it; and the doubled capacity was not capped, so a request near
# 1 GiB asked for more than 2 GiB and wrote through address 0.
fn _stik_pb_reserve(b, n) {
    var len = load64(b + 8);
    var cap = load64(b + 16);
    # Fast path: fits already. cap - len cannot overflow, so a huge or negative
    # n never passes here by wrapping.
    if (n >= 0 && n <= cap - len) { return 0; }
    if (n < 0 || n > 0x80000000 - len) { return _stik_alloc_fail(); }
    var nc = cap * 2;
    if (nc > 0x80000000) { nc = 0x80000000; }
    if (nc < len + n) { nc = len + n; }
    var nd = _stik_alloc(nc);
    memcpy(nd, load64(b), len);
    store64(b, nd);
    store64(b + 16, nc);
    return 0;
}

# Write a uint32 count field (OTLP's dropped_*_count) only when it is positive,
# saturated at 0xFFFFFFFF (F-043, 1.12.3). A negative count used to go out as a
# 10-byte varint that decoders read as 0xFFFFFFFF. Returns 0.
fn _stik_pb_count32(b, field, v) {
    if (v <= 0) { return 0; }
    if (v > 0xFFFFFFFF) { v = 0xFFFFFFFF; }
    _stik_pb_int64(b, field, v);
    return 0;
}

# Append the buffer's bytes to str_builder `sb`, in one copy. Returns 0.
fn _stik_pb_flush(b, sb) {
    var len = load64(b + 8);
    if (len > 0) { str_builder_add(sb, str_new(load64(b), len)); }
    return 0;
}

# Encode an unsigned int as a base-128 varint, low 7 bits per byte,
# MSB set on continuation. 1 byte for n < 128, up to 10 bytes for
# the full i64 range. A negative value is written as its 64-bit two's
# complement, 10 bytes, as protobuf encodes a negative int64.
fn _stik_pb_varint(b, n) {
    _stik_pb_reserve(b, 10);
    var len = load64(b + 8);
    var p = load64(b) + len;
    var i = 0;
    while ((n & 0xFFFFFFFFFFFFFF80) != 0) {
        store8(p + i, ((n & 0x7F) | 0x80) & 0xFF);
        n = (n >> 7) & 0x01FFFFFFFFFFFFFF;
        i = i + 1;
    }
    store8(p + i, n & 0x7F);
    store64(b + 8, len + i + 1);
    return 0;
}

# Field tag = (field_number << 3) | wire_type, encoded as varint.
fn _stik_pb_tag(b, field_no, wire_type) {
    _stik_pb_varint(b, (field_no << 3) | wire_type);
    return 0;
}

# Encode 8 bytes little-endian (fixed64 wire type), byte by byte so the
# order does not depend on the target.
fn _stik_pb_fixed64_raw(b, n) {
    _stik_pb_reserve(b, 8);
    var len = load64(b + 8);
    var p = load64(b) + len;
    store8(p, n & 0xFF);
    store8(p + 1, (n >> 8) & 0xFF);
    store8(p + 2, (n >> 16) & 0xFF);
    store8(p + 3, (n >> 24) & 0xFF);
    store8(p + 4, (n >> 32) & 0xFF);
    store8(p + 5, (n >> 40) & 0xFF);
    store8(p + 6, (n >> 48) & 0xFF);
    store8(p + 7, (n >> 56) & 0xFF);
    store64(b + 8, len + 8);
    return 0;
}

# uint64 / int64 / bool / enum field — tag + varint.
fn _stik_pb_int64(b, field_no, n) {
    _stik_pb_tag(b, field_no, PROTO_WT_VARINT);
    _stik_pb_varint(b, n);
    return 0;
}

# fixed64 / sfixed64 / double field — tag + 8 LE bytes. OTLP uses this for
# *_unix_nano, as_int and double values.
fn _stik_pb_fixed64(b, field_no, n) {
    _stik_pb_tag(b, field_no, PROTO_WT_FIXED64);
    _stik_pb_fixed64_raw(b, n);
    return 0;
}

# bytes field — tag + varint(len) + `len` raw bytes from `ptr`.
# Used by OTLP for trace_id (16 bytes), span_id (8 bytes), etc. A negative
# `len` or a 0 `ptr` writes an empty field: a negative length would move the
# write position below the buffer, and the next write would land outside it
# (audit F-027).
fn _stik_pb_bytes(b, field_no, ptr, len) {
    if (len < 0) { len = 0; }
    if (ptr == 0) { len = 0; }
    _stik_pb_tag(b, field_no, PROTO_WT_LENGTH);
    _stik_pb_varint(b, len);
    _stik_pb_reserve(b, len);
    var at = load64(b + 8);
    memcpy(load64(b) + at, ptr, len);
    store64(b + 8, at + len);
    return 0;
}

# The UTF-8 sequence at p[i] (i < len): its length (1..4) when it is well
# formed, else the negated length (-1..-3) of its maximal ill-formed subpart,
# the bytes one U+FFFD replaces (Unicode §3.9, "U+FFFD Substitution of Maximal
# Subparts", Table 3-7: overlongs, surrogates and code points past U+10FFFF are
# ill formed).
fn _stik_utf8_step(p, i, len) {
    var b0 = load8(p + i);
    if (b0 < 0x80) { return 1; }
    var need = 0;
    var lo = 0x80;
    var hi = 0xBF;
    if (b0 >= 0xC2) {
        if (b0 <= 0xDF) { need = 1; }
    }
    if (b0 == 0xE0) {
        need = 2;
        lo = 0xA0;
    }
    if (b0 >= 0xE1) {
        if (b0 <= 0xEC) { need = 2; }
    }
    if (b0 == 0xED) {
        need = 2;
        hi = 0x9F;
    }
    if (b0 >= 0xEE) {
        if (b0 <= 0xEF) { need = 2; }
    }
    if (b0 == 0xF0) {
        need = 3;
        lo = 0x90;
    }
    if (b0 >= 0xF1) {
        if (b0 <= 0xF3) { need = 3; }
    }
    if (b0 == 0xF4) {
        need = 3;
        hi = 0x8F;
    }
    if (need == 0) { return 0 - 1; }
    var k = 1;
    var going = 1;
    while (going == 1) {
        if (k > need) { going = 0; }
        elif (i + k >= len) { going = 0; }
        else {
            var c = load8(p + i + k);
            var l = 0x80;
            var h = 0xBF;
            if (k == 1) {
                l = lo;
                h = hi;
            }
            if (c < l) { going = 0; }
            elif (c > h) { going = 0; }
            else { k = k + 1; }
        }
    }
    if (k > need) { return need + 1; }
    return 0 - k;
}

# Byte length of the `len` bytes at p once every maximal ill-formed subpart is
# replaced by U+FFFD (3 bytes), or -1 when they are already valid UTF-8. ASCII
# takes a fast path: 8 bytes at a time while no byte has its high bit set (an
# unaligned load64, which every target the toolchain builds allows), then one
# byte at a time.
fn _stik_utf8_fixed_len(p, len) {
    var i = 0;
    var out = 0;
    var bad = 0;
    while (i < len) {
        var word = 0;
        if (i + 8 <= len) {
            if ((load64(p + i) & 0x8080808080808080) == 0) { word = 1; }
        }
        if (word == 1) {
            i = i + 8;
            out = out + 8;
        } elif (load8(p + i) < 0x80) {
            i = i + 1;
            out = out + 1;
        } else {
            var st = _stik_utf8_step(p, i, len);
            if (st > 0) {
                out = out + st;
                i = i + st;
            } else {
                out = out + 3;
                i = i - st;
                bad = 1;
            }
        }
    }
    if (bad == 0) { return 0 - 1; }
    return out;
}

# Packed repeated fixed64 / double field (proto3 packs repeated scalars): tag,
# varint(8 × count), then each element of vec `v` as 8 LE bytes. An empty or 0
# vec writes nothing. Returns 0.
fn _stik_pb_packed_fixed64(b, field_no, v) {
    if (v == 0) { return 0; }
    var n = vec_len(v);
    if (n == 0) { return 0; }
    _stik_pb_tag(b, field_no, PROTO_WT_LENGTH);
    _stik_pb_varint(b, n * 8);
    var i = 0;
    while (i < n) {
        _stik_pb_fixed64_raw(b, vec_get(v, i));
        i = i + 1;
    }
    return 0;
}

# Write field `field_no` as the `len` bytes at ptr (len >= 0), validating them
# as UTF-8 while copying, in one pass: 8 ASCII bytes at a time while no byte
# has its high bit set, else one sequence at a time. Returns 1 when they were
# valid and the field is written; on the first ill-formed sequence it rewinds
# the buffer to where the field began and returns 0, having written nothing.
fn _stik_pb_copy_utf8(b, field_no, ptr, len) {
    var start = load64(b + 8);
    _stik_pb_tag(b, field_no, PROTO_WT_LENGTH);
    _stik_pb_varint(b, len);
    _stik_pb_reserve(b, len);
    var at = load64(b + 8);
    var d = load64(b) + at;
    var i = 0;
    var ok = 1;
    while (i < len) {
        var w = 0;
        var word = 0;
        if (i + 8 <= len) {
            w = load64(ptr + i);
            if ((w & 0x8080808080808080) == 0) { word = 1; }
        }
        if (word == 1) {
            store64(d + i, w);
            i = i + 8;
        } else {
            var c = load8(ptr + i);
            if (c < 0x80) {
                store8(d + i, c);
                i = i + 1;
            } else {
                var st = _stik_utf8_step(ptr, i, len);
                if (st > 0) {
                    var j = 0;
                    while (j < st) {
                        store8(d + i + j, load8(ptr + i + j));
                        j = j + 1;
                    }
                    i = i + st;
                } else {
                    ok = 0;
                    i = len;
                }
            }
        }
    }
    if (ok == 0) {
        store64(b + 8, start);
        return 0;
    }
    store64(b + 8, at + len);
    return 1;
}

# string field — tag + varint(len) + the bytes, always valid UTF-8 (v1.12.0,
# ADR-006). Valid input is written as given, in one validating copy. Otherwise
# each maximal ill-formed subpart becomes U+FFFD (EF BF BD), the replacement
# the OTLP spec asks of decoders: it requires encoders to send valid UTF-8. A
# negative length or 0 pointer writes an empty string.
fn _stik_pb_text(b, field_no, ptr, len) {
    if (len < 0) { len = 0; }
    if (ptr == 0) { len = 0; }
    if (_stik_pb_copy_utf8(b, field_no, ptr, len) == 1) { return 0; }
    var fixed = _stik_utf8_fixed_len(ptr, len);
    _stik_pb_tag(b, field_no, PROTO_WT_LENGTH);
    _stik_pb_varint(b, fixed);
    _stik_pb_reserve(b, fixed);
    var at = load64(b + 8);
    _stik_utf8_fix_into(load64(b) + at, ptr, len);
    store64(b + 8, at + fixed);
    return 0;
}

# Copy the `len` bytes at ptr to d, replacing each maximal ill-formed UTF-8
# subpart with U+FFFD (EF BF BD). d must hold _stik_utf8_fixed_len(ptr, len)
# bytes when that is not -1, else `len`. Shared by the OTLP string fields and,
# since 2.0.0, the JSON writers (_stik_json_text), so both apply one rule.
# Returns the number of bytes written.
fn _stik_utf8_fix_into(d, ptr, len) {
    var i = 0;
    var o = 0;
    while (i < len) {
        var st = _stik_utf8_step(ptr, i, len);
        if (st > 0) {
            var j = 0;
            while (j < st) {
                store8(d + o + j, load8(ptr + i + j));
                j = j + 1;
            }
            o = o + st;
            i = i + st;
        } else {
            store8(d + o, 0xEF);
            store8(d + o + 1, 0xBF);
            store8(d + o + 2, 0xBD);
            o = o + 3;
            i = i - st;
        }
    }
    return o;
}

# Append Str `s` to `sb` as a JSON string that is always valid JSON text (RFC
# 8259 §8.1 requires UTF-8). Each maximal ill-formed UTF-8 subpart becomes
# U+FFFD, the rule ADR-006 set for OTLP strings; then `"`, `\` and control
# characters are escaped by the stdlib's str_builder_add_json_str, so valid
# input comes out exactly as it did through 1.12.x. A negative length or 0
# data writes "". Returns 0 (since 2.0.0).
fn _stik_json_text(sb, s: Str) {
    var p = str_data(s);
    var len = str_len(s);
    if (len < 0) { len = 0; }
    if (p == 0) { len = 0; }
    if (len == 0) {
        str_builder_add_cstr(sb, "\"\"");
        return 0;
    }
    var fixed = _stik_utf8_fixed_len(p, len);
    if (fixed < 0) {
        str_builder_add_json_str(sb, s);
        return 0;
    }
    var d = _stik_alloc(fixed + 1);
    _stik_utf8_fix_into(d, p, len);
    store8(d + fixed, 0);
    str_builder_add_json_str(sb, str_new(d, fixed));
    return 0;
}

# string field from a Str, through _stik_pb_text (valid UTF-8 guaranteed). A 0
# Str writes an empty string.
fn _stik_pb_string(b, field_no, s: Str) {
    if (s == 0) {
        _stik_pb_bytes(b, field_no, 0, 0);
        return 0;
    }
    _stik_pb_text(b, field_no, str_data(s), str_len(s));
    return 0;
}

# An AnyValue string member from `len` bytes at ptr: string_value (field 1)
# when they are valid UTF-8, else bytes_value (field 7) with the bytes
# unchanged, as the OTel attribute type mapping specifies for strings that are
# not valid Unicode (ADR-006). Returns 0.
fn _stik_pb_any_string(b, ptr, len) {
    if (len < 0) { len = 0; }
    if (ptr == 0) { len = 0; }
    if (_stik_pb_copy_utf8(b, 1, ptr, len) == 1) { return 0; }
    _stik_pb_bytes(b, 7, ptr, len);
    return 0;
}

# Open a nested message field `field_no`: the tag and a one-byte length
# placeholder. Returns the mark (the body's start) that _stik_pb_close takes.
fn _stik_pb_open(b, field_no) {
    _stik_pb_tag(b, field_no, PROTO_WT_LENGTH);
    _stik_pb_reserve(b, 1);
    var len = load64(b + 8);
    store8(load64(b) + len, 0);
    store64(b + 8, len + 1);
    return len + 1;
}

# Close the nested message opened at `mark`: write its body length into the
# placeholder. A body of 128 bytes or more needs a longer varint, so the body
# is first shifted right by the extra bytes (copied from its end, since the
# ranges overlap). Returns 0.
fn _stik_pb_close(b, mark) {
    var len = load64(b + 8);
    var body = len - mark;
    if (body < 128) {
        store8(load64(b) + mark - 1, body);
        return 0;
    }
    var k = 1;
    var t = body;
    while (t >= 128) {
        t = t >> 7;
        k = k + 1;
    }
    _stik_pb_reserve(b, k - 1);
    var d = load64(b);
    var i = body;
    while (i > 0) {
        i = i - 1;
        store8(d + mark + k - 1 + i, load8(d + mark + i));
    }
    var p = d + mark - 1;
    var v = body;
    var j = 0;
    while (v >= 128) {
        store8(p + j, (v & 0x7F) | 0x80);
        v = v >> 7;
        j = j + 1;
    }
    store8(p + j, v);
    store64(b + 8, len + k - 1);
    return 0;
}
