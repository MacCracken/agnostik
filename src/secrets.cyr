enum SecretKind {
    SECRET_OPAQUE;
    SECRET_API_KEY;
    SECRET_PASSWORD;
    SECRET_CERTIFICATE;
    SECRET_SSH_KEY;
    SECRET_TOKEN;
}
# Display name of a SecretKind: "Opaque", "ApiKey", "Password", "Certificate",
# "SshKey" or "Token", and "Unknown" for a value outside the enum.
# secret_kind_parse is the inverse.
fn secret_kind_name(k) {
    if (k == SECRET_OPAQUE)          { return "Opaque"; }
    elif (k == SECRET_API_KEY)       { return "ApiKey"; }
    elif (k == SECRET_PASSWORD)      { return "Password"; }
    elif (k == SECRET_CERTIFICATE)   { return "Certificate"; }
    elif (k == SECRET_SSH_KEY)       { return "SshKey"; }
    elif (k == SECRET_TOKEN)         { return "Token"; }
    return "Unknown";
}
# Inverse of secret_kind_name. Exact match on what secret_kind_name emits; an
# unrecognised string is an error rather than a silent default, so
# secret_kind_parse(secret_kind_name(v)) == v holds for every SecretKind member.
fn secret_kind_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "Opaque") == 1) { return Ok(SECRET_OPAQUE); }
    elif (str_eq_cstr(s, "ApiKey") == 1) { return Ok(SECRET_API_KEY); }
    elif (str_eq_cstr(s, "Password") == 1) { return Ok(SECRET_PASSWORD); }
    elif (str_eq_cstr(s, "Certificate") == 1) { return Ok(SECRET_CERTIFICATE); }
    elif (str_eq_cstr(s, "SshKey") == 1) { return Ok(SECRET_SSH_KEY); }
    elif (str_eq_cstr(s, "Token") == 1) { return Ok(SECRET_TOKEN); }
    return stik_err_invalid_argument(str_from("unknown SecretKind name"));
}
# A Secret holding a private copy of `value`. 16 bytes: +0 pointer to a fresh
# NUL-terminated copy of the bytes, +8 length. The caller's Str is not
# retained, so the caller remains responsible for its own copy. Wipe the
# secret with secret_destroy when done. A 0 Str or one with a negative length
# gives an empty secret (since 1.12.3; it used to write through address 0).
fn secret_new(value: Str) {
    var slen = 0;
    if (value != 0) { slen = str_len(value); }
    if (slen < 0) { slen = 0; }
    var buf = _stik_alloc(slen + 1);
    if (slen > 0) { memcpy(buf, str_data(value), slen); }
    store8(buf + slen, 0);
    var s = _stik_alloc(16);
    store64(s, buf);
    store64(s + 8, slen);
    return s;
}
# The secret's bytes as a Str. It is a view over the secret's own buffer, not
# a copy: after secret_destroy an earlier view sees its bytes zeroed (its
# length unchanged), and a new call returns an empty Str.
fn secret_expose(s): Str {
    return str_new(load64(s), load64(s + 8));
}
# Length of the secret in bytes; 0 after secret_destroy.
fn secret_len(s) {
    return load64(s + 8);
}
# 1 when the secret's length is 0 (an empty value, or after secret_destroy),
# else 0.
fn secret_is_empty(s) {
    if (load64(s + 8) == 0) { return 1; }
    return 0;
}
# Compare `an` bytes at `a` with `bn` bytes at `b` in time that depends only on
# the lengths: 1 when the lengths match and every byte matches, else 0. Every
# byte is XORed into one accumulator, with no exit at the first difference.
# The stdlib's ct_eq_bytes_lens (lib/ct.cyr) has the same contract; agnostik
# keeps this copy so consumers need no new stdlib module. Calling the stdlib's
# would give every consumer without lib/ct.cyr an undefined-fn warning on each
# build, and a build error once it called secret_matches.
fn _stik_ct_eq(a, an, b, bn) {
    if (an != bn) { return 0; }
    var acc = 0;
    var i = 0;
    while (i < an) {
        acc = acc | (load8(a + i) ^ load8(b + i));
        i = i + 1;
    }
    return acc == 0;
}
# 1 when `candidate` holds exactly the secret's bytes, else 0 (since 2.0.0).
# Use it to check a presented password, API key or token against a stored
# Secret. str_eq stops at the first differing byte, so its timing reveals how
# much of a guess was right. This compare takes time that depends only on the
# two lengths, which it treats as public. An empty secret (an empty value, or
# after secret_destroy) matches nothing, not even an empty candidate, so an
# unset key cannot authenticate anyone. A 0 candidate matches nothing.
fn secret_matches(s, candidate: Str) {
    var slen = load64(s + 8);
    if (slen <= 0) { return 0; }
    if (candidate == 0) { return 0; }
    return _stik_ct_eq(load64(s), slen, str_data(candidate), str_len(candidate));
}
# Zero the secret's bytes in place, then clear its pointer and length so it
# reads as empty. Returns 0. The buffer is overwritten, not freed. Calling it
# again is harmless.
fn secret_destroy(s) {
    var buf = load64(s);
    var slen = load64(s + 8);
    memset(buf, 0, slen);
    store64(s, 0);
    store64(s + 8, 0);
    return 0;
}
# F-020 (audit 2026-08-24): this allocated 72 B / 9 slots, but only
# offsets 0, 8, 16, 32, 40 and 48 have accessors — 24, 56 and 64 were
# zeroed and then unreachable. Shrunk to 56 B, the smallest size that
# still covers the highest accessed field (owner at 48). Offset 24 stays
# zeroed: it is an interior hole, so removing it would mean renumbering
# every accessor. No caller writes these records by raw offset, so the
# shrink is invisible outside this file.
#
# F-021: `expires_at` (16) and `owner` (48) start at 0. Until 1.4.0 they had
# getters and no setters, so they always read 0; SecretMetadata_set_expires_at and
# SecretMetadata_set_owner now write them.
fn secret_metadata_new(name: Str, kind) {
    var m = _stik_alloc(56);
    store64(m, name);
    store64(m + 8, clock_epoch_ns());
    store64(m + 16, 0);
    store64(m + 24, 0);
    store64(m + 32, kind);
    store64(m + 40, vec_new());
    store64(m + 48, 0);
    return m;
}
# Secret name Str, as passed to secret_metadata_new.
fn SecretMetadata_name(m)        { return load64(m); }
# Construction time from clock_epoch_ns(): Unix time in nanoseconds (wall
# clock; whole seconds on agnos), the same clock expires_at is meant in.
fn SecretMetadata_created_at(m)  { return load64(m + 8); }
# Expiry time, 0 (unset) until SecretMetadata_set_expires_at. Stored as given, in
# whatever time base the caller chose; nothing here enforces it.
fn SecretMetadata_expires_at(m)  { return load64(m + 16); }
# SecretKind of the secret, as passed.
fn SecretMetadata_kind(m)        { return load64(m + 32); }
# vec of tags, created empty at construction; push to it directly.
fn SecretMetadata_tags(m)        { return load64(m + 40); }
# Owner Str, 0 (unset) until SecretMetadata_set_owner.
fn SecretMetadata_owner(m)       { return load64(m + 48); }
# F-021 (audit 2026-08-24): `expires_at` and `owner` had getters but no
# setters and were never written after construction, so both read 0 for
# every secret in every release up to 1.3.7 — a consumer building expiry
# enforcement on `SecretMetadata_expires_at` had a permanent no-op. Setters added
# in v1.4.0 (additive, so the constructor signature is unchanged).
# Set expires_at, stored as given. Returns 0.
fn SecretMetadata_set_expires_at(m, v) { store64(m + 16, v); return 0; }
# Set the owner Str. Not validated. Returns 0.
fn SecretMetadata_set_owner(m, v: Str) { store64(m + 48, v); return 0; }
var SS_GET = 0;
var SS_PUT = 1;
var SS_DELETE = 2;
var SS_LIST_METADATA = 3;
var SS_ROTATE = 4;
var SS_SEARCH_BY_TAG = 5;
# Vtable for a SecretStore trait object. 48 bytes, one fn pointer per slot,
# indexed by the SS_* constants:
#   +0 get (SS_GET), +8 put (SS_PUT), +16 delete (SS_DELETE),
#   +24 list_metadata (SS_LIST_METADATA), +32 rotate (SS_ROTATE),
#   +40 search_by_tag (SS_SEARCH_BY_TAG).
# The first four come from the arguments; rotate and search_by_tag start at 0
# and are filled with secret_store_set_*. Every ss_* dispatcher checks its slot
# (since v1.11.0): an unset one is not called.
fn secret_store_vtable(get_fn, put_fn, delete_fn, list_fn) {
    var vt = _stik_alloc(48);
    store64(vt, get_fn);
    store64(vt + 8, put_fn);
    store64(vt + 16, delete_fn);
    store64(vt + 24, list_fn);
    store64(vt + 32, 0);
    store64(vt + 40, 0);
    return vt;
}
# Wrap a vtable from secret_store_vtable and the implementation's data pointer
# as a SecretStore trait object (a 16-byte vtable + data pair from
# trait_obj_new). Call it through the ss_* dispatchers.
fn secret_store_new(vtable, data) { return trait_obj_new(vtable, data); }
# Dispatch to the store's get fn as fn(data, sname) and return its result
# unchanged, or 0 when the slot is unset.
fn ss_get(store, sname: Str)    { return _stik_dispatch1(store, SS_GET, sname); }
var _ss_put_value = 0;
# Dispatch to the store's put fn as fn(data, sname, value) and return its
# result, or 0 when the slot is unset. Since v1.11.0 the value is the third
# argument, so nested or concurrent calls do not clobber each other. It is
# still parked in the global _ss_put_value too, for a put fn written as
# fn(data, sname) before then; that path stays non-reentrant. The global is
# cleared once the put fn returns (since 1.12.3), so the last secret written is
# not left reachable from it.
fn ss_put(store, sname: Str, value: Str) {
    _ss_put_value = value;
    var r = _stik_dispatch2(store, SS_PUT, sname, value);
    _ss_put_value = 0;
    return r;
}
# Dispatch to the store's delete fn as fn(data, sname) and return its result
# unchanged, or 0 when the slot is unset.
fn ss_delete(store, sname: Str) { return _stik_dispatch1(store, SS_DELETE, sname); }
# Dispatch to the store's list_metadata fn as fn(data) and return its result
# unchanged, or 0 when the slot is unset.
fn ss_list_metadata(store) { return _stik_dispatch0(store, SS_LIST_METADATA); }
# Dispatch to the store's rotate fn as fn(data, sname). Returns Ok(its result),
# or a not-supported Err for a store built without secret_store_set_rotate.
fn ss_rotate(store, sname: Str) {
    if (_stik_slot_fn(store, SS_ROTATE) == 0) { return stik_err_not_supported(str_from("secret store has no rotate")); }
    return Ok(_stik_dispatch1(store, SS_ROTATE, sname));
}
# Dispatch to the store's search_by_tag fn as fn(data, tag). Returns Ok(its
# result), or a not-supported Err for a store built without
# secret_store_set_search_by_tag.
fn ss_search_by_tag(store, tag: Str) {
    if (_stik_slot_fn(store, SS_SEARCH_BY_TAG) == 0) {
        return stik_err_not_supported(str_from("secret store has no search_by_tag"));
    }
    return Ok(_stik_dispatch1(store, SS_SEARCH_BY_TAG, tag));
}
# 1 when `store` implements `slot` (SS_GET … SS_SEARCH_BY_TAG), else 0. A slot
# number outside that range is 0.
fn secret_store_has(store, slot) {
    if (slot < SS_GET) { return 0; }
    if (slot > SS_SEARCH_BY_TAG) { return 0; }
    if (_stik_slot_fn(store, slot) == 0) { return 0; }
    return 1;
}
# Fill the rotate slot (SS_ROTATE) of a secret-store vtable; ss_rotate
# dispatches to it. Returns 0.
fn secret_store_set_rotate(vt, fn_ptr)        { store64(vt + 32, fn_ptr); return 0; }
# Fill the search_by_tag slot (SS_SEARCH_BY_TAG) of a secret-store vtable;
# ss_search_by_tag dispatches to it. Returns 0.
fn secret_store_set_search_by_tag(vt, fn_ptr) { store64(vt + 40, fn_ptr); return 0; }
