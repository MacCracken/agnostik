    LL_EXECUTE;
    LL_WRITE_FILE;
    LL_READ_FILE;
    LL_READ_DIR;
    LL_REMOVE_DIR;
    LL_REMOVE_FILE;
    LL_MAKE_CHAR;
    LL_MAKE_DIR;
    LL_MAKE_REG;
    LL_MAKE_SOCK;
    LL_MAKE_FIFO;
    LL_MAKE_BLOCK;
    LL_MAKE_SYM;
    LL_REFER;
    LL_TRUNCATE;
    LL_IOCTL_DEV;
    LL_RESOLVE_UNIX;
}
enum LandlockNetAccess { LL_BIND_TCP; LL_CONNECT_TCP; LL_BIND_UDP; LL_CONNECT_SEND_UDP; }
enum LandlockScope { LL_SCOPE_ABSTRACT_UNIX; LL_SCOPE_SIGNAL; }
enum DeviceType { DEV_CHAR; DEV_BLOCK; DEV_ALL; }
enum RlimitType {
    RLIM_NOFILE;
    RLIM_NPROC;
    RLIM_ADDRESS_SPACE;
    RLIM_FILE_SIZE;
    RLIM_CORE;
    RLIM_DATA;
    RLIM_STACK;
    RLIM_MEMLOCK;
    RLIM_SIGPENDING;
    RLIM_MSGQUEUE;
}
# A NetworkPolicy: outbound port and host lists and an inbound port list.
# 32 bytes, all 8-byte slots: +0 outbound ports, +8 outbound hosts, +16 inbound
# ports (three empty vecs), +24 zeroed with no accessor.
fn network_policy_new() {
    var p = _stik_alloc(32);
    store64(p, vec_new());
    store64(p + 8, vec_new());
    store64(p + 16, vec_new());
    store64(p + 24, 0);
    return p;
}
# vec of outbound ports.
fn NetworkPolicy_outbound_ports(p) { return load64(p); }
# vec of outbound hosts.
fn NetworkPolicy_outbound_hosts(p) { return load64(p + 8); }
# vec of inbound ports.
fn NetworkPolicy_inbound_ports(p)  { return load64(p + 16); }
# A CgroupLimits: resource limits for a cgroup. 96 bytes, zero-filled, so every
# limit reads 0 until set. Accessed slots: +0 memory_max, +8 memory_high,
# +16 cpu_max, +32 cpu_weight, +40 pids_max; +24 and +48..+88 have no accessor.
fn cgroup_limits_new() {
    var c = _stik_alloc(96);
    var i = 0;
    while (i < 96) { store64(c + i, 0); i = i + 8; }
    return c;
}
# Maximum memory, in bytes; 0 in a fresh struct.
fn CgroupLimits_memory_max(c)      { return load64(c); }
# Memory high threshold, in bytes; 0 in a fresh struct.
fn CgroupLimits_memory_high(c)     { return load64(c + 8); }
# CPU max limit, stored as given (this module fixes no unit); 0 in a fresh struct.
fn CgroupLimits_cpu_max(c)         { return load64(c + 16); }
# CPU weight, stored as given; 0 in a fresh struct.
fn CgroupLimits_cpu_weight(c)      { return load64(c + 32); }
# Maximum number of processes (pids); 0 in a fresh struct.
fn CgroupLimits_pids_max(c)        { return load64(c + 40); }
# Set memory_max, in bytes; returns 0.
fn CgroupLimits_set_memory_max(c, v) { store64(c, v); return 0; }
# Set pids_max; returns 0.
fn CgroupLimits_set_pids_max(c, v)   { store64(c + 40, v); return 0; }
# 1.5.1: the remaining three had accessors but no setters, so a consumer
# populating cgroup_limits from config had to write raw store64 offsets into
# its own source — the exact hazard the setters exist to prevent. kybernet's
# per-service limits parser (1.5.5) uses all five.
fn CgroupLimits_set_memory_high(c, v) { store64(c + 8, v); return 0; }
# Set cpu_max; returns 0.
fn CgroupLimits_set_cpu_max(c, v)     { store64(c + 16, v); return 0; }
# Set cpu_weight; returns 0.
fn CgroupLimits_set_cpu_weight(c, v)  { store64(c + 32, v); return 0; }
# A NamespaceConfig: one flag per Linux namespace type, nonzero to enable that
# namespace. 64 bytes, eight zeroed slots: +0 pid, +8 net, +16 mount, +24 user,
# +32 uts, +40 ipc, +48 cgroup, +56 time. Only pid, net, mount and user have
# setters.
fn namespace_config_new() {
    var n = _stik_alloc(64);
    var i = 0;
    while (i < 64) { store64(n + i, 0); i = i + 8; }
    return n;
}
# PID namespace flag; 0 in a fresh config.
fn NamespaceConfig_pid(n)    { return load64(n); }
# Network namespace flag; 0 in a fresh config.
fn NamespaceConfig_net(n)    { return load64(n + 8); }
# Mount namespace flag; 0 in a fresh config.
fn NamespaceConfig_mount(n)  { return load64(n + 16); }
# User namespace flag; 0 in a fresh config.
fn NamespaceConfig_user(n)   { return load64(n + 24); }
# UTS namespace flag; 0 from namespace_config_new until NamespaceConfig_set_uts.
fn NamespaceConfig_uts(n)    { return load64(n + 32); }
# Set the value NamespaceConfig_uts reads, stored as given (not validated). Returns 0.
fn NamespaceConfig_set_uts(n, v) { store64(n + 32, v); return 0; }
# IPC namespace flag; 0 from namespace_config_new until NamespaceConfig_set_ipc.
fn NamespaceConfig_ipc(n)    { return load64(n + 40); }
# Set the value NamespaceConfig_ipc reads, stored as given (not validated). Returns 0.
fn NamespaceConfig_set_ipc(n, v) { store64(n + 40, v); return 0; }
# cgroup namespace flag; 0 from namespace_config_new until NamespaceConfig_set_cgroup.
fn NamespaceConfig_cgroup(n) { return load64(n + 48); }
# Set the value NamespaceConfig_cgroup reads, stored as given (not validated). Returns 0.
fn NamespaceConfig_set_cgroup(n, v) { store64(n + 48, v); return 0; }
# Time namespace flag; 0 from namespace_config_new until NamespaceConfig_set_time.
fn NamespaceConfig_time(n)   { return load64(n + 56); }
# Set the value NamespaceConfig_time reads, stored as given (not validated). Returns 0.
fn NamespaceConfig_set_time(n, v) { store64(n + 56, v); return 0; }
# Set the PID namespace flag; returns 0.
fn NamespaceConfig_set_pid(n, v)    { store64(n, v); return 0; }
# Set the network namespace flag; returns 0.
fn NamespaceConfig_set_net(n, v)    { store64(n + 8, v); return 0; }
# Set the mount namespace flag; returns 0.
fn NamespaceConfig_set_mount(n, v)  { store64(n + 16, v); return 0; }
# Set the user namespace flag; returns 0.
fn NamespaceConfig_set_user(n, v)   { store64(n + 24, v); return 0; }
# A SandboxConfig: the isolation settings for a sandbox. 88 bytes, 11 8-byte
# slots: +0 fs_rules (vec, lazy), +8 net_access (NetworkAccess, default
# NET_LOCALHOST_ONLY), +16 seccomp (0 = none), +24 isolate_net (default 1),
# +40 AppArmor profile (Str), +48 SELinux label (Str), +64 masked_paths (vec,
# lazy), +72 readonly_paths (vec, lazy), +80 sysctl (map, lazy). Every other
# slot starts 0; +32 and +56 have no accessor. Since v1.11.0 the AppArmor and
# SELinux slots have getters and isolate_net has a setter.
fn sandbox_config_new() {
    # 88 bytes = 11 u64 slots. Unrolled: store the two live fields with
    # their values and zero the other nine directly — no loop counter /
    # compare / branch per slot. The old `while (i<88) store64(0)` loop
    # zeroed all 11 then overwrote two; this is a hot constructor, so the
    # unroll gives the bench real headroom against runner noise (the
    # 6.3.x codegen shift left it hugging the regression floor).
    var s = _stik_alloc(88);
    store64(s + 0,  0);
    store64(s + 8,  NET_LOCALHOST_ONLY);
    store64(s + 16, 0);
    store64(s + 24, 1);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, 0);
    store64(s + 64, 0);
    store64(s + 72, 0);
    store64(s + 80, 0);
    return s;
}
# Lazy-collection helper: return the vec held in the 8-byte slot at `ptr`,
# first creating an empty one with vec_new and storing it there if the slot is
# 0. Accessors in other modules use it too.
fn _stik_lazy_vec(ptr) {
    var v = load64(ptr);
    if (v == 0) { v = vec_new(); store64(ptr, v); }
    return v;
}
# Lazy-collection helper: return the map held in the 8-byte slot at `ptr`,
# first creating an empty one with map_new and storing it there if the slot is
# 0. Accessors in other modules use it too.
fn _stik_lazy_map(ptr) {
    var m = load64(ptr);
    if (m == 0) { m = map_new(); store64(ptr, m); }
    return m;
}
# vec of FilesystemRule (filesystem_rule_new); created empty on first access.
fn SandboxConfig_fs_rules(s)      { return _stik_lazy_vec(s); }
# Network access level, a NetworkAccess; NET_LOCALHOST_ONLY by default.
fn SandboxConfig_net_access(s)    { return load64(s + 8); }
# Seccomp slot: 0 (the default) means none. Meant to hold a SeccompProfile
# (seccomp_profile_new); nothing here checks what is stored.
fn SandboxConfig_seccomp(s)       { return load64(s + 16); }
# Network-isolation flag; 1 by default, set with SandboxConfig_set_isolate_net.
fn SandboxConfig_isolate_net(s)   { return load64(s + 24); }
# Set the value SandboxConfig_isolate_net reads, stored as given (not validated). Returns 0.
fn SandboxConfig_set_isolate_net(s, v) { store64(s + 24, v); return 0; }
# vec of paths to mask in the sandbox; created empty on first access.
fn SandboxConfig_masked_paths(s)  { return _stik_lazy_vec(s + 64); }
# vec of paths to make read-only in the sandbox; created empty on first access.
fn SandboxConfig_readonly_paths(s){ return _stik_lazy_vec(s + 72); }
# map of sysctl settings for the sandbox; created empty on first access.
fn SandboxConfig_sysctl(s)        { return _stik_lazy_map(s + 80); }
# Set the network access level (a NetworkAccess); returns 0.
fn SandboxConfig_set_net_access(s, v)   { store64(s + 8, v); return 0; }
# Set the seccomp slot (see SandboxConfig_seccomp); returns 0.
fn SandboxConfig_set_seccomp(s, v)      { store64(s + 16, v); return 0; }
# Set the AppArmor profile name (Str, slot +40); returns 0. SandboxConfig_apparmor reads it.
fn SandboxConfig_set_apparmor(s, v: Str) { store64(s + 40, v); return 0; }
# Set the SELinux label (Str, slot +48); returns 0. SandboxConfig_selinux reads it.
fn SandboxConfig_set_selinux(s, v: Str)  { store64(s + 48, v); return 0; }
# AppArmor profile name (Str) set with SandboxConfig_set_apparmor, or 0 when unset
# (added in v1.11.0; there was no getter).
fn SandboxConfig_apparmor(s) { return load64(s + 40); }
# SELinux label (Str) set with SandboxConfig_set_selinux, or 0 when unset (added in
# v1.11.0).
fn SandboxConfig_selinux(s) { return load64(s + 48); }
# A SecurityContext: an agent's permissions, sandbox and process identity.
# 56 bytes: +0 agent_id (as given), +8 permissions (empty vec), +16 sandbox
# (a fresh sandbox_config_new), +24 run_as_user 0, +32 run_as_group 0,
# +40 readonly_root 0, +48 no_new_privs 1. The four scalars have SecurityContext_set_*
# setters since v1.11.0.
fn security_context_new(agent_id) {
    var ctx = _stik_alloc(56);
    store64(ctx, agent_id);
    store64(ctx + 8, vec_new());
    store64(ctx + 16, sandbox_config_new());
    store64(ctx + 24, 0);
    store64(ctx + 32, 0);
    store64(ctx + 40, 0);
    store64(ctx + 48, 1);
    return ctx;
}
# The agent's AgentId, as passed to security_context_new.
fn SecurityContext_agent_id(c)        { return load64(c); }
# vec of the Permission values granted to the agent; starts empty.
fn SecurityContext_permissions(c)     { return load64(c + 8); }
# The agent's SandboxConfig; sandbox_config_new defaults until changed.
fn SecurityContext_sandbox(c)         { return load64(c + 16); }
# User ID to run the agent's process as; 0 in a fresh context, meaning "not
# set". 0 is also root's uid, so a launcher must treat 0 as "inherit" and
# never setuid(0) from it; v1 has no separate set flag.
fn SecurityContext_run_as_user(c)     { return load64(c + 24); }
# Set the value SecurityContext_run_as_user reads, stored as given (not validated). Returns 0.
fn SecurityContext_set_run_as_user(c, v) { store64(c + 24, v); return 0; }
# Group ID to run the agent's process as; 0 in a fresh context, meaning "not
# set" (0 is also root's gid; see SecurityContext_run_as_user).
fn SecurityContext_run_as_group(c)    { return load64(c + 32); }
# Set the value SecurityContext_run_as_group reads, stored as given (not validated). Returns 0.
fn SecurityContext_set_run_as_group(c, v) { store64(c + 32, v); return 0; }
# Read-only root filesystem flag; 0 in a fresh context.
fn SecurityContext_readonly_root(c)   { return load64(c + 40); }
# Set the value SecurityContext_readonly_root reads, stored as given (not validated). Returns 0.
fn SecurityContext_set_readonly_root(c, v) { store64(c + 40, v); return 0; }
# no_new_privs flag; 1 (on) in a fresh context.
fn SecurityContext_no_new_privs(c)    { return load64(c + 48); }
# Set the value SecurityContext_no_new_privs reads, stored as given (not validated). Returns 0.
fn SecurityContext_set_no_new_privs(c, v) { store64(c + 48, v); return 0; }
# A SecurityPolicy: a named rule applying `effect` to a set of permissions.
# 24 bytes: +0 name (Str), +8 effect (PolicyEffect), +16 permissions (empty vec).
fn security_policy_new(name: Str, effect) {
    var p = _stik_alloc(24);
    store64(p, name);
    store64(p + 8, effect);
    store64(p + 16, vec_new());
    return p;
}
# Policy name (Str).
fn SecurityPolicy_name(p)        { return load64(p); }
# What the policy does, a PolicyEffect: allow, deny or audit.
fn SecurityPolicy_effect(p)      { return load64(p + 8); }
# vec of the Permission values the policy covers; starts empty.
fn SecurityPolicy_permissions(p) { return load64(p + 16); }
# A CapabilitySet: the five Linux capability sets of a process, each a vec of
# LinuxCapability values (kernel capability numbers). 40 bytes: +0 effective,
# +8 permitted, +16 inheritable, +24 bounding, +32 ambient; all start empty.
fn capability_set_new() {
    var c = _stik_alloc(40);
    store64(c, vec_new());
    store64(c + 8, vec_new());
    store64(c + 16, vec_new());
    store64(c + 24, vec_new());
    store64(c + 32, vec_new());
    return c;
}
# vec of LinuxCapability values in the effective set.
fn CapabilitySet_effective(c)   { return load64(c); }
# vec of LinuxCapability values in the permitted set.
fn CapabilitySet_permitted(c)   { return load64(c + 8); }
# vec of LinuxCapability values in the inheritable set.
fn CapabilitySet_inheritable(c) { return load64(c + 16); }
# vec of LinuxCapability values in the bounding set.
fn CapabilitySet_bounding(c)    { return load64(c + 24); }
# vec of LinuxCapability values in the ambient set.
fn CapabilitySet_ambient(c)     { return load64(c + 32); }
# A SandboxCapabilities: which sandboxing features the host supports. 48 bytes,
# zeroed: +0 seccomp, +8 seccomp_mode (SeccompMode), +16 landlock, +24 Landlock
# ABI version, +32 cgroup v2, +40 namespaces, each set with its SandboxCapabilities_set_*
# setter (v1.11.0).
fn sandbox_capabilities_new() {
    var c = _stik_alloc(48);
    var i = 0;
    while (i < 48) { store64(c + i, 0); i = i + 8; }
    return c;
}
# Seccomp-available flag; 0 in a fresh struct.
fn SandboxCapabilities_seccomp(c)      { return load64(c); }
# Set the value SandboxCapabilities_seccomp reads, stored as given (not validated). Returns 0.
fn SandboxCapabilities_set_seccomp(c, v) { store64(c, v); return 0; }
# Seccomp mode, a SeccompMode; 0 (SECCOMP_DISABLED) in a fresh struct.
fn SandboxCapabilities_seccomp_mode(c) { return load64(c + 8); }
# Set the value SandboxCapabilities_seccomp_mode reads, stored as given (not validated). Returns 0.
fn SandboxCapabilities_set_seccomp_mode(c, v) { store64(c + 8, v); return 0; }
# Landlock-available flag; 0 in a fresh struct.
fn SandboxCapabilities_landlock(c)     { return load64(c + 16); }
# Set the value SandboxCapabilities_landlock reads, stored as given (not validated). Returns 0.
fn SandboxCapabilities_set_landlock(c, v) { store64(c + 16, v); return 0; }
# Landlock ABI version; 0 in a fresh struct.
fn SandboxCapabilities_ll_abi(c)       { return load64(c + 24); }
# Set the value SandboxCapabilities_ll_abi reads, stored as given (not validated). Returns 0.
fn SandboxCapabilities_set_ll_abi(c, v) { store64(c + 24, v); return 0; }
# cgroup v2 available flag; 0 in a fresh struct.
fn SandboxCapabilities_cgroup_v2(c)    { return load64(c + 32); }
# Set the value SandboxCapabilities_cgroup_v2 reads, stored as given (not validated). Returns 0.
fn SandboxCapabilities_set_cgroup_v2(c, v) { store64(c + 32, v); return 0; }
# Namespaces-available flag; 0 in a fresh struct.
fn SandboxCapabilities_namespaces(c)   { return load64(c + 40); }
# Set the value SandboxCapabilities_namespaces reads, stored as given (not validated). Returns 0.
fn SandboxCapabilities_set_namespaces(c, v) { store64(c + 40, v); return 0; }
# A SeccompArg: a condition on one syscall argument, used in a SeccompRule's
# args. 32 bytes: +0 index (which argument), +8 value, +16 value_two, +24 op
# (SeccompArgOp), all as given.
fn seccomp_arg_new(index, value, value_two, op) {
    var a = _stik_alloc(32);
    store64(a, index);
    store64(a + 8, value);
    store64(a + 16, value_two);
    store64(a + 24, op);
    return a;
}
# Index of the syscall argument the condition tests.
fn SeccompArg_index(a)     { return load64(a); }
# Value the argument is compared against.
fn SeccompArg_value(a)     { return load64(a + 8); }
# Second comparison value (value_two), as given to seccomp_arg_new.
fn SeccompArg_value_two(a) { return load64(a + 16); }
# Comparison operator, a SeccompArgOp.
fn SeccompArg_op(a)        { return load64(a + 24); }
# A FilesystemRule: access and mount options for one path. 48 bytes: +0 path
# (Str), +8 access (FsAccess), +16 readonly 0, +24 noexec 0, +32 zeroed with no
# accessor, +40 propagation (MountPropagation, MOUNT_PRIVATE). Only readonly
# and noexec have setters.
fn filesystem_rule_new(path: Str, access) {
    var r = _stik_alloc(48);
    store64(r, path);
    store64(r + 8, access);
    store64(r + 16, 0);
    store64(r + 24, 0);
    store64(r + 32, 0);
    store64(r + 40, MOUNT_PRIVATE);
    return r;
}
# Path the rule applies to (Str).
fn FilesystemRule_path(r)        { return load64(r); }
# Access level for the path, an FsAccess.
fn FilesystemRule_access(r)      { return load64(r + 8); }
# Read-only flag; 0 in a fresh rule.
fn FilesystemRule_readonly(r)    { return load64(r + 16); }
# noexec flag; 0 in a fresh rule.
fn FilesystemRule_noexec(r)      { return load64(r + 24); }
# Mount propagation, a MountPropagation; MOUNT_PRIVATE in a fresh rule.
fn FilesystemRule_propagation(r) { return load64(r + 40); }
# Set the value FilesystemRule_propagation reads, stored as given (not validated). Returns 0.
fn FilesystemRule_set_propagation(r, v) { store64(r + 40, v); return 0; }
# Set the read-only flag; returns 0.
fn FilesystemRule_set_readonly(r, v) { store64(r + 16, v); return 0; }
# Set the noexec flag; returns 0.
fn FilesystemRule_set_noexec(r, v)   { store64(r + 24, v); return 0; }
# A SeccompRule: an action applied to a set of syscalls, optionally gated on
# argument conditions. 24 bytes: +0 names (vec, lazy), +8 action (as given),
# +16 args (vec, lazy).
fn seccomp_rule_new(action) {
    var r = _stik_alloc(24);
    store64(r, 0);
    store64(r + 8, action);
    store64(r + 16, 0);
    return r;
}
# vec of the syscall names the rule matches; created empty on first access.
fn SeccompRule_names(r)  { return _stik_lazy_vec(r); }
# Action taken on a match: a SeccompAction member or a seccomp_errno /
# seccomp_trace box.
fn SeccompRule_action(r) { return load64(r + 8); }
# vec of SeccompArg conditions on the arguments; created empty on first access.
fn SeccompRule_args(r)   { return _stik_lazy_vec(r + 16); }
# A SeccompProfile: a complete seccomp filter. 48 bytes: +0 default_action (as
# given), +8 architectures, +16 flags, +24 syscalls (three vecs, created
# lazily), +32 and +40 zeroed with no accessor.
fn seccomp_profile_new(default_action) {
    var p = _stik_alloc(48);
    store64(p, default_action);
    store64(p + 8, 0);
    store64(p + 16, 0);
    store64(p + 24, 0);
    store64(p + 32, 0);
    store64(p + 40, 0);
    return p;
}
# Action for syscalls no rule matches: a SeccompAction member or a
# seccomp_errno / seccomp_trace box.
fn SeccompProfile_default_action(p) { return load64(p); }
# vec of SeccompArch values the profile targets; created empty on first access.
fn SeccompProfile_architectures(p)  { return _stik_lazy_vec(p + 8); }
# vec of profile flags; created empty on first access.
fn SeccompProfile_flags(p)          { return _stik_lazy_vec(p + 16); }
# vec of SeccompRule; created empty on first access.
fn SeccompProfile_syscalls(p)       { return _stik_lazy_vec(p + 24); }
# An EncryptedStorage: settings for an encrypted storage volume. 24 bytes:
# +0 enabled 0, +8 size_mb 256, +16 filesystem (Str, "ext4").
fn encrypted_storage_new() {
    var e = _stik_alloc(24);
    store64(e, 0);
    store64(e + 8, 256);
    store64(e + 16, str_from("ext4"));
    return e;
}
# Enabled flag; 0 in a fresh struct.
fn EncryptedStorage_enabled(e)    { return load64(e); }
# Size in megabytes; 256 in a fresh struct.
fn EncryptedStorage_size_mb(e)    { return load64(e + 8); }
# Filesystem type (Str); "ext4" in a fresh struct until EncryptedStorage_set_filesystem.
fn EncryptedStorage_filesystem(e) { return load64(e + 16); }
# Set the value EncryptedStorage_filesystem reads, stored as given (not validated). Returns 0.
fn EncryptedStorage_set_filesystem(e, v) { store64(e + 16, v); return 0; }
# Set the enabled flag; returns 0.
fn EncryptedStorage_set_enabled(e, v)  { store64(e, v); return 0; }
# Set the size in megabytes; returns 0.
fn EncryptedStorage_set_size_mb(e, v)  { store64(e + 8, v); return 0; }
# An Rlimit: a soft and a hard limit for one resource. 24 bytes: +0 type
# (RlimitType, an agnostik ordinal, not a kernel RLIMIT_* number), +8 soft,
# +16 hard, all as given.
fn rlimit_new(limit_type, soft, hard) {
    var r = _stik_alloc(24);
    store64(r, limit_type);
    store64(r + 8, soft);
    store64(r + 16, hard);
    return r;
}
# Resource limited, an RlimitType (agnostik ordinal; see rlimit_type_name).
fn Rlimit_type(r) { return load64(r); }
# Soft limit, as given to rlimit_new.
fn Rlimit_soft(r) { return load64(r + 8); }
# Hard limit, as given to rlimit_new.
fn Rlimit_hard(r) { return load64(r + 16); }
# A DeviceRule: allows or denies access to devices. 40 bytes: +0 allow flag,
# +8 type (DeviceType), +16 major 0, +24 minor 0, +32 access (Str). allow, type
# and access come from the arguments; major and minor are set with
# DeviceRule_set_major / DeviceRule_set_minor.
fn device_rule_new(allow, dtype, access_str: Str) {
    var r = _stik_alloc(40);
    store64(r, allow);
    store64(r + 8, dtype);
    store64(r + 16, 0);
    store64(r + 24, 0);
    store64(r + 32, access_str);
    return r;
}
# Allow flag: nonzero allows the access, 0 denies it.
fn DeviceRule_allow(r)  { return load64(r); }
# Device type, a DeviceType.
fn DeviceRule_type(r)   { return load64(r + 8); }
# Device major number; 0 from device_rule_new until DeviceRule_set_major.
fn DeviceRule_major(r)  { return load64(r + 16); }
# Set the value DeviceRule_major reads, stored as given (not validated). Returns 0.
fn DeviceRule_set_major(r, v) { store64(r + 16, v); return 0; }
# Device minor number; 0 from device_rule_new until DeviceRule_set_minor.
fn DeviceRule_minor(r)  { return load64(r + 24); }
# Set the value DeviceRule_minor reads, stored as given (not validated). Returns 0.
fn DeviceRule_set_minor(r, v) { store64(r + 24, v); return 0; }
# Access string (Str), as given to device_rule_new.
fn DeviceRule_access(r) { return load64(r + 32); }
# A NamespaceEntry: one namespace and an optional path. 16 bytes: +0 type (as
# given; this module defines no namespace-type enum), +8 path (0 until
# NamespaceEntry_set_path).
fn namespace_entry_new(ns_type) {
    var e = _stik_alloc(16);
    store64(e, ns_type);
    store64(e + 8, 0);
    return e;
}
# Namespace type, as passed to namespace_entry_new.
fn NamespaceEntry_type(e) { return load64(e); }
# Namespace path (Str), or 0 until NamespaceEntry_set_path stores one.
fn NamespaceEntry_path(e) { return load64(e + 8); }
# Set the namespace path (Str); returns 0.
fn NamespaceEntry_set_path(e, v: Str) { store64(e + 8, v); return 0; }
# An IdMapping: maps `count` consecutive IDs starting at outside_id (outside
# the namespace) to IDs starting at inside_id (inside it). 24 bytes:
# +0 inside_id, +8 outside_id, +16 count, all as given.
fn id_mapping_new(inside_id, outside_id, count) {
    var m = _stik_alloc(24);
    store64(m, inside_id);
    store64(m + 8, outside_id);
    store64(m + 16, count);
    return m;
}
# First ID of the range inside the namespace.
fn IdMapping_inside(m)  { return load64(m); }
# First ID of the range outside the namespace.
fn IdMapping_outside(m) { return load64(m + 8); }
# Number of consecutive IDs mapped.
fn IdMapping_count(m)   { return load64(m + 16); }
# A LandlockFsRule: the Landlock filesystem access allowed for one path.
# 16 bytes: +0 path (Str), +8 allowed_access (vec, lazy).
fn landlock_fs_rule_new(path: Str) {
    var r = _stik_alloc(16);
    store64(r, path);
    store64(r + 8, 0);
    return r;
}
# Path the rule applies to (Str).
fn LandlockFsRule_path(r)           { return load64(r); }
# vec of LandlockFsAccess values allowed for the path; created empty on first
# access.
fn LandlockFsRule_allowed_access(r) { return _stik_lazy_vec(r + 8); }
# A LandlockNetRule: the Landlock network access allowed on one port.
# 16 bytes: +0 port, +8 allowed_access (vec, lazy).
fn landlock_net_rule_new(port) {
    var r = _stik_alloc(16);
    store64(r, port);
    store64(r + 8, 0);
    return r;
}
# Port number the rule applies to.
fn LandlockNetRule_port(r)            { return load64(r); }
# vec of LandlockNetAccess values allowed on the port; created empty on first
# access.
fn LandlockNetRule_allowed_access(r)  { return _stik_lazy_vec(r + 8); }
# A LandlockRuleset. 24 bytes, three vecs created lazily: +0 fs_rules
# (LandlockFsRule), +8 net_rules (LandlockNetRule), +16 scoped (LandlockScope).
fn landlock_ruleset_new() {
    var r = _stik_alloc(24);
    store64(r, 0);
    store64(r + 8, 0);
    store64(r + 16, 0);
    return r;
}
# vec of LandlockFsRule; created empty on first access.
fn llrs_fs_rules(r)  { return _stik_lazy_vec(r); }
# vec of LandlockNetRule; created empty on first access.
fn llrs_net_rules(r) { return _stik_lazy_vec(r + 8); }
# vec of LandlockScope values; created empty on first access.
fn llrs_scoped(r)    { return _stik_lazy_vec(r + 16); }
# A PermissionCondition: an RBAC test `field operator value`. 24 bytes:
# +0 field (Str), +8 operator (ConditionOperator), +16 value, all as given.
fn permission_condition_new(field: Str, operator, value) {
    var c = _stik_alloc(24);
    store64(c, field);
    store64(c + 8, operator);
    store64(c + 16, value);
    return c;
}
# Name of the field the condition tests (Str).
fn PermissionCondition_field(c)    { return load64(c); }
# Comparison operator, a ConditionOperator.
fn PermissionCondition_operator(c) { return load64(c + 8); }
# Value compared against, stored as given (this module fixes no type).
fn PermissionCondition_value(c)    { return load64(c + 16); }
# A RolePermission: the actions allowed on one resource, with optional
# conditions. 24 bytes: +0 resource (Str), +8 actions, +16 conditions (two
# vecs, created lazily).
fn role_permission_new(resource: Str) {
    var p = _stik_alloc(24);
    store64(p, resource);
    store64(p + 8, 0);
    store64(p + 16, 0);
    return p;
}
# Resource the permission applies to (Str).
fn RolePermission_resource(p)   { return load64(p); }
# vec of the actions allowed on the resource; created empty on first access.
fn RolePermission_actions(p)    { return _stik_lazy_vec(p + 8); }
# vec of PermissionCondition; created empty on first access.
fn RolePermission_conditions(p) { return _stik_lazy_vec(p + 16); }
# A TokenPayload: the claims of a JWT-style auth token. 64 bytes: +0 sub (Str),
# +8 role (Role), +16 permissions (empty vec), +24 iat 0, +32 exp 0, +40 jti
# (empty Str), +48 email 0, +56 display_name 0. Only sub and role are set at
# construction; the TokenPayload_set_* setters (v1.11.0) set the rest.
fn token_payload_new(sub: Str, role) {
    var t = _stik_alloc(64);
    store64(t, sub);
    store64(t + 8, role);
    store64(t + 16, vec_new());
    store64(t + 24, 0);
    store64(t + 32, 0);
    store64(t + 40, str_from(""));
    store64(t + 48, 0);
    store64(t + 56, 0);
    return t;
}
# Subject claim (Str): who the token was issued to.
fn TokenPayload_sub(t)          { return load64(t); }
# Role the token grants, a Role.
fn TokenPayload_role(t)         { return load64(t + 8); }
# vec of the permissions the token carries; starts empty.
fn TokenPayload_permissions(t)  { return load64(t + 16); }
# Issued-at time (the iat claim); 0 in a fresh payload. No unit is enforced here.
fn TokenPayload_iat(t)          { return load64(t + 24); }
# Set the value TokenPayload_iat reads, stored as given (not validated). Returns 0.
fn TokenPayload_set_iat(t, v) { store64(t + 24, v); return 0; }
# Expiry time (the exp claim); 0 in a fresh payload. No unit is enforced here.
fn TokenPayload_exp(t)          { return load64(t + 32); }
# Set the value TokenPayload_exp reads, stored as given (not validated). Returns 0.
fn TokenPayload_set_exp(t, v) { store64(t + 32, v); return 0; }
# Token ID (the jti claim), a Str; empty in a fresh payload.
fn TokenPayload_jti(t)          { return load64(t + 40); }
# Set the value TokenPayload_jti reads, stored as given (not validated). Returns 0.
fn TokenPayload_set_jti(t, v) { store64(t + 40, v); return 0; }
# Email address (Str), or 0 (no Str at all) in a fresh payload.
fn TokenPayload_email(t)        { return load64(t + 48); }
# Set the value TokenPayload_email reads, stored as given (not validated). Returns 0.
fn TokenPayload_set_email(t, v) { store64(t + 48, v); return 0; }
# Display name (Str), or 0 (no Str at all) in a fresh payload.
fn TokenPayload_display_name(t) { return load64(t + 56); }
# Set the value TokenPayload_display_name reads, stored as given (not validated). Returns 0.
fn TokenPayload_set_display_name(t, v) { store64(t + 56, v); return 0; }
# An AuthContext: an authenticated agent's role and permissions. 24 bytes:
# +0 agent_id (as given), +8 role (Role), +16 permissions (empty vec).
fn auth_context_new(agent_id, role) {
    var a = _stik_alloc(24);
    store64(a, agent_id);
    store64(a + 8, role);
    store64(a + 16, vec_new());
    return a;
}
# The agent's AgentId, as passed to auth_context_new.
fn AuthContext_agent_id(a)    { return load64(a); }
# The agent's Role.
fn AuthContext_role(a)        { return load64(a + 8); }
# vec of the agent's permissions; starts empty.
fn AuthContext_permissions(a) { return load64(a + 16); }

# Canonical capability name, lowercase with the `cap_` prefix — the spelling
# capsh(1), getcap(8) and every capability(7) man page use, so a config file
# written against Linux documentation parses without translation.
fn capability_name(c) {
    if (c == CAP_CHOWN) { return "cap_chown"; }
    elif (c == CAP_DAC_OVERRIDE) { return "cap_dac_override"; }
    elif (c == CAP_DAC_READ_SEARCH) { return "cap_dac_read_search"; }
    elif (c == CAP_FOWNER) { return "cap_fowner"; }
    elif (c == CAP_FSETID) { return "cap_fsetid"; }
    elif (c == CAP_KILL) { return "cap_kill"; }
    elif (c == CAP_SETGID) { return "cap_setgid"; }
    elif (c == CAP_SETUID) { return "cap_setuid"; }
    elif (c == CAP_SETPCAP) { return "cap_setpcap"; }
    elif (c == CAP_LINUX_IMMUTABLE) { return "cap_linux_immutable"; }
    elif (c == CAP_NET_BIND_SERVICE) { return "cap_net_bind_service"; }
    elif (c == CAP_NET_BROADCAST) { return "cap_net_broadcast"; }
    elif (c == CAP_NET_ADMIN) { return "cap_net_admin"; }
    elif (c == CAP_NET_RAW) { return "cap_net_raw"; }
    elif (c == CAP_IPC_LOCK) { return "cap_ipc_lock"; }
    elif (c == CAP_IPC_OWNER) { return "cap_ipc_owner"; }
    elif (c == CAP_SYS_MODULE) { return "cap_sys_module"; }
    elif (c == CAP_SYS_RAWIO) { return "cap_sys_rawio"; }
    elif (c == CAP_SYS_CHROOT) { return "cap_sys_chroot"; }
    elif (c == CAP_SYS_PTRACE) { return "cap_sys_ptrace"; }
    elif (c == CAP_SYS_PACCT) { return "cap_sys_pacct"; }
    elif (c == CAP_SYS_ADMIN) { return "cap_sys_admin"; }
    elif (c == CAP_SYS_BOOT) { return "cap_sys_boot"; }
    elif (c == CAP_SYS_NICE) { return "cap_sys_nice"; }
    elif (c == CAP_SYS_RESOURCE) { return "cap_sys_resource"; }
    elif (c == CAP_SYS_TIME) { return "cap_sys_time"; }
    elif (c == CAP_SYS_TTY_CONFIG) { return "cap_sys_tty_config"; }
    elif (c == CAP_MKNOD) { return "cap_mknod"; }
    elif (c == CAP_LEASE) { return "cap_lease"; }
    elif (c == CAP_AUDIT_WRITE) { return "cap_audit_write"; }
    elif (c == CAP_AUDIT_CONTROL) { return "cap_audit_control"; }
    elif (c == CAP_SETFCAP) { return "cap_setfcap"; }
    elif (c == CAP_MAC_OVERRIDE) { return "cap_mac_override"; }
    elif (c == CAP_MAC_ADMIN) { return "cap_mac_admin"; }
    elif (c == CAP_SYSLOG) { return "cap_syslog"; }
    elif (c == CAP_WAKE_ALARM) { return "cap_wake_alarm"; }
    elif (c == CAP_BLOCK_SUSPEND) { return "cap_block_suspend"; }
    elif (c == CAP_AUDIT_READ) { return "cap_audit_read"; }
    elif (c == CAP_PERFMON) { return "cap_perfmon"; }
    elif (c == CAP_BPF) { return "cap_bpf"; }
    elif (c == CAP_CHECKPOINT_RESTORE) { return "cap_checkpoint_restore"; }
    return "unknown";
}

# Inverse of capability_name. Exact match, no coercion — an unrecognised
# name is an error, never a silent default, because the failure mode of
# "defaulted" here is retaining a capability the operator asked to drop.
# capability_parse(capability_name(v)) == v holds for every member.
fn capability_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "cap_chown") == 1) { return Ok(CAP_CHOWN); }
    elif (str_eq_cstr(s, "cap_dac_override") == 1) { return Ok(CAP_DAC_OVERRIDE); }
    elif (str_eq_cstr(s, "cap_dac_read_search") == 1) { return Ok(CAP_DAC_READ_SEARCH); }
    elif (str_eq_cstr(s, "cap_fowner") == 1) { return Ok(CAP_FOWNER); }
    elif (str_eq_cstr(s, "cap_fsetid") == 1) { return Ok(CAP_FSETID); }
    elif (str_eq_cstr(s, "cap_kill") == 1) { return Ok(CAP_KILL); }
    elif (str_eq_cstr(s, "cap_setgid") == 1) { return Ok(CAP_SETGID); }
    elif (str_eq_cstr(s, "cap_setuid") == 1) { return Ok(CAP_SETUID); }
    elif (str_eq_cstr(s, "cap_setpcap") == 1) { return Ok(CAP_SETPCAP); }
    elif (str_eq_cstr(s, "cap_linux_immutable") == 1) { return Ok(CAP_LINUX_IMMUTABLE); }
    elif (str_eq_cstr(s, "cap_net_bind_service") == 1) { return Ok(CAP_NET_BIND_SERVICE); }
    elif (str_eq_cstr(s, "cap_net_broadcast") == 1) { return Ok(CAP_NET_BROADCAST); }
    elif (str_eq_cstr(s, "cap_net_admin") == 1) { return Ok(CAP_NET_ADMIN); }
    elif (str_eq_cstr(s, "cap_net_raw") == 1) { return Ok(CAP_NET_RAW); }
    elif (str_eq_cstr(s, "cap_ipc_lock") == 1) { return Ok(CAP_IPC_LOCK); }
    elif (str_eq_cstr(s, "cap_ipc_owner") == 1) { return Ok(CAP_IPC_OWNER); }
    elif (str_eq_cstr(s, "cap_sys_module") == 1) { return Ok(CAP_SYS_MODULE); }
    elif (str_eq_cstr(s, "cap_sys_rawio") == 1) { return Ok(CAP_SYS_RAWIO); }
    elif (str_eq_cstr(s, "cap_sys_chroot") == 1) { return Ok(CAP_SYS_CHROOT); }
    elif (str_eq_cstr(s, "cap_sys_ptrace") == 1) { return Ok(CAP_SYS_PTRACE); }
    elif (str_eq_cstr(s, "cap_sys_pacct") == 1) { return Ok(CAP_SYS_PACCT); }
    elif (str_eq_cstr(s, "cap_sys_admin") == 1) { return Ok(CAP_SYS_ADMIN); }
    elif (str_eq_cstr(s, "cap_sys_boot") == 1) { return Ok(CAP_SYS_BOOT); }
    elif (str_eq_cstr(s, "cap_sys_nice") == 1) { return Ok(CAP_SYS_NICE); }
    elif (str_eq_cstr(s, "cap_sys_resource") == 1) { return Ok(CAP_SYS_RESOURCE); }
    elif (str_eq_cstr(s, "cap_sys_time") == 1) { return Ok(CAP_SYS_TIME); }
    elif (str_eq_cstr(s, "cap_sys_tty_config") == 1) { return Ok(CAP_SYS_TTY_CONFIG); }
    elif (str_eq_cstr(s, "cap_mknod") == 1) { return Ok(CAP_MKNOD); }
    elif (str_eq_cstr(s, "cap_lease") == 1) { return Ok(CAP_LEASE); }
    elif (str_eq_cstr(s, "cap_audit_write") == 1) { return Ok(CAP_AUDIT_WRITE); }
    elif (str_eq_cstr(s, "cap_audit_control") == 1) { return Ok(CAP_AUDIT_CONTROL); }
    elif (str_eq_cstr(s, "cap_setfcap") == 1) { return Ok(CAP_SETFCAP); }
    elif (str_eq_cstr(s, "cap_mac_override") == 1) { return Ok(CAP_MAC_OVERRIDE); }
    elif (str_eq_cstr(s, "cap_mac_admin") == 1) { return Ok(CAP_MAC_ADMIN); }
    elif (str_eq_cstr(s, "cap_syslog") == 1) { return Ok(CAP_SYSLOG); }
    elif (str_eq_cstr(s, "cap_wake_alarm") == 1) { return Ok(CAP_WAKE_ALARM); }
    elif (str_eq_cstr(s, "cap_block_suspend") == 1) { return Ok(CAP_BLOCK_SUSPEND); }
    elif (str_eq_cstr(s, "cap_audit_read") == 1) { return Ok(CAP_AUDIT_READ); }
    elif (str_eq_cstr(s, "cap_perfmon") == 1) { return Ok(CAP_PERFMON); }
    elif (str_eq_cstr(s, "cap_bpf") == 1) { return Ok(CAP_BPF); }
    elif (str_eq_cstr(s, "cap_checkpoint_restore") == 1) { return Ok(CAP_CHECKPOINT_RESTORE); }
    return stik_err_invalid_argument(str_from("unknown LinuxCapability name"));
}

# Display name of a Permission: "FileRead", "FileWrite", "NetworkAccess",
# "ProcessSpawn", "LlmInference" or "AuditRead", and "Unknown" for a value
# outside the enum. permission_parse is the inverse.
fn permission_name(p) {
    if (p == PERM_FILE_READ)       { return "FileRead"; }
    elif (p == PERM_FILE_WRITE)      { return "FileWrite"; }
    elif (p == PERM_NETWORK_ACCESS)  { return "NetworkAccess"; }
    elif (p == PERM_PROCESS_SPAWN)   { return "ProcessSpawn"; }
    elif (p == PERM_LLM_INFERENCE)   { return "LlmInference"; }
    elif (p == PERM_AUDIT_READ)      { return "AuditRead"; }
    return "Unknown";
}
# Inverse of permission_name. Exact match on what permission_name emits; an
# unrecognised string is an error rather than a silent default, so
# permission_parse(permission_name(v)) == v holds for every Permission member.
fn permission_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "FileRead") == 1) { return Ok(PERM_FILE_READ); }
    elif (str_eq_cstr(s, "FileWrite") == 1) { return Ok(PERM_FILE_WRITE); }
    elif (str_eq_cstr(s, "NetworkAccess") == 1) { return Ok(PERM_NETWORK_ACCESS); }
    elif (str_eq_cstr(s, "ProcessSpawn") == 1) { return Ok(PERM_PROCESS_SPAWN); }
    elif (str_eq_cstr(s, "LlmInference") == 1) { return Ok(PERM_LLM_INFERENCE); }
    elif (str_eq_cstr(s, "AuditRead") == 1) { return Ok(PERM_AUDIT_READ); }
    return stik_err_invalid_argument(str_from("unknown Permission name"));
}
# Display name of a Role: "Admin", "Operator", "Auditor", "Viewer" or
# "Service", and "Unknown" for a value outside the enum. role_parse is the
# inverse.
fn role_name(r) {
    if (r == ROLE_ADMIN)    { return "Admin"; }
    elif (r == ROLE_OPERATOR) { return "Operator"; }
    elif (r == ROLE_AUDITOR)  { return "Auditor"; }
    elif (r == ROLE_VIEWER)   { return "Viewer"; }
    elif (r == ROLE_SERVICE)  { return "Service"; }
    return "Unknown";
}
# Inverse of role_name. Exact match on what role_name emits; an
# unrecognised string is an error rather than a silent default, so
# role_parse(role_name(v)) == v holds for every Role member.
fn role_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "Admin") == 1) { return Ok(ROLE_ADMIN); }
    elif (str_eq_cstr(s, "Operator") == 1) { return Ok(ROLE_OPERATOR); }
    elif (str_eq_cstr(s, "Auditor") == 1) { return Ok(ROLE_AUDITOR); }
    elif (str_eq_cstr(s, "Viewer") == 1) { return Ok(ROLE_VIEWER); }
    elif (str_eq_cstr(s, "Service") == 1) { return Ok(ROLE_SERVICE); }
    return stik_err_invalid_argument(str_from("unknown Role name"));
}
# Display name of an FsAccess: "NoAccess", "ReadOnly" or "ReadWrite", and
# "Unknown" for a value outside the enum. fs_access_parse is the inverse.
fn fs_access_name(a) {
    if (a == FS_NO_ACCESS)    { return "NoAccess"; }
    elif (a == FS_READ_ONLY)  { return "ReadOnly"; }
    elif (a == FS_READ_WRITE) { return "ReadWrite"; }
    return "Unknown";
}
# Inverse of fs_access_name. Exact match on what fs_access_name emits; an
# unrecognised string is an error rather than a silent default, so
# fs_access_parse(fs_access_name(v)) == v holds for every FsAccess member.
fn fs_access_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "NoAccess") == 1) { return Ok(FS_NO_ACCESS); }
    elif (str_eq_cstr(s, "ReadOnly") == 1) { return Ok(FS_READ_ONLY); }
    elif (str_eq_cstr(s, "ReadWrite") == 1) { return Ok(FS_READ_WRITE); }
    return stik_err_invalid_argument(str_from("unknown FsAccess name"));
}
