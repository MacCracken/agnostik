fn ns_net(n)    { return load64(n + 8); }
fn ns_mount(n)  { return load64(n + 16); }
fn ns_user(n)   { return load64(n + 24); }
fn ns_uts(n)    { return load64(n + 32); }
fn ns_ipc(n)    { return load64(n + 40); }
fn ns_cgroup(n) { return load64(n + 48); }
fn ns_time(n)   { return load64(n + 56); }
fn ns_set_pid(n, v)    { store64(n, v); return 0; }
fn ns_set_net(n, v)    { store64(n + 8, v); return 0; }
fn ns_set_mount(n, v)  { store64(n + 16, v); return 0; }
fn ns_set_user(n, v)   { store64(n + 24, v); return 0; }
fn sandbox_config_new() {
    # 88 bytes = 11 u64 slots. Unrolled: store the two live fields with
    # their values and zero the other nine directly — no loop counter /
    # compare / branch per slot. The old `while (i<88) store64(0)` loop
    # zeroed all 11 then overwrote two; this is a hot constructor, so the
    # unroll gives the bench real headroom against runner noise (the
    # 6.3.x codegen shift left it hugging the regression floor).
    var s = alloc(88);
    store64(s + 0,  0);
    store64(s + 8,  NET_LOCALHOST_ONLY);
    store64(s + 16, 0);
    store64(s + 24, 1);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, 0);
    store64(s + 64, 0);
    store64(s + 72, 0);
    store64(s + 80, 0);
    return s;
}
fn _lazy_vec(ptr) {
    var v = load64(ptr);
    if (v == 0) { v = vec_new(); store64(ptr, v); }
    return v;
}
fn _lazy_map(ptr) {
    var m = load64(ptr);
    if (m == 0) { m = map_new(); store64(ptr, m); }
    return m;
}
fn sandbox_fs_rules(s)      { return _lazy_vec(s); }
fn sandbox_net_access(s)    { return load64(s + 8); }
fn sandbox_seccomp(s)       { return load64(s + 16); }
fn sandbox_isolate_net(s)   { return load64(s + 24); }
fn sandbox_masked_paths(s)  { return _lazy_vec(s + 64); }
fn sandbox_readonly_paths(s){ return _lazy_vec(s + 72); }
fn sandbox_sysctl(s)        { return _lazy_map(s + 80); }
fn sandbox_set_net_access(s, v)   { store64(s + 8, v); return 0; }
fn sandbox_set_seccomp(s, v)      { store64(s + 16, v); return 0; }
fn sandbox_set_apparmor(s, v: Str) { store64(s + 40, v); return 0; }
fn sandbox_set_selinux(s, v: Str)  { store64(s + 48, v); return 0; }
fn security_context_new(agent_id) {
    var ctx = alloc(56);
    store64(ctx, agent_id);
    store64(ctx + 8, vec_new());
    store64(ctx + 16, sandbox_config_new());
    store64(ctx + 24, 0);
    store64(ctx + 32, 0);
    store64(ctx + 40, 0);
    store64(ctx + 48, 1);
    return ctx;
}
