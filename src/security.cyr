    return "Unknown";
}
# Parse a LandlockScope display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn landlock_scope_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "AbstractUnixSocket") == 1) { return Ok(LL_SCOPE_ABSTRACT_UNIX); }
    elif (str_eq_cstr(s, "Signal") == 1) { return Ok(LL_SCOPE_SIGNAL); }
    return stik_err_invalid_argument(str_from("unknown LandlockScope name"));
}
# DeviceType display name: "c", "b" or "a", and "Unknown" for a value outside
# the enum. device_type_parse is the inverse. Spelling: the OCI runtime spec's
# device type letters (and cgroup v1 devices.allow).
fn device_type_name(t) {
    if (t == DEV_CHAR)    { return "c"; }
    elif (t == DEV_BLOCK) { return "b"; }
    elif (t == DEV_ALL)   { return "a"; }
    return "Unknown";
}
# Parse a DeviceType display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn device_type_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "c") == 1) { return Ok(DEV_CHAR); }
    elif (str_eq_cstr(s, "b") == 1) { return Ok(DEV_BLOCK); }
    elif (str_eq_cstr(s, "a") == 1) { return Ok(DEV_ALL); }
    return stik_err_invalid_argument(str_from("unknown DeviceType name"));
}
# RlimitType display name: "nofile", "nproc", "as" … "msgqueue", and "Unknown"
# for a value outside the enum. rlimit_type_parse is the inverse. Spelling:
# the limits.conf(5) item names, so a limits config parses as-is. The values
# are agnostik ordinals, NOT the kernel's RLIMIT_* numbers (RLIM_NOFILE is 0,
# which is RLIMIT_CPU): map one with rlimit_type_resource before passing it to
# setrlimit(2).
fn rlimit_type_name(t) {
    if (t == RLIM_NOFILE)          { return "nofile"; }
    elif (t == RLIM_NPROC)         { return "nproc"; }
    elif (t == RLIM_ADDRESS_SPACE) { return "as"; }
    elif (t == RLIM_FILE_SIZE)     { return "fsize"; }
    elif (t == RLIM_CORE)          { return "core"; }
    elif (t == RLIM_DATA)          { return "data"; }
    elif (t == RLIM_STACK)         { return "stack"; }
    elif (t == RLIM_MEMLOCK)       { return "memlock"; }
    elif (t == RLIM_SIGPENDING)    { return "sigpending"; }
    elif (t == RLIM_MSGQUEUE)      { return "msgqueue"; }
    return "Unknown";
}
# Parse a RlimitType display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn rlimit_type_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "nofile") == 1) { return Ok(RLIM_NOFILE); }
    elif (str_eq_cstr(s, "nproc") == 1) { return Ok(RLIM_NPROC); }
    elif (str_eq_cstr(s, "as") == 1) { return Ok(RLIM_ADDRESS_SPACE); }
    elif (str_eq_cstr(s, "fsize") == 1) { return Ok(RLIM_FILE_SIZE); }
    elif (str_eq_cstr(s, "core") == 1) { return Ok(RLIM_CORE); }
    elif (str_eq_cstr(s, "data") == 1) { return Ok(RLIM_DATA); }
    elif (str_eq_cstr(s, "stack") == 1) { return Ok(RLIM_STACK); }
    elif (str_eq_cstr(s, "memlock") == 1) { return Ok(RLIM_MEMLOCK); }
    elif (str_eq_cstr(s, "sigpending") == 1) { return Ok(RLIM_SIGPENDING); }
    elif (str_eq_cstr(s, "msgqueue") == 1) { return Ok(RLIM_MSGQUEUE); }
    return stik_err_invalid_argument(str_from("unknown RlimitType name"));
}
# The Linux RLIMIT_* resource number for a RlimitType, the value setrlimit(2)
# and prlimit(2) take, or -1 for a value outside the enum. The numbers are
# asm-generic/resource.h's, which x86_64 and aarch64 use (alpha, mips and sparc
# renumber some, and other kernels have their own): NOFILE 7, NPROC 6, AS 9,
# FSIZE 1, CORE 4, DATA 2, STACK 3, MEMLOCK 8, SIGPENDING 11, MSGQUEUE 12.
fn rlimit_type_resource(t) {
    if (t == RLIM_NOFILE)          { return 7; }
    elif (t == RLIM_NPROC)         { return 6; }
    elif (t == RLIM_ADDRESS_SPACE) { return 9; }
    elif (t == RLIM_FILE_SIZE)     { return 1; }
    elif (t == RLIM_CORE)          { return 4; }
    elif (t == RLIM_DATA)          { return 2; }
    elif (t == RLIM_STACK)         { return 3; }
    elif (t == RLIM_MEMLOCK)       { return 8; }
    elif (t == RLIM_SIGPENDING)    { return 11; }
    elif (t == RLIM_MSGQUEUE)      { return 12; }
    return 0 - 1;
}
