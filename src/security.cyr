# LandlockFsAccess display name: "Execute", "WriteFile", "ReadFile" …
# "Truncate", "IoctlDev", "ResolveUnix", and "Unknown" for a value outside the
# enum. landlock_fs_access_parse is the inverse. Spelling: the Rust `landlock`
# crate's AccessFs names; each value is the kernel's LANDLOCK_ACCESS_FS_* bit
# index, so `1 << v` is the kernel flag. IoctlDev (bit 15) needs Landlock ABI 5
# and ResolveUnix (bit 16) ABI 9; both were added in v1.11.0.
fn landlock_fs_access_name(a) {
    if (a == LL_EXECUTE)       { return "Execute"; }
    elif (a == LL_WRITE_FILE)  { return "WriteFile"; }
    elif (a == LL_READ_FILE)   { return "ReadFile"; }
    elif (a == LL_READ_DIR)    { return "ReadDir"; }
    elif (a == LL_REMOVE_DIR)  { return "RemoveDir"; }
    elif (a == LL_REMOVE_FILE) { return "RemoveFile"; }
    elif (a == LL_MAKE_CHAR)   { return "MakeChar"; }
    elif (a == LL_MAKE_DIR)    { return "MakeDir"; }
    elif (a == LL_MAKE_REG)    { return "MakeReg"; }
    elif (a == LL_MAKE_SOCK)   { return "MakeSock"; }
    elif (a == LL_MAKE_FIFO)   { return "MakeFifo"; }
    elif (a == LL_MAKE_BLOCK)  { return "MakeBlock"; }
    elif (a == LL_MAKE_SYM)    { return "MakeSym"; }
    elif (a == LL_REFER)       { return "Refer"; }
    elif (a == LL_TRUNCATE)    { return "Truncate"; }
    elif (a == LL_IOCTL_DEV)   { return "IoctlDev"; }
    elif (a == LL_RESOLVE_UNIX) { return "ResolveUnix"; }
    return "Unknown";
}
# Parse a LandlockFsAccess display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn landlock_fs_access_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "Execute") == 1) { return Ok(LL_EXECUTE); }
    elif (str_eq_cstr(s, "WriteFile") == 1) { return Ok(LL_WRITE_FILE); }
    elif (str_eq_cstr(s, "ReadFile") == 1) { return Ok(LL_READ_FILE); }
    elif (str_eq_cstr(s, "ReadDir") == 1) { return Ok(LL_READ_DIR); }
    elif (str_eq_cstr(s, "RemoveDir") == 1) { return Ok(LL_REMOVE_DIR); }
    elif (str_eq_cstr(s, "RemoveFile") == 1) { return Ok(LL_REMOVE_FILE); }
    elif (str_eq_cstr(s, "MakeChar") == 1) { return Ok(LL_MAKE_CHAR); }
    elif (str_eq_cstr(s, "MakeDir") == 1) { return Ok(LL_MAKE_DIR); }
    elif (str_eq_cstr(s, "MakeReg") == 1) { return Ok(LL_MAKE_REG); }
    elif (str_eq_cstr(s, "MakeSock") == 1) { return Ok(LL_MAKE_SOCK); }
    elif (str_eq_cstr(s, "MakeFifo") == 1) { return Ok(LL_MAKE_FIFO); }
    elif (str_eq_cstr(s, "MakeBlock") == 1) { return Ok(LL_MAKE_BLOCK); }
    elif (str_eq_cstr(s, "MakeSym") == 1) { return Ok(LL_MAKE_SYM); }
    elif (str_eq_cstr(s, "Refer") == 1) { return Ok(LL_REFER); }
    elif (str_eq_cstr(s, "Truncate") == 1) { return Ok(LL_TRUNCATE); }
    elif (str_eq_cstr(s, "IoctlDev") == 1) { return Ok(LL_IOCTL_DEV); }
    elif (str_eq_cstr(s, "ResolveUnix") == 1) { return Ok(LL_RESOLVE_UNIX); }
    return stik_err_invalid_argument(str_from("unknown LandlockFsAccess name"));
}
# LandlockNetAccess display name: "BindTcp", "ConnectTcp", "BindUdp" or
# "ConnectSendUdp", and "Unknown" for a value outside the enum.
# landlock_net_access_parse is the inverse. Spelling: the Rust `landlock`
# crate's AccessNet names; each value is the kernel's LANDLOCK_ACCESS_NET_* bit
# index. The UDP rights (bits 2 and 3, Landlock ABI 10, added in v1.11.0) are
# not in the crate yet, so their names follow its rule: the kernel suffix in
# CamelCase.
fn landlock_net_access_name(a) {
    if (a == LL_BIND_TCP)      { return "BindTcp"; }
    elif (a == LL_CONNECT_TCP) { return "ConnectTcp"; }
    elif (a == LL_BIND_UDP)    { return "BindUdp"; }
    elif (a == LL_CONNECT_SEND_UDP) { return "ConnectSendUdp"; }
    return "Unknown";
}
# Parse a LandlockNetAccess display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn landlock_net_access_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "BindTcp") == 1) { return Ok(LL_BIND_TCP); }
    elif (str_eq_cstr(s, "ConnectTcp") == 1) { return Ok(LL_CONNECT_TCP); }
    elif (str_eq_cstr(s, "BindUdp") == 1) { return Ok(LL_BIND_UDP); }
    elif (str_eq_cstr(s, "ConnectSendUdp") == 1) { return Ok(LL_CONNECT_SEND_UDP); }
    return stik_err_invalid_argument(str_from("unknown LandlockNetAccess name"));
}
