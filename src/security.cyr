enum Permission {
    PERM_FILE_READ;
    PERM_FILE_WRITE;
    PERM_NETWORK_ACCESS;
    PERM_PROCESS_SPAWN;
    PERM_LLM_INFERENCE;
    PERM_AUDIT_READ;
}
enum FsAccess { FS_NO_ACCESS; FS_READ_ONLY; FS_READ_WRITE; }
enum NetworkAccess { NET_NONE; NET_LOCALHOST_ONLY; NET_RESTRICTED; NET_FULL; }
enum SeccompAction { SECCOMP_ALLOW; SECCOMP_KILL; SECCOMP_KILL_PROCESS; SECCOMP_TRAP; SECCOMP_LOG; SECCOMP_NOTIFY; }
# SeccompAction Errno variant: a 16-byte tagged box (tag 100, payload
# errno_val) for an action that fails the syscall with that errno. The plain
# SeccompAction members are bare integers, so an action slot (SeccompRule_action,
# SeccompProfile_default_action) holds either form. Read a box only with boxed_tag /
# boxed_payload; seccomp_action_name does not recognise one ("Unknown").
fn seccomp_errno(errno_val) { return tagged_new(100, errno_val); }
# SeccompAction Trace variant: a 16-byte tagged box (tag 101, payload
# trace_val). Same representation and caveats as seccomp_errno.
fn seccomp_trace(trace_val) { return tagged_new(101, trace_val); }
enum SeccompArgOp {
    ARG_NOT_EQUAL;
    ARG_LESS_THAN;
    ARG_LESS_EQUAL;
    ARG_EQUAL;
    ARG_GREATER_EQUAL;
    ARG_GREATER_THAN;
    ARG_MASKED_EQUAL;
}
enum SeccompArch {
    ARCH_X86;
    ARCH_X86_64;
    ARCH_X32;
    ARCH_ARM;
    ARCH_AARCH64;
    ARCH_MIPS;
    ARCH_MIPS64;
    ARCH_MIPS64N32;
    ARCH_MIPSEL;
    ARCH_MIPSEL64;
    ARCH_MIPSEL64N32;
    ARCH_PPC;
    ARCH_PPC64;
    ARCH_PPC64LE;
    ARCH_S390;
    ARCH_S390X;
    ARCH_RISCV64;
}
enum MountPropagation { MOUNT_PRIVATE; MOUNT_SHARED; MOUNT_SLAVE; MOUNT_UNBINDABLE; }
enum PolicyEffect { POLICY_ALLOW; POLICY_DENY; POLICY_AUDIT; }
enum Role { ROLE_ADMIN; ROLE_OPERATOR; ROLE_AUDITOR; ROLE_VIEWER; ROLE_SERVICE; }
enum ConditionOperator { COND_EQ; COND_NEQ; COND_IN; COND_NIN; COND_GT; COND_GTE; COND_LT; COND_LTE; }
enum SeccompMode { SECCOMP_DISABLED; SECCOMP_STRICT; SECCOMP_FILTER; SECCOMP_UNSUPPORTED; }
enum SystemFeature { FEAT_LANDLOCK; FEAT_SECCOMP; FEAT_NAMESPACES; FEAT_CGROUPS; FEAT_TPM; FEAT_SECURE_BOOT; }
# Linux capability numbers, as the KERNEL defines them
# (include/uapi/linux/capability.h). The value IS the capability number, so
# an ordinal that does not match the kernel silently operates on a DIFFERENT
# capability. prctl(PR_CAPBSET_DROP) and similar take the number itself. A
# capset(2) mask (_LINUX_CAPABILITY_VERSION_3) is two 32-bit words: bit
# (cap % 32) of word (cap / 32). `1 << cap` is a 64-bit mask, so caps 32..40
# land in its high half, which capset reads as the second word only when the
# caller splits it.
#
# ⚠ Fixed at 1.4.1, and it was wrong in two ways. The list omitted
# CAP_MAC_OVERRIDE (32) and CAP_MAC_ADMIN (33) entirely, which shifted
# every capability above 31 down by two — CAP_SYSLOG resolved to 33
# (kernel: CAP_MAC_ADMIN), CAP_BPF to 36 (kernel: CAP_BLOCK_SUSPEND),
# CAP_CHECKPOINT_RESTORE to 37 (kernel: CAP_AUDIT_READ). And
# CAP_AUDIT_READ / CAP_AUDIT_CONTROL were transposed, so both were wrong
# even below the shift. Anything that dropped "all but CAP_SYSLOG" was
# really keeping CAP_MAC_ADMIN.
#
# Values are explicit rather than implicit ordinals precisely so a future
# insertion cannot silently renumber the tail again.
enum LinuxCapability {
    CAP_CHOWN = 0;
    CAP_DAC_OVERRIDE = 1;
    CAP_DAC_READ_SEARCH = 2;
    CAP_FOWNER = 3;
    CAP_FSETID = 4;
    CAP_KILL = 5;
    CAP_SETGID = 6;
    CAP_SETUID = 7;
    CAP_SETPCAP = 8;
    CAP_LINUX_IMMUTABLE = 9;
    CAP_NET_BIND_SERVICE = 10;
    CAP_NET_BROADCAST = 11;
    CAP_NET_ADMIN = 12;
    CAP_NET_RAW = 13;
    CAP_IPC_LOCK = 14;
    CAP_IPC_OWNER = 15;
    CAP_SYS_MODULE = 16;
    CAP_SYS_RAWIO = 17;
    CAP_SYS_CHROOT = 18;
    CAP_SYS_PTRACE = 19;
    CAP_SYS_PACCT = 20;
    CAP_SYS_ADMIN = 21;
    CAP_SYS_BOOT = 22;
    CAP_SYS_NICE = 23;
    CAP_SYS_RESOURCE = 24;
    CAP_SYS_TIME = 25;
    CAP_SYS_TTY_CONFIG = 26;
    CAP_MKNOD = 27;
    CAP_LEASE = 28;
    CAP_AUDIT_WRITE = 29;
    CAP_AUDIT_CONTROL = 30;
    CAP_SETFCAP = 31;
    CAP_MAC_OVERRIDE = 32;
    CAP_MAC_ADMIN = 33;
    CAP_SYSLOG = 34;
    CAP_WAKE_ALARM = 35;
    CAP_BLOCK_SUSPEND = 36;
    CAP_AUDIT_READ = 37;
    CAP_PERFMON = 38;
    CAP_BPF = 39;
    CAP_CHECKPOINT_RESTORE = 40;
    CAP_LAST_CAP = 40;
}
