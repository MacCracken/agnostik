# Append an OTLP ExportLogsServiceRequest body to `sb` (logs_service.proto):
# one ResourceLogs for `r` holding one ScopeLogs for `sc` with every record in
# vec `records`, laid out and batched as otlp_traces_request. Returns 0.
fn otlp_logs_request(r, sc, records, sb) {
