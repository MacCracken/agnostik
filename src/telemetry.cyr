# the otlp_*_request builders write. Returns 0.
fn Resource_to_otlp_proto(r, sb) {
    var b = _stik_pb_new();
    _stik_otlp_resource(b, r, _stik_alloc(128));
    _stik_pb_flush(b, sb);
    return 0;
}
# Write the InstrumentationScope fields of scope `sc` into buffer `b`: name 1
# and version 2 (omitted when empty), attributes 3. Returns 0.
fn _stik_otlp_scope(b, sc, path) {
    var nm = load64(sc);
    if (nm != 0) {
        if (str_len(nm) > 0) { _stik_pb_string(b, 1, nm); }
    }
    var ver = load64(sc + 8);
    if (ver != 0) {
        if (str_len(ver) > 0) { _stik_pb_string(b, 2, ver); }
    }
    _stik_otlp_attributes(b, 3, load64(sc + 24), path, 0);
    return 0;
