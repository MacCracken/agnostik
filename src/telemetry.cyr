# into buffer `b`, the body of the message without its own tag. Returns 0.
fn _stik_otlp_number_point(b, ptr, path) {
    var st = load64(ptr + 48);
    if (st != 0) { _stik_pb_fixed64(b, 2, st); }
    var ts = load64(ptr + 24);
    if (ts != 0) { _stik_pb_fixed64(b, 3, ts); }
    var mv = load64(ptr + 8);
    var t = 0 - 1;
    if (mv != 0) { t = boxed_tag(mv); }
    if (t == MV_FLOAT) { _stik_pb_fixed64(b, 4, boxed_payload(mv)); }
    _stik_otlp_exemplars(b, 5, ptr, path);
    if (t == MV_INT) { _stik_pb_fixed64(b, 6, boxed_payload(mv)); }
    _stik_otlp_attributes(b, 7, load64(ptr + 16), path, 0);
    var recorded = 0;
    if (t == MV_FLOAT) { recorded = 1; }
    if (t == MV_INT) { recorded = 1; }
    if (recorded == 0) { _stik_pb_int64(b, 8, 1); }
    return 0;
}
# An i64 whose signed order is the numeric order of the f64 with these bits:
# positive doubles keep their bits, negative ones flip the low 63, and -0.0
# folds into +0.0 so the two compare equal. NaN has no order; callers reject it
# first with _stik_f64_is_nan.
fn _stik_f64_order_key(bits) {
    if (bits == 0x8000000000000000) { return 0; }
    if (bits < 0) { return bits ^ 0x7FFFFFFFFFFFFFFF; }
    return bits;
}
# 1 when the f64 with these bits is a NaN (exponent all ones, mantissa not 0).
fn _stik_f64_is_nan(bits) {
    if ((bits & 0x7FF0000000000000) != 0x7FF0000000000000) { return 0; }
    if ((bits & 0x000FFFFFFFFFFFFF) == 0) { return 0; }
    return 1;
}
# 1 when HistogramValue box `mv` has the shape OTLP requires, else 0: no
# negative count or bucket count, no bounds without buckets, and when there are
# buckets, one more than the bounds and summing to the count. Since 1.12.3
# (F-042) the bucket counts must sum without overflowing i64 (wrapped counts
# used to pass), and the bounds must be strictly increasing and not NaN, as
# metrics.proto requires.
fn _stik_otlp_histogram_ok(mv) {
    if (mv == 0) { return 0; }
    if (boxed_tag(mv) != MV_HISTOGRAM) { return 0; }
    var h = boxed_payload(mv);
    if (h == 0) { return 0; }
    var count = load64(h);
    if (count < 0) { return 0; }
    var nb = 0;
    var bounds = load64(h + 24);
    if (bounds != 0) { nb = vec_len(bounds); }
    var nc = 0;
    var counts = load64(h + 32);
    if (counts != 0) { nc = vec_len(counts); }
    if (nc == 0) {
        if (nb != 0) { return 0; }
        return 1;
    }
    if (nc != nb + 1) { return 0; }
    var total = 0;
    var bad = 0;
    var i = 0;
    while (i < nc) {
        var c = vec_get(counts, i);
        if (c < 0) { bad = 1; }
        elif (c > 0x7FFFFFFFFFFFFFFF - total) { bad = 1; }
        else { total = total + c; }
        i = i + 1;
    }
    if (bad == 1) { return 0; }
    if (total != count) { return 0; }
    var j = 0;
    var prev = 0;
    while (j < nb) {
        var bb = vec_get(bounds, j);
        if (_stik_f64_is_nan(bb) == 1) { bad = 1; }
        else {
            var key = _stik_f64_order_key(bb);
            if (j > 0 && key <= prev) { bad = 1; }
            prev = key;
        }
        j = j + 1;
    }
    if (bad == 1) { return 0; }
    return 1;
}
# Write the HistogramDataPoint fields of data point `ptr`, whose value is a
# metric_histogram box already checked by _stik_otlp_histogram_ok, into buffer
# `b` (v1.12.0). Fields ascend: start 2, time 3, count 4 (fixed64), sum 5,
# bucket_counts 6 and explicit_bounds 7 (packed), exemplars 8, attributes 9,
# min 11, max 12. sum, min and max are proto3 optional: written when set, even
# as 0. Returns 0.
fn _stik_otlp_histogram_point(b, ptr, path) {
    var h = boxed_payload(load64(ptr + 8));
    var st = load64(ptr + 48);
    if (st != 0) { _stik_pb_fixed64(b, 2, st); }
    var ts = load64(ptr + 24);
    if (ts != 0) { _stik_pb_fixed64(b, 3, ts); }
    var count = load64(h);
    if (count != 0) { _stik_pb_fixed64(b, 4, count); }
    var fl = load64(h + 16);
    if ((fl & 1) != 0) { _stik_pb_fixed64(b, 5, load64(h + 8)); }
    _stik_pb_packed_fixed64(b, 6, load64(h + 32));
    _stik_pb_packed_fixed64(b, 7, load64(h + 24));
    _stik_otlp_exemplars(b, 8, ptr, path);
    _stik_otlp_attributes(b, 9, load64(ptr + 16), path, 0);
    if ((fl & 2) != 0) { _stik_pb_fixed64(b, 11, load64(h + 40)); }
    if ((fl & 4) != 0) { _stik_pb_fixed64(b, 12, load64(h + 48)); }
    return 0;
}
# Append data point `ptr` to `sb` as an OTLP NumberDataPoint message
# (opentelemetry.proto.metrics.v1.NumberDataPoint, metrics.proto), fields in
# ascending number order:
#   2 start_time_unix_nano  MetricDataPoint_set_start_time's value, when non-zero
#   3 time_unix_nano   the point's timestamp, when non-zero
#   4 as_double        for a metric_float value: its raw IEEE-754 bits
#   5 exemplars        MetricDataPoint_exemplars, as_int or as_double like the value
#   6 as_int           for a metric_int value (sfixed64)
#   7 attributes       the point's map, keys sorted; AnyValue values
#   8 flags            1 (FLAG_NO_RECORDED_VALUE) when the point holds no
#                      int or float value, so no value field is written
# The instrument name, temporality and monotonic flag belong to the enclosing
# Metric; metric_to_otlp_proto writes that, and a metric_histogram point as a
# HistogramDataPoint. Returns 0.
fn MetricDataPoint_to_otlp_proto(ptr, sb) {
    var b = _stik_pb_new();
    _stik_otlp_number_point(b, ptr, _stik_alloc(128));
    _stik_pb_flush(b, sb);
    return 0;
}
# OTLP AggregationTemporality for an agnostik one: TEMPORALITY_DELTA → 1,
# TEMPORALITY_CUMULATIVE → 2, and 0 for any other value. The enums differ:
# agnostik's are ordinals (CUMULATIVE = 0), OTLP's reserve 0 for UNSPECIFIED.
fn _stik_temporality_to_otlp(t) {
    if (t == TEMPORALITY_DELTA) { return 1; }
    if (t == TEMPORALITY_CUMULATIVE) { return 2; }
    return 0;
}
# The OTLP data member a MetricKind selects: gauge 5, sum 7 (counter and
# up-down counter) or histogram 9, and 0 for any other kind.
fn _stik_otlp_metric_member(kind) {
    if (kind == METRIC_GAUGE) { return 5; }
    if (kind == METRIC_COUNTER) { return 7; }
    if (kind == METRIC_UP_DOWN_COUNTER) { return 7; }
    if (kind == METRIC_HISTOGRAM) { return 9; }
    return 0;
}
# 0 when InstrumentDescriptor `desc` and data points `points` encode as an
# OTLP Metric, else why not: 1 an unknown kind, 2 a point with an unknown
# temporality, 3 points that disagree on temporality (sums and histograms
# carry one), 4 a histogram point whose value is not a well-formed
# metric_histogram. A 0 desc is 1. Writes nothing.
fn _stik_otlp_metric_check(desc, points) {
    if (desc == 0) { return 1; }
    var member = _stik_otlp_metric_member(load64(desc + 24));
    if (member == 0) { return 1; }
    var np = 0;
    if (points != 0) { np = vec_len(points); }
    var first = 0;
    var seen = 0;
    var bad = 0;
    var i = 0;
    while (i < np) {
        var p = vec_get(points, i);
        if (p != 0) {
            if (bad == 0) {
                if (member == 9) {
                    if (_stik_otlp_histogram_ok(load64(p + 8)) == 0) { bad = 4; }
                }
            }
            if (member != 5) {
                var tt = _stik_temporality_to_otlp(load64(p + 32));
                if (bad == 0) {
                    if (tt == 0) { bad = 2; }
                    elif (seen == 1) {
                        if (tt != first) { bad = 3; }
                    }
                }
                if (seen == 0) {
                    first = tt;
                    seen = 1;
                }
            }
        }
        i = i + 1;
    }
    return bad;
}
# The invalid-argument Err for a non-zero _stik_otlp_metric_check code.
fn _stik_otlp_metric_err(code) {
    if (code == 1) { return stik_err_invalid_argument(str_from("unknown metric kind")); }
    if (code == 2) { return stik_err_invalid_argument(str_from("unknown data point temporality")); }
    if (code == 3) { return stik_err_invalid_argument(str_from("data points disagree on temporality")); }
    return stik_err_invalid_argument(str_from("malformed histogram data point"));
}
# Write the Metric fields for `desc` and `points`, which
# _stik_otlp_metric_check passed, into buffer `b` (field table at
# metric_to_otlp_proto). Returns 0.
fn _stik_otlp_metric(b, desc, points, path) {
    var kind = load64(desc + 24);
    var member = _stik_otlp_metric_member(kind);
    var np = 0;
    if (points != 0) { np = vec_len(points); }
    var temporality = 2;
    var k = 0;
    var found = 0;
    while (k < np) {
        var fp = vec_get(points, k);
        if (found == 0) {
            if (fp != 0) {
                temporality = _stik_temporality_to_otlp(load64(fp + 32));
                found = 1;
            }
        }
        k = k + 1;
    }
    var nm = load64(desc);
    if (nm != 0) {
        if (str_len(nm) > 0) { _stik_pb_string(b, 1, nm); }
    }
    var ds = load64(desc + 8);
    if (ds != 0) {
        if (str_len(ds) > 0) { _stik_pb_string(b, 2, ds); }
    }
    var un = load64(desc + 16);
    if (un != 0) {
        if (str_len(un) > 0) { _stik_pb_string(b, 3, un); }
    }
    var dm = _stik_pb_open(b, member);
    var j = 0;
    while (j < np) {
        var q = vec_get(points, j);
        if (q != 0) {
            var pm = _stik_pb_open(b, 1);
            if (member == 9) { _stik_otlp_histogram_point(b, q, path); }
            else { _stik_otlp_number_point(b, q, path); }
            _stik_pb_close(b, pm);
        }
        j = j + 1;
    }
    if (member != 5) {
        _stik_pb_int64(b, 2, temporality);
        if (kind == METRIC_COUNTER) { _stik_pb_int64(b, 3, 1); }
    }
    _stik_pb_close(b, dm);
    return 0;
}
# Append an OTLP Metric message (metrics.proto) to `sb`: name 1, description 2
# and unit 3 from InstrumentDescriptor `desc` (each omitted when 0 or empty),
# then the data points in `points` (a vec of metric_data_point_new pointers; 0
# entries are skipped) inside the member its kind selects:
#   METRIC_GAUGE             gauge (5), NumberDataPoints
#   METRIC_COUNTER           sum (7), NumberDataPoints, is_monotonic true
#   METRIC_UP_DOWN_COUNTER   sum (7), NumberDataPoints, is_monotonic false
#   METRIC_HISTOGRAM         histogram (9), HistogramDataPoints (v1.12.0)
# A sum's or histogram's aggregation_temporality is the points' temporality,
# mapped to OTLP's numbering; with no points it is CUMULATIVE. A gauge ignores
# temporality. Returns Ok(0). Returns an invalid-argument Err, having written
# nothing, for an unknown kind, for a sum or histogram with a point whose
# temporality is not an AggregationTemporality or whose points disagree on it
# (OTLP carries one per Sum / Histogram), or for a histogram point that is not
# a well-formed metric_histogram (see histogram_value_new).
fn metric_to_otlp_proto(desc, points, sb) {
    var code = _stik_otlp_metric_check(desc, points);
    if (code != 0) { return _stik_otlp_metric_err(code); }
    var b = _stik_pb_new();
    _stik_otlp_metric(b, desc, points, _stik_alloc(128));
    _stik_pb_flush(b, sb);
    return Ok(0);
}
# A Metric: an InstrumentDescriptor and its data points, the unit an OTLP
# metrics request carries (v1.12.0). 16 bytes: +0 descriptor, +8 points (a vec
# of metric_data_point_new pointers), both stored as given.
fn metric_new(desc, points) {
    var m = _stik_alloc(16);
    store64(m, desc);
    store64(m + 8, points);
    return m;
}
# Metric's accessors Metric_<field>(p) and Metric_set_<field>(p, v) are generated by
# #derive(accessors) (ADR-009), one 8-byte slot per field in order:
#   descriptor: The metric's InstrumentDescriptor.
#   points: The metric's data points (vec).
#derive(accessors)
struct Metric {
    descriptor;
    points;
}
# Append Metric `m` to `sb` as an OTLP Metric message: metric_to_otlp_proto of
# its descriptor and points, with the same Ok / Err.
fn Metric_to_otlp_proto(m, sb) {
    return metric_to_otlp_proto(load64(m), load64(m + 8), sb);
}
# Write the Resource fields of resource `r` into buffer `b`: its attributes
# (field 1) are the Resource_attributes map plus the OpenTelemetry semantic-convention
# keys service.name, service.version and service.instance.id from the struct's
# three Strs. A non-empty struct field replaces a map entry under the same key;
# an empty one leaves the map's entry, if any. Keys are sorted, as for every
# attribute set. Returns 0.
fn _stik_otlp_resource(b, r, path) {
    var merged = map_new();
    var attrs = load64(r + 24);
    if (attrs != 0) {
        var keys = map_keys(attrs);
        var i = 0;
        while (i < vec_len(keys)) {
            var k = vec_get(keys, i);
            map_set(merged, k, map_get(attrs, k));
            i = i + 1;
        }
    }
    var nm = load64(r);
    if (nm != 0) {
        if (str_len(nm) > 0) { map_set(merged, "service.name", any_string(nm)); }
    }
    var ver = load64(r + 8);
    if (ver != 0) {
        if (str_len(ver) > 0) { map_set(merged, "service.version", any_string(ver)); }
    }
    var inst = load64(r + 16);
    if (inst != 0) {
        if (str_len(inst) > 0) { map_set(merged, "service.instance.id", any_string(inst)); }
    }
    _stik_otlp_attributes(b, 1, merged, path, 0);
    return 0;
}
# Append resource `r` to `sb` as the body of an OTLP Resource message
# (resource.proto): its attributes, with service.name / service.version /
# service.instance.id from the struct (see _stik_otlp_resource). The schema URL
