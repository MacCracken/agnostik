var TEXTMAP_GET = 0;
var TEXTMAP_SET = 1;
# Vtable for a TextMap carrier: 16 bytes, slot 0 (TEXTMAP_GET) = get_fn, slot 1
# (TEXTMAP_SET) = set_fn, `data` being the carrier's data pointer. get_fn is
# called as fn(data, key) and set_fn as fn(data, key, value) (since v1.11.0; a
# set_fn written as fn(data, key) reads the value from the global
# _textmap_extra, which textmap_set still fills).
fn textmap_carrier_vtable(get_fn, set_fn) {
    var vt = _stik_alloc(16);
    store64(vt, get_fn);
    store64(vt + 8, set_fn);
    return vt;
}
# A TextMap carrier: a trait object pairing a textmap_carrier_vtable with the
# caller's data pointer.
fn textmap_carrier_new(vtable, data) { return trait_obj_new(vtable, data); }
# Call the carrier's get_fn(data, key) and return its result, or 0 when the
# slot is unset.
fn textmap_get(carrier, key) { return _stik_dispatch1(carrier, TEXTMAP_GET, key); }
var _textmap_extra = 0;
# Call the carrier's set_fn(data, key, value) and return its result, or 0 when
# the slot is unset. The value is an argument since v1.11.0, so nested calls do
# not clobber it. It is also parked in the global _textmap_extra for a set_fn
# written as fn(data, key) before then; that path stays non-reentrant.
fn textmap_set(carrier, key, value) {
    _textmap_extra = value;
    return _stik_dispatch2(carrier, TEXTMAP_SET, key, value);
