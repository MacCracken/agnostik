# Append scope `sc` to `sb` as the body of an OTLP InstrumentationScope message
# (common.proto). Its schema URL belongs to the enclosing Scope* message.
# Returns 0.
fn InstrumentationScope_to_otlp_proto(sc, sb) {
    var b = _stik_pb_new();
    _stik_otlp_scope(b, sc, _stik_alloc(128));
    _stik_pb_flush(b, sb);
    return 0;
}
# Open the Resource* / Scope* envelope shared by the three request builders:
# field 1 of the request (ResourceSpans / ResourceLogs / ResourceMetrics), its
# resource (1, omitted when `r` is 0), then field 2 (ScopeSpans / ScopeLogs /
# ScopeMetrics) with its scope (1, omitted when `sc` is 0). Returns the two
# marks packed as outer * 2^32 + inner, for _stik_otlp_envelope_close.
fn _stik_otlp_envelope_open(b, r, sc, path) {
