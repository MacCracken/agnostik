# buffer `b`: time 2, as_double 3 or as_int 6, span_id 4, trace_id 5,
# filtered_attributes 7, in that ascending order (v1.12.0). Exemplar values are
# untyped words, so the point decides: as_int when its value is a metric_int,
# else as_double. The value is a oneof member, written even when 0. Returns 0.
fn _stik_otlp_exemplars(b, field_no, ptr, path) {
    var ex = load64(ptr + 56);
    if (ex == 0) { return 0; }
    var as_int = 0;
    var mv = load64(ptr + 8);
    if (mv != 0) {
        if (boxed_tag(mv) == MV_INT) { as_int = 1; }
    }
    var n = vec_len(ex);
    var i = 0;
    while (i < n) {
        var e = vec_get(ex, i);
        if (e != 0) {
            var em = _stik_pb_open(b, field_no);
            var ts = load64(e + 24);
            if (ts != 0) { _stik_pb_fixed64(b, 2, ts); }
            if (as_int == 0) { _stik_pb_fixed64(b, 3, load64(e + 16)); }
            var sid = load64(e + 8);
            if (sid != 0) { _stik_pb_bytes(b, 4, sid, 8); }
            var tid = load64(e);
            if (tid != 0) { _stik_pb_bytes(b, 5, tid, 16); }
            if (as_int == 1) { _stik_pb_fixed64(b, 6, load64(e + 16)); }
            _stik_otlp_attributes(b, 7, load64(e + 32), path, 0);
