var TRACE_FLAG_SAMPLED = 1;
# New random trace id: 16 bytes from agent_id_new, so random apart from the
# RFC 4122 v4 version and variant bits that it sets. Compare with trace_id_eq.
fn trace_id_new() { return agent_id_new(); }
# Trace id as 32 lowercase hex chars, its 16 bytes in memory order, no dashes.
# trace_id_from_str is the inverse.
fn trace_id_to_str(id): Str {
    # 32 hex chars (no dashes)
    var buf = alloc(33);
    var i = 0;
    while (i < 16) {
        _stik_hex_byte(buf, i * 2, load8(id + i));
        i = i + 1;
    }
    store8(buf + 32, 0);
    return str_new(buf, 32);
}
# Parse exactly 32 hex digits (either case) into a new 16-byte trace id.
# Returns Ok(id), or an invalid-argument Err on a wrong length or a non-hex
# digit. An all-zero id is accepted here; tctx_from_traceparent rejects it.
fn trace_id_from_str(s: Str) {
    var data = s.data;
    var slen = s.len;
    if (slen != 32) { return stik_err_invalid_argument(str_from("expected 32 hex digits")); }
    var id = alloc(16);
    var i = 0;
    while (i < 16) {
        var hi = _stik_hex_nibble(load8(data + i * 2));
        var lo = _stik_hex_nibble(load8(data + i * 2 + 1));
        if (hi < 0) { return stik_err_invalid_argument(str_from("invalid hex in trace id")); }
        if (lo < 0) { return stik_err_invalid_argument(str_from("invalid hex in trace id")); }
        store8(id + i, hi << 4 | lo);
        i = i + 1;
    }
    return Ok(id);
}
# 1 when the two 16-byte trace ids hold the same bytes, else 0.
fn trace_id_eq(a, b) { return agent_id_eq(a, b); }
# New random span id: 8 bytes from the OS random source (_stik_fill_random).
fn span_id_new() {
    var id = alloc(8);
    _stik_fill_random(id, 8);
    return id;
}
# Span id as 16 lowercase hex chars: the 8 bytes in memory order, as
# trace_id_to_str does for the trace id. That is the W3C traceparent span-id
# field, and the same bytes Span_to_otlp_proto emits as the OTLP span_id.
# span_id_from_str is the inverse.
fn span_id_to_str(id): Str {
    # 16 hex chars
    var buf = alloc(17);
    var i = 0;
    while (i < 8) {
        _stik_hex_byte(buf, i * 2, load8(id + i));
        i = i + 1;
    }
    store8(buf + 16, 0);
    return str_new(buf, 16);
}
# Parse exactly 16 hex digits (either case) into a new 8-byte span id, byte i
# from hex digits 2i and 2i+1 (the order span_id_to_str prints). Returns Ok(id),
# or an invalid-argument Err on a wrong length or a non-hex digit.
fn span_id_from_str(s: Str) {
    var data = s.data;
    var slen = s.len;
    if (slen != 16) { return stik_err_invalid_argument(str_from("expected 16 hex digits")); }
    var id = alloc(8);
    var i = 0;
    while (i < 8) {
        var hi = _stik_hex_nibble(load8(data + i * 2));
        var lo = _stik_hex_nibble(load8(data + i * 2 + 1));
        if (hi < 0) { return stik_err_invalid_argument(str_from("invalid hex in span id")); }
        if (lo < 0) { return stik_err_invalid_argument(str_from("invalid hex in span id")); }
        store8(id + i, hi << 4 | lo);
        i = i + 1;
    }
    return Ok(id);
}
# 1 when the two 8-byte span ids hold the same bytes, else 0.
fn span_id_eq(a, b) {
    if (load64(a) == load64(b)) { return 1; }
    return 0;
}
enum SpanStatus {
    SPAN_UNSET;
    SPAN_OK;
    SPAN_ERROR;
}
# SpanStatus display name: "Unset", "Ok" or "Error", and "Unknown" for a value
# outside the enum. span_status_parse is the inverse.
fn span_status_name(s) {
    if (s == SPAN_UNSET)       { return "Unset"; }
    elif (s == SPAN_OK)        { return "Ok"; }
    elif (s == SPAN_ERROR)     { return "Error"; }
    return "Unknown";
}
# Inverse of span_status_name. Exact match on what span_status_name emits; an
# unrecognised string is an error rather than a silent default, so
# span_status_parse(span_status_name(v)) == v holds for every SpanStatus member.
fn span_status_parse(s: Str) {
    if (str_eq_cstr(s, "Unset") == 1) { return Ok(SPAN_UNSET); }
    elif (str_eq_cstr(s, "Ok") == 1) { return Ok(SPAN_OK); }
    elif (str_eq_cstr(s, "Error") == 1) { return Ok(SPAN_ERROR); }
    return stik_err_invalid_argument(str_from("unknown SpanStatus name"));
}
# An error status with a description: a tagged box with tag SPAN_ERROR and
# `message` as payload, read with boxed_tag / boxed_payload. It is not a bare
# SpanStatus: a span's status slot (span_set_status, Span_to_otlp_proto) holds
# the plain enum value.
fn span_status_error(message: Str) {
    return tagged_new(SPAN_ERROR, message);
}
enum SpanKind {
    SPAN_INTERNAL;
    SPAN_SERVER;
    SPAN_CLIENT;
    SPAN_PRODUCER;
    SPAN_CONSUMER;
}
# SpanKind display name: "Internal", "Server", "Client", "Producer" or
# "Consumer", and "Unknown" for a value outside the enum. span_kind_parse is
# the inverse.
fn span_kind_name(k) {
    if (k == SPAN_INTERNAL)      { return "Internal"; }
    elif (k == SPAN_SERVER)      { return "Server"; }
    elif (k == SPAN_CLIENT)      { return "Client"; }
    elif (k == SPAN_PRODUCER)    { return "Producer"; }
    elif (k == SPAN_CONSUMER)    { return "Consumer"; }
    return "Unknown";
}
# Inverse of span_kind_name. Exact match on what span_kind_name emits; an
# unrecognised string is an error rather than a silent default, so
# span_kind_parse(span_kind_name(v)) == v holds for every SpanKind member.
fn span_kind_parse(s: Str) {
    if (str_eq_cstr(s, "Internal") == 1) { return Ok(SPAN_INTERNAL); }
    elif (str_eq_cstr(s, "Server") == 1) { return Ok(SPAN_SERVER); }
    elif (str_eq_cstr(s, "Client") == 1) { return Ok(SPAN_CLIENT); }
    elif (str_eq_cstr(s, "Producer") == 1) { return Ok(SPAN_PRODUCER); }
    elif (str_eq_cstr(s, "Consumer") == 1) { return Ok(SPAN_CONSUMER); }
    return stik_err_invalid_argument(str_from("unknown SpanKind name"));
}
enum EventType {
    EVT_AGENT_STARTED;
    EVT_AGENT_STOPPED;
    EVT_AGENT_FAILED;
    EVT_INFERENCE_COMPLETE;
    EVT_AUDIT_EVENT;
    EVT_SECURITY_ALERT;
    EVT_CUSTOM;
}
enum MetricKind {
    METRIC_COUNTER;
    METRIC_UP_DOWN_COUNTER;
    METRIC_GAUGE;
    METRIC_HISTOGRAM;
}
enum AggregationTemporality {
    TEMPORALITY_CUMULATIVE;
    TEMPORALITY_DELTA;
}
enum LogSeverity {
    LOG_TRACE = 1;
    LOG_DEBUG = 5;
    LOG_INFO = 9;
    LOG_WARN = 13;
    LOG_ERROR = 17;
    LOG_FATAL = 21;
}
# LogSeverity display name: "TRACE", "DEBUG", "INFO", "WARN", "ERROR" or
# "FATAL". Only the six exact member values (1, 5, 9 … 21) are named; any other
# value, including one between two members, is "UNKNOWN".
# log_severity_parse is the inverse.
fn log_severity_name(s) {
    if (s == LOG_TRACE) { return "TRACE"; }
    elif (s == LOG_DEBUG) { return "DEBUG"; }
    elif (s == LOG_INFO)  { return "INFO"; }
    elif (s == LOG_WARN)  { return "WARN"; }
    elif (s == LOG_ERROR) { return "ERROR"; }
    elif (s == LOG_FATAL) { return "FATAL"; }
    return "UNKNOWN";
}
# Inverse of log_severity_name. Exact match on what log_severity_name emits; an
# unrecognised string is an error rather than a silent default, so
# log_severity_parse(log_severity_name(v)) == v holds for every LogSeverity member.
fn log_severity_parse(s: Str) {
    if (str_eq_cstr(s, "TRACE") == 1) { return Ok(LOG_TRACE); }
    elif (str_eq_cstr(s, "DEBUG") == 1) { return Ok(LOG_DEBUG); }
    elif (str_eq_cstr(s, "INFO") == 1) { return Ok(LOG_INFO); }
    elif (str_eq_cstr(s, "WARN") == 1) { return Ok(LOG_WARN); }
    elif (str_eq_cstr(s, "ERROR") == 1) { return Ok(LOG_ERROR); }
    elif (str_eq_cstr(s, "FATAL") == 1) { return Ok(LOG_FATAL); }
    return stik_err_invalid_argument(str_from("unknown LogSeverity name"));
}
# EventType display name: "AgentStarted", "AgentStopped", "AgentFailed" …
# "Custom", and "Unknown" for a value outside the enum. event_type_parse is
# the inverse.
fn event_type_name(t) {
    if (t == EVT_AGENT_STARTED)        { return "AgentStarted"; }
    elif (t == EVT_AGENT_STOPPED)      { return "AgentStopped"; }
    elif (t == EVT_AGENT_FAILED)       { return "AgentFailed"; }
    elif (t == EVT_INFERENCE_COMPLETE) { return "InferenceComplete"; }
    elif (t == EVT_AUDIT_EVENT)        { return "AuditEvent"; }
    elif (t == EVT_SECURITY_ALERT)     { return "SecurityAlert"; }
    elif (t == EVT_CUSTOM)             { return "Custom"; }
    return "Unknown";
}
# Parse a EventType display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn event_type_parse(s: Str) {
    if (str_eq_cstr(s, "AgentStarted") == 1) { return Ok(EVT_AGENT_STARTED); }
    elif (str_eq_cstr(s, "AgentStopped") == 1) { return Ok(EVT_AGENT_STOPPED); }
    elif (str_eq_cstr(s, "AgentFailed") == 1) { return Ok(EVT_AGENT_FAILED); }
    elif (str_eq_cstr(s, "InferenceComplete") == 1) { return Ok(EVT_INFERENCE_COMPLETE); }
    elif (str_eq_cstr(s, "AuditEvent") == 1) { return Ok(EVT_AUDIT_EVENT); }
    elif (str_eq_cstr(s, "SecurityAlert") == 1) { return Ok(EVT_SECURITY_ALERT); }
    elif (str_eq_cstr(s, "Custom") == 1) { return Ok(EVT_CUSTOM); }
    return stik_err_invalid_argument(str_from("unknown EventType name"));
}
# MetricKind display name: "Counter", "UpDownCounter", "Gauge" or "Histogram",
# and "Unknown" for a value outside the enum. metric_kind_parse is the
# inverse. Spelling: the OpenTelemetry instrument names.
fn metric_kind_name(k) {
    if (k == METRIC_COUNTER)           { return "Counter"; }
    elif (k == METRIC_UP_DOWN_COUNTER) { return "UpDownCounter"; }
    elif (k == METRIC_GAUGE)           { return "Gauge"; }
    elif (k == METRIC_HISTOGRAM)       { return "Histogram"; }
    return "Unknown";
}
# Parse a MetricKind display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn metric_kind_parse(s: Str) {
    if (str_eq_cstr(s, "Counter") == 1) { return Ok(METRIC_COUNTER); }
    elif (str_eq_cstr(s, "UpDownCounter") == 1) { return Ok(METRIC_UP_DOWN_COUNTER); }
    elif (str_eq_cstr(s, "Gauge") == 1) { return Ok(METRIC_GAUGE); }
    elif (str_eq_cstr(s, "Histogram") == 1) { return Ok(METRIC_HISTOGRAM); }
    return stik_err_invalid_argument(str_from("unknown MetricKind name"));
}
# AggregationTemporality display name: "Cumulative" or "Delta", and "Unknown"
# for a value outside the enum. aggregation_temporality_parse is the inverse.
# Spelling: the OpenTelemetry names. The values are agnostik ordinals, not
# OTLP's (OTLP has DELTA = 1, CUMULATIVE = 2): an encoder must map them.
fn aggregation_temporality_name(t) {
    if (t == TEMPORALITY_CUMULATIVE)   { return "Cumulative"; }
    elif (t == TEMPORALITY_DELTA)      { return "Delta"; }
    return "Unknown";
}
# Parse a AggregationTemporality display name: exact, case-sensitive match.
# Returns Ok(member), or an invalid-argument Err for any other string.
fn aggregation_temporality_parse(s: Str) {
    if (str_eq_cstr(s, "Cumulative") == 1) { return Ok(TEMPORALITY_CUMULATIVE); }
    elif (str_eq_cstr(s, "Delta") == 1) { return Ok(TEMPORALITY_DELTA); }
    return stik_err_invalid_argument(str_from("unknown AggregationTemporality name"));
}
# MetricValueType display name: "Int", "Float", "Histogram" or
# "ExponentialHistogram", and "Unknown" for a value outside the enum.
# metric_value_type_parse is the inverse. Spelling: the OpenTelemetry data-
# point names.
fn metric_value_type_name(t) {
    if (t == MV_INT)             { return "Int"; }
    elif (t == MV_FLOAT)         { return "Float"; }
    elif (t == MV_HISTOGRAM)     { return "Histogram"; }
    elif (t == MV_EXP_HISTOGRAM) { return "ExponentialHistogram"; }
    return "Unknown";
}
# Parse a MetricValueType display name: exact, case-sensitive match. Returns
# Ok(member), or an invalid-argument Err for any other string.
fn metric_value_type_parse(s: Str) {
    if (str_eq_cstr(s, "Int") == 1) { return Ok(MV_INT); }
    elif (str_eq_cstr(s, "Float") == 1) { return Ok(MV_FLOAT); }
    elif (str_eq_cstr(s, "Histogram") == 1) { return Ok(MV_HISTOGRAM); }
    elif (str_eq_cstr(s, "ExponentialHistogram") == 1) { return Ok(MV_EXP_HISTOGRAM); }
    return stik_err_invalid_argument(str_from("unknown MetricValueType name"));
}
# A Resource: the entity that produces telemetry. 40 bytes, all 8-byte slots:
#   +0 service name (Str), +8 service version (Str), +16 instance id (Str),
#   +24 attributes (map, created empty), +32 schema URL (0 = unset).
fn resource_new(name: Str, version: Str, instance_id: Str) {
    var r = alloc(40);
    store64(r, name);
    store64(r + 8, version);
    store64(r + 16, instance_id);
    store64(r + 24, map_new());
    store64(r + 32, 0);
    return r;
}
# A Resource whose service name, version and instance id are all empty Strs.
fn resource_default() {
    return resource_new(str_from(""), str_from(""), str_from(""));
}
# Name of the service the resource describes (Str).
fn res_service_name(r)    { return load64(r); }
# Version of that service (Str).
fn res_service_version(r) { return load64(r + 8); }
# Id of this instance of the service (Str).
fn res_instance_id(r)     { return load64(r + 16); }
# Further resource attributes: a cstr-keyed map, created empty by resource_new.
fn res_attributes(r)      { return load64(r + 24); }
# Schema URL; resource_new leaves it 0 (unset).
fn res_schema_url(r)      { return load64(r + 32); }
# A TraceContext for a new root span: the identity a W3C traceparent carries.
# 40 bytes, all 8-byte slots:
#   +0 trace id (fresh 16-byte id), +8 span id (fresh 8-byte id),
#   +16 parent span id (0 = none), +24 trace flags (TRACE_FLAG_SAMPLED),
#   +32 trace state (Str, empty).
fn trace_context_new() {
    var ctx = alloc(40);
    store64(ctx, trace_id_new());
    store64(ctx + 8, span_id_new());
    store64(ctx + 16, 0);
    store64(ctx + 24, TRACE_FLAG_SAMPLED);
    store64(ctx + 32, str_from(""));
    return ctx;
}
# Trace id: pointer to its 16 bytes.
fn tctx_trace_id(c)       { return load64(c); }
# This context's span id: pointer to its 8 bytes.
fn tctx_span_id(c)        { return load64(c + 8); }
# Parent span id (pointer to 8 bytes), or 0 when there is none: trace_context_new
# and tctx_from_traceparent leave it 0, tctx_child sets it.
fn tctx_parent_span_id(c) { return load64(c + 16); }
# Trace flags as an integer; bit 0 is TRACE_FLAG_SAMPLED. tctx_to_traceparent
# writes only the low byte.
fn tctx_trace_flags(c)    { return load64(c + 24); }
# Trace state (Str). The constructors set it empty and tctx_child copies the
# parent's; the traceparent functions do not carry it.
fn tctx_trace_state(c)    { return load64(c + 32); }
# 1 when the TRACE_FLAG_SAMPLED bit of the trace flags is set, else 0.
fn tctx_is_sampled(c) {
    if ((load64(c + 24) & TRACE_FLAG_SAMPLED) != 0) { return 1; }
    return 0;
}
# A new 40-byte TraceContext for a child span: the parent's trace id, a fresh
# span id, the parent's span id as its parent span id, and the parent's flags
# and trace state. The id pointers are shared with the parent, not copied.
fn tctx_child(parent) {
    var child = alloc(40);
    store64(child, load64(parent));          # same trace_id
    store64(child + 8, span_id_new());       # new span_id
    store64(child + 16, load64(parent + 8)); # parent's span_id
    store64(child + 24, load64(parent + 24)); # propagate flags
    store64(child + 32, load64(parent + 32)); # propagate state
    return child;
}
# The context as a W3C traceparent header value, version 00:
# "00-<32 hex trace id>-<16 hex span id>-<2 hex flags>", 55 lowercase chars.
# Only the low byte of the flags is written; trace state is not included.
fn tctx_to_traceparent(c): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "00-");
    str_builder_add(sb, trace_id_to_str(tctx_trace_id(c)));
    str_builder_putc(sb, '-');
    str_builder_add(sb, span_id_to_str(tctx_span_id(c)));
    str_builder_putc(sb, '-');
    var flags = tctx_trace_flags(c);
    var fbuf = alloc(3);
    _stik_hex_byte(fbuf, 0, flags & 0xFF);
    store8(fbuf + 2, 0);
    str_builder_add(sb, str_new(fbuf, 2));
    return str_builder_build(sb);
}
# True when all `len` bytes at `p` are zero. Used to reject the all-zero
# trace-id / parent-id that W3C Trace Context declares invalid (F-015).
fn _stik_all_zero_bytes(p, len) {
    var i = 0;
    var nz = 0;
    while (i < len) {
        if (load8(p + i) != 0) { nz = 1; i = len; continue; }
        i = i + 1;
    }
    if (nz == 1) { return 0; }
    return 1;
}
# Parse a W3C traceparent header value into a new TraceContext. Requires exactly
# 55 chars, dashes at offsets 2, 35 and 52, lowercase hex everywhere else, a
# version other than ff (versions above 00 are accepted), and a trace id and
# parent id that are not all zero. Returns Ok(ctx), or an invalid-argument Err
# naming the failed check. The header's parent id becomes the context's span
# id; parent span id is 0 and trace state is empty.
fn tctx_from_traceparent(s: Str) {
    # Format: "VV-TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT-SSSSSSSSSSSSSSSS-FF"
    # Total: 55 chars
    var data = s.data;
    var slen = s.len;
    if (slen != 55) { return stik_err_invalid_argument(str_from("traceparent must be 55 chars")); }
    if (load8(data + 2) != 45) { return stik_err_invalid_argument(str_from("invalid traceparent format")); }
    if (load8(data + 35) != 45) { return stik_err_invalid_argument(str_from("invalid traceparent format")); }
    if (load8(data + 52) != 45) { return stik_err_invalid_argument(str_from("invalid traceparent format")); }
    # F-017 (audit 2026-08-24): W3C Trace Context requires the whole
    # header to be LOWERCASE hex; uppercase makes the traceparent
    # invalid and it must be ignored. The shared `_stik_hex_nibble` also
    # serves JSON's four-hex-digit `\u` escapes, where RFC 8259 permits
    # either case, so the case rule is enforced here on the W3C-governed
    # path instead of tightening the shared helper. Covers version, trace-id, parent-id
    # and flags — every hex position in the header.
    var ci = 0;
    while (ci < 55) {
        if (ci == 2) { ci = 3; continue; }
        if (ci == 35) { ci = 36; continue; }
        if (ci == 52) { ci = 53; continue; }
        var ch = load8(data + ci);
        if (ch >= 65 && ch <= 70) {
            return stik_err_invalid_argument(str_from("traceparent must be lowercase hex"));
        }
        ci = ci + 1;
    }
    # F-016 (audit 2026-08-24): the 2-char version field was never
    # validated — non-hex versions parsed, and version "ff" (which the
    # spec forbids) was accepted. Reject both. A version above 00 that is
    # still valid hex is accepted: the spec requires forward
    # compatibility for the fields this implementation understands.
    var vhi = _stik_hex_nibble(load8(data));
    var vlo = _stik_hex_nibble(load8(data + 1));
    if (vhi < 0) { return stik_err_invalid_argument(str_from("invalid hex in traceparent version")); }
    if (vlo < 0) { return stik_err_invalid_argument(str_from("invalid hex in traceparent version")); }
    if (vhi == 15 && vlo == 15) {
        return stik_err_invalid_argument(str_from("traceparent version ff is forbidden"));
    }
    # Parse trace_id (32 hex chars at offset 3)
    var tid = trace_id_from_str(str_new(data + 3, 32))?;
    # Parse span_id (16 hex chars at offset 36)
    var sid = span_id_from_str(str_new(data + 36, 16))?;
    # F-015 (audit 2026-08-24): an all-zero trace-id and an all-zero
    # parent-id are both invalid per spec and must be rejected. These
    # parsed cleanly before, so an invalid context propagated downstream.
    if (_stik_all_zero_bytes(tid, 16) == 1) {
        return stik_err_invalid_argument(str_from("traceparent trace-id must not be all zero"));
    }
    if (_stik_all_zero_bytes(sid, 8) == 1) {
        return stik_err_invalid_argument(str_from("traceparent parent-id must not be all zero"));
    }
    # Parse flags (2 hex chars at offset 53)
    var fhi = _stik_hex_nibble(load8(data + 53));
    var flo = _stik_hex_nibble(load8(data + 54));
    if (fhi < 0) { return stik_err_invalid_argument(str_from("invalid hex in traceparent flags")); }
    if (flo < 0) { return stik_err_invalid_argument(str_from("invalid hex in traceparent flags")); }
    var flags = fhi << 4 | flo;
    var ctx = alloc(40);
    store64(ctx, tid);
    store64(ctx + 8, sid);
    store64(ctx + 16, 0);
    store64(ctx + 24, flags);
    store64(ctx + 32, str_from(""));
    return Ok(ctx);
}
# A Span: one timed operation within a trace. 112 bytes, all 8-byte slots:
#   +0 name (Str), +8 trace id, +16 span id, +24 parent span id (0 = none),
#   +32 status (SpanStatus, SPAN_UNSET), +40 kind (SpanKind, SPAN_INTERNAL),
#   +48 start time (clock_epoch_ns at creation), +56 duration in ms (0),
#   +64 attributes (map), +72 events (vec), +80 links (vec), all created empty,
#   +88 / +96 / +104 dropped attribute / event / link counts (0).
# The id pointers are stored as given, not copied. The start time is
# clock_epoch_ns(), Unix time in nanoseconds, which OTLP's start_time_unix_nano
# requires.
fn span_new(name: Str, trace_id, span_id) {
    var s = alloc(112);
    store64(s, name);
    store64(s + 8, trace_id);
    store64(s + 16, span_id);
    store64(s + 24, 0);
    store64(s + 32, SPAN_UNSET);
    store64(s + 40, SPAN_INTERNAL);
    store64(s + 48, clock_epoch_ns());
    store64(s + 56, 0);
    store64(s + 64, map_new());
    store64(s + 72, vec_new());
    store64(s + 80, vec_new());
    store64(s + 88, 0);
    store64(s + 96, 0);
    store64(s + 104, 0);
    return s;
}
# Operation name (Str).
fn span_name(s)           { return load64(s); }
# Id of the trace the span belongs to: pointer to its 16 bytes.
fn span_trace_id(s)       { return load64(s + 8); }
# The span's own id: pointer to its 8 bytes.
fn span_span_id(s)        { return load64(s + 16); }
# Parent span id (pointer to 8 bytes), or 0 for a span with no parent.
fn span_parent_id(s)      { return load64(s + 24); }
# Status: a SpanStatus value, SPAN_UNSET until span_set_status.
fn span_status(s)         { return load64(s + 32); }
# Kind: a SpanKind value, SPAN_INTERNAL until span_set_kind.
fn span_kind(s)           { return load64(s + 40); }
# Start time, Unix ns from clock_epoch_ns, taken in span_new.
fn span_started_at(s)     { return load64(s + 48); }
# Duration in milliseconds; 0 until span_set_duration_ms.
fn span_duration_ms(s)    { return load64(s + 56); }
# Span attributes: a cstr-keyed map, created empty by span_new. Span_to_otlp_proto
# reads its values as AnyValue boxes (any_string, any_int, ...).
fn span_attributes(s)     { return load64(s + 64); }
# vec of the span's events, created empty by span_new.
fn span_events(s)         { return load64(s + 72); }
# vec of the span's links, created empty by span_new.
fn span_links(s)          { return load64(s + 80); }
# Set the status to a SpanStatus value, stored as given (not validated). Returns 0.
fn span_set_status(s, v)      { store64(s + 32, v); return 0; }
# Set the kind to a SpanKind value, stored as given (not validated). Returns 0.
fn span_set_kind(s, v)        { store64(s + 40, v); return 0; }
# Set the duration in milliseconds; Span_to_otlp_proto derives the end time
# from it. Returns 0.
fn span_set_duration_ms(s, v) { store64(s + 56, v); return 0; }
# Set the parent span id (pointer to an 8-byte span id, or 0 for none). Returns 0.
fn span_set_parent(s, v)      { store64(s + 24, v); return 0; }
# Number of attributes dropped from the span; span_new sets 0.
fn span_dropped_attrs(s)  { return load64(s + 88); }
# Number of events dropped from the span; span_new sets 0.
fn span_dropped_events(s) { return load64(s + 96); }
# Number of links dropped from the span; span_new sets 0.
fn span_dropped_links(s)  { return load64(s + 104); }
# AnyValueType: what an AnyValue box holds. Each value is the field number of
# the matching member of OTLP's AnyValue oneof
# (opentelemetry/proto/common/v1/common.proto), so 0 is never a valid type.
enum AnyValueType {
    ANY_STRING = 1;
    ANY_BOOL = 2;
    ANY_INT = 3;
    ANY_DOUBLE = 4;
    ANY_ARRAY = 5;
    ANY_KVLIST = 6;
    ANY_BYTES = 7;
}
# AnyValueType name: the OTLP/JSON key of the matching AnyValue member,
# "stringValue", "boolValue", "intValue", "doubleValue", "arrayValue",
# "kvlistValue" or "bytesValue", and "Unknown" for a value outside the enum.
# any_value_type_parse is the inverse.
fn any_value_type_name(t) {
    if (t == ANY_STRING)       { return "stringValue"; }
    elif (t == ANY_BOOL)       { return "boolValue"; }
    elif (t == ANY_INT)        { return "intValue"; }
    elif (t == ANY_DOUBLE)     { return "doubleValue"; }
    elif (t == ANY_ARRAY)      { return "arrayValue"; }
    elif (t == ANY_KVLIST)     { return "kvlistValue"; }
    elif (t == ANY_BYTES)      { return "bytesValue"; }
    return "Unknown";
}
# Parse an AnyValueType name: exact, case-sensitive match on the OTLP/JSON
# key. Returns Ok(member), or an invalid-argument Err for any other string.
fn any_value_type_parse(s: Str) {
    if (str_eq_cstr(s, "stringValue") == 1) { return Ok(ANY_STRING); }
    elif (str_eq_cstr(s, "boolValue") == 1) { return Ok(ANY_BOOL); }
    elif (str_eq_cstr(s, "intValue") == 1) { return Ok(ANY_INT); }
    elif (str_eq_cstr(s, "doubleValue") == 1) { return Ok(ANY_DOUBLE); }
    elif (str_eq_cstr(s, "arrayValue") == 1) { return Ok(ANY_ARRAY); }
    elif (str_eq_cstr(s, "kvlistValue") == 1) { return Ok(ANY_KVLIST); }
    elif (str_eq_cstr(s, "bytesValue") == 1) { return Ok(ANY_BYTES); }
    return stik_err_invalid_argument(str_from("unknown AnyValueType name"));
}
# An AnyValue holding a string: a tagged box with tag ANY_STRING and the Str
# `s` as payload, stored as given (0 encodes as the empty string). Attribute
# maps exported to OTLP hold AnyValue boxes as their values.
fn any_string(s: Str) { return tagged_new(ANY_STRING, s); }
# An AnyValue holding a bool: tag ANY_BOOL, payload 1 when `b` is non-zero,
# else 0.
fn any_bool(b) {
    if (b != 0) { return tagged_new(ANY_BOOL, 1); }
    return tagged_new(ANY_BOOL, 0);
}
# An AnyValue holding a signed 64-bit integer: tag ANY_INT, payload `n`.
fn any_int(n) { return tagged_new(ANY_INT, n); }
# An AnyValue holding a double: tag ANY_DOUBLE, payload the raw 8-byte
# IEEE-754 bits given (no conversion, as metric_float).
fn any_double(bits) { return tagged_new(ANY_DOUBLE, bits); }
# An AnyValue holding an array: tag ANY_ARRAY, payload a vec of AnyValue boxes,
# stored as given (0 encodes as an empty array).
fn any_array(values) { return tagged_new(ANY_ARRAY, values); }
# An AnyValue holding a key/value list: tag ANY_KVLIST, payload a map (cstr- or
# Str-keyed) whose values are AnyValue boxes, stored as given (0 encodes as an
# empty list).
fn any_kvlist(m) { return tagged_new(ANY_KVLIST, m); }
# An AnyValue holding raw bytes: tag ANY_BYTES, payload a Str whose bytes are
# the value, stored as given (0 encodes as no bytes).
fn any_bytes(b: Str) { return tagged_new(ANY_BYTES, b); }
# AnyValueType tag of an AnyValue box.
fn any_value_type(v) { return boxed_tag(v); }
# Payload of an AnyValue box: the Str, flag, integer, bits, vec or map it holds.
fn any_value_val(v)  { return boxed_payload(v); }
# Compare two NUL-terminated keys byte by byte as unsigned values; returns <0,
# 0 or >0. vec_sort_by comparator for cstr-keyed attribute maps.
fn _stik_cstr_cmp(a, b) {
    var i = 0;
    var r = 0;
    var done = 0;
    while (done == 0) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) {
            r = ca - cb;
            done = 1;
        } elif (ca == 0) {
            done = 1;
        }
        i = i + 1;
    }
    return r;
}
# Compare two Str keys byte by byte as unsigned values, a proper prefix first;
# returns <0, 0 or >0. vec_sort_by comparator for Str-keyed attribute maps.
fn _stik_str_key_cmp(a, b) {
    var la = str_len(a);
    var lb = str_len(b);
    var da = str_data(a);
    var db = str_data(b);
    var n = la;
    if (lb < n) { n = lb; }
    var i = 0;
    var r = 0;
    while (i < n) {
        if (r == 0) { r = load8(da + i) - load8(db + i); }
        i = i + 1;
    }
    if (r == 0) { r = la - lb; }
    return r;
}
# 1 when `m` is a Str-keyed map (map_new_str), 0 when cstr-keyed (map_new).
# Reads the stdlib map header's key-type word at +24, which has no accessor;
# test_v1100_otlp pins both key types, so a layout change fails a test.
fn _stik_map_str_keys(m) {
    if (load64(m + 24) == KeyTypeStr) { return 1; }
    return 0;
}
# Append the AnyValue oneof member for box `v` to protobuf buffer `b`: the
# body of an OTLP AnyValue message, without the message's own tag. A member is
# written even when it holds its zero value, as oneof presence requires. A 0
# box, an unknown type, a box nested 16 levels deep, or a box that already
# encloses itself (a cycle) writes nothing, which decodes as an empty
# AnyValue. `path` is a 128-byte buffer holding the enclosing boxes, `depth`
# how many it holds.
fn _stik_otlp_any_value(b, v, path, depth) {
    if (v == 0) { return 0; }
    if (depth >= 16) { return 0; }
    var i = 0;
    var cyc = 0;
    while (i < depth) {
        if (load64(path + i * 8) == v) { cyc = 1; }
        i = i + 1;
    }
    if (cyc == 1) { return 0; }
    store64(path + depth * 8, v);
    var t = boxed_tag(v);
    var x = boxed_payload(v);
    if (t == ANY_STRING) {
        if (x == 0) { _stik_pb_bytes(b, 1, 0, 0); }
        else { _stik_pb_string(b, 1, x); }
    } elif (t == ANY_BOOL) {
        _stik_pb_int64(b, 2, x & 1);
    } elif (t == ANY_INT) {
        _stik_pb_int64(b, 3, x);
    } elif (t == ANY_DOUBLE) {
        _stik_pb_fixed64(b, 4, x);
    } elif (t == ANY_ARRAY) {
        var am = _stik_pb_open(b, 5);
        if (x != 0) {
            var n = vec_len(x);
            var j = 0;
            while (j < n) {
                var em = _stik_pb_open(b, 1);
                _stik_otlp_any_value(b, vec_get(x, j), path, depth + 1);
                _stik_pb_close(b, em);
                j = j + 1;
            }
        }
        _stik_pb_close(b, am);
    } elif (t == ANY_KVLIST) {
        var km = _stik_pb_open(b, 6);
        _stik_otlp_attributes(b, 1, x, path, depth + 1);
        _stik_pb_close(b, km);
    } elif (t == ANY_BYTES) {
        if (x == 0) { _stik_pb_bytes(b, 7, 0, 0); }
        else { _stik_pb_bytes(b, 7, str_data(x), str_len(x)); }
    }
    return 0;
}
# Append one KeyValue message per entry of map `m` as field `field_no` of the
# message being written in buffer `b`. Keys are sorted bytewise, so equal
# attributes always encode to equal bytes whatever the insertion order or hash
# seed. The values must be AnyValue boxes. An empty key is omitted, as proto3
# omits an empty string; the value message is always present. A 0 map writes
# nothing.
fn _stik_otlp_attributes(b, field_no, m, path, depth) {
    if (m == 0) { return 0; }
    var n = map_size(m);
    if (n == 0) { return 0; }
    var strk = _stik_map_str_keys(m);
    var keys = map_keys(m);
    if (strk == 1) { vec_sort_by(keys, &_stik_str_key_cmp); }
    else { vec_sort_by(keys, &_stik_cstr_cmp); }
    var i = 0;
    while (i < n) {
        var k = vec_get(keys, i);
        var kp = k;
        var kl = 0;
        if (strk == 1) {
            kp = str_data(k);
            kl = str_len(k);
        } else {
            kl = strlen(k);
        }
        var km = _stik_pb_open(b, field_no);
        if (kl > 0) { _stik_pb_bytes(b, 1, kp, kl); }
        var vm = _stik_pb_open(b, 2);
        _stik_otlp_any_value(b, map_get(m, k), path, depth);
        _stik_pb_close(b, vm);
        _stik_pb_close(b, km);
        i = i + 1;
    }
    return 0;
}
# Append AnyValue box `v` to `sb` as the body of an OTLP AnyValue message
# (common.proto): the one oneof member it holds, with arrays and key/value
# lists nested to 16 levels and cycles cut (see _stik_otlp_any_value). The
# caller wraps the bytes as a message field. Returns 0.
fn AnyValue_to_otlp_proto(v, sb) {
    var b = _stik_pb_new();
    _stik_otlp_any_value(b, v, alloc(128), 0);
    _stik_pb_flush(b, sb);
    return 0;
}
# OTLP wire-format encoder for Span (v1.2.0; attributes, events and links and
# the Status fix since v1.10.0). Writes one opentelemetry.proto.trace.v1.Span
# (trace.proto, opentelemetry-proto v1.7.0), fields in ascending number order
# as canonical encoders do:
#   1 trace_id (16 bytes), 2 span_id (8 bytes)
#   3 trace_state                       not stored, never written
#   4 parent_span_id (8 bytes)          only when set
#   5 name, 7 start_time_unix_nano      always written
#   6 kind                              only when not SPAN_INTERNAL
#   8 end_time_unix_nano                start + duration_ms × 1,000,000
#   9 attributes (KeyValue)             the span's map, keys sorted
#  10 / 12 / 14 dropped counts          only when non-zero
#  11 events (Span.Event)              one per span_event_new in the vec
#  13 links (Span.Link)                one per span_link_new in the vec
#  15 status (Status)                  only for SPAN_OK / SPAN_ERROR
#  16 flags                            not stored, never written
# Attribute values must be AnyValue boxes (any_string, any_int, ...).
#
# SpanKind enum values map agnostik → OTLP:
#   SPAN_INTERNAL=0 → SPAN_KIND_INTERNAL=1
#   SPAN_SERVER=1   → SPAN_KIND_SERVER=2
#   SPAN_CLIENT=2   → SPAN_KIND_CLIENT=3
#   SPAN_PRODUCER=3 → SPAN_KIND_PRODUCER=4
#   SPAN_CONSUMER=4 → SPAN_KIND_CONSUMER=5
fn _stik_span_kind_to_otlp(k) {
    if (k == SPAN_INTERNAL) { return 1; }
    if (k == SPAN_SERVER)   { return 2; }
    if (k == SPAN_CLIENT)   { return 3; }
    if (k == SPAN_PRODUCER) { return 4; }
    if (k == SPAN_CONSUMER) { return 5; }
    return 0;
}
# Append one Span.Event message (time 1, name 2, attributes 3) for span event
# `e` as field 11 of the span in buffer `b`. A zero time and an empty name are
# omitted, as proto3 omits default scalars. Returns 0.
fn _stik_otlp_span_event(b, e, path) {
    var em = _stik_pb_open(b, 11);
    var ts = load64(e + 8);
    if (ts != 0) { _stik_pb_fixed64(b, 1, ts); }
    var nm = load64(e);
    if (nm != 0) {
        if (str_len(nm) > 0) { _stik_pb_string(b, 2, nm); }
    }
    _stik_otlp_attributes(b, 3, load64(e + 16), path, 0);
    _stik_pb_close(b, em);
    return 0;
}
# Append one Span.Link message (trace_id 1, span_id 2, attributes 4) for span
# link `l` as field 13 of the span in buffer `b`. An unset id is omitted.
# Returns 0.
fn _stik_otlp_span_link(b, l, path) {
    var lm = _stik_pb_open(b, 13);
    var tid = load64(l);
    if (tid != 0) { _stik_pb_bytes(b, 1, tid, 16); }
    var sid = load64(l + 8);
    if (sid != 0) { _stik_pb_bytes(b, 2, sid, 8); }
    _stik_otlp_attributes(b, 4, load64(l + 16), path, 0);
    _stik_pb_close(b, lm);
    return 0;
}
# Append span `ptr` to `sb` as an OTLP Span message (field table above).
# SpanStatus values equal OTLP's StatusCode values, and the code is
# Status field 3: through v1.9.0 it was written as field 1, which the schema
# reserves, so collectors read every status as UNSET. A status value outside
# SpanStatus writes no status. Returns 0.
fn Span_to_otlp_proto(ptr, sb) {
    var trace_id = load64(ptr + 8);
    var span_id  = load64(ptr + 16);
    var parent   = load64(ptr + 24);
    var name     = load64(ptr);
    var kind     = load64(ptr + 40);
    var start_ns = load64(ptr + 48);
    var dur_ms   = load64(ptr + 56);
    var b = _stik_pb_new();
    var path = alloc(128);
    # field 1: trace_id (16 raw bytes — agent_id_new returns alloc(16))
    _stik_pb_bytes(b, 1, trace_id, 16);
    # field 2: span_id (8 raw bytes — span_id_new returns alloc(8))
    _stik_pb_bytes(b, 2, span_id, 8);
    # field 4: parent_span_id (only if set)
    if (parent != 0) { _stik_pb_bytes(b, 4, parent, 8); }
    # field 5: name
    _stik_pb_string(b, 5, name);
    # field 6: kind (default SPAN_INTERNAL → 1; emit only if non-default
    # to match canonical OTLP encoders that elide default-value scalars).
    if (kind != SPAN_INTERNAL) { _stik_pb_int64(b, 6, _stik_span_kind_to_otlp(kind)); }
    # field 7: start_time_unix_nano
    _stik_pb_fixed64(b, 7, start_ns);
    # field 8: end_time_unix_nano = start + duration_ms × 1_000_000
    _stik_pb_fixed64(b, 8, start_ns + dur_ms * 1000000);
    # field 9: attributes
    _stik_otlp_attributes(b, 9, load64(ptr + 64), path, 0);
    # field 10: dropped_attributes_count (only if non-zero)
    var da = load64(ptr + 88);
    if (da != 0) { _stik_pb_int64(b, 10, da); }
    # field 11: events
    var evs = load64(ptr + 72);
    if (evs != 0) {
        var ne = vec_len(evs);
        var i = 0;
        while (i < ne) {
            var e = vec_get(evs, i);
            if (e != 0) { _stik_otlp_span_event(b, e, path); }
            i = i + 1;
        }
    }
    # field 12: dropped_events_count
    var de = load64(ptr + 96);
    if (de != 0) { _stik_pb_int64(b, 12, de); }
    # field 13: links
    var lks = load64(ptr + 80);
    if (lks != 0) {
        var nl = vec_len(lks);
        var j = 0;
        while (j < nl) {
            var l = vec_get(lks, j);
            if (l != 0) { _stik_otlp_span_link(b, l, path); }
            j = j + 1;
        }
    }
    # field 14: dropped_links_count
    var dl = load64(ptr + 104);
    if (dl != 0) { _stik_pb_int64(b, 14, dl); }
    # field 15: status — Status.code is field 3 (field 1 is reserved)
    var status = load64(ptr + 32);
    var code = 0;
    if (status == SPAN_OK) { code = 1; }
    if (status == SPAN_ERROR) { code = 2; }
    if (code != 0) {
        var sm = _stik_pb_open(b, 15);
        _stik_pb_int64(b, 3, code);
        _stik_pb_close(b, sm);
    }
    _stik_pb_flush(b, sb);
    return 0;
}
struct TelemetryConfig { enabled; sample_rate; export_endpoint; }
# Append the config to `sb` as compact JSON,
# {"enabled":N,"sample_rate":N,"export_endpoint":"..."}, with null for a 0
# endpoint. The endpoint is JSON-escaped (since 1.9.0). Returns 0.
fn TelemetryConfig_to_json(ptr, sb) {
    # ADR-002: compact byte format for library uniformity. The Str
    # field with null-for-0 handling prevents derive adoption (cyrius
    # 5.10.14 derive on `: Str` field with value 0 → SIGSEGV via
    # str_data(0)). Hand-written stays.
    str_builder_add_cstr(sb, "{\"enabled\":");
    str_builder_add_int(sb, load64(ptr));
    str_builder_add_cstr(sb, ",\"sample_rate\":");
    str_builder_add_int(sb, load64(ptr + 8));
    str_builder_add_cstr(sb, ",\"export_endpoint\":");
    var ep = load64(ptr + 16);
    if (ep != 0) {
        # Escaped: a quote, backslash or control character in the endpoint
        # must not end the string or inject keys.
        str_builder_add_json_str(sb, ep);
    } else {
        str_builder_add_cstr(sb, "null");
    }
    str_builder_putc(sb, '}');
    return 0;
}
# Build a new TelemetryConfig from JSON text. A missing or non-numeric integer
# key reads 0, not telemetry_config_new's default, so a missing "enabled" means
# disabled; export_endpoint is 0 when missing, null or not a string. Never
# fails: returns the config pointer, not a Result.
fn TelemetryConfig_from_json(src: Str) {
    var c = alloc(24);
    store64(c, _stik_json_int(src, str_from("enabled")));
    store64(c + 8, _stik_json_int(src, str_from("sample_rate")));
    store64(c + 16, _stik_json_str(src, str_from("export_endpoint")));
    return c;
}
# A TelemetryConfig with defaults. 24 bytes, all 8-byte slots:
#   +0 enabled (1), +8 sample rate (1000, a rate of 1.0 in thousandths),
#   +16 export endpoint (Str, 0 = none).
fn telemetry_config_new() {
    var c = alloc(24);
    store64(c, 1);       # enabled = true
    store64(c + 8, 1000); # sample_rate = 1.0
    store64(c + 16, 0);
    return c;
}
# Enabled flag: 1 when telemetry is enabled, 0 when disabled.
fn telcfg_enabled(c)    { return load64(c); }
# Sampling rate in thousandths: 1000 is a rate of 1.0, the default.
fn telcfg_sample_rate(c){ return load64(c + 8); }
# Export endpoint (Str), or 0 when none is configured.
fn telcfg_endpoint(c)   { return load64(c + 16); }
# A LogRecord. 64 bytes, all 8-byte slots:
#   +0 timestamp (clock_epoch_ns at creation), +8 0 (no accessor reads it),
#   +16 severity (LogSeverity, stored as given), +24 body (Str),
#   +32 attributes (map, created empty), +40 trace id, +48 span id,
#   +56 resource; the last three are 0 until set.
fn log_record_new(severity, body: Str) {
    var lr = alloc(64);
    store64(lr, clock_epoch_ns());
    store64(lr + 8, 0);
    store64(lr + 16, severity);
    store64(lr + 24, body);
    store64(lr + 32, map_new());
    store64(lr + 40, 0);
    store64(lr + 48, 0);
    store64(lr + 56, 0);
    return lr;
}
# Creation time, Unix ns from clock_epoch_ns.
fn logrec_timestamp(lr)  { return load64(lr); }
# Severity: a LogSeverity value.
fn logrec_severity(lr)   { return load64(lr + 16); }
# Message body (Str).
fn logrec_body(lr)       { return load64(lr + 24); }
# Record attributes: a cstr-keyed map, created empty by log_record_new; values are
# AnyValue boxes for OTLP export.
fn logrec_attributes(lr) { return load64(lr + 32); }
# Id of the trace the record belongs to (pointer to 16 bytes), or 0 when unset.
fn logrec_trace_id(lr)   { return load64(lr + 40); }
# Id of the span the record belongs to (pointer to 8 bytes), or 0 when unset.
fn logrec_span_id(lr)    { return load64(lr + 48); }
# Resource that produced the record (see resource_new), or 0 when unset.
fn logrec_resource(lr)   { return load64(lr + 56); }
# Set the trace id (pointer to a 16-byte trace id, or 0). Returns 0.
fn logrec_set_trace_id(lr, v) { store64(lr + 40, v); return 0; }
# Set the span id (pointer to an 8-byte span id, or 0). Returns 0.
fn logrec_set_span_id(lr, v)  { store64(lr + 48, v); return 0; }
# Set the resource (a resource_new pointer, or 0). Returns 0.
fn logrec_set_resource(lr, v) { store64(lr + 56, v); return 0; }
# Append log record `ptr` to `sb` as an OTLP LogRecord message
# (opentelemetry.proto.logs.v1.LogRecord, logs.proto), fields in ascending
# number order, defaults omitted as proto3 omits them:
#   1 time_unix_nano       the record's timestamp, when non-zero
#   2 severity_number      the LogSeverity value, when it is 1..24
#                          (LogSeverity values are OTLP SeverityNumber values)
#   3 severity_text        log_severity_name, for the six named severities
#   5 body                 AnyValue string_value holding the body Str
#   6 attributes           the record's map, keys sorted; AnyValue values
#   9 / 10 trace_id / span_id   when set (16 / 8 bytes)
# observed_time_unix_nano, dropped_attributes_count, flags and event_name are
# not stored and not written. The resource belongs to the enclosing
# ResourceLogs message, not to the record. Returns 0.
fn LogRecord_to_otlp_proto(ptr, sb) {
    var b = _stik_pb_new();
    var ts = load64(ptr);
    if (ts != 0) { _stik_pb_fixed64(b, 1, ts); }
    var sev = load64(ptr + 16);
    if (sev >= 1) {
        if (sev <= 24) { _stik_pb_int64(b, 2, sev); }
    }
    var named = 0;
    if (sev == LOG_TRACE) { named = 1; }
    if (sev == LOG_DEBUG) { named = 1; }
    if (sev == LOG_INFO) { named = 1; }
    if (sev == LOG_WARN) { named = 1; }
    if (sev == LOG_ERROR) { named = 1; }
    if (sev == LOG_FATAL) { named = 1; }
    if (named == 1) {
        var sn = log_severity_name(sev);
        _stik_pb_bytes(b, 3, sn, strlen(sn));
    }
    var body = load64(ptr + 24);
    if (body != 0) {
        # body: an AnyValue holding string_value (field 1), written directly
        var bm = _stik_pb_open(b, 5);
        _stik_pb_string(b, 1, body);
        _stik_pb_close(b, bm);
    }
    _stik_otlp_attributes(b, 6, load64(ptr + 32), alloc(128), 0);
    var tid = load64(ptr + 40);
    if (tid != 0) { _stik_pb_bytes(b, 9, tid, 16); }
    var sid = load64(ptr + 48);
    if (sid != 0) { _stik_pb_bytes(b, 10, sid, 8); }
    _stik_pb_flush(b, sb);
    return 0;
}
# A CrashReport. 32 bytes, all 8-byte slots:
#   +0 agent id (AgentId pointer, stored as given), +8 error message (Str),
#   +16 backtrace (0), +24 timestamp (clock_epoch_ns at creation).
fn crash_report_new(agent_id, error_msg: Str) {
    var cr = alloc(32);
    store64(cr, agent_id);
    store64(cr + 8, error_msg);
    store64(cr + 16, 0);
    store64(cr + 24, clock_epoch_ns());
    return cr;
}
# Id of the agent that crashed (AgentId pointer).
fn crash_agent_id(cr)  { return load64(cr); }
# Error message describing the crash (Str).
fn crash_error(cr)     { return load64(cr + 8); }
# Backtrace slot. crash_report_new sets it to 0 and no fn in this module sets
# it, so the code does not fix its form.
fn crash_backtrace(cr) { return load64(cr + 16); }
# Time the report was created, Unix ns from clock_epoch_ns.
fn crash_timestamp(cr) { return load64(cr + 24); }
# An InstrumentationScope: the instrumenting library or component that emits
# telemetry. 32 bytes, all 8-byte slots:
#   +0 name (Str), +8 version (Str), +16 schema URL (0 = unset),
#   +24 attributes (map, created on first access).
fn instrumentation_scope_new(scope_name: Str, scope_version: Str) {
    var s = alloc(32);
    store64(s, scope_name);
    store64(s + 8, scope_version);
    store64(s + 16, 0);
    store64(s + 24, 0);
    return s;
}
# Scope name (Str).
fn iscope_name(s)       { return load64(s); }
# Scope version (Str).
fn iscope_version(s)    { return load64(s + 8); }
# Schema URL; instrumentation_scope_new leaves it 0 (unset).
fn iscope_schema_url(s) { return load64(s + 16); }
# Scope attributes: a cstr-keyed map, created empty on first access.
fn iscope_attributes(s) { return _stik_lazy_map(s + 24); }
# A SpanEvent: a named, timestamped event within a span. 24 bytes:
#   +0 name (Str), +8 timestamp (clock_epoch_ns at creation),
#   +16 attributes (map, created on first access).
fn span_event_new(evt_name: Str) {
    var e = alloc(24);
    store64(e, evt_name);
    store64(e + 8, clock_epoch_ns());
    store64(e + 16, 0);
    return e;
}
# Event name (Str).
fn sevt_name(e)       { return load64(e); }
# Event time, Unix ns from clock_epoch_ns.
fn sevt_timestamp(e)  { return load64(e + 8); }
# Event attributes: a cstr-keyed map, created empty on first access; values are
# AnyValue boxes for OTLP export.
fn sevt_attributes(e) { return _stik_lazy_map(e + 16); }
# A SpanLink: a reference from a span to another span, which may be in another
# trace. 24 bytes: +0 trace id, +8 span id (pointers, stored as given),
#   +16 attributes (map, created on first access).
fn span_link_new(link_trace_id, link_span_id) {
    var l = alloc(24);
    store64(l, link_trace_id);
    store64(l + 8, link_span_id);
    store64(l + 16, 0);
    return l;
}
# Trace id of the linked span (pointer to 16 bytes).
fn slink_trace_id(l)   { return load64(l); }
# Span id of the linked span (pointer to 8 bytes).
fn slink_span_id(l)    { return load64(l + 8); }
# Link attributes: a cstr-keyed map, created empty on first access; values are
# AnyValue boxes for OTLP export.
fn slink_attributes(l) { return _stik_lazy_map(l + 16); }
# An Exemplar: a sample measurement tied to the trace and span it was recorded
# in. 40 bytes, all 8-byte slots:
#   +0 trace id, +8 span id (pointers, stored as given), +16 value (as given),
#   +24 timestamp (clock_epoch_ns at creation), +32 attributes (map, created on
#   first access).
fn exemplar_new(ex_trace_id, ex_span_id, value) {
    var e = alloc(40);
    store64(e, ex_trace_id);
    store64(e + 8, ex_span_id);
    store64(e + 16, value);
    store64(e + 24, clock_epoch_ns());
    store64(e + 32, 0);
    return e;
}
# Id of the trace the measurement was recorded in (pointer to 16 bytes).
fn exem_trace_id(e)   { return load64(e); }
# Id of the span the measurement was recorded in (pointer to 8 bytes).
fn exem_span_id(e)    { return load64(e + 8); }
# The measured value: the raw 8-byte value passed to exemplar_new.
fn exem_value(e)      { return load64(e + 16); }
# Time the exemplar was created, Unix ns from clock_epoch_ns.
fn exem_timestamp(e)  { return load64(e + 24); }
# Exemplar attributes: a cstr-keyed map, created empty on first access.
fn exem_attributes(e) { return _stik_lazy_map(e + 32); }
# A Baggage: key/value entries carried alongside a trace context. 8 bytes:
#   +0 entries (map, created on first access).
fn baggage_new() {
    var b = alloc(8);
    store64(b, 0);
    return b;
}
# The baggage entries: a cstr-keyed map, created empty on first access.
fn baggage_entries(b) { return _stik_lazy_map(b); }
# Set entry `key` (a NUL-terminated cstr) to `value`, replacing any existing
# value. The value is stored as given, not copied. Returns 0.
fn baggage_set(b, key, value) {
    map_set(baggage_entries(b), key, value);
    return 0;
}
# Value stored under `key` (a NUL-terminated cstr), or 0 when there is none;
# an absent key and a stored 0 read the same.
fn baggage_get(b, key) {
    return map_get(baggage_entries(b), key);
}
# An InstrumentDescriptor: the identity of a metric instrument. 32 bytes, all
# 8-byte slots: +0 name (Str), +8 description (Str), +16 unit (Str),
#   +24 kind (MetricKind, stored as given).
fn instrument_descriptor_new(inst_name: Str, desc: Str, unit: Str, kind) {
    var d = alloc(32);
    store64(d, inst_name);
    store64(d + 8, desc);
    store64(d + 16, unit);
    store64(d + 24, kind);
    return d;
}
# Instrument name (Str).
fn idesc_name(d) { return load64(d); }
# Description of the instrument (Str).
fn idesc_desc(d) { return load64(d + 8); }
# Unit of the instrument's measurements (Str).
fn idesc_unit(d) { return load64(d + 16); }
# Instrument kind: a MetricKind value.
fn idesc_kind(d) { return load64(d + 24); }
enum MetricValueType { MV_INT; MV_FLOAT; MV_HISTOGRAM; MV_EXP_HISTOGRAM; }
# An integer metric value: a tagged box with tag MV_INT and `val` as payload.
# Read it with metric_value_type / metric_value_val.
fn metric_int(val)   { return tagged_new(MV_INT, val); }
# A float metric value: a tagged box with tag MV_FLOAT and `val` as payload,
# stored as the raw 8-byte value given (no conversion).
fn metric_float(val) { return tagged_new(MV_FLOAT, val); }
# MetricValueType tag of a metric value box (MV_INT or MV_FLOAT from metric_int / metric_float).
fn metric_value_type(mv) { return boxed_tag(mv); }
# Payload of a metric value box: the raw 8-byte value it was built with.
fn metric_value_val(mv)  { return boxed_payload(mv); }
# A MetricDataPoint: one recorded value of an instrument. 48 bytes, all 8-byte
# slots: +0 instrument name (Str), +8 value (a metric_int / metric_float box),
#   +16 attributes (map, created on first access), +24 timestamp
#   (clock_epoch_ns at creation), +32 temporality (TEMPORALITY_CUMULATIVE), +40 monotonic flag (0).
fn metric_data_point_new(inst_name: Str, mv) {
    var dp = alloc(48);
    store64(dp, inst_name);
    store64(dp + 8, mv);
    store64(dp + 16, 0);
    store64(dp + 24, clock_epoch_ns());
    store64(dp + 32, TEMPORALITY_CUMULATIVE);
    store64(dp + 40, 0);
    return dp;
}
# Name of the instrument the point belongs to (Str), not an InstrumentDescriptor.
fn mdp_instrument(dp)   { return load64(dp); }
# The recorded value: a metric value box (metric_int / metric_float).
fn mdp_value(dp)         { return load64(dp + 8); }
# Data-point attributes: a cstr-keyed map, created empty on first access; values
# are AnyValue boxes for OTLP export.
fn mdp_attributes(dp)   { return _stik_lazy_map(dp + 16); }
# Time the point was created, Unix ns from clock_epoch_ns.
fn mdp_timestamp(dp)    { return load64(dp + 24); }
# AggregationTemporality of the value; metric_data_point_new sets TEMPORALITY_CUMULATIVE.
fn mdp_temporality(dp)  { return load64(dp + 32); }
# Monotonic flag: 1 when the value never decreases, else 0. metric_data_point_new
# sets 0 and this module has no setter for it.
fn mdp_is_monotonic(dp) { return load64(dp + 40); }
# Write the NumberDataPoint fields of data point `ptr` (field table below)
# into buffer `b`, the body of the message without its own tag. Returns 0.
fn _stik_otlp_number_point(b, ptr, path) {
    var ts = load64(ptr + 24);
    if (ts != 0) { _stik_pb_fixed64(b, 3, ts); }
    var mv = load64(ptr + 8);
    var recorded = 0;
    if (mv != 0) {
        var t = boxed_tag(mv);
        if (t == MV_FLOAT) {
            _stik_pb_fixed64(b, 4, boxed_payload(mv));
            recorded = 1;
        }
        if (t == MV_INT) {
            _stik_pb_fixed64(b, 6, boxed_payload(mv));
            recorded = 1;
        }
    }
    _stik_otlp_attributes(b, 7, load64(ptr + 16), path, 0);
    if (recorded == 0) { _stik_pb_int64(b, 8, 1); }
    return 0;
}
# Append data point `ptr` to `sb` as an OTLP NumberDataPoint message
# (opentelemetry.proto.metrics.v1.NumberDataPoint, metrics.proto), fields in
# ascending number order:
#   3 time_unix_nano   the point's timestamp, when non-zero
#   4 as_double        for a metric_float value: its raw IEEE-754 bits
#   6 as_int           for a metric_int value (sfixed64)
#   7 attributes       the point's map, keys sorted; AnyValue values
#   8 flags            1 (FLAG_NO_RECORDED_VALUE) when the point holds no
#                      int or float value, so no value field is written
# start_time_unix_nano and exemplars are not stored and not written. The
# instrument name, temporality and monotonic flag belong to the enclosing
# Metric; metric_to_otlp_proto writes that. Returns 0.
fn MetricDataPoint_to_otlp_proto(ptr, sb) {
    var b = _stik_pb_new();
    _stik_otlp_number_point(b, ptr, alloc(128));
    _stik_pb_flush(b, sb);
    return 0;
}
# OTLP AggregationTemporality for an agnostik one: TEMPORALITY_DELTA → 1,
# TEMPORALITY_CUMULATIVE → 2, and 0 for any other value. The enums differ:
# agnostik's are ordinals (CUMULATIVE = 0), OTLP's reserve 0 for UNSPECIFIED.
fn _stik_temporality_to_otlp(t) {
    if (t == TEMPORALITY_DELTA) { return 1; }
    if (t == TEMPORALITY_CUMULATIVE) { return 2; }
    return 0;
}
# Append an OTLP Metric message (metrics.proto) to `sb`: name 1, description 2
# and unit 3 from InstrumentDescriptor `desc` (each omitted when 0 or empty),
# then the data points in `points` (a vec of metric_data_point_new pointers; 0
# entries are skipped) as NumberDataPoint messages inside the member its kind
# selects:
#   METRIC_GAUGE             gauge (5)
#   METRIC_COUNTER           sum (7), is_monotonic true
#   METRIC_UP_DOWN_COUNTER   sum (7), is_monotonic false (omitted)
# A sum's aggregation_temporality is the points' temporality, mapped to OTLP's
# numbering; with no points it is CUMULATIVE. A gauge ignores temporality.
# Returns Ok(0). Returns an invalid-argument Err, having written nothing, for
# METRIC_HISTOGRAM or any other kind (agnostik has no histogram data point),
# or for a sum with a point whose temporality is not an AggregationTemporality
# or whose points disagree on temporality (OTLP carries one per Sum).
fn metric_to_otlp_proto(desc, points, sb) {
    var kind = load64(desc + 24);
    var member = 0;
    if (kind == METRIC_GAUGE) { member = 5; }
    if (kind == METRIC_COUNTER) { member = 7; }
    if (kind == METRIC_UP_DOWN_COUNTER) { member = 7; }
    if (member == 0) { return stik_err_invalid_argument(str_from("metric kind has no OTLP number data point")); }
    var temporality = 2;
    var np = 0;
    if (points != 0) { np = vec_len(points); }
    # A gauge has no temporality; a sum's points must all carry the same valid one.
    var seen = 0;
    var bad = 0;
    var i = 0;
    while (i < np) {
        var p = vec_get(points, i);
        if (member == 7) {
            if (p != 0) {
                var tt = _stik_temporality_to_otlp(load64(p + 32));
                if (bad == 0) {
                    if (tt == 0) { bad = 1; }
                    elif (seen == 1) {
                        if (tt != temporality) { bad = 2; }
                    }
                }
                if (seen == 0) {
                    temporality = tt;
                    seen = 1;
                }
            }
        }
        i = i + 1;
    }
    if (bad == 1) { return stik_err_invalid_argument(str_from("unknown data point temporality")); }
    if (bad == 2) { return stik_err_invalid_argument(str_from("data points disagree on temporality")); }
    var b = _stik_pb_new();
    var path = alloc(128);
    var nm = load64(desc);
    if (nm != 0) {
        if (str_len(nm) > 0) { _stik_pb_string(b, 1, nm); }
    }
    var ds = load64(desc + 8);
    if (ds != 0) {
        if (str_len(ds) > 0) { _stik_pb_string(b, 2, ds); }
    }
    var un = load64(desc + 16);
    if (un != 0) {
        if (str_len(un) > 0) { _stik_pb_string(b, 3, un); }
    }
    var dm = _stik_pb_open(b, member);
    var j = 0;
    while (j < np) {
        var q = vec_get(points, j);
        if (q != 0) {
            var pm = _stik_pb_open(b, 1);
            _stik_otlp_number_point(b, q, path);
            _stik_pb_close(b, pm);
        }
        j = j + 1;
    }
    if (member == 7) {
        _stik_pb_int64(b, 2, temporality);
        if (kind == METRIC_COUNTER) { _stik_pb_int64(b, 3, 1); }
    }
    _stik_pb_close(b, dm);
    _stik_pb_flush(b, sb);
    return Ok(0);
}
var TEXTMAP_GET = 0;
var TEXTMAP_SET = 1;
# Vtable for a TextMap carrier: 16 bytes, slot 0 (TEXTMAP_GET) = get_fn, slot 1
# (TEXTMAP_SET) = set_fn. Both are called as fn(data, key), `data` being the
# carrier's data pointer; set_fn gets the value from the global _textmap_extra,
# which textmap_set fills just before the call.
fn textmap_carrier_vtable(get_fn, set_fn) {
    var vt = alloc(16);
    store64(vt, get_fn);
    store64(vt + 8, set_fn);
    return vt;
}
# A TextMap carrier: a trait object pairing a textmap_carrier_vtable with the
# caller's data pointer.
fn textmap_carrier_new(vtable, data) { return trait_obj_new(vtable, data); }
# Call the carrier's get_fn(data, key) and return its result.
fn textmap_get(carrier, key) { return trait_call1(carrier, TEXTMAP_GET, key); }
var _textmap_extra = 0;
# Call the carrier's set_fn(data, key) and return its result. `value` travels
# in the global _textmap_extra, set just before the call, so concurrent calls
# are unsafe and set_fn must read it before making another textmap_set.
fn textmap_set(carrier, key, value) {
    _textmap_extra = value;
    return trait_call1(carrier, TEXTMAP_SET, key);
}
var PROPAGATOR_INJECT = 0;
var PROPAGATOR_EXTRACT = 1;
# Vtable for a TextMap propagator: 16 bytes, slot 0 (PROPAGATOR_INJECT) =
# inject_fn, slot 1 (PROPAGATOR_EXTRACT) = extract_fn, each called with the
# propagator's data pointer first. inject_fn gets its carrier from the global
# _propagator_extra, which propagator_inject fills just before the call.
fn textmap_propagator_vtable(inject_fn, extract_fn) {
    var vt = alloc(16);
    store64(vt, inject_fn);
    store64(vt + 8, extract_fn);
    return vt;
}
# A TextMap propagator: a trait object pairing a textmap_propagator_vtable with
# the caller's data pointer.
fn propagator_new(vtable, data) { return trait_obj_new(vtable, data); }
var _propagator_extra = 0;
# Call the propagator's inject_fn(data, context) and return its result. The
# carrier travels in the global _propagator_extra, set just before the call, so
# concurrent calls are unsafe.
fn propagator_inject(prop, context, carrier) {
    _propagator_extra = carrier;
    return trait_call1(prop, PROPAGATOR_INJECT, context);
}
# Call the propagator's extract_fn(data, carrier) and return its result.
fn propagator_extract(prop, carrier) {
    return trait_call1(prop, PROPAGATOR_EXTRACT, carrier);
}
var SC_EXPORT = 0;
var SC_FLUSH = 1;
var SC_SHUTDOWN = 2;
# Vtable for a span collector: 24 bytes, slot 0 (SC_EXPORT) = export_fn,
# slot 1 (SC_FLUSH) = flush_fn, slot 2 (SC_SHUTDOWN) = shutdown_fn, each called
# with the collector's data pointer first.
fn span_collector_vtable(export_fn, flush_fn, shutdown_fn) {
    var vt = alloc(24);
    store64(vt, export_fn);
    store64(vt + 8, flush_fn);
    store64(vt + 16, shutdown_fn);
    return vt;
}
# A span collector: a trait object pairing a span_collector_vtable with the
# caller's data pointer.
fn span_collector_new(vtable, data) { return trait_obj_new(vtable, data); }
# Call the collector's export_fn(data, spans) and return its result; `spans` is
# passed through as given.
fn sc_export(collector, spans)  { return trait_call1(collector, SC_EXPORT, spans); }
# Call the collector's flush_fn(data) and return its result.
fn sc_flush(collector)          { return trait_call0(collector, SC_FLUSH); }
# Call the collector's shutdown_fn(data) and return its result.
fn sc_shutdown(collector)       { return trait_call0(collector, SC_SHUTDOWN); }
var MS_EXPORT = 0;
var MS_FLUSH = 1;
# Vtable for a metric sink: 16 bytes, slot 0 (MS_EXPORT) = export_fn, slot 1
# (MS_FLUSH) = flush_fn, each called with the sink's data pointer first.
fn metric_sink_vtable(export_fn, flush_fn) {
    var vt = alloc(16);
    store64(vt, export_fn);
    store64(vt + 8, flush_fn);
    return vt;
}
# A metric sink: a trait object pairing a metric_sink_vtable with the caller's
# data pointer.
fn metric_sink_new(vtable, data) { return trait_obj_new(vtable, data); }
# Call the sink's export_fn(data, metrics) and return its result; `metrics` is
# passed through as given.
fn ms_export(sink, metrics) { return trait_call1(sink, MS_EXPORT, metrics); }
# Call the sink's flush_fn(data) and return its result.
fn ms_flush(sink)           { return trait_call0(sink, MS_FLUSH); }
