var TRACE_FLAG_SAMPLED = 1;
# New random trace id: 16 bytes from agent_id_new, so random apart from the
# RFC 4122 v4 version and variant bits that it sets. Compare with trace_id_eq.
fn trace_id_new() { return agent_id_new(); }
# Trace id as 32 lowercase hex chars, its 16 bytes in memory order, no dashes.
# trace_id_from_str is the inverse.
fn trace_id_to_str(id): Str {
    # 32 hex chars (no dashes)
    var buf = _stik_alloc(33);
    var i = 0;
    while (i < 16) {
        _stik_hex_byte(buf, i * 2, load8(id + i));
        i = i + 1;
    }
    store8(buf + 32, 0);
    return str_new(buf, 32);
}
# Parse exactly 32 hex digits (either case) into a new 16-byte trace id.
# Returns Ok(id), or an invalid-argument Err on a wrong length or a non-hex
# digit. An all-zero id is accepted here; tctx_from_traceparent rejects it.
fn trace_id_from_str(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    var data = s.data;
    var slen = s.len;
    if (slen != 32) { return stik_err_invalid_argument(str_from("expected 32 hex digits")); }
    var id = _stik_alloc(16);
    var i = 0;
    while (i < 16) {
        var hi = _stik_hex_nibble(load8(data + i * 2));
        var lo = _stik_hex_nibble(load8(data + i * 2 + 1));
        if (hi < 0) { return stik_err_invalid_argument(str_from("invalid hex in trace id")); }
        if (lo < 0) { return stik_err_invalid_argument(str_from("invalid hex in trace id")); }
        store8(id + i, hi << 4 | lo);
        i = i + 1;
    }
    return Ok(id);
}
# 1 when the two 16-byte trace ids hold the same bytes, else 0.
fn trace_id_eq(a, b) { return agent_id_eq(a, b); }
# New random span id: 8 bytes from the OS random source (_stik_fill_random).
fn span_id_new() {
    var id = _stik_alloc(8);
    _stik_fill_random(id, 8);
    return id;
}
# Span id as 16 lowercase hex chars: the 8 bytes in memory order, as
# trace_id_to_str does for the trace id. That is the W3C traceparent span-id
# field, and the same bytes Span_to_otlp_proto emits as the OTLP span_id.
# span_id_from_str is the inverse.
fn span_id_to_str(id): Str {
    # 16 hex chars
    var buf = _stik_alloc(17);
    var i = 0;
    while (i < 8) {
        _stik_hex_byte(buf, i * 2, load8(id + i));
        i = i + 1;
    }
    store8(buf + 16, 0);
    return str_new(buf, 16);
}
# Parse exactly 16 hex digits (either case) into a new 8-byte span id, byte i
# from hex digits 2i and 2i+1 (the order span_id_to_str prints). Returns Ok(id),
# or an invalid-argument Err on a wrong length or a non-hex digit.
fn span_id_from_str(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    var data = s.data;
    var slen = s.len;
    if (slen != 16) { return stik_err_invalid_argument(str_from("expected 16 hex digits")); }
    var id = _stik_alloc(8);
    var i = 0;
    while (i < 8) {
        var hi = _stik_hex_nibble(load8(data + i * 2));
        var lo = _stik_hex_nibble(load8(data + i * 2 + 1));
        if (hi < 0) { return stik_err_invalid_argument(str_from("invalid hex in span id")); }
        if (lo < 0) { return stik_err_invalid_argument(str_from("invalid hex in span id")); }
        store8(id + i, hi << 4 | lo);
        i = i + 1;
    }
    return Ok(id);
}
# 1 when the two 8-byte span ids hold the same bytes, else 0.
fn span_id_eq(a, b) {
    if (load64(a) == load64(b)) { return 1; }
    return 0;
}
enum SpanStatus {
    SPAN_UNSET;
    SPAN_OK;
    SPAN_ERROR;
}
# SpanStatus display name: "Unset", "Ok" or "Error", and "Unknown" for a value
# outside the enum. span_status_parse is the inverse.
fn span_status_name(s) {
    if (s == SPAN_UNSET)       { return "Unset"; }
    elif (s == SPAN_OK)        { return "Ok"; }
    elif (s == SPAN_ERROR)     { return "Error"; }
    return "Unknown";
}
# Inverse of span_status_name. Exact match on what span_status_name emits; an
# unrecognised string is an error rather than a silent default, so
# span_status_parse(span_status_name(v)) == v holds for every SpanStatus member.
fn span_status_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "Unset") == 1) { return Ok(SPAN_UNSET); }
    elif (str_eq_cstr(s, "Ok") == 1) { return Ok(SPAN_OK); }
    elif (str_eq_cstr(s, "Error") == 1) { return Ok(SPAN_ERROR); }
    return stik_err_invalid_argument(str_from("unknown SpanStatus name"));
}
# An error status with a description: a tagged box with tag SPAN_ERROR and
# `message` as payload, read with boxed_tag / boxed_payload. It is not a bare
# SpanStatus: a span's status slot (Span_set_status, Span_to_otlp_proto) holds
# the plain enum value.
fn span_status_error(message: Str) {
    return tagged_new(SPAN_ERROR, message);
}
enum SpanKind {
    SPAN_INTERNAL;
    SPAN_SERVER;
    SPAN_CLIENT;
    SPAN_PRODUCER;
    SPAN_CONSUMER;
}
# SpanKind display name: "Internal", "Server", "Client", "Producer" or
# "Consumer", and "Unknown" for a value outside the enum. span_kind_parse is
# the inverse.
fn span_kind_name(k) {
    if (k == SPAN_INTERNAL)      { return "Internal"; }
    elif (k == SPAN_SERVER)      { return "Server"; }
    elif (k == SPAN_CLIENT)      { return "Client"; }
    elif (k == SPAN_PRODUCER)    { return "Producer"; }
    elif (k == SPAN_CONSUMER)    { return "Consumer"; }
    return "Unknown";
}
# Inverse of span_kind_name. Exact match on what span_kind_name emits; an
# unrecognised string is an error rather than a silent default, so
# span_kind_parse(span_kind_name(v)) == v holds for every SpanKind member.
fn span_kind_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "Internal") == 1) { return Ok(SPAN_INTERNAL); }
    elif (str_eq_cstr(s, "Server") == 1) { return Ok(SPAN_SERVER); }
    elif (str_eq_cstr(s, "Client") == 1) { return Ok(SPAN_CLIENT); }
    elif (str_eq_cstr(s, "Producer") == 1) { return Ok(SPAN_PRODUCER); }
    elif (str_eq_cstr(s, "Consumer") == 1) { return Ok(SPAN_CONSUMER); }
    return stik_err_invalid_argument(str_from("unknown SpanKind name"));
}
enum EventType {
    EVT_AGENT_STARTED;
    EVT_AGENT_STOPPED;
    EVT_AGENT_FAILED;
    EVT_INFERENCE_COMPLETE;
    EVT_AUDIT_EVENT;
    EVT_SECURITY_ALERT;
    EVT_CUSTOM;
}
enum MetricKind {
    METRIC_COUNTER;
    METRIC_UP_DOWN_COUNTER;
    METRIC_GAUGE;
    METRIC_HISTOGRAM;
}
enum AggregationTemporality {
    TEMPORALITY_CUMULATIVE;
    TEMPORALITY_DELTA;
