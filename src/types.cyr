# CSPRNG — fills `n` bytes at `buf` with kernel-supplied randomness.
# Audit 2026-04-26 F-001: removed xorshift state and the deterministic
# fallback constant. UUIDs now draw fresh entropy per call.
fn _stik_fill_random(buf, n) {
    # getrandom(2), the only source. Preferred over opening /dev/urandom
    # because it works in sandboxed envs that block file IO and never
    # returns short reads for buffers <= 256 B.
    #
    # F-022 (audit 2026-09-23): reached through the stdlib's
    # sys_getrandom, never a raw syscall number. Each target's syscall
    # peer supplies it — getrandom 318 on x86_64-linux, 278 on
    # aarch64-linux, #45 on agnos, ProcessPrng on Windows, getentropy
    # (normalised to the byte count) on macOS. The raw 318 this replaced
    # is getrandom only on x86_64-linux: aarch64 returned -ENOSYS on every
    # call, so the fast path never ran there, and agnos has no syscall 318.
    # Spelling it SYS_GETRANDOM instead would not compile for Windows,
    # whose peer defines no such constant.
    var got = sys_getrandom(buf, n, 0);
    if (got == n) { return 0; }
    # F-023 (audit 2026-09-23): there is no /dev/urandom fallback. The
    # one this replaced opened, read and closed by raw x86_64-linux
    # numbers (2 / 0 / 3), which on agnos are getpid / exit / spawn, and
    # neither agnos nor Windows has a /dev/urandom to open. sys_getrandom
    # covers every target, so the fallback only served Linux < 3.17 and
    # sandboxes that deny getrandom but still allow the open.
    #
    # Identifier generation is security-critical (agent_id, session_id,
    # trace_id back authorisation in aegis/sigil), so we fail loudly
    # rather than degrade to a deterministic seed. sys_write / sys_exit,
    # not raw numbers: raw 60 is winsize on agnos, whose exit is #0.
    # F-012 (audit 2026-05-10): the byte-count was hardcoded 67 for a
    # 68-byte literal; the trailing newline silently dropped. Use
    # strlen() so the count tracks the literal.
    var msg = "agnostik: CSPRNG unavailable (getrandom failed)\n";
    sys_write(2, msg, strlen(msg));
    sys_exit(70);
    return 0 - 1;
}
# A fresh AgentId: a 16-byte random UUID v4. The bytes come from the CSPRNG
# (_stik_fill_random) with the RFC 4122 version (byte 6) and variant (byte 8)
# bits set. If the CSPRNG is unavailable the process exits with status 70
# rather than return a predictable id.
fn agent_id_new() {
    var id = _stik_alloc(16);
    _stik_fill_random(id, 16);
    # RFC 4122 v4 markers: high nibble of byte 6 = 0100, top two bits
    # of byte 8 = 10.
    var b6 = load8(id + 6);
    b6 = (b6 & 0x0F) | 0x40;
    store8(id + 6, b6);
    var b8 = load8(id + 8);
    b8 = (b8 & 0x3F) | 0x80;
    store8(id + 8, b8);
    return id;
}
# Bytes 0-7 of the id as one i64 (load64, so native byte order).
fn agent_id_high(id) { return load64(id); }
# Bytes 8-15 of the id as one i64 (load64, so native byte order).
fn agent_id_low(id)  { return load64(id + 8); }
# 1 when the two ids hold the same 16 bytes, else 0.
fn agent_id_eq(a, b) {
    if (load64(a) != load64(b)) { return 0; }
    if (load64(a + 8) != load64(b + 8)) { return 0; }
    return 1;
}
var _stik_hex_lut = "0123456789abcdef";
# Write `byte` (0-255) as two lower-case hex digits at buf + offset. The
# caller provides the two bytes of room. Returns 0.
fn _stik_hex_byte(buf, offset, byte) {
    store8(buf + offset, load8(_stik_hex_lut + (byte >> 4)));
    store8(buf + offset + 1, load8(_stik_hex_lut + (byte & 0x0F)));
    return 0;
}
# Returns 0-15 on valid hex char, -1 on invalid. The single hex-char
# decoder for the whole library — UUID/trace-id/span-id parsing, the
# _stik_json_str's \u escape decoder, and version_from_str all route through it.
fn _stik_hex_nibble(ch) {
    if (ch >= 48 && ch <= 57)  { return ch - 48; }   # '0'-'9'
    if (ch >= 97 && ch <= 102) { return ch - 87; }   # 'a'-'f'
    if (ch >= 65 && ch <= 70)  { return ch - 55; }   # 'A'-'F'
    return 0 - 1;
}
# Parse 4 hex digits at data+offset; return codepoint (0..65535) or -1.
# Caller is responsible for bounds-checking offset+4 <= slen.
fn _stik_json_parse_u4(data, offset) {
    var h0 = _stik_hex_nibble(load8(data + offset));
    var h1 = _stik_hex_nibble(load8(data + offset + 1));
    var h2 = _stik_hex_nibble(load8(data + offset + 2));
    var h3 = _stik_hex_nibble(load8(data + offset + 3));
    if (h0 < 0) { return 0 - 1; }
    if (h1 < 0) { return 0 - 1; }
    if (h2 < 0) { return 0 - 1; }
    if (h3 < 0) { return 0 - 1; }
    return (h0 << 12) | (h1 << 8) | (h2 << 4) | h3;
}
# UTF-8 encode `cp` into `out` at offset `op`; return new op (1..4 bytes).
# Caller guarantees enough output buffer space (max 4 bytes per cp).
# RFC 3629; surrogate range U+D800..U+DFFF is invalid as a standalone
# codepoint but this fn does not validate — surrogate handling lives
# in _stik_json_str so the caller can implement pair-merging.
fn _stik_utf8_encode(out, op, cp) {
    if (cp < 128) {
        store8(out + op, cp);
        return op + 1;
    }
    if (cp < 2048) {
        store8(out + op,     0xC0 | (cp >> 6));
        store8(out + op + 1, 0x80 | (cp & 0x3F));
        return op + 2;
    }
    if (cp < 65536) {
        store8(out + op,     0xE0 | (cp >> 12));
        store8(out + op + 1, 0x80 | ((cp >> 6) & 0x3F));
        store8(out + op + 2, 0x80 | (cp & 0x3F));
        return op + 3;
    }
    # 4-byte: U+10000..U+10FFFF
    store8(out + op,     0xF0 | (cp >> 18));
    store8(out + op + 1, 0x80 | ((cp >> 12) & 0x3F));
    store8(out + op + 2, 0x80 | ((cp >> 6) & 0x3F));
    store8(out + op + 3, 0x80 | (cp & 0x3F));
    return op + 4;
}
# The id in canonical UUID form, 36 characters of lower-case hex in 8-4-4-4-12
# groups, as a new Str. agent_id_from_str is the inverse.
fn agent_id_to_str(id): Str {
    # UUID format: 8-4-4-4-12 = 36 chars
    var buf = _stik_alloc(37);
    var pos = 0;
    var i = 0;
    while (i < 16) {
        if (i == 4) { store8(buf + pos, 45); pos = pos + 1; }
        if (i == 6) { store8(buf + pos, 45); pos = pos + 1; }
        if (i == 8) { store8(buf + pos, 45); pos = pos + 1; }
        if (i == 10) { store8(buf + pos, 45); pos = pos + 1; }
        _stik_hex_byte(buf, pos, load8(id + i));
        pos = pos + 2;
        i = i + 1;
    }
    store8(buf + pos, 0);
    return str_new(buf, 36);
}
# Parse a 36-character UUID string into a new 16-byte AgentId. Hex digits may
# be either case. Returns Ok(id), or an invalid-argument Err when the length is
# not 36, a digit is not hex, or positions 8, 13, 18 and 23 do not hold '-'
# (checked since v1.11.0; they were skipped). Any UUID version and variant is
# accepted, the nil and max UUIDs included (ADR-005).
fn agent_id_from_str(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    var data = s.data;
    var slen = s.len;
    if (slen != 36) { return stik_err_invalid_argument(str_from("invalid agent id: expected UUID")); }
    var id = _stik_alloc(16);
    var si = 0;
    var bi = 0;
    while (bi < 16) {
        # The 8-4-4-4-12 group separators must be '-' (45).
        var sep = 0;
        if (si == 8) { sep = 1; }
        if (si == 13) { sep = 1; }
        if (si == 18) { sep = 1; }
        if (si == 23) { sep = 1; }
        if (sep == 1) {
            if (load8(data + si) != 45) {
                return stik_err_invalid_argument(str_from("invalid agent id: expected '-'"));
            }
            si = si + 1;
        }
        var hi = _stik_hex_nibble(load8(data + si));
        var lo = _stik_hex_nibble(load8(data + si + 1));
        if (hi < 0) { return stik_err_invalid_argument(str_from("invalid hex in agent id")); }
        if (lo < 0) { return stik_err_invalid_argument(str_from("invalid hex in agent id")); }
        store8(id + bi, hi << 4 | lo);
        si = si + 2;
        bi = bi + 1;
    }
    return Ok(id);
}
# --- JSON field extractors ------------------------------------------------
# Audit 2026-04-26 F-004: a strstr probe for `"key":` was matching the
# needle when it appeared *inside* a string value, e.g. an attacker-
# controlled `"note":"max_memory:..."` poisoned a sibling lookup for
# `max_memory`. The walker now tracks string boundaries and only
# matches when the cursor is outside `"..."`. Backslash escapes inside
# strings respected so `"\""` doesn't end the string early (parallels
# the F-002 fix in `_stik_json_str`).
fn _stik_json_find_value(src: Str, key: Str) {
    # Since 1.12.3 (F-029) it reads the document's structure, so it agrees with
    # the #derive(Serialize) parser: a key matches only as a member of the
    # top-level object (depth 1), whitespace may sit before the ':' as RFC 8259
    # allows, and a repeated key gives its LAST value. Through 1.12.2 it matched
    # `"key":` at any depth and took the first, so in
    # `{"meta":{"name":"x"},"name":"y"}` it read "x" while the derived parser
    # read "y", and `"name" : "y"` was missing. Keys are compared as raw bytes
    # (an escaped key is not decoded). Returns the index of the value, after the
    # colon and any whitespace, or -1.
    var data = src.data;
    var slen = src.len;
    var kd = key.data;
    var klen = key.len;
    var depth = 0;
    var found = 0 - 1;
    var i = 0;
    while (i < slen) {
        var ch = load8(data + i);
        if (ch == 34) {
            # A string: find its closing quote, honouring backslash escapes.
            var s0 = i + 1;
            var j = s0;
            var open = 1;
            while (j < slen && open == 1) {
                var c = load8(data + j);
                if (c == 92) { j = j + 2; }
                elif (c == 34) { open = 0; }
                else { j = j + 1; }
            }
            if (open == 1) { i = slen; }
            else {
                # A member name is a string followed by ':' (after whitespace).
                var k = _stik_json_skip_ws(data, j + 1, slen);
                if (k < slen && load8(data + k) == 58) {
                    if (depth == 1 && j - s0 == klen && memeq(data + s0, kd, klen) == 1) {
                        found = _stik_json_skip_ws(data, k + 1, slen);
                    }
                    i = k + 1;
                } else {
                    i = j + 1;
                }
            }
        }
        elif (ch == 123 || ch == 91) { depth = depth + 1; i = i + 1; }
        elif (ch == 125 || ch == 93) { depth = depth - 1; i = i + 1; }
        else { i = i + 1; }
    }
    return found;
}
# The first index at or after `i` (and below `slen`) that is not RFC 8259
# whitespace (space, tab, LF, CR); `slen` when there is none.
fn _stik_json_skip_ws(data, i, slen) {
    var k = i;
    var skipping = 1;
    while (k < slen && skipping == 1) {
        var w = load8(data + k);
        if (w == 32 || w == 9 || w == 10 || w == 13) { k = k + 1; }
        else { skipping = 0; }
    }
    return k;
}
# Audit 2026-04-26 F-003: handle leading '-' for negatives.
# Audit 2026-04-26 F-008: pre-multiply overflow check; we no longer
# accept digits whose multiply would lift val above i64::MAX. The
# original 19-digit cap was insufficient — values in
# [9223372036854775808, 9999999999999999999] still overflowed and
# wrapped silently. Both findings together close
# GHSA-72HV-8253-57QQ-shape risk.
fn _stik_json_int(src: Str, key: Str) {
    var vi = _stik_json_find_value(src, key);
    if (vi < 0) { return 0; }
    return _stik_json_int_at(src.data, src.len, vi);
}
# The JSON integer at index `vi` of the `slen` bytes at `data`, as
# _stik_json_int reads a member's value: an optional '-' then digits, stopping
# at the first non-digit; 0 when there are no digits or the number is outside
# i64 (F-030).
fn _stik_json_int_at(data, slen, vi) {
    var neg = 0;
    if (vi < slen && load8(data + vi) == 45) { neg = 1; vi = vi + 1; }
    var val = 0;
    var parsing = 1;
    var overflow = 0;
    while (vi < slen && parsing == 1) {
        var ch = load8(data + vi);
        # F-008: detect i64 overflow before it wraps. i64::MAX =
        # 9223372036854775807 = 922337203685477580 * 10 + 7. Stop
        # accepting digits the moment the next multiply would lift val
        # above MAX; a 19-digit overflowing input like 9999999999999999999
        # used to wrap silently to a negative i64, letting an attacker
        # smuggle a value past `if (x > LIMIT)` non-negative guards.
        if (ch < 48 || ch > 57) { parsing = 0; }
        elif (val > 922337203685477580) { overflow = 1; parsing = 0; }
        elif (val == 922337203685477580 && (ch - 48) > 7) { overflow = 1; parsing = 0; }
        else {
            val = val * 10 + (ch - 48);
            vi = vi + 1;
        }
    }
    # F-030 (1.12.3): an out-of-range number reads 0, the contract's value for
    # an invalid one. F-008 stopped the wrap, but kept the digits read so far:
    # 12345678901234567890 read as 1234567890123456789.
    if (overflow == 1) { return 0; }
    if (neg == 1) { return 0 - val; }
    return val;
}
# Audit 2026-04-26 F-002: respect '\' escape so `"abc\"xyz"` parses as
# the full string, not just the prefix. Decode the common escapes
# (\" \\ \/ \n \t \r \b \f) by writing into a fresh buffer; the buffer
# is at most as long as the source so allocating slen bytes is safe.
# v1.0.7: four-hex-digit \u escapes (and surrogate pairs) decoded as UTF-8.
# Output is at most as long as input — a \u escape is 6 source bytes
# producing ≤4 UTF-8 bytes, surrogate pair is 12 source bytes
# producing 4 UTF-8 bytes. slen+1 buffer remains sufficient.
# Malformed escapes (truncated, invalid hex, orphan surrogate) emit
# U+FFFD REPLACEMENT CHARACTER (3 UTF-8 bytes) per common JSON
# implementations.
var _stik_utf8_replacement_cp = 0xFFFD;
# Returns the value of `key` in `src`, unescaped, as a new Str; 0 when the key
# is missing, its value is null, or the value is not a string.
fn _stik_json_str(src: Str, key: Str) {
    var vi = _stik_json_find_value(src, key);
    if (vi < 0) { return 0; }
    var data = src.data;
    var slen = src.len;
    # F-009: gate the 4-byte memeq probe on remaining length so we
    # don't read past slen on truncated input like `{"x":nu}`.
    if (vi + 4 <= slen && memeq(data + vi, "null", 4) == 1) { return 0; }
    if (vi >= slen) { return 0; }
    if (load8(data + vi) != 34) { return 0; }
    vi = vi + 1;
    # F-031 (1.12.3): the buffer is sized to this value, not the document.
    # Through 1.12.2 every string field allocated the whole document's length
    # (4 MiB for four fields of a 1 MiB document, never freed). Find the
    # closing quote first; decoding is bounded by it, so no escape can run past
    # it, and decoding never emits more bytes than it consumes except a
    # truncated \u at the very end (3 for 2), so the value's length + 2 is
    # enough. An unterminated value runs to the end of `src`.
    var vend = vi;
    var scanning = 1;
    while (vend < slen && scanning == 1) {
        var vc = load8(data + vend);
        if (vc == 92) { vend = vend + 2; }
        elif (vc == 34) { scanning = 0; }
        else { vend = vend + 1; }
    }
    if (vend > slen) { vend = slen; }
    var out = _stik_alloc(vend - vi + 2);
    var op = 0;
    var done = 0;
    while (vi < vend && done == 0) {
        var ch = load8(data + vi);
        if (ch == 34) { done = 1; }
        elif (ch == 92 && vi + 1 < vend) {
            var esc = load8(data + vi + 1);
            if (esc == 34)      { store8(out + op, 34); op = op + 1; vi = vi + 2; }
            elif (esc == 92)    { store8(out + op, 92); op = op + 1; vi = vi + 2; }
            elif (esc == 47)    { store8(out + op, 47); op = op + 1; vi = vi + 2; }
            elif (esc == 110)   { store8(out + op, 10); op = op + 1; vi = vi + 2; }
            elif (esc == 116)   { store8(out + op, 9);  op = op + 1; vi = vi + 2; }
            elif (esc == 114)   { store8(out + op, 13); op = op + 1; vi = vi + 2; }
            elif (esc == 98)    { store8(out + op, 8);  op = op + 1; vi = vi + 2; }
            elif (esc == 102)   { store8(out + op, 12); op = op + 1; vi = vi + 2; }
            elif (esc == 117) {
                # \u escape — needs 6 source bytes (\, u, then 4 hex).
                if (vi + 6 > vend) {
                    op = _stik_utf8_encode(out, op, _stik_utf8_replacement_cp);
                    vi = vend;
                } else {
                    var cp = _stik_json_parse_u4(data, vi + 2);
                    if (cp < 0) {
                        op = _stik_utf8_encode(out, op, _stik_utf8_replacement_cp);
                        vi = vi + 6;
                    }
                    elif (cp >= 0xD800 && cp <= 0xDBFF) {
                        # High surrogate — expect \uYYYY low surrogate next.
                        if (vi + 12 > vend) {
                            op = _stik_utf8_encode(out, op, _stik_utf8_replacement_cp);
                            vi = vi + 6;
                        }
                        elif (load8(data + vi + 6) != 92) {
                            op = _stik_utf8_encode(out, op, _stik_utf8_replacement_cp);
                            vi = vi + 6;
                        }
                        elif (load8(data + vi + 7) != 117) {
                            op = _stik_utf8_encode(out, op, _stik_utf8_replacement_cp);
                            vi = vi + 6;
                        }
                        else {
                            var lo = _stik_json_parse_u4(data, vi + 8);
                            if (lo < 0xDC00) {
                                op = _stik_utf8_encode(out, op, _stik_utf8_replacement_cp);
                                vi = vi + 6;
                            }
                            elif (lo > 0xDFFF) {
                                op = _stik_utf8_encode(out, op, _stik_utf8_replacement_cp);
                                vi = vi + 6;
                            }
                            else {
                                # Combine surrogate pair → full codepoint.
                                var combined = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                                op = _stik_utf8_encode(out, op, combined);
                                vi = vi + 12;
                            }
                        }
                    }
                    elif (cp >= 0xDC00 && cp <= 0xDFFF) {
                        # Orphan low surrogate — invalid alone.
                        op = _stik_utf8_encode(out, op, _stik_utf8_replacement_cp);
                        vi = vi + 6;
                    }
                    else {
                        # Plain BMP codepoint.
                        op = _stik_utf8_encode(out, op, cp);
                        vi = vi + 6;
                    }
                }
            }
            else {
                # Unknown escape — preserve verbatim (existing behavior).
                store8(out + op, 92); store8(out + op + 1, esc); op = op + 2;
                vi = vi + 2;
            }
        }
        else { store8(out + op, ch); op = op + 1; vi = vi + 1; }
    }
    return str_new(out, op);
}

# --- Serde for the seven value structs (ADR-008) -----------------------------
# ResourceLimits, ResourceUsage, AgentStats, EdgeResourceOverrides,
# InjectionScores, TokenUsage and AcceleratorFlags had T_to_json, T_from_json
# and T_from_json_str generated by #derive(Serialize) through 1.12.2. Since
# 1.12.3 (F-047) they are written by hand on these helpers, with the same names,
# arity and output bytes: the generated T_from_json_str looked for a key's
# closing quote with no bound, so truncated text read past its end (or
# segfaulted), and both generated decoders wrapped numbers outside i64.

# A field table for _stik_json_read_fields: `n` member names as
# [n, name0, len0, name1, len1, ...], filled with _stik_ft_set. Each struct
# builds its table once and keeps it.
fn _stik_ft_new(n) {
    var ft = _stik_alloc(8 + n * 16);
    store64(ft, n);
    return ft;
}
# Set entry `i` of field table `ft` to C string `name`. Returns 0.
fn _stik_ft_set(ft, i, name) {
    store64(ft + 8 + i * 16, name);
    store64(ft + 16 + i * 16, strlen(name));
    return 0;
}
# One pass over the JSON object in the C string at `data`, which the caller has
# checked opens with '{'. The walk stops at the NUL terminator and never reads
# past it, a backslash just before the NUL included. A member of the top-level
# object whose name is entry j of field table `ft` has its value read as an
# integer (_stik_json_int_at, which also stops at the NUL) and stored in slot j
# of `out` by `mode`: 0 an i64 at out + 8j, 1 a score saturated to 0..100 at the
# byte out + j, 2 a 0/1 flag at the byte out + j. A nested member never matches,
# a repeated one overwrites (the last wins), and a missing one leaves its slot.
# Returns 0.
fn _stik_json_read_fields(data, ft, out, mode) {
    var n = load64(ft);
    var nextf = 0;
    var depth = 0;
    var i = 0;
    var go = 1;
    while (go == 1) {
        var ch = load8(data + i);
        if (ch == 34) {
            var s0 = i + 1;
            var j = s0;
            var open = 1;
            while (open == 1) {
                var c = load8(data + j);
                if (c > 92) { j = j + 1; }
                elif (c == 34) { open = 0; }
                elif (c == 92) {
                    if (load8(data + j + 1) == 0) { open = 2; } else { j = j + 2; }
                }
                elif (c == 0) { open = 2; }
                else { j = j + 1; }
            }
            if (open == 2) { go = 0; }
            else {
                var k = j + 1;
                var w = load8(data + k);
                while (w == 32 || w == 9 || w == 10 || w == 13) { k = k + 1; w = load8(data + k); }
                var hit = 0 - 1;
                if (w == 58 && depth == 1) {
                    # Search from the entry after the last hit: members usually
                    # come in layout order, so this matches on the first try.
                    var klen = j - s0;
                    var tries = 0;
                    var f = nextf;
                    while (tries < n && hit < 0) {
                        var e = ft + 8 + f * 16;
                        if (load64(e + 8) == klen && memeq(data + s0, load64(e), klen) == 1) { hit = f; }
                        f = f + 1;
                        if (f == n) { f = 0; }
                        tries = tries + 1;
                    }
                    if (hit >= 0) { nextf = f; }
                }
                if (hit >= 0) {
                    # The value, read in place as _stik_json_int_at reads it
                    # (an optional '-' then digits; outside i64 reads 0), and
                    # the walk resumes after it.
                    var vi = k + 1;
                    var vw = load8(data + vi);
                    while (vw == 32 || vw == 9 || vw == 10 || vw == 13) { vi = vi + 1; vw = load8(data + vi); }
                    var neg = 0;
                    if (vw == 45) { neg = 1; vi = vi + 1; vw = load8(data + vi); }
                    var val = 0;
                    var ovf = 0;
                    while (vw >= 48 && vw <= 57) {
                        if (val > 922337203685477580) { ovf = 1; }
                        elif (val == 922337203685477580 && vw > 55) { ovf = 1; }
                        if (ovf == 0) { val = val * 10 + (vw - 48); }
                        vi = vi + 1;
                        vw = load8(data + vi);
                    }
                    if (ovf == 1) { val = 0; }
                    elif (neg == 1) { val = 0 - val; }
                    if (mode == 0) { store64(out + hit * 8, val); }
                    elif (mode == 1) {
                        if (val < 0) { val = 0; }
                        if (val > 100) { val = 100; }
                        store8(out + hit, val);
                    }
                    else { store8(out + hit, val != 0); }
                    i = vi;
                }
                elif (w == 58) { i = k + 1; }
                else { i = j + 1; }
            }
        }
        elif (ch == 0) { go = 0; }
        elif (ch == 123 || ch == 91) { depth = depth + 1; i = i + 1; }
        elif (ch == 125 || ch == 93) { depth = depth - 1; i = i + 1; }
        else { i = i + 1; }
    }
    return 0;
}
# 1 when the C string `json` is non-0 and opens with '{' after whitespace.
fn _stik_json_is_obj_cstr(json) {
    if (json == 0) { return 0; }
    var i = 0;
    var c = load8(json);
    while (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; c = load8(json + i); }
    if (c == 123) { return 1; }
    return 0;
}
# Integer value of member `name` (a C string) in `pairs`, the vec
# bayan_json_parse returns: the first pair with that key, as the derived
# T_from_json read it. 0 when `pairs` is 0, the key is missing, or the value is
# not wholly a decimal integer within i64 (the derived code's str_to_int wrapped
# and read "12abc" as 12). It walks the pairs with bayan_json_key /
# bayan_json_value, which every cyrius pin a consumer uses provides.
fn _stik_json_pair_int(pairs, name) {
    if (pairs == 0) { return 0; }
    var n = vec_len(pairs);
    var i = 0;
    var v = 0;
    var looking = 1;
    while (i < n && looking == 1) {
        var pr = vec_get(pairs, i);
        if (str_eq_cstr(bayan_json_key(pr), name) == 1) { v = bayan_json_value(pr); looking = 0; }
        i = i + 1;
    }
    if (v == 0) { return 0; }
    return _stik_int_str_checked(v);
}
# A Str holding an optional '-' then decimal digits, as an i64; 0 when it holds
# anything else or the number is outside i64.
fn _stik_int_str_checked(v: Str) {
    var d = v.data;
    var n = v.len;
    var i = 0;
    var neg = 0;
    if (n > 0 && load8(d) == 45) { neg = 1; i = 1; }
    if (i >= n) { return 0; }
    var k = i;
    var digits = 1;
    while (k < n && digits == 1) {
        var c = load8(d + k);
        if (c < 48 || c > 57) { digits = 0; }
        k = k + 1;
    }
    if (digits == 0) { return 0; }
    var val = _stik_dec_checked(d + i, n - i);
    if (val < 0) { return 0; }
    if (neg == 1) { return 0 - val; }
    return val;
}

# A fresh UserId. A UserId shares AgentId's representation (a 16-byte random
# UUID v4), so this and the other user_id_* fns delegate to agent_id_*.
fn user_id_new()              { return agent_id_new(); }
# Bytes 0-7 of the id as one i64; see agent_id_high.
fn user_id_high(id)           { return agent_id_high(id); }
# Bytes 8-15 of the id as one i64; see agent_id_low.
fn user_id_low(id)            { return agent_id_low(id); }
# 1 when the two ids hold the same 16 bytes, else 0; see agent_id_eq.
fn user_id_eq(a, b)           { return agent_id_eq(a, b); }
# Canonical 36-character lower-case UUID form, as a new Str; see agent_id_to_str.
fn user_id_to_str(id): Str    { return agent_id_to_str(id); }
# Parse a 36-character UUID string. Ok(id) or Err, as agent_id_from_str.
fn user_id_from_str(s: Str)   { return agent_id_from_str(s); }
# A Version (SemVer). 40 bytes, all 8-byte slots, read through the version_*
# accessors:
#   +0 major, +8 minor, +16 patch, +24 prerelease, +32 build.
# prerelease and build are Strs, both 0 (absent) at construction.
fn version_new(major, minor, patch) {
    var v = _stik_alloc(40);
    store64(v, major);
    store64(v + 8, minor);
    store64(v + 16, patch);
    store64(v + 24, 0);
    store64(v + 32, 0);
    return v;
}
# Version 0.0.0 with no prerelease or build.
fn version_default() { return version_new(0, 0, 0); }
# Major version number.
fn version_major(v)      { return load64(v); }
# Minor version number.
fn version_minor(v)      { return load64(v + 8); }
# Patch version number.
fn version_patch(v)      { return load64(v + 16); }
# Prerelease Str, the part after '-' (for example "beta.1"); 0 when absent.
fn version_prerelease(v) { return load64(v + 24); }
# Build-metadata Str, the part after '+'; 0 when absent.
fn version_build(v)      { return load64(v + 32); }
# Set the prerelease Str, without its leading '-'. Not validated. Returns 0.
fn version_set_prerelease(v, pre: Str) { store64(v + 24, pre); return 0; }
# Set the build-metadata Str, without its leading '+'. Not validated. Returns 0.
fn version_set_build(v, b: Str)        { store64(v + 32, b); return 0; }
# Format as "MAJOR.MINOR.PATCH", then "-PRERELEASE" and "+BUILD" when set, as
# a new Str. Output is capped at 127 bytes: a prerelease or build part that
# would not fit is dropped silently, not truncated.
fn version_to_str(v): Str {
    var buf = _stik_alloc(128);
    var cap = 127;
    var pos = 0;
    pos = pos + fmt_int_buf(version_major(v), buf + pos);
    store8(buf + pos, 46); pos = pos + 1;
    pos = pos + fmt_int_buf(version_minor(v), buf + pos);
    store8(buf + pos, 46); pos = pos + 1;
    pos = pos + fmt_int_buf(version_patch(v), buf + pos);
    var pre = version_prerelease(v);
    if (pre != 0) {
        var plen = str_len(pre);
        if (pos + 1 + plen < cap) {
            store8(buf + pos, 45); pos = pos + 1;
            memcpy(buf + pos, str_data(pre), plen);
            pos = pos + plen;
        }
    }
    var bld = version_build(v);
    if (bld != 0) {
        var blen = str_len(bld);
        if (pos + 1 + blen < cap) {
            store8(buf + pos, 43); pos = pos + 1;
            memcpy(buf + pos, str_data(bld), blen);
            pos = pos + blen;
        }
    }
    store8(buf + pos, 0);
    return str_new(buf, pos);
}
# The value of the `len` ASCII digits at `p` (the caller has checked they are
# digits), or -1 when it exceeds i64 max: F-008's pre-multiply check.
fn _stik_dec_checked(p, len) {
    var val = 0;
    var k = 0;
    var ok = 1;
    while (k < len && ok == 1) {
        var d = load8(p + k) - 48;
        if (val > 922337203685477580) { ok = 0; }
        elif (val == 922337203685477580 && d > 7) { ok = 0; }
        else { val = val * 10 + d; k = k + 1; }
    }
    if (ok == 0) { return 0 - 1; }
    return val;
}
# Parse "MAJOR.MINOR.PATCH[-PRERELEASE][+BUILD]" into a new Version. Returns
# Ok(version), or an invalid-argument Err when a dot is missing, a numeric
# segment is empty or has a non-digit, or a number exceeds i64 max. The first
# '-' or '+' after the second dot ends the patch; the prerelease runs to the
# next '+'. Prerelease and build text is not validated.
fn version_from_str(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    var data = s.data;
    var slen = s.len;
    var v = _stik_alloc(40);
    store64(v, 0);
    store64(v + 8, 0);
    store64(v + 16, 0);
    store64(v + 24, 0);
    store64(v + 32, 0);
    # Find first dot
    var i = 0;
    var dot1 = 0 - 1;
    while (i < slen) {
        if (load8(data + i) == 46) { dot1 = i; break; }
        i = i + 1;
    }
    if (dot1 < 0) { return stik_err_invalid_argument(str_from("invalid version: missing dot")); }
    # Find second dot
    i = dot1 + 1;
    var dot2 = 0 - 1;
    while (i < slen) {
        if (load8(data + i) == 46) { dot2 = i; break; }
        i = i + 1;
    }
    if (dot2 < 0) { return stik_err_invalid_argument(str_from("invalid version: missing second dot")); }
    # Find the first pre-release (-) or build (+) separator after patch.
    # Bounded scan over [dot2+1, slen): strchr would walk to a NUL
    # terminator, over-reading past slen on non-NUL-terminated Str
    # slices (str_new over a larger buffer). Single pass — semver puts
    # prerelease before build, so the first separator is the patch end.
    var patch_end = slen;
    var j = dot2 + 1;
    var ch = 0;
    while (j < slen) {
        ch = load8(data + j);
        if (ch == 45 || ch == 43) { patch_end = j; j = slen; }
        else { j = j + 1; }
    }
    # Audit 2026-04-26 F-005: every segment must be wholly digits.
    # str_to_int silently returns 0 for non-numeric input, so a string
    # like "abc.1.2" used to parse as 0.1.2; now it errors.
    var maj_len = dot1;
    var min_len = dot2 - dot1 - 1;
    var pat_len = patch_end - dot2 - 1;
    if (maj_len == 0 || min_len == 0 || pat_len == 0) {
        return stik_err_invalid_argument(str_from("invalid version: empty segment"));
    }
    var k = 0;
    while (k < maj_len) {
        var c = load8(data + k);
        if (c < 48 || c > 57) {
            return stik_err_invalid_argument(str_from("invalid version: non-digit in major"));
        }
        k = k + 1;
    }
    k = 0;
    while (k < min_len) {
        var c = load8(data + dot1 + 1 + k);
        if (c < 48 || c > 57) {
            return stik_err_invalid_argument(str_from("invalid version: non-digit in minor"));
        }
        k = k + 1;
    }
    k = 0;
    while (k < pat_len) {
        var c = load8(data + dot2 + 1 + k);
        if (c < 48 || c > 57) {
            return stik_err_invalid_argument(str_from("invalid version: non-digit in patch"));
        }
        k = k + 1;
    }
    # F-038 (1.12.3): checked conversion. str_to_int wrapped, so
    # 18446744073709551617.0.0 parsed as 1.0.0 and 9223372036854775808.0.0 as a
    # negative major that version_to_str printed and could not re-parse.
    var maj = _stik_dec_checked(data, maj_len);
    var mnr = _stik_dec_checked(data + dot1 + 1, min_len);
    var pat = _stik_dec_checked(data + dot2 + 1, pat_len);
    if (maj < 0 || mnr < 0 || pat < 0) {
        return stik_err_invalid_argument(str_from("invalid version: number out of range"));
    }
    store64(v, maj);
    store64(v + 8, mnr);
    store64(v + 16, pat);
    # Parse prerelease and build if present
    if (patch_end < slen) {
        var sep = load8(data + patch_end);
        if (sep == 45) {
            # Pre-release: find +build if any
            var build_start = slen;
            i = patch_end + 1;
            while (i < slen) {
                if (load8(data + i) == 43) { build_start = i; break; }
                i = i + 1;
            }
            var pre = str_new(data + patch_end + 1, build_start - patch_end - 1);
            store64(v + 24, pre);
            if (build_start < slen) {
                var bld = str_new(data + build_start + 1, slen - build_start - 1);
                store64(v + 32, bld);
            }
        }
        elif (sep == 43) {
            var bld = str_new(data + patch_end + 1, slen - patch_end - 1);
            store64(v + 32, bld);
        }
    }
    return Ok(v);
}
# 1 when major, minor and patch are equal, else 0. Prerelease and build are
# not compared, so 1.0.0-rc.1 equals 1.0.0.
fn version_eq(a, b) {
    if (version_major(a) != version_major(b)) { return 0; }
    if (version_minor(a) != version_minor(b)) { return 0; }
    if (version_patch(a) != version_patch(b)) { return 0; }
    return 1;
}
enum MessageType {
    MSG_COMMAND;
    MSG_RESPONSE;
    MSG_EVENT;
    MSG_HEARTBEAT;
}
enum SystemStatus {
    STATUS_HEALTHY;
    STATUS_DEGRADED;
    STATUS_CRITICAL;
    STATUS_UNKNOWN;
}
# A capabilities record: four feature flags. 32 bytes, one 0/1 flag per 8-byte
# slot, read through the capabilities_* accessors:
#   +0 llm, +8 virtualization, +16 gpu, +24 tpm.
# All start at 0.
fn capabilities_new() {
    var c = _stik_alloc(32);
    store64(c, 0);
    store64(c + 8, 0);
    store64(c + 16, 0);
    store64(c + 24, 0);
    return c;
}
# LLM capability flag (0/1).
fn capabilities_llm(c)            { return load64(c); }
# Virtualization capability flag (0/1).
fn capabilities_virtualization(c) { return load64(c + 8); }
# GPU capability flag (0/1).
fn capabilities_gpu(c)            { return load64(c + 16); }
# TPM capability flag (0/1).
fn capabilities_tpm(c)            { return load64(c + 24); }
# Set the LLM capability flag. Stored as given. Returns 0.
fn capabilities_set_llm(c, v)            { store64(c, v); return 0; }
# Set the virtualization capability flag. Stored as given. Returns 0.
fn capabilities_set_virtualization(c, v) { store64(c + 8, v); return 0; }
# Set the GPU capability flag. Stored as given. Returns 0.
fn capabilities_set_gpu(c, v)            { store64(c + 16, v); return 0; }
# Set the TPM capability flag. Stored as given. Returns 0.
fn capabilities_set_tpm(c, v)            { store64(c + 24, v); return 0; }
# 1 when all four flags are equal, else 0.
fn capabilities_eq(a, b) {
    if (load64(a) != load64(b)) { return 0; }
    if (load64(a + 8) != load64(b + 8)) { return 0; }
    if (load64(a + 16) != load64(b + 16)) { return 0; }
    if (load64(a + 24) != load64(b + 24)) { return 0; }
    return 1;
}
# A ComponentConfig: one named component and its settings. 24 bytes:
#   +0 name (a Str), +8 enabled (a 0/1 flag), +16 settings (a cstr-keyed map,
#   created empty).
# name and enabled are stored as passed; there are no setters.
fn component_config_new(name: Str, enabled) {
    var c = _stik_alloc(24);
    store64(c, name);
    store64(c + 8, enabled);
    store64(c + 16, map_new());
    return c;
}
# Component name Str, as passed.
fn component_config_name(c)     { return load64(c); }
# Enabled flag (0/1), as passed.
fn component_config_enabled(c)  { return load64(c + 8); }
# Settings map (map_new, cstr keys), created empty at construction.
fn component_config_settings(c) { return load64(c + 16); }

# Display name of a MessageType: "Command", "Response", "Event" or "Heartbeat",
# and "Unknown" for a value outside the enum. message_type_parse is the inverse.
fn message_type_name(t) {
    if (t == MSG_COMMAND)        { return "Command"; }
    elif (t == MSG_RESPONSE)     { return "Response"; }
    elif (t == MSG_EVENT)        { return "Event"; }
    elif (t == MSG_HEARTBEAT)    { return "Heartbeat"; }
    return "Unknown";
}
# Inverse of message_type_name. Exact match on what message_type_name emits; an
# unrecognised string is an error rather than a silent default, so
# message_type_parse(message_type_name(v)) == v holds for every MessageType member.
fn message_type_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "Command") == 1) { return Ok(MSG_COMMAND); }
    elif (str_eq_cstr(s, "Response") == 1) { return Ok(MSG_RESPONSE); }
    elif (str_eq_cstr(s, "Event") == 1) { return Ok(MSG_EVENT); }
    elif (str_eq_cstr(s, "Heartbeat") == 1) { return Ok(MSG_HEARTBEAT); }
    return stik_err_invalid_argument(str_from("unknown MessageType name"));
}
# Display name of a SystemStatus: "Healthy", "Degraded" or "Critical".
# STATUS_UNKNOWN, and any value outside the enum, is "Unknown", the fallthrough
# rather than an explicit arm. system_status_parse is the inverse.
fn system_status_name(s) {
    if (s == STATUS_HEALTHY)     { return "Healthy"; }
    elif (s == STATUS_DEGRADED)  { return "Degraded"; }
    elif (s == STATUS_CRITICAL)  { return "Critical"; }
    return "Unknown";
}
# Inverse of system_status_name. Exact match on what system_status_name emits; an
# unrecognised string is an error rather than a silent default, so
# system_status_parse(system_status_name(v)) == v holds for every SystemStatus member.
# `Unknown` is STATUS_UNKNOWN's canonical name (it is produced by
# system_status_name's fallback, not by an explicit arm), so it maps back here.
fn system_status_parse(s: Str) {
    if (s == 0) { return _stik_err_no_value(); }
    if (str_eq_cstr(s, "Healthy") == 1) { return Ok(STATUS_HEALTHY); }
    elif (str_eq_cstr(s, "Degraded") == 1) { return Ok(STATUS_DEGRADED); }
    elif (str_eq_cstr(s, "Critical") == 1) { return Ok(STATUS_CRITICAL); }
    elif (str_eq_cstr(s, "Unknown") == 1) { return Ok(STATUS_UNKNOWN); }
    return stik_err_invalid_argument(str_from("unknown SystemStatus name"));
}
# Checked trait-object dispatch (v1.11.0), shared by the audit, secret-store and
# telemetry traits. A trait object is lib/trait.cyr's 16-byte { vtable, data }
# pair; these read that layout directly, so this module needs only fnptr.cyr.
# The fn pointer in `slot` of trait object `obj`'s vtable, or 0 when the object,
# its vtable or the slot is unset. `slot` must be within the vtable.
fn _stik_slot_fn(obj, slot) {
    if (obj == 0) { return 0; }
    var vt = load64(obj);
    if (vt == 0) { return 0; }
    return load64(vt + slot * 8);
}
# Call slot `slot` of trait object `obj` as fn(data) and return its result, or
# return 0 without calling anything when the slot is unset.
fn _stik_dispatch0(obj, slot) {
    var fp = _stik_slot_fn(obj, slot);
    if (fp == 0) { return 0; }
    return fncall1(fp, load64(obj + 8));
}
# Call slot `slot` of `obj` as fn(data, a); 0 when the slot is unset.
fn _stik_dispatch1(obj, slot, a) {
    var fp = _stik_slot_fn(obj, slot);
    if (fp == 0) { return 0; }
    return fncall2(fp, load64(obj + 8), a);
}
# Call slot `slot` of `obj` as fn(data, a, b); 0 when the slot is unset. A
# callback written as fn(data, a) still works: the arguments travel in
# registers on every target, and a two-parameter fn ignores the third.
fn _stik_dispatch2(obj, slot, a, b) {
    var fp = _stik_slot_fn(obj, slot);
    if (fp == 0) { return 0; }
    return fncall3(fp, load64(obj + 8), a, b);
}
