fn _b_agent_id_new() { agent_id_new(); return 0; }
fn _b_trace_context_new() { trace_context_new(); return 0; }
var _bench_parent = 0;
fn _b_trace_context_child() { tctx_child(_bench_parent); return 0; }
fn _b_sandbox_config() { sandbox_config_new(); return 0; }
fn _b_agent_id_to_str() { agent_id_to_str(agent_id_new()); return 0; }
fn _b_agent_id_roundtrip() { agent_id_from_str(agent_id_to_str(agent_id_new())); return 0; }
fn _b_version_to_str() { version_to_str(version_new(0, 90, 0)); return 0; }
var _bench_vs = 0;
fn _b_version_roundtrip() { var ver_t, ver = version_from_str(_bench_vs); version_to_str(ver); return 0; }
fn _b_traceparent() { tctx_to_traceparent(trace_context_new()); return 0; }
fn _b_inference_request() {
    var r = inference_request_new(str_from("llama3"));
    ireq_set_max_tokens(r, 1024);
    vec_push(ireq_messages(r), message_text(ROLE_USER, str_from("hello")));
    return 0;
}
fn _b_audit_entry() {
    audit_entry_new(str_from("e1"), agent_id_new(), str_from("read"), AUDIT_INFO);
    return 0;
}
fn _b_accel_device() {
    var d = accelerator_device_new(0, str_from("RTX 4090"), VENDOR_NVIDIA, DEV_GPU);
    adev_set_vram_total(d, 24576);
    return 0;
}
fn _b_token_usage() {
    var u = token_usage_new();
    tusage_set_prompt(u, 100);
    tusage_set_completion(u, 50);
    tusage_set_total(u, 150);
    return 0;
}
fn _b_security_context() {
    var ctx = security_context_new(agent_id_new());
    vec_push(secctx_permissions(ctx), PERM_FILE_READ);
    vec_push(secctx_permissions(ctx), PERM_NETWORK_ACCESS);
    return 0;
}
fn _b_message_build() {
    message_text(ROLE_SYSTEM, str_from("You are helpful."));
    message_text(ROLE_USER, str_from("What is Cyrius?"));
    message_text(ROLE_ASSISTANT, str_from("A systems language."));
    return 0;
}
# --- serde benchmark helpers ---
fn _ser(ptr, fn_ptr) {
    var sb = str_builder_new();
    fncall2(fn_ptr, ptr, sb);
    return str_builder_build(sb);
}
# --- OTLP encoder fixtures (v1.10.0), built once in main ---
var _bench_span_full = 0;
var _bench_span_min = 0;
var _bench_log = 0;
var _bench_metric_desc = 0;
var _bench_metric_points = 0;
# Encodes the prebuilt full span (3 attributes, 2 events, 1 link, a status).
fn _b_span_otlp_full() { _ser(_bench_span_full, &Span_to_otlp_proto); return 0; }
# Encodes the prebuilt span with no attributes, events or links.
fn _b_span_otlp_min() { _ser(_bench_span_min, &Span_to_otlp_proto); return 0; }
# Encodes the prebuilt log record (2 attributes, trace and span ids).
fn _b_log_otlp() { _ser(_bench_log, &LogRecord_to_otlp_proto); return 0; }
# Encodes the prebuilt counter metric with two data points.
fn _b_metric_otlp() {
    var sb = str_builder_new();
    var r_t, r = metric_to_otlp_proto(_bench_metric_desc, _bench_metric_points, sb);
    return 0;
}
# Builds the OTLP fixtures the tier5 rows encode; returns 0.
fn _bench_otlp_fixtures() {
    var sp = span_new(str_from("GET /api/v1/agents"), trace_id_new(), span_id_new());
    span_set_kind(sp, SPAN_SERVER);
    span_set_duration_ms(sp, 12);
    map_set(span_attributes(sp), "http.method", any_string(str_from("GET")));
    map_set(span_attributes(sp), "http.status_code", any_int(200));
    map_set(span_attributes(sp), "net.peer.name", any_string(str_from("agnos.local")));
    var e1 = span_event_new(str_from("auth.checked"));
    map_set(sevt_attributes(e1), "outcome", any_string(str_from("allow")));
    vec_push(span_events(sp), e1);
    vec_push(span_events(sp), span_event_new(str_from("db.query")));
    var l1 = span_link_new(trace_id_new(), span_id_new());
    map_set(slink_attributes(l1), "link.kind", any_string(str_from("follows_from")));
    vec_push(span_links(sp), l1);
    span_set_status(sp, SPAN_OK);
    _bench_span_full = sp;
    _bench_span_min = span_new(str_from("op"), trace_id_new(), span_id_new());
    var lr = log_record_new(LOG_WARN, str_from("disk usage above 90%"));
    map_set(logrec_attributes(lr), "mount", any_string(str_from("/var")));
    map_set(logrec_attributes(lr), "used_pct", any_int(93));
    logrec_set_trace_id(lr, trace_id_new());
    logrec_set_span_id(lr, span_id_new());
    _bench_log = lr;
    _bench_metric_desc = instrument_descriptor_new(str_from("http.server.requests"), str_from("Requests served"),
      str_from("{request}"), METRIC_COUNTER);
    var p1 = metric_data_point_new(str_from("http.server.requests"), metric_int(1042));
    map_set(mdp_attributes(p1), "route", any_string(str_from("/api/v1/agents")));
    var p2 = metric_data_point_new(str_from("http.server.requests"), metric_int(17));
    map_set(mdp_attributes(p2), "route", any_string(str_from("/health")));
    _bench_metric_points = vec_new();
    vec_push(_bench_metric_points, p1);
    vec_push(_bench_metric_points, p2);
    return 0;
}
var _bench_rl_json = 0;
var _bench_tu_json = 0;
var _bench_af_json = 0;
var _bench_is_json = 0;
var _bench_as_json = 0;
fn _b_rl_to_json() { _ser(resource_limits_new(), &ResourceLimits_to_json); return 0; }
fn _b_rl_from_json() { ResourceLimits_from_json_str(str_data(_bench_rl_json)); return 0; }
fn _b_tu_to_json() {
    var u = token_usage_new();
    tusage_set_prompt(u, 100);
    tusage_set_completion(u, 50);
    tusage_set_total(u, 150);
    _ser(u, &TokenUsage_to_json);
    return 0;
}
fn _b_tu_from_json() { TokenUsage_from_json_str(str_data(_bench_tu_json)); return 0; }
fn _b_af_to_json() {
    var f = accelerator_flags_new();
    aflags_set_cuda(f, 1);
    aflags_set_vulkan(f, 1);
    _ser(f, &AcceleratorFlags_to_json);
    return 0;
}
fn _b_af_from_json() { AcceleratorFlags_from_json_str(str_data(_bench_af_json)); return 0; }
fn _b_is_to_json() {
    var s = injection_scores_new();
    iscore_set_sql(s, 85);
    iscore_set_xss(s, 10);
    iscore_set_prompt_injection(s, 95);
    _ser(s, &InjectionScores_to_json);
    return 0;
}
fn _b_is_from_json() { InjectionScores_from_json_str(str_data(_bench_is_json)); return 0; }
fn _b_as_to_json() {
    var s = agent_stats_new();
    store64(s, 999);
    store64(s + 8, 50000);
    store64(s + 16, 86400);
    _ser(s, &AgentStats_to_json);
    return 0;
}
fn _b_as_from_json() { AgentStats_from_json_str(str_data(_bench_as_json)); return 0; }

# Prints a blank line then `label` as a tier heading between bench groups; returns 0.
fn tier(label) {
    syscall(SYS_WRITE, 1, "\n", 1);
    syscall(SYS_WRITE, 1, label, strlen(label));
    syscall(SYS_WRITE, 1, "\n", 1);
    return 0;
}
# Batch sizes (1.6.3): each row's window, batch x per-op time, is sized to
# about 1 ms or more. Since cyrius 6.6.5, lib/bench.cyr counts a window toward
# min/max only if it clears 100 x (clock floor + tick). That is ~225 us on the
# reference host and up to ~455 us on the Linux CI hosts bench.cyr documents.
# A row whose windows sat near that bar counted only its slow ones, so it could
# print a min above its avg. 5 rounds, not 10, hold peak RSS near 126 MB: the
# bump allocator never frees, and the fastest rows now run 250,000 iterations.
# The gate reads avg only; an interleaved A/B of the old and new sizes put 23 of
# 25 rows within 5%, the other two being 2-3 ns moves on 25-30 ns ops.
fn run(bname, fp, batch, rounds) {
    var b = bench_new(bname);
    bench_run_batch(b, fp, batch, rounds);
    bench_report(b);
    return 0;
}
# Bench entry: runs the five tiers (core, format, integration, serde, otlp),
# pre-building the JSON inputs the from_json rows parse and the OTLP fixtures;
# returns 0.
fn main() {
    _bench_parent = trace_context_new();
    _bench_vs = str_from("0.90.0");
    println("=== agnostik benchmarks ===");
    tier("[tier1] core");
    run("agent_id_new", &_b_agent_id_new, 2000, 5);
    run("trace_context_new", &_b_trace_context_new, 1000, 5);
    run("trace_context_child", &_b_trace_context_child, 2000, 5);
    run("sandbox_config_default", &_b_sandbox_config, 50000, 5);
    tier("[tier2] format");
    run("agent_id_to_str", &_b_agent_id_to_str, 2000, 5);
    run("agent_id_roundtrip", &_b_agent_id_roundtrip, 2000, 5);
    run("version_to_str", &_b_version_to_str, 10000, 5);
    run("version_roundtrip", &_b_version_roundtrip, 5000, 5);
    run("traceparent_format", &_b_traceparent, 1000, 5);
    tier("[tier3] integration");
    run("inference_request_full", &_b_inference_request, 5000, 5);
    run("audit_entry_full", &_b_audit_entry, 1000, 5);
    run("accelerator_device_full", &_b_accel_device, 20000, 5);
    run("security_context_full", &_b_security_context, 2000, 5);
    run("message_build_3turn", &_b_message_build, 5000, 5);
    run("token_usage_update", &_b_token_usage, 50000, 5);
    # Pre-generate JSON for from_json benchmarks
    _bench_rl_json = _ser(resource_limits_new(), &ResourceLimits_to_json);
    var _tu = token_usage_new();
    tusage_set_prompt(_tu, 100); tusage_set_completion(_tu, 50); tusage_set_total(_tu, 150);
    _bench_tu_json = _ser(_tu, &TokenUsage_to_json);
    var _af = accelerator_flags_new();
    aflags_set_cuda(_af, 1); aflags_set_vulkan(_af, 1);
    _bench_af_json = _ser(_af, &AcceleratorFlags_to_json);
    var _is = injection_scores_new();
    iscore_set_sql(_is, 85); iscore_set_xss(_is, 10); iscore_set_prompt_injection(_is, 95);
    _bench_is_json = _ser(_is, &InjectionScores_to_json);
    var _as = agent_stats_new();
    store64(_as, 999); store64(_as + 8, 50000); store64(_as + 16, 86400);
    _bench_as_json = _ser(_as, &AgentStats_to_json);
    tier("[tier4] serde");
    run("resource_limits_to_json", &_b_rl_to_json, 2000, 5);
    run("resource_limits_from_json", &_b_rl_from_json, 5000, 5);
    run("token_usage_to_json", &_b_tu_to_json, 2000, 5);
    run("token_usage_from_json", &_b_tu_from_json, 5000, 5);
    run("accel_flags_to_json", &_b_af_to_json, 1000, 5);
    run("accel_flags_from_json", &_b_af_from_json, 2000, 5);
    run("injection_scores_to_json", &_b_is_to_json, 2000, 5);
    run("injection_scores_from_json", &_b_is_from_json, 5000, 5);
    run("agent_stats_to_json", &_b_as_to_json, 2000, 5);
    run("agent_stats_from_json", &_b_as_from_json, 5000, 5);
    _bench_otlp_fixtures();
    tier("[tier5] otlp");
    run("span_otlp_full", &_b_span_otlp_full, 500, 5);
    run("span_otlp_min", &_b_span_otlp_min, 2000, 5);
    run("log_record_otlp", &_b_log_otlp, 1000, 5);
    run("metric_otlp_sum", &_b_metric_otlp, 1000, 5);
    println("\n=== done ===");
    return 0;
}
