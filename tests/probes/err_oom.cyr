# tests/probes/err_oom.cyr
#
# End-to-end check that agnostik_err_new survives an exhausted heap (the
# anuenue report fixed in 1.12.3). Not part of `cyrius test`: draining the heap
# with no address-space limit would map memory until the address space runs
# out. scripts/oom-probe.sh builds it and runs it under `prlimit --as`.
#
# It drains the heap in shrinking steps until even an 8-byte alloc returns 0,
# so the next allocation, agnostik_err_new's 24 bytes, must fail too. After
# that it uses only loads and sys_write. Exit 0 means the static error came
# back intact; until 1.12.3 the probe died of SIGSEGV writing to address 0.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/trait.cyr"
include "src/lib.cyr"

# Writes a C string to stderr; allocates nothing.
fn _probe_say(s) {
    sys_write(2, s, strlen(s));
    return 0;
}

# Allocates `step`-byte blocks until alloc returns 0; returns how many succeeded.
fn _probe_drain(step) {
    var n = 0;
    var more = 1;
    while (more == 1) {
        if (alloc(step) == 0) { more = 0; } else { n = n + 1; }
    }
    return n;
}

# Drains the heap, builds an error, and checks it is the static OOM error.
fn main() {
    var msg = str_from("disk unreadable");   # built while memory is available
    var big = _probe_drain(1048576);
    _probe_drain(4096);
    _probe_drain(8);
    if (big == 0) { _probe_say("err_oom: no 1 MiB block ever succeeded\n"); return 2; }
    if (alloc(24) != 0) { _probe_say("err_oom: heap not exhausted; raise the drain\n"); return 2; }
    var e = agnostik_err_new(STIK_ERR_IO, msg);
    if (e == 0) { _probe_say("err_oom: agnostik_err_new returned 0\n"); return 1; }
    if (agnostik_err_kind(e) != STIK_ERR_RESOURCE_EXHAUSTED) { _probe_say("err_oom: wrong kind\n"); return 1; }
    if (agnostik_err_code(e) != CODE_RESOURCE_EXHAUSTED) { _probe_say("err_oom: wrong code\n"); return 1; }
    var m = agnostik_err_message(e);
    if (m == 0) { _probe_say("err_oom: no message\n"); return 1; }
    if (str_eq_cstr(m, "out of memory") != 1) { _probe_say("err_oom: wrong message\n"); return 1; }
    # A stik_err_* constructor goes through the same path; the value-form Err allocates nothing.
    var t, v = stik_err_io(msg);
    if (is_err_result(t) != 1) { _probe_say("err_oom: stik_err_io did not return Err\n"); return 1; }
    if (v != e) { _probe_say("err_oom: stik_err_io did not get the static error\n"); return 1; }
    _probe_say("err_oom: printed under an exhausted heap -> ");
    agnostik_err_print(e);
    _probe_say("err_oom: ok\n");
    return 0;
}
