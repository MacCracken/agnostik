# test_coverage_3.tcyr — extended coverage for hardware module
# P(-1) hardening: all device accessors/setters, flags, summary

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/trait.cyr"
include "lib/assert.cyr"
include "src/lib.cyr"

# Test: AcceleratorDevice constructor fields, defaults, and a set/get roundtrip on every setter.
fn test_hardware_device() {
    var dev = accelerator_device_new(0, str_from("A100"), VENDOR_NVIDIA, DEV_GPU);
    assert_eq(AcceleratorDevice_index(dev), 0, "dev index 0");
    assert_eq(str_eq(AcceleratorDevice_name(dev), str_from("A100")), 1, "dev name A100");
    assert_eq(AcceleratorDevice_vendor(dev), VENDOR_NVIDIA, "dev vendor nvidia");
    assert_eq(AcceleratorDevice_family(dev), DEV_GPU, "dev family gpu");
    assert_eq(AcceleratorDevice_vram_total(dev), 0, "dev default vram_total 0");
    assert_eq(AcceleratorDevice_vram_used(dev), 0, "dev default vram_used 0");
    assert_eq(AcceleratorDevice_utilization(dev), 0, "dev default util 0");
    assert_eq(AcceleratorDevice_temperature(dev), 0, "dev default temp 0");
    assert_eq(AcceleratorDevice_driver_version(dev), 0, "dev default no driver");
    assert_eq(AcceleratorDevice_compute_capability(dev), 0, "dev default no compute");
    assert_eq(AcceleratorDevice_power_watts(dev), 0, "dev default power 0");
    assert_eq(AcceleratorDevice_memory_bandwidth_gbps(dev), 0, "dev default bw 0");
    assert_eq(AcceleratorDevice_memory_type(dev), MEM_UNKNOWN, "dev default memtype unknown");
    assert_eq(AcceleratorDevice_health(dev), HEALTH_OK, "dev default health ok");
    assert(AcceleratorDevice_flags(dev) != 0, "dev has flags");
    # set + get roundtrip for all settable fields
    AcceleratorDevice_set_vram_total(dev, 81920);
    AcceleratorDevice_set_vram_used(dev, 40960);
    AcceleratorDevice_set_utilization(dev, 75);
    AcceleratorDevice_set_temperature(dev, 72);
    AcceleratorDevice_set_driver_version(dev, str_from("535.104.05"));
    AcceleratorDevice_set_compute_capability(dev, str_from("8.0"));
    AcceleratorDevice_set_power_watts(dev, 300);
    AcceleratorDevice_set_memory_bandwidth_gbps(dev, 2039);
    AcceleratorDevice_set_memory_type(dev, MEM_HBM2E);
    AcceleratorDevice_set_health(dev, HEALTH_DEGRADED);
    assert_eq(AcceleratorDevice_vram_total(dev), 81920, "dev set vram_total");
    assert_eq(AcceleratorDevice_vram_used(dev), 40960, "dev set vram_used");
    assert_eq(AcceleratorDevice_utilization(dev), 75, "dev set util");
    assert_eq(AcceleratorDevice_temperature(dev), 72, "dev set temp");
    assert_eq(str_eq(AcceleratorDevice_driver_version(dev), str_from("535.104.05")), 1, "dev set driver");
    assert_eq(str_eq(AcceleratorDevice_compute_capability(dev), str_from("8.0")), 1, "dev set compute");
    assert_eq(AcceleratorDevice_power_watts(dev), 300, "dev set power");
    assert_eq(AcceleratorDevice_memory_bandwidth_gbps(dev), 2039, "dev set bw");
    assert_eq(AcceleratorDevice_memory_type(dev), MEM_HBM2E, "dev set memtype");
    assert_eq(AcceleratorDevice_health(dev), HEALTH_DEGRADED, "dev set health");
    return 0;
}

# Test: all nine AcceleratorFlags default to 0 and read back 1 after their setters.
fn test_hardware_flags() {
    var af = accelerator_flags_new();
    assert_eq(AcceleratorFlags_cuda_available(af), 0, "af default no cuda");
    assert_eq(AcceleratorFlags_rocm_available(af), 0, "af default no rocm");
    assert_eq(AcceleratorFlags_metal_available(af), 0, "af default no metal");
    assert_eq(AcceleratorFlags_vulkan_available(af), 0, "af default no vulkan");
    assert_eq(AcceleratorFlags_oneapi_available(af), 0, "af default no oneapi");
    assert_eq(AcceleratorFlags_tpu_available(af), 0, "af default no tpu");
    assert_eq(AcceleratorFlags_sycl_available(af), 0, "af default no sycl");
    assert_eq(AcceleratorFlags_openvino_available(af), 0, "af default no openvino");
    assert_eq(AcceleratorFlags_directml_available(af), 0, "af default no directml");
    AcceleratorFlags_set_cuda_available(af, 1);
    AcceleratorFlags_set_rocm_available(af, 1);
    AcceleratorFlags_set_metal_available(af, 1);
    AcceleratorFlags_set_vulkan_available(af, 1);
    AcceleratorFlags_set_oneapi_available(af, 1);
    AcceleratorFlags_set_tpu_available(af, 1);
    AcceleratorFlags_set_sycl_available(af, 1);
    AcceleratorFlags_set_openvino_available(af, 1);
    AcceleratorFlags_set_directml_available(af, 1);
    assert_eq(AcceleratorFlags_cuda_available(af), 1, "af set cuda");
    assert_eq(AcceleratorFlags_rocm_available(af), 1, "af set rocm");
    assert_eq(AcceleratorFlags_metal_available(af), 1, "af set metal");
    assert_eq(AcceleratorFlags_vulkan_available(af), 1, "af set vulkan");
    assert_eq(AcceleratorFlags_oneapi_available(af), 1, "af set oneapi");
    assert_eq(AcceleratorFlags_tpu_available(af), 1, "af set tpu");
    assert_eq(AcceleratorFlags_sycl_available(af), 1, "af set sycl");
    assert_eq(AcceleratorFlags_openvino_available(af), 1, "af set openvino");
    assert_eq(AcceleratorFlags_directml_available(af), 1, "af set directml");
    return 0;
}

# Test: AcceleratorSummary device count, total VRAM, and by_vendor / by_family filtering.
fn test_hardware_summary() {
    var sum = accelerator_summary_new();
    assert_eq(vec_len(AcceleratorSummary_devices(sum)), 0, "sum default no devices");
    assert_eq(AcceleratorSummary_total_vram(sum), 0, "sum default 0 vram");
    var d1 = accelerator_device_new(0, str_from("RTX 4090"), VENDOR_NVIDIA, DEV_GPU);
    AcceleratorDevice_set_vram_total(d1, 24576);
    var d2 = accelerator_device_new(1, str_from("MI300X"), VENDOR_AMD, DEV_GPU);
    AcceleratorDevice_set_vram_total(d2, 192000);
    var d3 = accelerator_device_new(2, str_from("Gaudi2"), VENDOR_HABANA, DEV_AI_ASIC);
    AcceleratorDevice_set_vram_total(d3, 98304);
    asum_add_device(sum, d1);
    asum_add_device(sum, d2);
    asum_add_device(sum, d3);
    assert_eq(vec_len(AcceleratorSummary_devices(sum)), 3, "sum 3 devices");
    assert_eq(AcceleratorSummary_total_vram(sum), 314880, "sum total vram");
    assert_eq(vec_len(asum_by_vendor(sum, VENDOR_NVIDIA)), 1, "sum 1 nvidia");
    assert_eq(vec_len(asum_by_vendor(sum, VENDOR_AMD)), 1, "sum 1 amd");
    assert_eq(vec_len(asum_by_vendor(sum, VENDOR_INTEL)), 0, "sum 0 intel");
    assert_eq(vec_len(asum_by_vendor(sum, VENDOR_HABANA)), 1, "sum 1 habana");
    assert_eq(vec_len(asum_by_family(sum, DEV_GPU)), 2, "sum 2 gpus");
    assert_eq(vec_len(asum_by_family(sum, DEV_AI_ASIC)), 1, "sum 1 asic");
    assert_eq(vec_len(asum_by_family(sum, DEV_TPU)), 0, "sum 0 tpus");
    return 0;
}

# Test-file entry: runs every hardware coverage test above; returns the assertion summary.
fn main() {
    println("=== agnostik extended coverage 3 (hardware) ===");
    test_hardware_device();
    test_hardware_flags();
    test_hardware_summary();
    println("");
    return assert_summary();
}
