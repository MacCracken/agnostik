# tests/tcyr/test_v1110_contract_gaps.tcyr
#
# v1.11.0: the contract gaps the v1.9.0 documentation pass recorded.
#   - the four newer Landlock rights, at the kernel's bit indices, and the
#     RlimitType → RLIMIT_* mapping;
#   - agent_id_from_str's dash check;
#   - the optional vtable slots: checked dispatchers that return an
#     unsupported-operation Err instead of calling address 0;
#   - textmap_set, propagator_inject and ss_put pass their second argument to
#     the callback directly, so nested calls do not clobber each other;
#   - the missing setters and getters.
# Kernel numbers come from linux-api-headers 7.2 (linux/landlock.h,
# asm-generic/resource.h).

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/trait.cyr"
include "lib/assert.cyr"
include "src/lib.cyr"

# The four newer rights sit at the kernel's bit indices, after the old ones.
fn test_landlock_new_rights() {
    assert_eq(LL_TRUNCATE, 14, "existing fs values unchanged");
    assert_eq(LL_IOCTL_DEV, 15, "LANDLOCK_ACCESS_FS_IOCTL_DEV is bit 15");
    assert_eq(LL_RESOLVE_UNIX, 16, "LANDLOCK_ACCESS_FS_RESOLVE_UNIX is bit 16");
    assert_eq(1 << LL_IOCTL_DEV, 0x8000, "1 << v is the kernel flag");
    assert_eq(1 << LL_RESOLVE_UNIX, 0x10000, "1 << v is the kernel flag (resolve)");
    assert_eq(LL_CONNECT_TCP, 1, "existing net values unchanged");
    assert_eq(LL_BIND_UDP, 2, "LANDLOCK_ACCESS_NET_BIND_UDP is bit 2");
    assert_eq(LL_CONNECT_SEND_UDP, 3, "LANDLOCK_ACCESS_NET_CONNECT_SEND_UDP is bit 3");
    assert(str_eq_cstr(str_from(landlock_fs_access_name(LL_IOCTL_DEV)), "IoctlDev") == 1, "crate spelling");
    assert(str_eq_cstr(str_from(landlock_fs_access_name(LL_RESOLVE_UNIX)), "ResolveUnix") == 1, "crate spelling");
    assert(str_eq_cstr(str_from(landlock_net_access_name(LL_BIND_UDP)), "BindUdp") == 1, "BindUdp");
    assert(str_eq_cstr(str_from(landlock_net_access_name(LL_CONNECT_SEND_UDP)), "ConnectSendUdp") == 1,
      "ConnectSendUdp");
    var a_t, a = landlock_fs_access_parse(str_from("IoctlDev"));
    assert(is_ok(a_t) == 1, "IoctlDev parses");
    assert_eq(a, LL_IOCTL_DEV, "IoctlDev round-trips");
    var b_t, b = landlock_fs_access_parse(str_from("ResolveUnix"));
    assert_eq(b, LL_RESOLVE_UNIX, "ResolveUnix round-trips");
    var c_t, c = landlock_net_access_parse(str_from("BindUdp"));
    assert_eq(c, LL_BIND_UDP, "BindUdp round-trips");
    var d_t, d = landlock_net_access_parse(str_from("ConnectSendUdp"));
    assert_eq(d, LL_CONNECT_SEND_UDP, "ConnectSendUdp round-trips");
    assert(str_eq_cstr(str_from(landlock_fs_access_name(17)), "Unknown") == 1, "17 is past the fs rights");
    assert(str_eq_cstr(str_from(landlock_net_access_name(4)), "Unknown") == 1, "4 is past the net rights");
    return 0;
}

# rlimit_type_resource gives the asm-generic RLIMIT_* number for each member.
fn test_rlimit_type_resource() {
    assert_eq(rlimit_type_resource(RLIM_NOFILE), 7, "RLIMIT_NOFILE");
    assert_eq(rlimit_type_resource(RLIM_NPROC), 6, "RLIMIT_NPROC");
    assert_eq(rlimit_type_resource(RLIM_ADDRESS_SPACE), 9, "RLIMIT_AS");
    assert_eq(rlimit_type_resource(RLIM_FILE_SIZE), 1, "RLIMIT_FSIZE");
    assert_eq(rlimit_type_resource(RLIM_CORE), 4, "RLIMIT_CORE");
    assert_eq(rlimit_type_resource(RLIM_DATA), 2, "RLIMIT_DATA");
    assert_eq(rlimit_type_resource(RLIM_STACK), 3, "RLIMIT_STACK");
    assert_eq(rlimit_type_resource(RLIM_MEMLOCK), 8, "RLIMIT_MEMLOCK");
    assert_eq(rlimit_type_resource(RLIM_SIGPENDING), 11, "RLIMIT_SIGPENDING");
    assert_eq(rlimit_type_resource(RLIM_MSGQUEUE), 12, "RLIMIT_MSGQUEUE");
    assert_eq(rlimit_type_resource(RLIM_MSGQUEUE + 1), 0 - 1, "outside the enum");
    assert_eq(rlimit_type_resource(0 - 1), 0 - 1, "negative");
    # A limits.conf item name maps straight to the kernel number.
    var r_t, r = rlimit_type_parse(str_from("nofile"));
    assert_eq(rlimit_type_resource(r), 7, "\"nofile\" is RLIMIT_NOFILE");
    return 0;
}

# 1 if agent_id_from_str accepts the cstr `u`.
fn id_ok(u) {
    var r_t, r = agent_id_from_str(str_from(u));
    return is_ok(r_t);
}

# The four separators must be '-'; every UUID version and variant parses.
fn test_agent_id_dashes() {
    assert_eq(id_ok("0af76519-16cd-43dd-8448-eb211c80319c"), 1, "canonical v4 parses");
    assert_eq(id_ok("0af76519x16cd-43dd-8448-eb211c80319c"), 0, "position 8 must be '-'");
    assert_eq(id_ok("0af76519-16cdx43dd-8448-eb211c80319c"), 0, "position 13 must be '-'");
    assert_eq(id_ok("0af76519-16cd-43ddx8448-eb211c80319c"), 0, "position 18 must be '-'");
    assert_eq(id_ok("0af76519-16cd-43dd-8448xeb211c80319c"), 0, "position 23 must be '-'");
    assert_eq(id_ok("0af76519016cd043dd08448-eb211c80319c"), 0, "a hex digit in a separator slot");
    assert_eq(id_ok("0af76519-16cd-43dd-8448-eb211c80319-"), 0, "a dash outside the separators");
    assert_eq(id_ok("0AF76519-16CD-43DD-8448-EB211C80319C"), 1, "upper-case hex");
    assert_eq(id_ok("c232ab00-9414-11ec-b3c8-9f6bdeced846"), 1, "v1 accepted (ADR-005)");
    assert_eq(id_ok("017f22e2-79b0-7cc3-98c4-dc0c0c07398f"), 1, "v7 accepted");
    assert_eq(id_ok("00000000-0000-0000-0000-000000000000"), 1, "nil UUID accepted");
    assert_eq(id_ok("ffffffff-ffff-ffff-ffff-ffffffffffff"), 1, "max UUID accepted");
    var u_t, u = user_id_from_str(str_from("0af76519 16cd-43dd-8448-eb211c80319c"));
    assert(is_err_result(u_t) == 1, "user_id_from_str checks too");
    # Generated ids still round-trip.
    var id = agent_id_new();
    var r_t, r = agent_id_from_str(agent_id_to_str(id));
    assert(is_ok(r_t) == 1, "agent_id_new round-trips");
    assert(agent_id_eq(r, id) == 1, "same bytes");
    # AgentInfo_from_json reads a malformed id as 0, as it does any invalid field.
    var ai = AgentInfo_from_json(str_from("{\"id\":\"0af76519+16cd-43dd-8448-eb211c80319c\",\"name\":\"n\"}"));
    assert_eq(ainfo_id(ai), 0, "malformed id in JSON reads as 0");
    return 0;
}

# ─── vtable slots ────

# Audit-sink callbacks: record what they were called with in `data` (+0 last
# arg) and return a recognisable value.
fn cb_append(data, entry) {
    store64(data, entry);
    return 11;
}
# verify_chain stand-in: returns 12.
fn cb_verify_chain(data) { return 12; }
# verify_entry stand-in: records the entry, returns 13.
fn cb_verify_entry(data, entry) {
    store64(data, entry);
    return 13;
}
# query stand-in: records the filter, returns 14.
fn cb_query(data, filter) {
    store64(data, filter);
    return 14;
}
# seal stand-in: returns 15.
fn cb_seal(data) { return 15; }

# Unset optional slots are not called: verify_entry and seal return 0, query
# returns a not-supported Err; set slots dispatch with the data pointer first.
fn test_audit_sink_slots() {
    var data = alloc(8);
    var vt = audit_sink_vtable(&cb_append, &cb_verify_chain);
    var sink = audit_sink_new(vt, data);
    assert_eq(as_append(sink, 77), 11, "append dispatches");
    assert_eq(load64(data), 77, "append got the entry after the data pointer");
    assert_eq(as_verify_chain(sink), 12, "verify_chain dispatches");
    assert_eq(as_verify_entry(sink, 5), 0, "unset verify_entry: 0, not a call to address 0");
    assert_eq(as_seal(sink), 0, "unset seal: 0");
    var q_t, q = as_query(sink, 3);
    assert(is_err_result(q_t) == 1, "unset query: Err");
    assert_eq(agnostik_err_kind(q), STIK_ERR_NOT_SUPPORTED, "not-supported kind");
    assert_eq(agnostik_err_code(q), CODE_NOT_SUPPORTED, "code 1007");
    assert_eq(audit_sink_has(sink, AS_APPEND), 1, "has append");
    assert_eq(audit_sink_has(sink, AS_VERIFY_ENTRY), 0, "lacks verify_entry");
    assert_eq(audit_sink_has(sink, AS_SEAL + 1), 0, "slot past the vtable");
    assert_eq(audit_sink_has(sink, 0 - 1), 0, "negative slot");
    audit_sink_set_verify_entry(vt, &cb_verify_entry);
    audit_sink_set_query(vt, &cb_query);
    audit_sink_set_seal(vt, &cb_seal);
    assert_eq(as_verify_entry(sink, 6), 13, "set verify_entry dispatches");
    assert_eq(load64(data), 6, "verify_entry got the entry");
    var r_t, r = as_query(sink, 9);
    assert(is_ok(r_t) == 1, "set query: Ok");
    assert_eq(r, 14, "query result passed through");
    assert_eq(load64(data), 9, "query got the filter");
    assert_eq(as_seal(sink), 15, "set seal dispatches");
    assert_eq(audit_sink_has(sink, AS_SEAL), 1, "has seal once set");
    # A 0 required slot, a 0 vtable and a 0 sink are not called either.
    var empty = audit_sink_new(audit_sink_vtable(0, 0), data);
    assert_eq(as_append(empty, 1), 0, "0 append slot");
    assert_eq(as_verify_chain(audit_sink_new(0, data)), 0, "0 vtable");
    assert_eq(as_seal(0), 0, "0 sink");
    return 0;
}

# Secret-store stand-ins for rotate and search_by_tag: return 21 / 22.
fn cb_rotate(data, sname) { return 21; }
# search_by_tag stand-in: records the tag, returns 22.
fn cb_search(data, tag) {
    store64(data, tag);
    return 22;
}

# ss_rotate and ss_search_by_tag: Err until their slots are set.
fn test_secret_store_slots() {
    var data = alloc(8);
    var vt = secret_store_vtable(0, 0, 0, 0);
    var st = secret_store_new(vt, data);
    var a_t, a = ss_rotate(st, str_from("k"));
    assert(is_err_result(a_t) == 1, "unset rotate: Err");
    assert_eq(agnostik_err_kind(a), STIK_ERR_NOT_SUPPORTED, "rotate: not supported");
    var b_t, b = ss_search_by_tag(st, str_from("t"));
    assert(is_err_result(b_t) == 1, "unset search_by_tag: Err");
    assert_eq(ss_get(st, str_from("k")), 0, "0 get slot not called");
    assert_eq(ss_list_metadata(st), 0, "0 list slot not called");
    assert_eq(secret_store_has(st, SS_ROTATE), 0, "lacks rotate");
    secret_store_set_rotate(vt, &cb_rotate);
    secret_store_set_search_by_tag(vt, &cb_search);
    var c_t, c = ss_rotate(st, str_from("k"));
    assert_eq(c, 21, "rotate dispatches");
    var tag = str_from("prod");
    var d_t, d = ss_search_by_tag(st, tag);
    assert(is_ok(d_t) == 1, "search_by_tag: Ok");
    assert_eq(d, 22, "search_by_tag result");
    assert_eq(load64(data), tag, "search_by_tag got the tag");
    assert_eq(secret_store_has(st, SS_SEARCH_BY_TAG), 1, "has search_by_tag");
    assert_eq(secret_store_has(st, SS_SEARCH_BY_TAG + 1), 0, "slot past the vtable");
    return 0;
}

# ─── hand-offs ────

# A second carrier the outer set_fn writes to before recording its own value.
var _inner_carrier = 0;

# set_fn that makes a nested textmap_set, then records (key, value) in data.
fn cb_set_nested(data, key, value) {
    if (_inner_carrier != 0) {
        var inner = _inner_carrier;
        _inner_carrier = 0;
        textmap_set(inner, "inner-key", "inner-value");
    }
    store64(data, key);
    store64(data + 8, value);
    return 31;
}
# set_fn in the pre-v1.11.0 shape: two parameters, value from the global.
fn cb_set_old(data, key) {
    store64(data, key);
    store64(data + 8, _textmap_extra);
    return 32;
}

# A nested textmap_set no longer clobbers the outer call's value, and a
# two-parameter set_fn still reads it from the global.
fn test_textmap_set_reentrant() {
    var outer_d = alloc(16);
    var inner_d = alloc(16);
    var outer = textmap_carrier_new(textmap_carrier_vtable(0, &cb_set_nested), outer_d);
    _inner_carrier = textmap_carrier_new(textmap_carrier_vtable(0, &cb_set_nested), inner_d);
    assert_eq(textmap_set(outer, "outer-key", "outer-value"), 31, "set_fn result");
    assert(streq(load64(outer_d + 8), "outer-value") == 1, "outer value survives the nested call");
    assert(streq(load64(inner_d + 8), "inner-value") == 1, "inner call got its own value");
    var old_d = alloc(16);
    var old = textmap_carrier_new(textmap_carrier_vtable(0, &cb_set_old), old_d);
    assert_eq(textmap_set(old, "k", "v"), 32, "old-shape set_fn called");
    assert(streq(load64(old_d + 8), "v") == 1, "old-shape set_fn reads the global");
    assert_eq(textmap_get(old, "k"), 0, "unset get slot not called");
    return 0;
}

# inject_fn recording (context, carrier) after a nested inject.
var _inner_prop = 0;
# inject_fn that injects through another propagator first.
fn cb_inject_nested(data, context, carrier) {
    if (_inner_prop != 0) {
        var p = _inner_prop;
        _inner_prop = 0;
        propagator_inject(p, 2, 222);
    }
    store64(data, context);
    store64(data + 8, carrier);
    return 41;
}

# A nested propagator_inject no longer clobbers the outer carrier.
fn test_propagator_inject_reentrant() {
    var od = alloc(16);
    var id = alloc(16);
    var outer = propagator_new(textmap_propagator_vtable(&cb_inject_nested, 0), od);
    _inner_prop = propagator_new(textmap_propagator_vtable(&cb_inject_nested, 0), id);
    assert_eq(propagator_inject(outer, 1, 111), 41, "inject_fn result");
    assert_eq(load64(od + 8), 111, "outer carrier survives the nested inject");
    assert_eq(load64(id + 8), 222, "inner inject got its carrier");
    assert_eq(propagator_extract(outer, 5), 0, "unset extract slot not called");
    return 0;
}

# put fn recording (sname, value) after a nested put.
var _inner_store = 0;
# put fn that puts into another store first.
fn cb_put_nested(data, sname, value) {
    if (_inner_store != 0) {
        var st = _inner_store;
        _inner_store = 0;
        ss_put(st, str_from("inner"), str_from("inner-secret"));
    }
    store64(data, sname);
    store64(data + 8, value);
    return 51;
}

# A nested ss_put no longer clobbers the outer value.
fn test_ss_put_reentrant() {
    var od = alloc(16);
    var id = alloc(16);
    var outer = secret_store_new(secret_store_vtable(0, &cb_put_nested, 0, 0), od);
    _inner_store = secret_store_new(secret_store_vtable(0, &cb_put_nested, 0, 0), id);
    var v = str_from("outer-secret");
    assert_eq(ss_put(outer, str_from("outer"), v), 51, "put fn result");
    assert_eq(load64(od + 8), v, "outer value survives the nested put");
    assert(str_eq_cstr(load64(id + 8), "inner-secret") == 1, "inner put got its value");
    return 0;
}

# ─── setters ────

# Every v1.11.0 setter stores what its getter reads, without touching the
# neighbouring fields: each field gets a distinct value, then all are read back.
fn test_setters_round_trip() {
    var ok = 0;
    var n = 0;
    var o1 = resource_usage_new();
    rusage_set_memory(o1, 7010);
    rusage_set_cpu(o1, 7011);
    rusage_set_fds(o1, 7012);
    rusage_set_procs(o1, 7013);
    if (rusage_memory(o1) == 7010) { ok = ok + 1; }
    n = n + 1;
    if (rusage_cpu(o1) == 7011) { ok = ok + 1; }
    n = n + 1;
    if (rusage_fds(o1) == 7012) { ok = ok + 1; }
    n = n + 1;
    if (rusage_procs(o1) == 7013) { ok = ok + 1; }
    n = n + 1;
    var o2 = agnostik_health_check_new();
    hc_set_probe_type(o2, 7020);
    hc_set_interval(o2, 7021);
    hc_set_timeout(o2, 7022);
    hc_set_retries(o2, 7023);
    hc_set_initial_delay(o2, 7024);
    if (hc_probe_type(o2) == 7020) { ok = ok + 1; }
    n = n + 1;
    if (hc_interval(o2) == 7021) { ok = ok + 1; }
    n = n + 1;
    if (hc_timeout(o2) == 7022) { ok = ok + 1; }
    n = n + 1;
    if (hc_retries(o2) == 7023) { ok = ok + 1; }
    n = n + 1;
    if (hc_initial_delay(o2) == 7024) { ok = ok + 1; }
    n = n + 1;
    var o3 = agent_config_new(str_from("a"));
    aconf_set_metadata(o3, 7030);
    aconf_set_startup_timeout(o3, 7031);
    aconf_set_shutdown_timeout(o3, 7032);
    aconf_set_restart_backoff(o3, 7033);
    if (aconf_metadata(o3) == 7030) { ok = ok + 1; }
    n = n + 1;
    if (aconf_startup_timeout(o3) == 7031) { ok = ok + 1; }
    n = n + 1;
    if (aconf_shutdown_timeout(o3) == 7032) { ok = ok + 1; }
