    n = n + 1;
    if (arl_concurrent(o4) == 7042) { ok = ok + 1; }
    n = n + 1;
    var o5 = agent_stats_new();
    astats_set_requests(o5, 7050);
    astats_set_tokens(o5, 7051);
    astats_set_uptime(o5, 7052);
    if (astats_requests(o5) == 7050) { ok = ok + 1; }
    n = n + 1;
