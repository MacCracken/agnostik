    n = n + 1;
    assert_eq(n, 91, "every setter exercised");
    assert_eq(ok, n, "every setter round-trips through its getter");
    # The two getters that were missing read their setters' slots.
    var sb = sandbox_config_new();
    assert_eq(sandbox_apparmor(sb), 0, "AppArmor unset reads 0");
    var aa = str_from("agnos-default");
    var se = str_from("system_u:system_r:agnos_t:s0");
    sandbox_set_apparmor(sb, aa);
    sandbox_set_selinux(sb, se);
    assert_eq(sandbox_apparmor(sb), aa, "sandbox_apparmor reads sandbox_set_apparmor");
    assert_eq(sandbox_selinux(sb), se, "sandbox_selinux reads sandbox_set_selinux");
    # A value set through a setter reaches the serializers and encoders.
    var cfg = telemetry_config_new();
    telcfg_set_endpoint(cfg, str_from("http://collector:4318"));
    var jb = str_builder_new();
    TelemetryConfig_to_json(cfg, jb);
    var back = TelemetryConfig_from_json(str_builder_build(jb));
    assert(str_eq_cstr(telcfg_endpoint(back), "http://collector:4318") == 1, "endpoint set and serialized");
    return 0;
}

# Test-file entry: runs every test, returns the assertion summary.
fn main() {
    println("--- v1.11.0 contract gaps ---");
    test_landlock_new_rights();
    test_rlimit_type_resource();
    test_agent_id_dashes();
    test_audit_sink_slots();
    test_secret_store_slots();
    test_textmap_set_reentrant();
    test_propagator_inject_reentrant();
    test_ss_put_reentrant();
    test_setters_round_trip();
    return assert_summary();
}
