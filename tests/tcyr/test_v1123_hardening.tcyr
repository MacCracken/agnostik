# tests/tcyr/test_v1123_hardening.tcyr
#
# v1.12.3: the last v1 repair cycle (a P(-1) pass) and the consumer report it
# starts from. One test per finding, F-028..F-047 (docs/audit/2026-10-28-audit.md
# §"v1.12.3 P(-1) pass"), plus fuzz targets whose oracles come from the
# generators, not from the code under test. The allocation-failure paths that
# need an exhausted heap or exit the process live in tests/probes/, run under
# `prlimit --as` by scripts/oom-probe.sh.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/trait.cyr"
include "lib/assert.cyr"
include "src/lib.cyr"

# F-037: these names were agnostik's private globals through 1.12.2. Same-named
# globals merge across libraries with no diagnostic, so a consumer's own
# definitions replaced agnostik's: every UUID became ZZZZZZZZ-... and a genuine
# genesis record stopped being recognised. Since 1.12.3 agnostik's are
# _stik_-prefixed and its genesis cache does not read GENESIS_HASH.
var _hex_lut = "ZZZZZZZZZZZZZZZZ";
var _genesis_hash_str = 0;

# ─── helpers ────

var _RNG = 0;
# Seed the xorshift generator (0 becomes 1).
fn rng_init(seed) {
    if (_RNG == 0) { _RNG = alloc(8); }
    if (seed == 0) { seed = 1; }
    store64(_RNG, seed);
    return 0;
}
# Next 64-bit xorshift value.
fn rng_next() {
    var s = load64(_RNG);
    s = s ^ (s << 13);
    s = s ^ (s >> 7);
    s = s ^ (s << 17);
    store64(_RNG, s);
    return s;
}
# A random value in 0..n-1.
fn rng_below(n) { return (rng_next() & 0x7FFFFFFF) % n; }

# Lower-case hex of a Str's bytes.
fn hex_of(s) {
    var d = "0123456789abcdef";
    var sb = str_builder_new();
    var i = 0;
    while (i < str_len(s)) {
        var b = load8(str_data(s) + i);
        str_builder_putc(sb, load8(d + (b >> 4)));
        str_builder_putc(sb, load8(d + (b & 15)));
        i = i + 1;
    }
    return str_builder_build(sb);
}
# 1 when Str `hay` contains C string `needle`, else 0.
fn str_has(hay, needle) {
    var n = strlen(needle);
    var i = 0;
    var found = 0;
    while (i + n <= str_len(hay) && found == 0) {
        if (memeq(str_data(hay) + i, needle, n) == 1) { found = 1; }
        i = i + 1;
    }
    return found;
}
# Serialize `ptr` with a T_to_json fn pointer into a fresh Str.
fn ser(ptr, fp) {
    var sb = str_builder_new();
    fncall2(fp, ptr, sb);
    return str_builder_build(sb);
}
# A Span with fixed ids and start time, so two encodings can be compared.
var _IDS = 0;
# Fixed 16-byte trace id / 8-byte span id buffers.
fn fixed_ids() {
    if (_IDS == 0) {
        _IDS = alloc(24);
        var i = 0;
        while (i < 24) { store8(_IDS + i, i + 1); i = i + 1; }
    }
    return _IDS;
}
# A span named "s" with fixed ids and start time 1000.
fn fixed_span() {
    var ids = fixed_ids();
    var sp = span_new(str_from("s"), ids, ids + 16);
    store64(sp + 48, 1000);
    return sp;
}
# Span_to_otlp_proto of `sp` as a Str.
fn enc_span(sp) {
    var sb = str_builder_new();
    Span_to_otlp_proto(sp, sb);
    return str_builder_build(sb);
}

# ─── F-028: allocation failure ────

# The static out-of-memory error reads like any AgnostikError, is the same
# object on every call, and lives outside the heap.
fn test_err_oom_static() {
    var e = _stik_err_oom();
    assert(e != 0, "never 0");
    assert_eq(agnostik_err_kind(e), STIK_ERR_RESOURCE_EXHAUSTED, "kind: resource exhausted");
    assert_eq(agnostik_err_code(e), CODE_RESOURCE_EXHAUSTED, "code 1005");
    assert_eq(agnostik_err_is_retriable(e), 1, "retriable, like any exhaustion");
    var m = agnostik_err_message(e);
    assert(m != 0, "has a message");
    assert(str_eq_cstr(m, "out of memory") == 1, "message is 'out of memory'");
    assert_eq(str_len(m), 13, "message length");
    assert_eq(_stik_err_oom(), e, "the same object every call");
    var other = agnostik_err_new(STIK_ERR_IO, str_from("disk"));
    assert(other != e, "an ordinary allocation still gets its own error");
    assert_eq(agnostik_err_kind(other), STIK_ERR_IO, "ordinary kind kept");
    assert_eq(agnostik_err_kind(e), STIK_ERR_RESOURCE_EXHAUSTED, "static error unchanged");
    return 0;
}
# _stik_alloc hands back usable memory when alloc succeeds.
fn test_stik_alloc_ok() {
    var p = _stik_alloc(32);
    assert(p != 0, "_stik_alloc returns memory");
    store64(p + 24, 77);
    assert_eq(load64(p + 24), 77, "and it is writable");
    return 0;
}

# ─── F-029: the JSON member lookup reads the document's structure ────

# A nested key, a repeated key and whitespace before the colon.
fn test_find_value_structure() {
    var a = AgentInfo_from_json(str_from("{\"meta\":{\"name\":\"victim\"},\"name\":\"attacker\"}"));
    assert(str_eq_cstr(ainfo_name(a), "attacker") == 1, "a nested name does not shadow the top-level one");
    var b = AgentInfo_from_json(str_from("{\"name\":\"first\",\"name\":\"last\"}"));
    assert(str_eq_cstr(ainfo_name(b), "last") == 1, "a repeated key gives its last value, as the derived parser did");
    var c = AgentInfo_from_json(str_from("{\"name\" : \"spaced\"}"));
    assert(str_eq_cstr(ainfo_name(c), "spaced") == 1, "whitespace before the colon is allowed (RFC 8259)");
    var d = AgentInfo_from_json(str_from("{\"note\":\"\\\"name\\\":\\\"x\\\"\",\"name\":\"real\"}"));
    assert(str_eq_cstr(ainfo_name(d), "real") == 1, "a key inside a string value is not a key (F-004 still holds)");
    var e = AgentInfo_from_json(str_from("[{\"name\":\"in-array\"}]"));
    assert_eq(ainfo_name(e), 0, "a member of a nested object in an array is not top-level");
    var tj = "{\"x\":{\"enabled\":1,\"export_endpoint\":\"http://evil\"},\"enabled\":0}";
    var t = TelemetryConfig_from_json(str_from(tj));
    assert_eq(telcfg_enabled(t), 0, "TelemetryConfig: nested enabled ignored");
    assert_eq(telcfg_endpoint(t), 0, "TelemetryConfig: nested endpoint ignored");
    assert_eq(_stik_json_int(str_from("{\"a\":{\"a\":5},\"a\":7}"), str_from("a")), 7, "json_int: top-level, last");
    assert_eq(_stik_json_int(str_from("{\"b\":{\"a\":5}}"), str_from("a")), 0, "json_int: nested only reads 0");
    return 0;
}

# ─── F-030: out-of-range numbers read 0 ────

# i64 max reads exactly; one past it, or a 20-digit value, reads 0.
fn test_json_int_range() {
    assert_eq(_stik_json_int(str_from("{\"x\":9223372036854775807}"), str_from("x")), 0x7FFFFFFFFFFFFFFF, "i64 max");
    assert_eq(_stik_json_int(str_from("{\"x\":9223372036854775808}"), str_from("x")), 0, "i64 max + 1 reads 0");
    assert_eq(_stik_json_int(str_from("{\"x\":12345678901234567890}"), str_from("x")), 0, "no silent prefix");
    assert_eq(_stik_json_int(str_from("{\"x\":-42}"), str_from("x")), 0 - 42, "negatives still parse");
    return 0;
}

# ─── F-031: a string field allocates its own length, and stays inside it ────

# The decode buffer is sized to the value, not the document.
fn test_json_str_alloc() {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"k\":\"v\",\"pad\":\"");
    var i = 0;
    while (i < 60000) { str_builder_putc(sb, 'x'); i = i + 1; }
    str_builder_add_cstr(sb, "\"}");
    var doc = str_builder_build(sb);
    var key = str_from("k");
    var before = alloc_used();
    var v = _stik_json_str(doc, key);
    var used = alloc_used() - before;
    assert(str_eq_cstr(v, "v") == 1, "value decoded");
    assert(used < 1024, "a 1-byte value allocates bytes, not the 60 KB document");
    return 0;
}
# A \u escape cut short by the closing quote cannot run past it.
fn test_json_str_bounded() {
    var v = _stik_json_str(str_from("{\"k\":\"\\u12\",\"z\":\"tail\"}"), str_from("k"));
    assert_eq(str_len(v), 3, "only U+FFFD: the escape stops at the quote");
    assert_eq(load8(str_data(v)), 0xEF, "U+FFFD byte 1");
    var w = _stik_json_str(str_from("{\"k\":\"ab\\u00e9\"}"), str_from("k"));
    assert(str_eq_cstr(w, "ab\xc3\xa9") == 1, "a whole escape still decodes");
    return 0;
}

# ─── F-032: InjectionScores stay in 0..100 ────

# Setters saturate, getters cap, and both JSON readers saturate.
fn test_iscore_range() {
    var s = injection_scores_new();
    iscore_set_sql(s, 256);
    assert_eq(iscore_sql(s), 100, "256 saturates to 100 (it wrapped to 0)");
    iscore_set_xss(s, 0 - 1);
    assert_eq(iscore_xss(s), 0, "-1 saturates to 0");
    iscore_set_command(s, 300);
    assert_eq(iscore_command(s), 100, "300 saturates to 100 (it read 44)");
    iscore_set_path_traversal(s, 55);
    assert_eq(iscore_path_traversal(s), 55, "in range unchanged");
    store8(s + 4, 200);
    assert_eq(iscore_prompt_injection(s), 100, "a raw byte above 100 reads 100");
    var j = InjectionScores_from_json_str("{\"sql\":256,\"xss\":-5,\"command\":50}");
    assert_eq(iscore_sql(j), 100, "JSON 256 saturates (the derived parser read 0)");
    assert_eq(iscore_xss(j), 0, "JSON -5 saturates to 0");
    assert_eq(iscore_command(j), 50, "JSON in range");
    var out = ser(j, &InjectionScores_to_json);
    var want = "{\"sql\":100,\"xss\":0,\"command\":50,\"path_traversal\":0,\"prompt_injection\":0}";
    assert(str_eq_cstr(out, want) == 1, "to_json agrees with the getters");
    return 0;
}

# ─── F-033: ss_put leaves no secret in its hand-off global ────

var _seen_value = 0;
# A two-parameter (legacy) put fn: reads the value from _ss_put_value.
fn cb_put_legacy(data, sname) {
    _seen_value = _ss_put_value;
    return 7;
}
# The legacy callback still sees the value; the global is 0 afterwards.
fn test_ss_put_clears() {
    var st = secret_store_new(secret_store_vtable(0, &cb_put_legacy, 0, 0), alloc(8));
    var v = str_from("hunter2-api-key");
    assert_eq(ss_put(st, str_from("db"), v), 7, "put fn result passed through");
    assert_eq(_seen_value, v, "a legacy put fn still reads the value during the call");
    assert_eq(_ss_put_value, 0, "the global no longer holds the secret afterwards");
    return 0;
}

# ─── F-034: secret_new with a 0 or negative-length Str ────

# Both give an empty secret instead of writing through address 0.
fn test_secret_new_edges() {
    var a = secret_new(0);
    assert_eq(secret_len(a), 0, "0 Str: empty secret");
    var b = secret_new(str_new("abc", 0 - 1));
    assert_eq(secret_len(b), 0, "negative length: empty secret");
    var c = secret_new(str_from("pw"));
    assert_eq(secret_len(c), 2, "ordinary secret kept");
    assert(str_eq_cstr(secret_expose(c), "pw") == 1, "ordinary bytes kept");
    return 0;
}

# ─── F-035: an unrecognised classification level fails closed ────

# Out-of-range levels become CLASS_RESTRICTED; valid ones are kept.
fn test_classification_level() {
    assert_eq(cresult_level(classification_result_new(99)), CLASS_RESTRICTED, "99 -> Restricted");
    assert_eq(cresult_auto_level(classification_result_new(0 - 1)), CLASS_RESTRICTED, "-1 -> Restricted");
    assert_eq(cresult_level(classification_result_new(CLASS_INTERNAL)), CLASS_INTERNAL, "valid level kept");
    return 0;
}

