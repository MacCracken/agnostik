# ─── F-037: private globals are agnostik's own ────

# This file defines _hex_lut and _genesis_hash_str (top); agnostik ignores them.
fn test_private_globals() {
    var u = "0af76519-16cd-43dd-8448-eb211c80319c";
    var t, v = agent_id_from_str(str_from(u));
    assert(str_eq_cstr(agent_id_to_str(v), u) == 1, "a consumer's _hex_lut no longer changes UUIDs");
    var f = integrity_fields_genesis(str_from("sig"));
    assert_eq(integrity_is_genesis(f), 1, "genesis recognised with a consumer _genesis_hash_str defined");
    assert_eq(str_len(integrity_prev_hash(f)), 64, "genesis hash is 64 chars");
    return 0;
}

# ─── F-038: version numbers do not wrap ────

# Out-of-range segments are an Err; i64 max still parses.
fn test_version_range() {
    var a_t, a = version_from_str(str_from("18446744073709551617.0.0"));
    assert(is_err_result(a_t) == 1, "2^64+1 is out of range (it parsed as 1.0.0)");
    var b_t, b = version_from_str(str_from("9223372036854775808.0.0"));
    assert(is_err_result(b_t) == 1, "i64 max + 1 is out of range");
    var c_t, c = version_from_str(str_from("9223372036854775807.1.2"));
    assert(is_ok(c_t) == 1, "i64 max parses");
    assert_eq(version_major(c), 0x7FFFFFFFFFFFFFFF, "major is i64 max");
    return 0;
}

# ─── F-039: AgentInfo_from_json does not default to the most privileged type ────

# The agent_type AgentInfo_from_json reads from C string `c`.
fn ai_type(c) { return ainfo_type(AgentInfo_from_json(str_from(c))); }
# The status AgentInfo_from_json reads from C string `c`.
fn ai_status(c) { return ainfo_status(AgentInfo_from_json(str_from(c))); }
# Missing or invalid types read as User; explicit System still parses.
fn test_agent_info_defaults() {
    assert_eq(ai_type("{}"), AGENT_TYPE_USER, "missing type -> User");
    assert_eq(ai_type("{\"agent_type\":\"Bogus\"}"), AGENT_TYPE_USER, "unknown name -> User");
    assert_eq(ai_type("{\"agent_type_id\":99}"), AGENT_TYPE_USER, "out-of-range id -> User");
    assert_eq(ai_type("{\"agent_type_id\":-7}"), AGENT_TYPE_USER, "negative id -> User");
    assert_eq(ai_type("{\"agent_type\":\"System\"}"), AGENT_TYPE_SYSTEM, "explicit System kept");
    assert_eq(ai_type("{\"agent_type_id\":0}"), AGENT_TYPE_SYSTEM, "explicit id 0 kept");
    assert_eq(ai_status("{\"status_id\":42}"), AGENT_PENDING, "out-of-range status -> Pending");
    return 0;
}

# ─── F-041: traceparent forward compatibility ────

# A later version may be longer than 55 chars after a '-'; 00 may not.
fn test_traceparent_future() {
    var fut = "cc-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-09-what-the-future-will-be-like";
    var a_t, a = tctx_from_traceparent(str_from(fut));
    assert(is_ok(a_t) == 1, "the W3C spec's future-version example parses");
    var b_t, b = tctx_from_traceparent(str_from("00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01-extra"));
    assert(is_err_result(b_t) == 1, "version 00 must be exactly 55");
    var c_t, c = tctx_from_traceparent(str_from("01-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01x"));
    assert(is_err_result(c_t) == 1, "a longer header needs '-' at 55");
    var d_t, d = tctx_from_traceparent(str_from("00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01"));
    assert(is_ok(d_t) == 1, "an ordinary header still parses");
    return 0;
}

# ─── F-042: histogram shapes ────

# Encode one histogram point; returns 1 when metric_to_otlp_proto answers Ok.
fn hist_ok(bounds, counts, count) {
    var h = histogram_value_new();
    var i = 0;
    while (i < vec_len(bounds)) { vec_push(hval_bounds(h), vec_get(bounds, i)); i = i + 1; }
    i = 0;
    while (i < vec_len(counts)) { vec_push(hval_bucket_counts(h), vec_get(counts, i)); i = i + 1; }
    hval_set_count(h, count);
    var pts = vec_new();
    vec_push(pts, metric_data_point_new(str_from("h"), metric_histogram(h)));
    var desc = instrument_descriptor_new(str_from("h"), str_from(""), str_from(""), METRIC_HISTOGRAM);
    var sb = str_builder_new();
    var t, r = metric_to_otlp_proto(desc, pts, sb);
    return is_ok(t);
}
# A vec of the given values (up to 4; pass -999 to stop early).
fn v4(a, b, c, d) {
    var v = vec_new();
    if (a != 0 - 999) { vec_push(v, a); }
    if (b != 0 - 999) { vec_push(v, b); }
    if (c != 0 - 999) { vec_push(v, c); }
    if (d != 0 - 999) { vec_push(v, d); }
    return v;
}
# Bounds strictly increasing and not NaN; bucket counts sum without overflow.
fn test_histogram_shapes() {
    var n = 0 - 999;
    var neg2 = 0xC000000000000000;   # -2.0
    var neg1 = 0xBFF0000000000000;   # -1.0
    var negz = 0x8000000000000000;   # -0.0
    var one  = 0x3FF0000000000000;   # 1.0
    var two  = 0x4000000000000000;   # 2.0
    var nan  = 0x7FF8000000000000;
    assert_eq(hist_ok(v4(one, two, n, n), v4(1, 1, 1, n), 3), 1, "1.0 < 2.0 is fine");
    assert_eq(hist_ok(v4(two, one, n, n), v4(1, 1, 1, n), 3), 0, "2.0 then 1.0 is refused");
    assert_eq(hist_ok(v4(one, one, n, n), v4(1, 1, 1, n), 3), 0, "a repeated bound is refused");
    assert_eq(hist_ok(v4(negz, 0, n, n), v4(1, 1, 1, n), 3), 0, "-0.0 then 0.0 are equal, so refused");
    assert_eq(hist_ok(v4(one, nan, n, n), v4(1, 1, 1, n), 3), 0, "a NaN bound is refused");
    assert_eq(hist_ok(v4(neg2, neg1, one, n), v4(1, 1, 1, 1), 4), 1, "negative bounds order by value");
    assert_eq(hist_ok(v4(neg1, neg2, n, n), v4(1, 1, 1, n), 3), 0, "-1.0 then -2.0 is refused");
    var big = 0x7FFFFFFFFFFFFFFF;
    assert_eq(hist_ok(v4(one, two, n, n), v4(big, big, 3, n), 1), 0, "bucket counts that overflow are refused");
    return 0;
}

# ─── F-043: span fields stay in their wire ranges ────

# Out-of-range kind, negative duration and dropped counts encode as defaults.
fn test_span_wire_ranges() {
    var base = fixed_span();
    var ref = enc_span(base);
    var k = fixed_span();
    span_set_kind(k, 99);
    assert(str_eq(enc_span(k), ref) == 1, "a kind outside SpanKind is omitted, not written as 0");
    var d = fixed_span();
    span_set_duration_ms(d, 0 - 5000);
    assert(str_eq(enc_span(d), ref) == 1, "a negative duration ends at the start");
    var c = fixed_span();
    span_set_dropped_attrs(c, 0 - 1);
    span_set_dropped_events(c, 0 - 5);
    span_set_dropped_links(c, 0 - 9);
    assert(str_eq(enc_span(c), ref) == 1, "negative dropped counts are omitted");
    var e = fixed_span();
    span_set_dropped_attrs(e, 0x10000000000);
    var f = fixed_span();
    span_set_dropped_attrs(f, 0xFFFFFFFF);
    assert(str_eq(enc_span(e), enc_span(f)) == 1, "a count above uint32 saturates at 0xFFFFFFFF");
    var g = fixed_span();
    span_set_duration_ms(g, 0x7FFFFFFFFFFFFFFF);
    assert_eq(str_has(hex_of(enc_span(g)), "41ffffffffffffff7f"), 1, "a huge duration saturates the end time");
    return 0;
}

# ─── F-044, F-045, F-046: audit, hardware ────

# integrity_is_genesis with no prev_hash answers 0.
fn test_genesis_null() {
    var f = integrity_fields_new(version_default(), str_from("s"), 0);
    assert_eq(integrity_is_genesis(f), 0, "0 prev_hash is not genesis, and does not crash");
    return 0;
}
# VRAM totals skip non-positive values and saturate.
fn test_vram_sum() {
    var s = accelerator_summary_new();
    var a = accelerator_device_new(0, str_from("a"), 0, 0);
    adev_set_vram_total(a, 24576);
    asum_add_device(s, a);
    var b = accelerator_device_new(1, str_from("b"), 0, 0);
    adev_set_vram_total(b, 0 - 100000);
    asum_add_device(s, b);
    assert_eq(asum_total_vram(s), 24576, "a negative report adds nothing");
    var c = accelerator_device_new(2, str_from("c"), 0, 0);
    adev_set_vram_total(c, 0x7FFFFFFFFFFFFFFF);
    asum_add_device(s, c);
    assert_eq(asum_total_vram(s), 0x7FFFFFFFFFFFFFFF, "the total saturates instead of wrapping");
    return 0;
}
# AcceleratorFlags are 0 or 1 through every path.
fn test_aflags_bool() {
    var f = accelerator_flags_new();
    aflags_set_cuda(f, 256);
    assert_eq(aflags_cuda(f), 1, "256 sets the flag (it stored 0)");
    aflags_set_rocm(f, 255);
    assert_eq(aflags_rocm(f), 1, "255 reads 1");
    store8(f + 2, 7);
    assert_eq(aflags_metal(f), 1, "a raw nonzero byte reads 1");
    var j = AcceleratorFlags_from_json_str("{\"cuda_available\":2,\"rocm_available\":0}");
    assert_eq(aflags_cuda(j), 1, "JSON 2 reads 1");
    assert_eq(aflags_rocm(j), 0, "JSON 0 reads 0");
    var out = ser(f, &AcceleratorFlags_to_json);
    assert_eq(str_has(out, "\"cuda_available\":1,\"rocm_available\":1,\"metal_available\":1"), 1, "to_json writes 0/1");
    return 0;
}

# ─── F-047: the seven value structs' hand-written serde ────

# Truncated text is read up to its NUL and never past it.
fn test_serde_bounded() {
    var a = TokenUsage_from_json_str("{\"pro");
    assert(a != 0, "truncated object: a struct, not a crash");
    assert_eq(tusage_total(a), 0, "missing fields read 0");
    var buf = alloc(64);
    var lead = "{\"prompt_tok";
    memcpy(buf, lead, strlen(lead));
    store8(buf + strlen(lead), 0);
    var tail = "\":77,\"total_tok\":88}";
    memcpy(buf + strlen(lead) + 1, tail, strlen(tail) + 1);
    var b = TokenUsage_from_json_str(buf);
    assert_eq(tusage_total(b), 0, "nothing is read past the NUL (the derived scanner read 88)");
    assert_eq(TokenUsage_from_json_str(0), 0, "0 text: 0");
    assert_eq(TokenUsage_from_json_str(""), 0, "empty text: 0");
    assert_eq(TokenUsage_from_json_str("[1,2]"), 0, "not an object: 0");
    assert_eq(TokenUsage_from_json_str("not json"), 0, "junk: 0");
    return 0;
}
# Numbers outside i64, or not wholly numbers, read 0 on both paths.
fn test_serde_ranges() {
    var a = TokenUsage_from_json_str("{\"total_tok\":18446744073709551615}");
    assert_eq(tusage_total(a), 0, "2^64-1 reads 0 (the derived parser read -1)");
    var b = ResourceLimits_from_json_str("{\"max_memory\":9223372036854775808,\"max_fds\":64}");
    assert_eq(rlim_max_memory(b), 0, "i64 max + 1 reads 0");
    assert_eq(rlim_max_fds(b), 64, "its neighbour is unaffected");
    var c = ResourceLimits_from_json(bayan_json_parse(str_from("{\"max_memory\":99999999999999999999,\"max_fds\":7}")));
    assert_eq(rlim_max_memory(c), 0, "pairs path: out of range reads 0");
    assert_eq(rlim_max_fds(c), 7, "pairs path: in range kept");
    var d = ResourceLimits_from_json(0);
    assert_eq(rlim_max_memory(d), 0, "pairs path: 0 pairs gives zeros, not a crash");
    var e = ResourceLimits_from_json_str("{\"max_memory\":1,\"max_memory\":2}");
    assert_eq(rlim_max_memory(e), 2, "a repeated member gives its last value");
    return 0;
}

# ─── fuzz ────

# The F-029 oracle: random objects with nested copies of the key, repeats,
# strings that look like members and random whitespace. The generator knows the
# last top-level value of "a"; _stik_json_int must agree.
fn fuzz_find_value(seed) {
    rng_init(seed);
    var ok = 0;
    var it = 0;
    while (it < 400) {
        var sb = str_builder_new();
        str_builder_putc(sb, '{');
        var expect = 0;
        var m = rng_below(6);
        var i = 0;
        while (i < m) {
            if (i > 0) { str_builder_putc(sb, ','); }
            var which = rng_below(4);
            if (which == 0) { str_builder_add_cstr(sb, "\"a\""); }
            elif (which == 1) { str_builder_add_cstr(sb, "\"b\""); }
            elif (which == 2) { str_builder_add_cstr(sb, "\"ab\""); }
            else { str_builder_add_cstr(sb, "\"x\""); }
            if (rng_below(3) == 0) { str_builder_putc(sb, ' '); }
            str_builder_putc(sb, ':');
            if (rng_below(3) == 0) { str_builder_putc(sb, '\n'); }
            var kind = rng_below(4);
            if (kind == 0) {
                var n = rng_below(100000) - 50000;
                str_builder_add_int(sb, n);
                if (which == 0) { expect = n; }
            } elif (kind == 1) {
                str_builder_add_cstr(sb, "{\"a\":");
                str_builder_add_int(sb, rng_below(1000) + 1);
                str_builder_add_cstr(sb, ",\"q\":[{\"a\":3}]}");
                if (which == 0) { expect = 0; }
            } elif (kind == 2) {
                str_builder_add_cstr(sb, "\"\\\"a\\\":99\"");
                if (which == 0) { expect = 0; }
            } else {
                str_builder_add_cstr(sb, "[1,{\"a\":4},\"a\"]");
                if (which == 0) { expect = 0; }
            }
            i = i + 1;
        }
        str_builder_putc(sb, '}');
        var doc = str_builder_build(sb);
        if (_stik_json_int(doc, str_from("a")) == expect) { ok = ok + 1; }
        it = it + 1;
    }
    assert_eq(ok, 400, "fuzz: json member lookup agrees with the generator");
    return 0;
}
# The F-031 oracle: a random string value followed by a marker tail. The decoded
# value never holds a marker byte (no escape ran past the quote), is at most
# one byte longer than the source, and equals the source when it has no escape.
fn fuzz_json_str(seed) {
    rng_init(seed);
    var alpha = "\\u0123456789abcdefABCDEF xyz\xc3\xa9\x7f\x1f";
    var na = strlen(alpha);
    var ok = 0;
    var it = 0;
    while (it < 600) {
        var raw = str_builder_new();
        var n = rng_below(24);
        var has_esc = 0;
        var i = 0;
        while (i < n) {
            var c = load8(alpha + rng_below(na));
            if (c == 92) {
                has_esc = 1;
                str_builder_putc(raw, 92);
                var e = rng_below(5);
                if (e == 0) { str_builder_putc(raw, 34); }
                elif (e == 1) { str_builder_putc(raw, 92); }
                elif (e == 2) { str_builder_putc(raw, 'n'); }
                else { str_builder_putc(raw, 'u'); }
                i = i + 2;
            } else {
                str_builder_putc(raw, c);
                i = i + 1;
            }
        }
        var payload = str_builder_build(raw);
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "{\"k\":\"");
        str_builder_add(sb, payload);
        str_builder_add_cstr(sb, "\",\"z\":\"\x01\x01\x01\x01\x01\x01\x01\x01\"}");
        var v = _stik_json_str(str_builder_build(sb), str_from("k"));
        var good = 1;
        if (v == 0) { good = 0; }
        else {
            if (str_len(v) > str_len(payload) + 1) { good = 0; }
            var j = 0;
            while (j < str_len(v)) {
                if (load8(str_data(v) + j) == 1) { good = 0; }
                j = j + 1;
            }
            if (has_esc == 0 && str_eq(v, payload) != 1) { good = 0; }
        }
        ok = ok + good;
        it = it + 1;
    }
    assert_eq(ok, 600, "fuzz: string decode stays inside its value and its bound");
    return 0;
}
# The F-047 oracle: every prefix of a valid TokenUsage / ResourceLimits text,
# NUL-terminated with digits written after the NUL, decodes without reading
# them: no field exceeds its original value.
fn fuzz_serde_truncation(seed) {
    rng_init(seed);
    var ok = 0;
    var total = 0;
    var it = 0;
    while (it < 40) {
        var u = token_usage_new();
        var f = 0;
        while (f < 5) { store64(u + f * 8, rng_below(1000000)); f = f + 1; }
        var txt = ser(u, &TokenUsage_to_json);
        var cut = 0;
        while (cut <= str_len(txt)) {
            var buf = alloc(str_len(txt) + 16);
            memcpy(buf, str_data(txt), cut);
            store8(buf + cut, 0);
            memcpy(buf + cut + 1, "99999999", 9);
            var d = TokenUsage_from_json_str(buf);
            var good = 1;
            if (d != 0) {
                var g = 0;
                while (g < 5) {
                    if (load64(d + g * 8) > load64(u + g * 8)) { good = 0; }
                    g = g + 1;
                }
            }
            ok = ok + good;
            total = total + 1;
            cut = cut + 1;
        }
        it = it + 1;
    }
    assert_eq(ok, total, "fuzz: truncated text is never read past its NUL");
    return 0;
}

# Test-file entry: runs every test, returns the assertion summary.
fn main() {
    println("--- v1.12.3 hardening (P(-1)) ---");
    test_err_oom_static();
    test_stik_alloc_ok();
    test_find_value_structure();
    test_json_int_range();
    test_json_str_alloc();
    test_json_str_bounded();
    test_iscore_range();
    test_ss_put_clears();
    test_secret_new_edges();
    test_classification_level();
    test_parsers_null();
    test_private_globals();
    test_version_range();
    test_agent_info_defaults();
    test_traceparent_future();
    test_histogram_shapes();
    test_span_wire_ranges();
    test_genesis_null();
    test_vram_sum();
    test_aflags_bool();
    test_serde_bounded();
    test_serde_ranges();
    fuzz_find_value(0x5eed1123);
    fuzz_json_str(0x5eed1124);
    fuzz_serde_truncation(0x5eed1125);
    return assert_summary();
}
