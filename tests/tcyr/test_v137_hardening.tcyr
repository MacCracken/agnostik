# tests/tcyr/test_v137_hardening.tcyr
#
# v1.3.7 P(-1) hardening findings. See docs/audit/2026-08-24-audit.md.
#
# F-014  _fill_random's /dev/urandom fallback used `off = 0 - 1` as a
#        give-up sentinel. Cyrius compares SIGNED, so `(0 - 1) < n` stays
#        true: the loop retried with `buf + (0 - 1)` and length n + 1 — a
#        one-byte heap underflow write — and never terminated if the reads
#        kept failing. Exercised here through a faithful replica, since
#        forcing a getrandom(2) failure from a test is not practical.
# F-015  tctx_from_traceparent accepted an all-zero trace-id and an
#        all-zero parent-id. W3C Trace Context declares both invalid and
#        requires implementations to ignore such a traceparent.
# F-016  The 2-char version field was never validated: non-hex versions
#        parsed, and version "ff" (forbidden by the spec) was accepted.
# F-017  Uppercase hex was accepted throughout the traceparent. The spec
#        mandates lowercase. _hex_nibble legitimately accepts uppercase
#        for JSON's four-hex-digit \u escapes (RFC 8259 permits either
#        case), so the fix enforces lowercase only on the W3C-governed
#        path rather than tightening the shared helper.
# F-019  user_id_from_str had no roundtrip test, breaking the CLAUDE.md
#        rule that every parse function carries one.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/trait.cyr"
include "lib/assert.cyr"
include "src/lib.cyr"

var _f014_out = alloc(16);

# --- F-014: the loop must exit on read failure -------------------------
# Replica of the fallback loop's control flow with the read() result
# scripted, so the failure branch is deterministic. Mirrors the FIXED
# shape: a flag exits the loop and success is reported off the flag.
fn _f014_replica(n, fail_first) {
    var off = 0;
    var failed = 0;
    var iters = 0;
    var min_off = 0;
    var max_len = 0;
    while (off < n) {
        iters = iters + 1;
        if (iters > 4) { off = n; continue; }   # guard: keep the test finite
        if (off < min_off) { min_off = off; }
        var want = n - off;
        if (want > max_len) { max_len = want; }
        var r = 0;
        if (iters == 1 && fail_first == 1) { r = 0 - 1; }  # simulated EINTR
        else { r = want; }
        if (r <= 0) { failed = 1; off = n; continue; }
        off = off + r;
    }
    store64(_f014_out, min_off);
    store64(_f014_out + 8, max_len);
    if (failed == 1) { return 0 - iters; }
    return iters;
}

fn test_f014_clean_read_completes() {
    var it = _f014_replica(16, 0);
    assert_eq(it, 1, "F-014: clean read completes in one iteration");
    assert_eq(load64(_f014_out), 0, "F-014: offset never negative");
    assert_eq(load64(_f014_out + 8), 16, "F-014: never requests more than n");
    return 0;
}

fn test_f014_failed_read_exits_loop() {
    var it = _f014_replica(16, 1);
    # Negative return encodes "failed"; magnitude is the iteration count.
    assert_eq(it, 0 - 1, "F-014: failure exits after one iteration, flagged");
    assert_eq(load64(_f014_out), 0, "F-014: offset never goes negative");
    assert_eq(load64(_f014_out + 8), 16, "F-014: never requests n+1 at buf-1");
    return 0;
}

# The signed-comparison fact the bug depended on. If a future toolchain
# made `<` unsigned this guard would flip, and the sentinel pattern that
# F-014 removed would silently become safe again — worth pinning.
fn test_f014_cyrius_compares_signed() {
    var neg = 0 - 1;
    var lt = 0;
    if (neg < 16) { lt = 1; }
    assert_eq(lt, 1, "F-014: (0-1) < 16 is true — Cyrius compares signed");
    return 0;
}

# --- F-015: all-zero ids must be rejected -----------------------------
fn test_f015_all_zero_trace_id() {
    var s = str_from("00-00000000000000000000000000000000-00f067aa0ba902b7-01");
    assert_eq(is_ok(tctx_from_traceparent(s)), 0, "F-015: all-zero trace-id rejected");
    return 0;
}

fn test_f015_all_zero_parent_id() {
    var s = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-0000000000000000-01");
    assert_eq(is_ok(tctx_from_traceparent(s)), 0, "F-015: all-zero parent-id rejected");
    return 0;
}

# A single non-zero nibble keeps the id valid — the rule is "all bytes
# zero", not "leading zeros".
fn test_f015_near_zero_ids_still_valid() {
    var tid = str_from("00-00000000000000000000000000000001-00f067aa0ba902b7-01");
    assert_eq(is_ok(tctx_from_traceparent(tid)), 1, "F-015: trace-id 0..01 accepted");
    var sid = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-0000000000000001-01");
    assert_eq(is_ok(tctx_from_traceparent(sid)), 1, "F-015: parent-id 0..01 accepted");
    return 0;
}

# --- F-016: version field validation ----------------------------------
fn test_f016_version_must_be_hex() {
    var s = str_from("zz-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");
    assert_eq(is_ok(tctx_from_traceparent(s)), 0, "F-016: non-hex version rejected");
    return 0;
}

fn test_f016_version_ff_forbidden() {
    var s = str_from("ff-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");
    assert_eq(is_ok(tctx_from_traceparent(s)), 0, "F-016: version ff rejected");
    return 0;
}

# Forward compatibility: a known-field-compatible future version parses.
fn test_f016_future_version_accepted() {
    var s = str_from("01-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");
    assert_eq(is_ok(tctx_from_traceparent(s)), 1, "F-016: version 01 accepted");
    return 0;
}

# --- F-017: lowercase-only hex on the traceparent path -----------------
fn test_f017_uppercase_rejected() {
    var tid = str_from("00-4BF92F3577B34DA6A3CE929D0E0E4736-00f067aa0ba902b7-01");
    assert_eq(is_ok(tctx_from_traceparent(tid)), 0, "F-017: uppercase trace-id rejected");
    var sid = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00F067AA0BA902B7-01");
    assert_eq(is_ok(tctx_from_traceparent(sid)), 0, "F-017: uppercase parent-id rejected");
    var fl = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-0A");
    assert_eq(is_ok(tctx_from_traceparent(fl)), 0, "F-017: uppercase flags rejected");
    var ver = str_from("0A-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");
    assert_eq(is_ok(tctx_from_traceparent(ver)), 0, "F-017: uppercase version rejected");
    return 0;
}

# Guard against an over-broad fix: JSON's four-hex-digit \u escapes must
# stay case-insensitive, because RFC 8259 permits either case.
fn test_f017_json_unicode_escape_still_case_insensitive() {
    var lo = _json_str(str_from("{\"k\":\"\\u00e9\"}"), str_from("k"));
    var hi = _json_str(str_from("{\"k\":\"\\u00E9\"}"), str_from("k"));
    assert_eq(str_eq(lo, hi), 1, "F-017: JSON hex escape still case-insensitive");
    return 0;
}

# --- F-019: user_id parse roundtrip -----------------------------------
fn test_f019_user_id_roundtrip() {
    var id = user_id_new();
    var s = user_id_to_str(id);
    var r = user_id_from_str(s);
    assert_eq(is_ok(r), 1, "F-019: user_id_from_str accepts its own output");
    var back = payload(r);
    assert_eq(user_id_eq(id, back), 1, "F-019: user_id roundtrip preserves value");
    assert_eq(str_eq(user_id_to_str(back), s), 1, "F-019: user_id re-format is stable");
    return 0;
}

fn test_f019_user_id_rejects_garbage() {
    assert_eq(is_ok(user_id_from_str(str_from("not-a-uuid"))), 0, "F-019: garbage rejected");
    assert_eq(is_ok(user_id_from_str(str_from(""))), 0, "F-019: empty rejected");
    return 0;
}

# --- sanity: the canonical spec example is unaffected ------------------
fn test_canonical_traceparent_still_parses() {
    var s = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");
    var r = tctx_from_traceparent(s);
    assert_eq(is_ok(r), 1, "canonical traceparent accepted");
    var ctx = payload(r);
    assert_eq(tctx_trace_flags(ctx), 1, "canonical flags = 01");
    assert_eq(tctx_is_sampled(ctx), 1, "canonical is sampled");
    return 0;
}

# Roundtrip through the formatter must survive the new validation.
fn test_traceparent_format_roundtrip_still_holds() {
    var s = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");
    var ctx = payload(tctx_from_traceparent(s));
    assert_eq(str_eq(tctx_to_traceparent(ctx), s), 1, "traceparent roundtrip stable");
    return 0;
}

fn main() {
    println("=== agnostik v1.3.7 hardening (F-014..F-019) ===");
    test_f014_clean_read_completes();
    test_f014_failed_read_exits_loop();
    test_f014_cyrius_compares_signed();
    test_f015_all_zero_trace_id();
    test_f015_all_zero_parent_id();
    test_f015_near_zero_ids_still_valid();
    test_f016_version_must_be_hex();
    test_f016_version_ff_forbidden();
    test_f016_future_version_accepted();
    test_f017_uppercase_rejected();
    test_f017_json_unicode_escape_still_case_insensitive();
    test_f019_user_id_roundtrip();
    test_f019_user_id_rejects_garbage();
    test_canonical_traceparent_still_parses();
    test_traceparent_format_roundtrip_still_holds();
    println("");
    return assert_summary();
}
