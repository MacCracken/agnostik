    assert_eq(is_ok(r8_t), 1, "AgnostikErrorKind/STIK_ERR_INTERNAL: parses");
    assert_eq(r8, STIK_ERR_INTERNAL, "AgnostikErrorKind/STIK_ERR_INTERNAL: roundtrips");
    var r9_t, r9 = agnostik_err_kind_parse(str_from(agnostik_err_kind_name(STIK_ERR_SERIALIZATION)));
    assert_eq(is_ok(r9_t), 1, "AgnostikErrorKind/STIK_ERR_SERIALIZATION: parses");
    assert_eq(r9, STIK_ERR_SERIALIZATION, "AgnostikErrorKind/STIK_ERR_SERIALIZATION: roundtrips");
    var r10_t, r10 = agnostik_err_kind_parse(str_from(agnostik_err_kind_name(STIK_ERR_IO)));
