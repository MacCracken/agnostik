    return 0;
}

# --- AuditResult: 3 members ---
fn test_audit_result_roundtrip() {
    var r1_t, r1 = audit_result_parse(str_from(audit_result_name(AUDIT_SUCCESS)));
    assert_eq(is_ok(r1_t), 1, "AuditResult/AUDIT_SUCCESS: parses");
