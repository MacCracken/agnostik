    assert_eq(is_ok(r4_t), 1, "DeviceFamily/DEV_AI_ASIC: parses");
    assert_eq(r4, DEV_AI_ASIC, "DeviceFamily/DEV_AI_ASIC: roundtrips");
    var r5_t, r5 = device_family_parse(str_from(device_family_name(DEV_CPU)));
    assert_eq(is_ok(r5_t), 1, "DeviceFamily/DEV_CPU: parses");
    assert_eq(r5, DEV_CPU, "DeviceFamily/DEV_CPU: roundtrips");
    var r6_t, r6 = device_family_parse(str_from("__not_a_device_family__"));
    assert_eq(is_ok(r6_t), 0, "DeviceFamily: unknown string rejected");
    var r7_t, r7 = device_family_parse(str_from("Unknown"));
    assert_eq(is_ok(r7_t), 0, "DeviceFamily: fallback string owned by no member -> Err");
    return 0;
}

