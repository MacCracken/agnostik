    assert_eq(is_ok(r1_t), 1, "SpanStatus/SPAN_UNSET: parses");
    assert_eq(r1, SPAN_UNSET, "SpanStatus/SPAN_UNSET: roundtrips");
    var r2_t, r2 = span_status_parse(str_from(span_status_name(SPAN_OK)));
    assert_eq(is_ok(r2_t), 1, "SpanStatus/SPAN_OK: parses");
    assert_eq(r2, SPAN_OK, "SpanStatus/SPAN_OK: roundtrips");
    var r3_t, r3 = span_status_parse(str_from(span_status_name(SPAN_ERROR)));
    assert_eq(is_ok(r3_t), 1, "SpanStatus/SPAN_ERROR: parses");
    assert_eq(r3, SPAN_ERROR, "SpanStatus/SPAN_ERROR: roundtrips");
    var r4_t, r4 = span_status_parse(str_from("__not_a_span_status__"));
    assert_eq(is_ok(r4_t), 0, "SpanStatus: unknown string rejected");
    var r5_t, r5 = span_status_parse(str_from("Unknown"));
    assert_eq(is_ok(r5_t), 0, "SpanStatus: fallback string owned by no member -> Err");
    return 0;
}

# --- SystemStatus: 4 members ---
fn test_system_status_roundtrip() {
    var r1_t, r1 = system_status_parse(str_from(system_status_name(STATUS_HEALTHY)));
    assert_eq(is_ok(r1_t), 1, "SystemStatus/STATUS_HEALTHY: parses");
    assert_eq(r1, STATUS_HEALTHY, "SystemStatus/STATUS_HEALTHY: roundtrips");
    var r2_t, r2 = system_status_parse(str_from(system_status_name(STATUS_DEGRADED)));
    assert_eq(is_ok(r2_t), 1, "SystemStatus/STATUS_DEGRADED: parses");
    assert_eq(r2, STATUS_DEGRADED, "SystemStatus/STATUS_DEGRADED: roundtrips");
    var r3_t, r3 = system_status_parse(str_from(system_status_name(STATUS_CRITICAL)));
    assert_eq(is_ok(r3_t), 1, "SystemStatus/STATUS_CRITICAL: parses");
    assert_eq(r3, STATUS_CRITICAL, "SystemStatus/STATUS_CRITICAL: roundtrips");
    var r4_t, r4 = system_status_parse(str_from(system_status_name(STATUS_UNKNOWN)));
    assert_eq(is_ok(r4_t), 1, "SystemStatus/STATUS_UNKNOWN: parses");
    assert_eq(r4, STATUS_UNKNOWN, "SystemStatus/STATUS_UNKNOWN: roundtrips");
    var r5_t, r5 = system_status_parse(str_from("__not_a_system_status__"));
    assert_eq(is_ok(r5_t), 0, "SystemStatus: unknown string rejected");
    return 0;
}

# --- ValidationSeverity: 3 members ---
fn test_validation_severity_roundtrip() {
    var r1_t, r1 = validation_severity_parse(str_from(validation_severity_name(VSEV_LOW)));
    assert_eq(is_ok(r1_t), 1, "ValidationSeverity/VSEV_LOW: parses");
    assert_eq(r1, VSEV_LOW, "ValidationSeverity/VSEV_LOW: roundtrips");
    var r2_t, r2 = validation_severity_parse(str_from(validation_severity_name(VSEV_MEDIUM)));
    assert_eq(is_ok(r2_t), 1, "ValidationSeverity/VSEV_MEDIUM: parses");
    assert_eq(r2, VSEV_MEDIUM, "ValidationSeverity/VSEV_MEDIUM: roundtrips");
    var r3_t, r3 = validation_severity_parse(str_from(validation_severity_name(VSEV_HIGH)));
    assert_eq(is_ok(r3_t), 1, "ValidationSeverity/VSEV_HIGH: parses");
    assert_eq(r3, VSEV_HIGH, "ValidationSeverity/VSEV_HIGH: roundtrips");
    var r4_t, r4 = validation_severity_parse(str_from("__not_a_validation_severity__"));
    assert_eq(is_ok(r4_t), 0, "ValidationSeverity: unknown string rejected");
    var r5_t, r5 = validation_severity_parse(str_from("Unknown"));
    assert_eq(is_ok(r5_t), 0, "ValidationSeverity: fallback string owned by no member -> Err");
    return 0;
}

# --- F-021: previously unsettable fields ---
fn test_f021_secret_metadata_setters() {
    var m = secret_metadata_new(str_from("db-password"), SECRET_PASSWORD);
    assert_eq(smeta_expires_at(m), 0, "F-021: expires_at starts 0");
    assert_eq(smeta_owner(m), 0, "F-021: owner starts 0");
    smeta_set_expires_at(m, 1893456000);
    assert_eq(smeta_expires_at(m), 1893456000, "F-021: expires_at now settable");
    smeta_set_owner(m, str_from("billing-svc"));
    assert_eq(str_eq(smeta_owner(m), str_from("billing-svc")), 1, "F-021: owner now settable");
    return 0;
}

fn test_f021_mcap_flag_setters() {
    var m = model_capabilities_new(str_from("claude-opus-5"), LLM_ANTHROPIC);
    assert_eq(mcap_supports_vision(m), 0, "F-021: vision starts 0");
    assert_eq(mcap_supports_tools(m), 0, "F-021: tools starts 0");
    assert_eq(mcap_supports_structured(m), 0, "F-021: structured starts 0");
    assert_eq(mcap_supports_streaming(m), 0, "F-021: streaming starts 0");
    assert_eq(mcap_supports_thinking(m), 0, "F-021: thinking starts 0");
    assert_eq(mcap_supports_audio(m), 0, "F-021: audio starts 0");
    assert_eq(mcap_supports_citations(m), 0, "F-021: citations starts 0");
    mcap_set_supports_vision(m, 1);
    mcap_set_supports_tools(m, 1);
    mcap_set_supports_structured(m, 1);
    mcap_set_supports_streaming(m, 1);
    mcap_set_supports_thinking(m, 1);
    mcap_set_supports_audio(m, 1);
    mcap_set_supports_citations(m, 1);
    assert_eq(mcap_supports_vision(m), 1, "F-021: vision now settable");
    assert_eq(mcap_supports_tools(m), 1, "F-021: tools now settable");
    assert_eq(mcap_supports_structured(m), 1, "F-021: structured now settable");
    assert_eq(mcap_supports_streaming(m), 1, "F-021: streaming now settable");
    assert_eq(mcap_supports_thinking(m), 1, "F-021: thinking now settable");
    assert_eq(mcap_supports_audio(m), 1, "F-021: audio now settable");
    assert_eq(mcap_supports_citations(m), 1, "F-021: citations now settable");
    return 0;
}

