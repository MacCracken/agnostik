    assert_eq(r4, STIK_ERR_TIMEOUT, "AgnostikErrorKind/STIK_ERR_TIMEOUT: roundtrips");
    var r5_t, r5 = agnostik_err_kind_parse(str_from(agnostik_err_kind_name(STIK_ERR_RESOURCE_EXHAUSTED)));
    assert_eq(is_ok(r5_t), 1, "AgnostikErrorKind/STIK_ERR_RESOURCE_EXHAUSTED: parses");
    assert_eq(r5, STIK_ERR_RESOURCE_EXHAUSTED, "AgnostikErrorKind/STIK_ERR_RESOURCE_EXHAUSTED: roundtrips");
