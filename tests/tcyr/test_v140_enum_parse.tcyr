# --- FinishReason: 6 members ---
fn test_finish_reason_roundtrip() {
    var r1_t, r1 = finish_reason_parse(str_from(finish_reason_name(FINISH_STOP)));
    assert_eq(is_ok(r1_t), 1, "FinishReason/FINISH_STOP: parses");
    assert_eq(r1, FINISH_STOP, "FinishReason/FINISH_STOP: roundtrips");
    var r2_t, r2 = finish_reason_parse(str_from(finish_reason_name(FINISH_LENGTH)));
