    test_llm_provider_roundtrip();
    test_log_severity_roundtrip();
    test_memory_type_roundtrip();
    test_message_role_roundtrip();
    test_message_type_roundtrip();
    test_mount_propagation_roundtrip();
    test_net_access_roundtrip();
    test_permission_roundtrip();
    test_pii_kind_roundtrip();
