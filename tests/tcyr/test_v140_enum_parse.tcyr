# tests/tcyr/test_v140_enum_parse.tcyr
#
# v1.4.0 contract completeness. See docs/audit/2026-08-24-audit.md.
#
# F-018  Every enum carrying a `*_name()` now has a `*_parse()` inverse.
#        Before v1.4.0 the library had 31 enum `_name` functions and
#        ZERO enum `_parse`, so the CLAUDE.md roundtrip guarantee held
#        for no enum at all and each of the eleven consumers hand-rolled
#        its own string->enum mapping.
#
#        This file is deliberately exhaustive and mechanically derived:
#        it asserts `parse(name(v)) == v` for EVERY member of EVERY such
#        enum, plus a rejection case per enum. The reason a 31-enum gap
#        survived eight releases is that nothing checked it, so the
#        invariant is pinned here rather than left to per-enum spot
#        tests. Adding an enum member without extending its `_name` and
#        `_parse` should fail here.
#
#        Note the seven members whose canonical name comes from their
#        `_name` fallback rather than an explicit arm (STIK_ERR_UNKNOWN,
#        HEALTH_UNKNOWN, VENDOR_CUSTOM, LLM_CUSTOM, MEM_UNKNOWN,
#        PII_CUSTOM, STATUS_UNKNOWN). Their `_parse` maps the fallback
#        string back, so the roundtrip is total; the other 24 enums
#        reject their fallback string, since no member owns it.
#
# F-021  `SecretMetadata.expires_at` / `.owner` and the seven original
#        `mcap_supports_*` flags had getters but no setters, so they
#        could only ever read 0. Setters added; exercised below.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/trait.cyr"
include "lib/assert.cyr"
include "src/lib.cyr"

# --- AgentStatus: 9 members ---
fn test_agent_status_roundtrip() {
    var r = 0;
    r = agent_status_parse(str_from(agent_status_name(AGENT_PENDING)));
    assert_eq(is_ok(r), 1, "AgentStatus/AGENT_PENDING: parses");
    assert_eq(payload(r), AGENT_PENDING, "AgentStatus/AGENT_PENDING: roundtrips");
    r = agent_status_parse(str_from(agent_status_name(AGENT_STARTING)));
    assert_eq(is_ok(r), 1, "AgentStatus/AGENT_STARTING: parses");
    assert_eq(payload(r), AGENT_STARTING, "AgentStatus/AGENT_STARTING: roundtrips");
    r = agent_status_parse(str_from(agent_status_name(AGENT_RUNNING)));
    assert_eq(is_ok(r), 1, "AgentStatus/AGENT_RUNNING: parses");
    assert_eq(payload(r), AGENT_RUNNING, "AgentStatus/AGENT_RUNNING: roundtrips");
    r = agent_status_parse(str_from(agent_status_name(AGENT_PAUSED)));
    assert_eq(is_ok(r), 1, "AgentStatus/AGENT_PAUSED: parses");
    assert_eq(payload(r), AGENT_PAUSED, "AgentStatus/AGENT_PAUSED: roundtrips");
    r = agent_status_parse(str_from(agent_status_name(AGENT_STOPPING)));
    assert_eq(is_ok(r), 1, "AgentStatus/AGENT_STOPPING: parses");
    assert_eq(payload(r), AGENT_STOPPING, "AgentStatus/AGENT_STOPPING: roundtrips");
    r = agent_status_parse(str_from(agent_status_name(AGENT_STOPPED)));
    assert_eq(is_ok(r), 1, "AgentStatus/AGENT_STOPPED: parses");
    assert_eq(payload(r), AGENT_STOPPED, "AgentStatus/AGENT_STOPPED: roundtrips");
    r = agent_status_parse(str_from(agent_status_name(AGENT_RESTARTING)));
    assert_eq(is_ok(r), 1, "AgentStatus/AGENT_RESTARTING: parses");
    assert_eq(payload(r), AGENT_RESTARTING, "AgentStatus/AGENT_RESTARTING: roundtrips");
    r = agent_status_parse(str_from(agent_status_name(AGENT_TERMINATED)));
    assert_eq(is_ok(r), 1, "AgentStatus/AGENT_TERMINATED: parses");
    assert_eq(payload(r), AGENT_TERMINATED, "AgentStatus/AGENT_TERMINATED: roundtrips");
    r = agent_status_parse(str_from(agent_status_name(AGENT_FAILED)));
    assert_eq(is_ok(r), 1, "AgentStatus/AGENT_FAILED: parses");
    assert_eq(payload(r), AGENT_FAILED, "AgentStatus/AGENT_FAILED: roundtrips");
    r = agent_status_parse(str_from("__not_a_agent_status__"));
    assert_eq(is_ok(r), 0, "AgentStatus: unknown string rejected");
    r = agent_status_parse(str_from("Unknown"));
    assert_eq(is_ok(r), 0, "AgentStatus: fallback string owned by no member -> Err");
    return 0;
}

