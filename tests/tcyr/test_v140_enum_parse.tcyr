    assert_eq(is_ok(r1_t), 1, "AgnostikErrorKind/STIK_ERR_AGENT_NOT_FOUND: parses");
    assert_eq(r1, STIK_ERR_AGENT_NOT_FOUND, "AgnostikErrorKind/STIK_ERR_AGENT_NOT_FOUND: roundtrips");
    var r2_t, r2 = agnostik_err_kind_parse(str_from(agnostik_err_kind_name(STIK_ERR_PERMISSION_DENIED)));
    assert_eq(is_ok(r2_t), 1, "AgnostikErrorKind/STIK_ERR_PERMISSION_DENIED: parses");
    assert_eq(r2, STIK_ERR_PERMISSION_DENIED, "AgnostikErrorKind/STIK_ERR_PERMISSION_DENIED: roundtrips");
