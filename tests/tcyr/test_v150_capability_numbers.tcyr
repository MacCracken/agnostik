# test_v150_capability_numbers.tcyr — LinuxCapability values ARE kernel
# capability numbers, plus the name/parse roundtrip.
#
# These are not ordinals. Consumers build masks with `1 << cap` and hand
# them to capset(2) / PR_CAPBSET_DROP, so a value that disagrees with
# include/uapi/linux/capability.h silently operates on a DIFFERENT
# capability than the operator named.
#
# Pre-1.5.0 the enum omitted CAP_MAC_OVERRIDE (32) and CAP_MAC_ADMIN (33)
# entirely, shifting everything above 31 down by two, and transposed
# CAP_AUDIT_READ / CAP_AUDIT_CONTROL. "Drop all but CAP_SYSLOG" really kept
# CAP_MAC_ADMIN.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/trait.cyr"
include "lib/assert.cyr"
include "src/lib.cyr"

fn main() {
    alloc_init();
    println("--- v1.5.0 capability numbers ---");

    # --- spot-check the boundaries and the previously-wrong tail ---
    assert_eq(CAP_CHOWN, 0, "cap_chown = 0");
    assert_eq(CAP_DAC_OVERRIDE, 1, "cap_dac_override = 1");
    assert_eq(CAP_KILL, 5, "cap_kill = 5");
    assert_eq(CAP_SETUID, 7, "cap_setuid = 7");
    assert_eq(CAP_SETPCAP, 8, "cap_setpcap = 8");
    assert_eq(CAP_NET_BIND_SERVICE, 10, "cap_net_bind_service = 10");
    assert_eq(CAP_NET_ADMIN, 12, "cap_net_admin = 12");
    assert_eq(CAP_SYS_CHROOT, 18, "cap_sys_chroot = 18");
    assert_eq(CAP_SYS_ADMIN, 21, "cap_sys_admin = 21");
    assert_eq(CAP_SYS_TIME, 25, "cap_sys_time = 25");
    assert_eq(CAP_MKNOD, 27, "cap_mknod = 27");

    # The tail that was wrong before 1.5.0.
    assert_eq(CAP_AUDIT_WRITE, 29, "cap_audit_write = 29");
    assert_eq(CAP_AUDIT_CONTROL, 30, "cap_audit_control = 30");
    assert_eq(CAP_SETFCAP, 31, "cap_setfcap = 31");
    assert_eq(CAP_MAC_OVERRIDE, 32, "cap_mac_override = 32 (was absent)");
    assert_eq(CAP_MAC_ADMIN, 33, "cap_mac_admin = 33 (was absent)");
    assert_eq(CAP_SYSLOG, 34, "cap_syslog = 34 (was 33)");
    assert_eq(CAP_WAKE_ALARM, 35, "cap_wake_alarm = 35");
    assert_eq(CAP_BLOCK_SUSPEND, 36, "cap_block_suspend = 36");
    assert_eq(CAP_AUDIT_READ, 37, "cap_audit_read = 37 (was 30)");
    assert_eq(CAP_PERFMON, 38, "cap_perfmon = 38");
    assert_eq(CAP_BPF, 39, "cap_bpf = 39 (was 36)");
    assert_eq(CAP_CHECKPOINT_RESTORE, 40, "cap_checkpoint_restore = 40 (was 37)");
    assert_eq(CAP_LAST_CAP, 40, "cap_last_cap = 40");

    # No two capabilities may share a value — the defect class that made
    # the tail wrong was a shift, which this catches directly.
    assert(CAP_SYSLOG != CAP_MAC_ADMIN, "syslog != mac_admin");
    assert(CAP_BPF != CAP_BLOCK_SUSPEND, "bpf != block_suspend");
    assert(CAP_AUDIT_READ != CAP_AUDIT_CONTROL, "audit_read != audit_control");

    # --- name / parse roundtrip over every member ---
    var i = 0;
    var roundtrips = 0;
    while (i <= CAP_LAST_CAP) {
        var nm = capability_name(i);
        var r = capability_parse(str_from(nm));
        if (is_ok(r) == 1) {
            if (payload(r) == i) { roundtrips = roundtrips + 1; }
        }
        i = i + 1;
    }
    assert_eq(roundtrips, 41, "all 41 capabilities roundtrip name->parse");

    # Canonical spelling is the lowercase cap_ form used by capsh(1) and
    # capability(7), so a config written against Linux docs parses as-is.
    assert(str_eq_cstr(str_from(capability_name(CAP_SYS_ADMIN)), "cap_sys_admin") == 1, "name spelling");
    assert_eq(payload(capability_parse(str_from("cap_net_bind_service"))), 10, "parse by kernel name");

    # Unrecognised names must error, never default — the failure mode of a
    # silent default is retaining a capability the operator asked to drop.
    assert(is_err_result(capability_parse(str_from("CAP_SYS_ADMIN"))) == 1, "rejects uppercase");
    assert(is_err_result(capability_parse(str_from("sys_admin"))) == 1, "rejects missing prefix");
    assert(is_err_result(capability_parse(str_from("cap_not_a_thing"))) == 1, "rejects unknown");
    assert(is_err_result(capability_parse(str_from(""))) == 1, "rejects empty");
    assert(is_err_result(capability_parse(str_from("unknown"))) == 1, "rejects _name fallback");

    return assert_summary();
}
var r = main();
syscall(SYS_EXIT, r);
