# --- SafetyCategory: 5 members ---
fn test_safety_category_roundtrip() {
    var r1_t, r1 = safety_category_parse(str_from(safety_category_name(SAFETY_HATE)));
    assert_eq(is_ok(r1_t), 1, "SafetyCategory/SAFETY_HATE: parses");
    assert_eq(r1, SAFETY_HATE, "SafetyCategory/SAFETY_HATE: roundtrips");
    var r2_t, r2 = safety_category_parse(str_from(safety_category_name(SAFETY_HARASSMENT)));
    assert_eq(is_ok(r2_t), 1, "SafetyCategory/SAFETY_HARASSMENT: parses");
    assert_eq(r2, SAFETY_HARASSMENT, "SafetyCategory/SAFETY_HARASSMENT: roundtrips");
    var r3_t, r3 = safety_category_parse(str_from(safety_category_name(SAFETY_SEXUAL)));
    assert_eq(is_ok(r3_t), 1, "SafetyCategory/SAFETY_SEXUAL: parses");
    assert_eq(r3, SAFETY_SEXUAL, "SafetyCategory/SAFETY_SEXUAL: roundtrips");
    var r4_t, r4 = safety_category_parse(str_from(safety_category_name(SAFETY_DANGEROUS)));
    assert_eq(is_ok(r4_t), 1, "SafetyCategory/SAFETY_DANGEROUS: parses");
