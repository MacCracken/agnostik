    var r2_t, r2 = device_type_parse(str_from(device_type_name(DEV_BLOCK)));
    assert_eq(is_ok(r2_t), 1, "DeviceType/DEV_BLOCK: parses");
    assert_eq(r2, DEV_BLOCK, "DeviceType/DEV_BLOCK: roundtrips");
    var r3_t, r3 = device_type_parse(str_from(device_type_name(DEV_ALL)));
    assert_eq(is_ok(r3_t), 1, "DeviceType/DEV_ALL: parses");
    assert_eq(r3, DEV_ALL, "DeviceType/DEV_ALL: roundtrips");
    var r4_t, r4 = device_type_parse(str_from("__not_a_device_type__"));
    assert_eq(is_ok(r4_t), 0, "DeviceType: unknown string rejected");
    var r5_t, r5 = device_type_parse(str_from("Unknown"));
    assert_eq(is_ok(r5_t), 0, "DeviceType: fallback string owned by no member -> Err");
    assert(streq(device_type_name(0 - 1), "Unknown") == 1, "DeviceType: -1 names Unknown");
    assert(streq(device_type_name(99999), "Unknown") == 1, "DeviceType: 99999 names Unknown");
    return 0;
}

