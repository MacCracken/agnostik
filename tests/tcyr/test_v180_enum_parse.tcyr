# --- Spellings taken from an external standard, pinned by hand. The
# roundtrip above cannot catch a misspelling, since one table generated
# both the functions and those assertions. ---
fn spell(got, want, label) {
    assert(streq(got, want) == 1, label);
    return 0;
}
# Test: hand-pinned spellings of enum names taken from external standards (Kubernetes,
# LLM APIs, Gemini, Landlock, OCI, limits.conf, OTel), which the roundtrip cannot catch.
fn test_external_spellings() {
    spell(label_operator_name(LABEL_NOT_IN), "NotIn", "LabelOperator: Kubernetes NotIn");
    spell(label_operator_name(LABEL_DOES_NOT_EXIST), "DoesNotExist", "LabelOperator: Kubernetes DoesNotExist");
    spell(content_block_type_name(CB_TOOL_USE), "tool_use", "ContentBlockType: tool_use");
    spell(content_block_type_name(CB_TOOL_RESULT), "tool_result", "ContentBlockType: tool_result");
    spell(cache_control_name(CACHE_EPHEMERAL), "ephemeral", "CacheControl: ephemeral");
    spell(tool_choice_name(TOOL_REQUIRED), "required", "ToolChoice: required");
    spell(response_format_name(RESP_JSON_OBJECT), "json_object", "ResponseFormat: json_object");
    spell(response_format_name(RESP_JSON_SCHEMA), "json_schema", "ResponseFormat: json_schema");
    spell(safety_category_name(SAFETY_HATE), "HARM_CATEGORY_HATE_SPEECH", "SafetyCategory: Gemini hate speech");
    spell(safety_category_name(SAFETY_HARASSMENT), "HARM_CATEGORY_HARASSMENT", "SafetyCategory: Gemini harassment");
    spell(safety_category_name(SAFETY_SEXUAL), "HARM_CATEGORY_SEXUALLY_EXPLICIT", "SafetyCategory: sexually explicit");
    spell(safety_category_name(SAFETY_DANGEROUS), "HARM_CATEGORY_DANGEROUS_CONTENT", "SafetyCategory: dangerous");
    spell(safety_category_name(SAFETY_CIVIC), "HARM_CATEGORY_CIVIC_INTEGRITY", "SafetyCategory: civic integrity");
    spell(safety_probability_name(SAFETY_NEGLIGIBLE), "NEGLIGIBLE", "SafetyProbability: Gemini NEGLIGIBLE");
    spell(safety_probability_name(SAFETY_HIGH), "HIGH", "SafetyProbability: Gemini HIGH");
    spell(batch_status_name(BATCH_IN_PROGRESS), "in_progress", "BatchStatus: in_progress");
    spell(batch_status_name(BATCH_CANCELLED), "cancelled", "BatchStatus: cancelled");
    spell(landlock_fs_access_name(LL_EXECUTE), "Execute", "LandlockFsAccess: Execute");
    spell(landlock_fs_access_name(LL_MAKE_SYM), "MakeSym", "LandlockFsAccess: MakeSym");
    spell(landlock_net_access_name(LL_CONNECT_TCP), "ConnectTcp", "LandlockNetAccess: ConnectTcp");
    spell(landlock_scope_name(LL_SCOPE_ABSTRACT_UNIX), "AbstractUnixSocket", "LandlockScope: AbstractUnixSocket");
    spell(device_type_name(DEV_CHAR), "c", "DeviceType: OCI c");
    spell(device_type_name(DEV_BLOCK), "b", "DeviceType: OCI b");
    spell(device_type_name(DEV_ALL), "a", "DeviceType: OCI a");
    spell(rlimit_type_name(RLIM_NOFILE), "nofile", "RlimitType: limits.conf nofile");
    spell(rlimit_type_name(RLIM_ADDRESS_SPACE), "as", "RlimitType: limits.conf as");
    spell(rlimit_type_name(RLIM_FILE_SIZE), "fsize", "RlimitType: limits.conf fsize");
    spell(rlimit_type_name(RLIM_MSGQUEUE), "msgqueue", "RlimitType: limits.conf msgqueue");
    spell(metric_kind_name(METRIC_UP_DOWN_COUNTER), "UpDownCounter", "MetricKind: OTel UpDownCounter");
    spell(metric_value_type_name(MV_EXP_HISTOGRAM), "ExponentialHistogram", "MetricValueType: OTel exp histogram");
    spell(aggregation_temporality_name(TEMPORALITY_DELTA), "Delta", "AggregationTemporality: OTel Delta");
    return 0;
}

# --- Kernel facts the doc comments state, checked against
# include/uapi/linux/landlock.h and seccomp.h (verified against the kernel
# headers when these were written). ---
fn test_kernel_numbers() {
    # LANDLOCK_ACCESS_FS_* bit indices: `1 << v` is the kernel flag.
    assert_eq(LL_EXECUTE, 0, "LL_EXECUTE is bit 0");
    assert_eq(LL_WRITE_FILE, 1, "LL_WRITE_FILE is bit 1");
    assert_eq(LL_READ_FILE, 2, "LL_READ_FILE is bit 2");
    assert_eq(LL_READ_DIR, 3, "LL_READ_DIR is bit 3");
    assert_eq(LL_REMOVE_DIR, 4, "LL_REMOVE_DIR is bit 4");
    assert_eq(LL_REMOVE_FILE, 5, "LL_REMOVE_FILE is bit 5");
    assert_eq(LL_MAKE_CHAR, 6, "LL_MAKE_CHAR is bit 6");
    assert_eq(LL_MAKE_DIR, 7, "LL_MAKE_DIR is bit 7");
    assert_eq(LL_MAKE_REG, 8, "LL_MAKE_REG is bit 8");
    assert_eq(LL_MAKE_SOCK, 9, "LL_MAKE_SOCK is bit 9");
    assert_eq(LL_MAKE_FIFO, 10, "LL_MAKE_FIFO is bit 10");
    assert_eq(LL_MAKE_BLOCK, 11, "LL_MAKE_BLOCK is bit 11");
    assert_eq(LL_MAKE_SYM, 12, "LL_MAKE_SYM is bit 12");
    assert_eq(LL_REFER, 13, "LL_REFER is bit 13");
    assert_eq(LL_TRUNCATE, 14, "LL_TRUNCATE is bit 14");
    assert_eq(LL_BIND_TCP, 0, "LL_BIND_TCP is bit 0");
    assert_eq(LL_CONNECT_TCP, 1, "LL_CONNECT_TCP is bit 1");
    assert_eq(LL_SCOPE_ABSTRACT_UNIX, 0, "LL_SCOPE_ABSTRACT_UNIX is bit 0");
    assert_eq(LL_SCOPE_SIGNAL, 1, "LL_SCOPE_SIGNAL is bit 1");
    # SECCOMP_MODE_*.
    assert_eq(SECCOMP_DISABLED, 0, "SECCOMP_DISABLED is SECCOMP_MODE_DISABLED");
    assert_eq(SECCOMP_STRICT, 1, "SECCOMP_STRICT is SECCOMP_MODE_STRICT");
    assert_eq(SECCOMP_FILTER, 2, "SECCOMP_FILTER is SECCOMP_MODE_FILTER");
    # AgnostikErrorCode names by value, 1001..1010.
    spell(agnostik_err_code_name(1001), "AgentNotFound", "AgnostikErrorCode: 1001");
    spell(agnostik_err_code_name(1010), "Io", "AgnostikErrorCode: 1010");
    spell(agnostik_err_code_name(0), "Unknown", "AgnostikErrorCode: 0 is no code");
    return 0;
}

# --- Exact match: no case-folding, trimming or aliases (the F-018 rule). ---
fn test_exact_match() {
    var a_t, a = circuit_breaker_state_parse(str_from("halfopen"));
    assert_eq(is_ok(a_t), 0, "CircuitBreakerState: lowercase rejected");
    var b_t, b = content_block_type_parse(str_from("TEXT"));
    assert_eq(is_ok(b_t), 0, "ContentBlockType: uppercase rejected");
    var c_t, c = rlimit_type_parse(str_from("NOFILE"));
    assert_eq(is_ok(c_t), 0, "RlimitType: uppercase rejected");
    var d_t, d = rlimit_type_parse(str_from("RLIMIT_NOFILE"));
    assert_eq(is_ok(d_t), 0, "RlimitType: kernel macro spelling rejected");
    var e_t, e = device_type_parse(str_from(" c"));
    assert_eq(is_ok(e_t), 0, "DeviceType: leading space rejected");
    var f_t, f = safety_probability_parse(str_from("HARM_PROBABILITY_UNSPECIFIED"));
    assert_eq(is_ok(f_t), 0, "SafetyProbability: Gemini UNSPECIFIED has no member");
    var g_t, g = landlock_scope_parse(str_from(""));
    assert_eq(is_ok(g_t), 0, "LandlockScope: empty string rejected");
    return 0;
}

# Test-file entry: runs every v1.8.0 enum roundtrip plus the spelling, kernel-number and
# exact-match pins; returns the assertion summary.
fn main() {
    println("--- v1.8.0 enum name/parse completion ---");
    test_restart_policy_roundtrip();
    test_probe_type_roundtrip();
    test_stop_reason_roundtrip();
    test_circuit_breaker_state_roundtrip();
    test_label_operator_roundtrip();
    test_agnostik_err_code_roundtrip();
    test_content_block_type_roundtrip();
    test_cache_control_roundtrip();
    test_tool_choice_roundtrip();
    test_response_format_roundtrip();
    test_safety_category_roundtrip();
    test_safety_probability_roundtrip();
    test_stream_event_type_roundtrip();
    test_batch_status_roundtrip();
    test_condition_operator_roundtrip();
    test_seccomp_mode_roundtrip();
    test_system_feature_roundtrip();
    test_landlock_fs_access_roundtrip();
    test_landlock_net_access_roundtrip();
    test_landlock_scope_roundtrip();
    test_device_type_roundtrip();
    test_rlimit_type_roundtrip();
    test_event_type_roundtrip();
    test_metric_kind_roundtrip();
    test_aggregation_temporality_roundtrip();
    test_metric_value_type_roundtrip();
    test_external_spellings();
    test_kernel_numbers();
    test_exact_match();
    println("");
    return assert_summary();
}
