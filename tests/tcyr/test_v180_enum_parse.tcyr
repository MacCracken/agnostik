# --- AgnostikErrorCode: 10 members ---
fn test_agnostik_err_code_roundtrip() {
    var r1_t, r1 = agnostik_err_code_parse(str_from(agnostik_err_code_name(CODE_AGENT_NOT_FOUND)));
    assert_eq(is_ok(r1_t), 1, "AgnostikErrorCode/CODE_AGENT_NOT_FOUND: parses");
    assert_eq(r1, CODE_AGENT_NOT_FOUND, "AgnostikErrorCode/CODE_AGENT_NOT_FOUND: roundtrips");
    var r2_t, r2 = agnostik_err_code_parse(str_from(agnostik_err_code_name(CODE_PERMISSION_DENIED)));
    assert_eq(is_ok(r2_t), 1, "AgnostikErrorCode/CODE_PERMISSION_DENIED: parses");
    assert_eq(r2, CODE_PERMISSION_DENIED, "AgnostikErrorCode/CODE_PERMISSION_DENIED: roundtrips");
    var r3_t, r3 = agnostik_err_code_parse(str_from(agnostik_err_code_name(CODE_CONFIG_ERROR)));
    assert_eq(is_ok(r3_t), 1, "AgnostikErrorCode/CODE_CONFIG_ERROR: parses");
    assert_eq(r3, CODE_CONFIG_ERROR, "AgnostikErrorCode/CODE_CONFIG_ERROR: roundtrips");
    var r4_t, r4 = agnostik_err_code_parse(str_from(agnostik_err_code_name(CODE_TIMEOUT)));
    assert_eq(is_ok(r4_t), 1, "AgnostikErrorCode/CODE_TIMEOUT: parses");
    assert_eq(r4, CODE_TIMEOUT, "AgnostikErrorCode/CODE_TIMEOUT: roundtrips");
    var r5_t, r5 = agnostik_err_code_parse(str_from(agnostik_err_code_name(CODE_RESOURCE_EXHAUSTED)));
    assert_eq(is_ok(r5_t), 1, "AgnostikErrorCode/CODE_RESOURCE_EXHAUSTED: parses");
    assert_eq(r5, CODE_RESOURCE_EXHAUSTED, "AgnostikErrorCode/CODE_RESOURCE_EXHAUSTED: roundtrips");
    var r6_t, r6 = agnostik_err_code_parse(str_from(agnostik_err_code_name(CODE_INVALID_ARGUMENT)));
    assert_eq(is_ok(r6_t), 1, "AgnostikErrorCode/CODE_INVALID_ARGUMENT: parses");
    assert_eq(r6, CODE_INVALID_ARGUMENT, "AgnostikErrorCode/CODE_INVALID_ARGUMENT: roundtrips");
    var r7_t, r7 = agnostik_err_code_parse(str_from(agnostik_err_code_name(CODE_NOT_SUPPORTED)));
    assert_eq(is_ok(r7_t), 1, "AgnostikErrorCode/CODE_NOT_SUPPORTED: parses");
    assert_eq(r7, CODE_NOT_SUPPORTED, "AgnostikErrorCode/CODE_NOT_SUPPORTED: roundtrips");
    var r8_t, r8 = agnostik_err_code_parse(str_from(agnostik_err_code_name(CODE_INTERNAL)));
    assert_eq(is_ok(r8_t), 1, "AgnostikErrorCode/CODE_INTERNAL: parses");
    assert_eq(r8, CODE_INTERNAL, "AgnostikErrorCode/CODE_INTERNAL: roundtrips");
    var r9_t, r9 = agnostik_err_code_parse(str_from(agnostik_err_code_name(CODE_SERIALIZATION)));
    assert_eq(is_ok(r9_t), 1, "AgnostikErrorCode/CODE_SERIALIZATION: parses");
    assert_eq(r9, CODE_SERIALIZATION, "AgnostikErrorCode/CODE_SERIALIZATION: roundtrips");
    var r10_t, r10 = agnostik_err_code_parse(str_from(agnostik_err_code_name(CODE_IO)));
    assert_eq(is_ok(r10_t), 1, "AgnostikErrorCode/CODE_IO: parses");
    assert_eq(r10, CODE_IO, "AgnostikErrorCode/CODE_IO: roundtrips");
    var r11_t, r11 = agnostik_err_code_parse(str_from("__not_a_agnostik_err_code__"));
