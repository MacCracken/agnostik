# tests/tcyr/test_v200_derived_layout.tcyr
#
# v2.0.0 step 3b: the structs whose accessors #derive(accessors) now generates
# (ADR-009). For every field, a value stored raw at the offset the 1.12.x
# hand-written accessor used must come back through the derived getter, and the
# derived setter must write that same offset. The offsets below were taken from
# the hand-written accessors before the conversion, so they do not depend on
# the derive. Generated by the step 3b converter. IntegrityFields left the
# derive in step 5d (its Str setters copy), taking its 6 checks with it.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/trait.cyr"
include "lib/assert.cyr"
include "src/lib.cyr"

var _ok = 0;
var _n = 0;
# Counts one check: `got` must equal `want`.
fn chk(got, want) {
    _n = _n + 1;
    if (got == want) { _ok = _ok + 1; }
    return 0;
}

# AcceleratorSummary: 2 fields, raw store -> derived getter, derived setter -> raw load.
fn layout_accelerator_summary() {
    var p = alloc(16);
    store64(p + 0, 7000);
    chk(AcceleratorSummary_devices(p), 7000);
    AcceleratorSummary_set_devices(p, 7500);
    chk(load64(p + 0), 7500);
    store64(p + 8, 7001);
    chk(AcceleratorSummary_total_vram(p), 7001);
    AcceleratorSummary_set_total_vram(p, 7501);
    chk(load64(p + 8), 7501);
    return 0;
}
