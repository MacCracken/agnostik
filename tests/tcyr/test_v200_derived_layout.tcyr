# Test-file entry: checks every derived struct's layout.
fn main() {
    println("--- v2.0.0 derived accessor layout ---");
    layout_accelerator_summary();
    layout_agent_dependency();
    layout_agent_event();
    layout_agent_info();
    layout_agent_manifest();
    layout_agent_message();
    layout_agent_pool();
    layout_agent_rate_limit();
    layout_agent_stats();
    layout_agnos_config();
    layout_agnostik_error();
    layout_auth_context();
    layout_batch_request();
    layout_batch_result();
    layout_capabilities();
    layout_capability_set();
    layout_component_config();
    layout_crash_report();
    layout_device_rule();
    layout_edge_resource_overrides();
    layout_encrypted_storage();
    layout_fleet_config();
    layout_id_mapping();
    layout_inference_response();
    layout_instrument_descriptor();
    layout_lifecycle_hook();
    layout_lifecycle_hooks();
    layout_message();
    layout_metric();
    layout_namespace_config();
    layout_namespace_entry();
    layout_permission_condition();
    layout_profile_definition();
    layout_rate_limit_info();
    layout_resource_grant();
    layout_resource_request();
    layout_resource_usage();
    layout_restart_backoff();
    layout_retention_policy();
    layout_retry_policy();
    layout_rlimit();
    layout_safety_rating();
    layout_sampling_params();
    layout_sandbox_capabilities();
    layout_seccomp_arg();
    layout_security_policy();
    layout_span();
    layout_subscription();
    layout_telemetry_config();
    layout_token_logprob();
    layout_token_payload();
    layout_token_usage();
    layout_tool_call();
    layout_tool_definition();
    layout_tool_result();
    layout_topic();
    layout_topic_message();
    layout_trace_context();
    layout_validation_warning();
    layout_version();
    assert_eq(_ok, 494, "every derived accessor reads and writes the 1.12.x offset");
    assert_eq(_n, 494, "every field was checked");
    return assert_summary();
}
